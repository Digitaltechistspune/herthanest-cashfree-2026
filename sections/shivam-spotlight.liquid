{% comment %}
  HERTHA NEST — ARTISAN SPOTLIGHT V2
  File: sections/shivam-spotlight.liquid
  Assets: shivam-spotlight.css, shivam-spotlight.js
  Product blocks and setting IDs kept compatible with V1.
  Architecture: two picture sources + Shopify Liquid product data + vanilla JS carousel.
{% endcomment %}

{{ 'shivam-spotlight.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shivam-spotlight.js' | asset_url }}" defer></script>

{%- liquid
  assign shs_count = 0
  assign shs_first_product = blank
  assign shs_first_note = blank
  for block in section.blocks
    if block.settings.product != blank
      assign shs_count = shs_count | plus: 1
      if shs_first_product == blank
        assign shs_first_product = block.settings.product
        assign shs_first_note = block.settings.subtitle
      endif
    endif
  endfor

  assign shs_desktop_url = 'https://cdn.shopify.com/s/files/1/0677/4649/6670/files/desktoparc.png?v=1793607872'
  assign shs_mobile_url = 'https://cdn.shopify.com/s/files/1/0677/4649/6670/files/mobilearc.png?v=1793607872'

  if section.settings.desktop_background != blank
    assign shs_desktop_url = section.settings.desktop_background | image_url: width: 2000
  endif
  if section.settings.mobile_background != blank
    assign shs_mobile_url = section.settings.mobile_background | image_url: width: 1000
  endif
-%}

{% if shs_count > 0 or request.design_mode %}
  <section
    id="ShivamSpotlight-{{ section.id }}"
    class="shs"
    data-shs-section
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.autoplay_seconds | times: 1000 }}"
    data-editor="{{ request.design_mode }}"
    aria-labelledby="ShivamSpotlightTitle-{{ section.id }}"
    style="
      --shs-bg: {{ section.settings.background }};
      --shs-ink: {{ section.settings.text_color }};
      --shs-muted: {{ section.settings.muted_color }};
      --shs-accent: {{ section.settings.accent }};
      --shs-duration: {{ section.settings.animation_duration }}ms;
      --shs-near-opacity: {{ section.settings.near_opacity | divided_by: 100.0 }};
      --shs-far-opacity: {{ section.settings.far_opacity | divided_by: 100.0 }};
      --shs-light-opacity: {{ section.settings.spotlight_intensity | divided_by: 100.0 }};
      --shs-max-width: {{ section.settings.scene_max_width }}px;
    "
  >
    <div class="shs__container">
      <header class="shs__header">
        {% if section.settings.eyebrow != blank %}
          <p class="shs__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 id="ShivamSpotlightTitle-{{ section.id }}" class="shs__heading">
          {{ section.settings.heading | escape }}
        </h2>
        {% if section.settings.description != blank %}
          <p class="shs__description">{{ section.settings.description | escape }}</p>
        {% endif %}
      </header>

      {% if shs_count > 0 %}
        <div class="shs__experience">
          <div
            class="shs__stage"
            data-shs-stage
            role="region"
            aria-roledescription="carousel"
            aria-label="Hertha Nest artisan products"
            aria-describedby="ShivamSpotlightHint-{{ section.id }}"
            tabindex="0"
          >
            <picture class="shs__backdrop" aria-hidden="true">
              <source media="(max-width: 749px)" srcset="{{ shs_mobile_url | escape }}">
              <img
                src="{{ shs_desktop_url | escape }}"
                alt=""
                width="1672"
                height="941"
                loading="lazy"
                decoding="async"
              >
            </picture>

            <div class="shs__dynamic-light" aria-hidden="true"></div>

            <ul class="shs__products" data-shs-products>
              {% assign shs_rendered = 0 %}
              {% for block in section.blocks %}
                {% assign shs_product = block.settings.product %}
                {% if shs_product != blank %}
                  {%- liquid
                    assign shs_image = block.settings.stage_image | default: shs_product.featured_image
                    assign shs_alt = block.settings.image_alt | default: shs_product.title
                    assign shs_scale = block.settings.image_scale | divided_by: 100.0
                    assign shs_load = 'lazy'
                    if shs_rendered == 0
                      assign shs_load = 'eager'
                    endif
                  -%}
                  <li
                    class="shs__slide"
                    data-shs-slide
                    data-shs-initial="{% if shs_rendered == 0 %}true{% else %}false{% endif %}"
                    data-block-id="{{ block.id }}"
                    data-title="{{ shs_product.title | escape }}"
                    data-note="{{ block.settings.subtitle | escape }}"
                    data-price="{{ shs_product.price | money | escape }}"
                    data-url="{{ shs_product.url | escape }}"
                    style="
                      --shs-item-scale: {{ shs_scale }};
                      --shs-item-x: {{ block.settings.offset_x }}px;
                      --shs-item-y: {{ block.settings.offset_y }}px;
                    "
                    {{ block.shopify_attributes }}
                  >
                    <a
                      class="shs__product-link"
                      href="{{ shs_product.url }}"
                      draggable="false"
                      aria-label="View {{ shs_product.title | escape }}"
                    >
                      {% if shs_image != blank %}
                        {{
                          shs_image
                          | image_url: width: 1000
                          | image_tag:
                            class: 'shs__product-image',
                            widths: '240,360,480,600,720,900,1000',
                            sizes: '(max-width: 749px) 78vw, (max-width: 1100px) 26vw, 390px',
                            loading: shs_load,
                            alt: shs_alt
                        }}
                      {% else %}
                        <span class="shs__missing-image">{{ shs_product.title | escape }}</span>
                      {% endif %}
                    </a>
                  </li>
                  {% assign shs_rendered = shs_rendered | plus: 1 %}
                {% endif %}
              {% endfor %}
            </ul>

            {% if section.settings.show_mini_labels %}
              <div class="shs__mini-labels" data-shs-mini-labels>
                {% for position in (0..4) %}
                  {% assign shs_position = position | minus: 2 %}
                  <a
                    class="shs__mini-label"
                    data-shs-label
                    data-slot="{{ shs_position }}"
                    href="{{ shs_first_product.url }}"
                    aria-label="View featured product"
                  >
                    <span class="shs__mini-title" data-shs-mini-title></span>
                    {% if section.settings.show_mini_prices %}
                      <span class="shs__mini-price" data-shs-mini-price></span>
                    {% endif %}
                  </a>
                {% endfor %}
              </div>
            {% endif %}

            {% if shs_count > 1 %}
              <div class="shs__arrows" aria-label="Spotlight navigation">
                <button type="button" class="shs__arrow shs__arrow--prev" data-shs-prev aria-label="Previous product">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
                </button>
                <button type="button" class="shs__arrow shs__arrow--next" data-shs-next aria-label="Next product">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
                </button>
              </div>
            {% endif %}
          </div>

          <div class="shs__details" data-shs-details aria-live="polite" aria-atomic="true">
            <span class="shs__count" data-shs-counter>
              01 / {{ shs_count | prepend: '0' | slice: -2, 2 }}
            </span>
            <h3 class="shs__product-title" data-shs-title>{{ shs_first_product.title | escape }}</h3>
            <p class="shs__note" data-shs-note {% if shs_first_note == blank %}hidden{% endif %}>
              {{ shs_first_note | escape }}
            </p>
            {% if section.settings.show_price %}
              <p class="shs__price" data-shs-price>{{ shs_first_product.price | money }}</p>
            {% endif %}
            {% if section.settings.show_cta %}
              <a class="shs__cta" data-shs-cta href="{{ shs_first_product.url }}">
                {{ section.settings.cta_label | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </a>
            {% endif %}
          </div>
        </div>
        <p class="shs__sr-only" id="ShivamSpotlightHint-{{ section.id }}">
          Use the previous and next buttons or the left and right arrow keys to browse products.
          Swipe on touchscreens. Product images and display labels link to product pages.
        </p>
      {% elsif request.design_mode %}
        <div class="shs__editor-empty">
          Add product blocks, choose the Shopify products, and upload their transparent spotlight images.
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Hertha Artisan Spotlight",
  "tag": "div",
  "class": "section-shivam-hertha-spotlight",
  "enabled_on": {"templates": ["index"]},
  "max_blocks": 10,
  "settings": [
    {"type": "header", "content": "Section content"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE HERTHA NEST COLLECTION"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Every Piece Has a Story."},
    {"type": "textarea", "id": "description", "label": "Description", "default": "Discover handcrafted treasures, one spotlight at a time."},
    {"type": "checkbox", "id": "show_price", "label": "Show active product price", "default": true},
    {"type": "checkbox", "id": "show_cta", "label": "Show View Product button", "default": true},
    {"type": "text", "id": "cta_label", "label": "Button label", "default": "DISCOVER THIS PIECE"},
    {"type": "header", "content": "Gallery backgrounds"},
    {"type": "paragraph", "content": "Desktop and mobile arch scenes are preconfigured. Use the pickers only if you want to replace them."},
    {"type": "image_picker", "id": "desktop_background", "label": "Override desktop gallery scene"},
    {"type": "image_picker", "id": "mobile_background", "label": "Override mobile gallery scene"},
    {"type": "range", "id": "scene_max_width", "label": "Max desktop scene width", "min": 1200, "max": 2000, "step": 50, "unit": "px", "default": 1700},
    {"type": "color", "id": "background", "label": "Section background", "default": "#F7F3EB"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#29211C"},
    {"type": "color", "id": "muted_color", "label": "Secondary text", "default": "#73695F"},
    {"type": "color", "id": "accent", "label": "Buttons and accents", "default": "#315548"},
    {"type": "range", "id": "spotlight_intensity", "label": "Extra moving spotlight glow", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20},
    {"type": "header", "content": "Stage and movement"},
    {"type": "range", "id": "animation_duration", "label": "Motion duration", "min": 450, "max": 1050, "step": 50, "unit": "ms", "default": 750},
    {"type": "range", "id": "near_opacity", "label": "Neighbour product opacity", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 90},
    {"type": "range", "id": "far_opacity", "label": "Outer product opacity", "min": 30, "max": 90, "step": 5, "unit": "%", "default": 70},
    {"type": "checkbox", "id": "show_mini_labels", "label": "Show showroom product labels", "default": true},
    {"type": "checkbox", "id": "show_mini_prices", "label": "Show price inside mini labels", "default": false},
    {"type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": false},
    {"type": "range", "id": "autoplay_seconds", "label": "Autoplay interval", "min": 3, "max": 9, "step": 1, "unit": "s", "default": 5}
  ],
  "blocks": [
    {
      "type": "product_spotlight",
      "name": "Spotlight product",
      "settings": [
        {"type": "product", "id": "product", "label": "Product", "info": "Title, price and product link come from Shopify."},
        {"type": "image_picker", "id": "stage_image", "label": "Transparent product image", "info": "Use a 1400 x 1400 transparent PNG/WebP. Does not change your product gallery."},
        {"type": "text", "id": "image_alt", "label": "Optional image alt text"},
        {"type": "text", "id": "subtitle", "label": "Short subtitle (optional)"},
        {"type": "header", "content": "Fine-tune podium alignment"},
        {"type": "range", "id": "image_scale", "label": "Product size", "min": 65, "max": 150, "step": 5, "unit": "%", "default": 100},
        {"type": "range", "id": "offset_x", "label": "Horizontal adjustment", "min": -60, "max": 60, "step": 5, "unit": "px", "default": 0},
        {"type": "range", "id": "offset_y", "label": "Vertical adjustment", "min": -80, "max": 80, "step": 5, "unit": "px", "default": 0}
      ]
    }
  ],
  "presets": [{"name": "Hertha Artisan Spotlight", "category": "Products"}]
}
{% endschema %}
