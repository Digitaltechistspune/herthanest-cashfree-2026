
{% comment %}
  HERTHA NEST — LATEST 30 PRODUCTS
  File: sections/shivam-hertha-latest-30.liquid

  Collection-powered Shopify section.
  No client-side product-fetching or sorting.

  Row 1: Products 1–15
  Row 2: Products 16–30

  Features:
  - Collection picker in theme editor
  - Shopify Liquid product rendering
  - Responsive Shopify CDN images
  - Infinite carousel with arrows
  - Autoplay and mobile swipe
  - AJAX Add to Cart
  - Cart feedback notification
  - Accessible links and controls
  - Reduced-motion support
{% endcomment %}

{%- liquid
  assign hn_collection = section.settings.collection
  assign hn_total = 0

  if hn_collection != blank
    assign hn_total = hn_collection.products_count
  endif
-%}

<section
  id="hn-new30-{{ section.id }}"
  class="hn-new30"
  data-hn-latest
  data-autoplay="{{ section.settings.autoplay }}"
  aria-labelledby="hn-new30-title-{{ section.id }}"
>
  <div class="hn-new30__inner">

    <header class="hn-new30__header">
      <span class="hn-new30__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </span>

      <h2
        class="hn-new30__title"
        id="hn-new30-title-{{ section.id }}"
      >
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="hn-new30__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </header>

    {% if hn_collection != blank and hn_total > 0 %}

      {% for hn_row in (1..2) %}

        {%- liquid
          assign hn_offset = 0

          if hn_row == 2
            assign hn_offset = 15
          endif

          assign hn_remaining = hn_total | minus: hn_offset
        -%}

        {% if hn_remaining > 0 %}

          {% if hn_row == 2 %}
            <div
              class="hn-new30__divider"
              aria-hidden="true"
            >
              <span></span>
            </div>
          {% endif %}

          <div
            class="hn-new30__carousel"
            data-hn-carousel
            data-delay="{% if hn_row == 1 %}3400{% else %}3900{% endif %}"
            aria-label="{% if hn_row == 1 %}Latest fifteen products{% else %}Next fifteen products{% endif %}"
          >

            <div class="hn-new30__controls" hidden>
              <button
                type="button"
                class="hn-new30__arrow"
                data-hn-prev
                aria-label="Previous products"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M15 18 9 12l6-6"/>
                </svg>
              </button>

              <button
                type="button"
                class="hn-new30__arrow"
                data-hn-next
                aria-label="Next products"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>
            </div>

            <div class="hn-new30__viewport">
              <div class="hn-new30__track">

                {% for product in hn_collection.products limit: 15 offset: hn_offset %}

                  {%- liquid
                    assign hn_variant = product.selected_or_first_available_variant

                    assign hn_image = hn_variant.featured_image

                    if hn_image == blank
                      assign hn_image = product.featured_image
                    endif

                    assign hn_image_alt = hn_image.alt | default: product.title

                    assign hn_compare = false

                    if hn_variant.compare_at_price > hn_variant.price
                      assign hn_compare = true
                    endif
                  -%}

                  <article class="hn-new30__card">

                    <a
                      class="hn-new30__image-link"
                      href="{{ product.url }}"
                      aria-label="View {{ product.title | escape }}"
                    >
                      <span class="hn-new30__badge">
                        Just Unveiled
                      </span>

                      {% if hn_image != blank %}
                        {{
                          hn_image
                          | image_url: width: 720
                          | image_tag:
                            class: 'hn-new30__image',
                            widths: '240,320,400,480,600,720',
                            sizes: '(max-width: 580px) calc(100vw - 28px), (max-width: 820px) calc((100vw - 58px) / 2), (max-width: 1120px) calc((100vw - 84px) / 3), 360px',
                            loading: 'lazy',
                            alt: hn_image_alt
                        }}
                      {% else %}
                        <div class="hn-new30__image-placeholder">
                          {{ product.title | escape }}
                        </div>
                      {% endif %}
                    </a>

                    <div class="hn-new30__content">

                      {% if section.settings.show_vendor and product.vendor != blank %}
                        <div class="hn-new30__vendor">
                          {{ product.vendor | escape }}
                        </div>
                      {% endif %}

                      <h3 class="hn-new30__product-title">
                        <a href="{{ product.url }}">
                          {{ product.title | escape }}
                        </a>
                      </h3>

                      <div class="hn-new30__bottom">

                        <div class="hn-new30__prices">
                          {% if hn_variant != blank %}
                            <span class="hn-new30__price">
                              {{ hn_variant.price | money }}
                            </span>

                            {% if hn_compare %}
                              <span class="hn-new30__compare-price">
                                {{ hn_variant.compare_at_price | money }}
                              </span>
                            {% endif %}
                          {% endif %}
                        </div>

                        {% if hn_variant != blank and hn_variant.available %}
                          <button
                            type="button"
                            class="hn-new30__add"
                            data-hn-add
                            data-variant-id="{{ hn_variant.id }}"
                            data-product-title="{{ product.title | escape }}"
                            aria-label="Add {{ product.title | escape }} to cart"
                          >
                            <span class="hn-new30__cart-symbol">
                              <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                              >
                                <path d="M6 7h12l-1 13H7L6 7Z"/>
                                <path d="M9 9V6a3 3 0 0 1 6 0v3"/>
                              </svg>
                            </span>

                            <span class="hn-new30__button-text">
                              Add to cart
                            </span>
                          </button>
                        {% else %}
                          <button
                            type="button"
                            class="hn-new30__add"
                            disabled
                          >
                            Sold out
                          </button>
                        {% endif %}

                      </div>
                    </div>

                  </article>

                {% endfor %}

              </div>
            </div>
          </div>

        {% endif %}
      {% endfor %}

    {% else %}

      {% if request.design_mode %}
        <div class="hn-new30__empty">
          Select your Home – Latest Arrivals collection
          in this section's settings to display products.
        </div>
      {% endif %}

    {% endif %}

  </div>

  <div
    class="hn-new30__toast"
    data-hn-toast
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <span class="hn-new30__toast-icon">
      ✓
    </span>

    <span data-hn-toast-message>
      Product added to your cart.
    </span>

    <a href="{{ routes.cart_url }}">
      View cart
    </a>
  </div>
</section>

<style>
  /* SECTION AND THEME WRAPPER */

  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  #hn-new30-{{ section.id }} {
    --hn30-green: #315548;
    --hn30-green-dark: #203f35;
    --hn30-gold: #bd9152;
    --hn30-white: #ffffff;
    --hn30-heading: #29211c;
    --hn30-text: rgba(41,33,28,.70);
    --hn30-muted: rgba(41,33,28,.52);
    --hn30-border: rgba(49,85,72,.14);
    --hn30-gap: 20px;

    position: relative;
    left: 50%;
    width: 100vw;
    max-width: 100vw;
    margin: 0 0 0 -50vw;
    padding: 38px 0 44px;
    overflow: hidden;

    color: var(--hn30-heading);

    background:
      radial-gradient(
        circle at 5% 0%,
        rgba(189,145,82,.14),
        transparent 27%
      ),
      radial-gradient(
        circle at 95% 100%,
        rgba(49,85,72,.10),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #f8f6ef 0%,
        #fffdf8 48%,
        #f4f3ec 100%
      );
  }

  #hn-new30-{{ section.id }} *,
  #hn-new30-{{ section.id }} *::before,
  #hn-new30-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* INNER LAYOUT */

  #hn-new30-{{ section.id }} .hn-new30__inner {
    width: 100%;
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* SECTION HEADER */

  #hn-new30-{{ section.id }} .hn-new30__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 850px;
    margin: 0 auto 22px;
    text-align: center;
  }

  #hn-new30-{{ section.id }} .hn-new30__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin: 0 0 9px;

    color: var(--hn30-green);
    font-size: 11px;
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  #hn-new30-{{ section.id }} .hn-new30__eyebrow::before,
  #hn-new30-{{ section.id }} .hn-new30__eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--hn30-gold);
  }

  #hn-new30-{{ section.id }} .hn-new30__title {
    margin: 0;
    color: var(--hn30-heading);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(29px,3.5vw,44px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.5px;
  }

  #hn-new30-{{ section.id }} .hn-new30__description {
    max-width: 720px;
    margin: 10px auto 0;
    color: var(--hn30-text);
    font-size: 14px;
    line-height: 1.65;
  }

  /* CAROUSELS */

  #hn-new30-{{ section.id }} .hn-new30__carousel {
    width: 100%;
  }

  #hn-new30-{{ section.id }} .hn-new30__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    margin: 0 0 17px;
  }

  #hn-new30-{{ section.id }} .hn-new30__controls[hidden] {
    display: none !important;
  }

  #hn-new30-{{ section.id }} .hn-new30__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    padding: 0;
    border: 1px solid var(--hn30-border);
    border-radius: 50%;
    background: rgba(255,255,255,.86);
    color: var(--hn30-green-dark);
    box-shadow:
      0 7px 18px rgba(32,63,53,.08),
      inset 0 1px 0 rgba(255,255,255,.9);
    cursor: pointer;

    transition:
      transform .25s ease,
      border-color .25s ease,
      background .25s ease,
      color .25s ease;
  }

  #hn-new30-{{ section.id }} .hn-new30__arrow:hover {
    transform: translateY(-2px);
    border-color: var(--hn30-green);
    background: var(--hn30-green);
    color: #fff;
  }

  #hn-new30-{{ section.id }} .hn-new30__arrow:focus-visible,
  #hn-new30-{{ section.id }} .hn-new30__add:focus-visible,
  #hn-new30-{{ section.id }} .hn-new30__product-title a:focus-visible {
    outline: 2px solid var(--hn30-gold);
    outline-offset: 3px;
  }

  #hn-new30-{{ section.id }} .hn-new30__arrow svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #hn-new30-{{ section.id }} .hn-new30__viewport {
    width: 100%;
    overflow: hidden;
    touch-action: pan-y;
  }

  #hn-new30-{{ section.id }} .hn-new30__track {
    display: flex;
    align-items: stretch;
    gap: var(--hn30-gap);
    width: 100%;
    transition: transform .55s cubic-bezier(.22,.61,.36,1);
  }

  /* SEPARATOR */

  #hn-new30-{{ section.id }} .hn-new30__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 26px 0 18px;
  }

  #hn-new30-{{ section.id }} .hn-new30__divider span {
    position: relative;
    display: block;
    width: min(620px,75%);
    height: 1px;

    background: linear-gradient(
      90deg,
      transparent,
      rgba(49,85,72,.16),
      rgba(189,145,82,.36),
      rgba(49,85,72,.16),
      transparent
    );
  }

  #hn-new30-{{ section.id }} .hn-new30__divider span::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    border: 1px solid rgba(189,145,82,.55);
    background: #f8f6ef;
    transform: translate(-50%,-50%) rotate(45deg);
  }

  /* PRODUCT CARD */

  #hn-new30-{{ section.id }} .hn-new30__card {
    position: relative;
    flex: 0 0 calc((100% - 60px) / 4);
    min-width: 0;
    overflow: hidden;

    border: 1px solid var(--hn30-border);
    border-radius: 18px;
    background: var(--hn30-white);
    box-shadow:
      0 10px 25px rgba(41,33,28,.06),
      0 2px 5px rgba(41,33,28,.025);

    transition:
      transform .3s ease,
      border-color .3s ease,
      box-shadow .3s ease;
  }

  #hn-new30-{{ section.id }} .hn-new30__card:hover {
    transform: translateY(-5px);
    border-color: rgba(189,145,82,.38);
    box-shadow:
      0 18px 38px rgba(41,33,28,.11),
      0 4px 10px rgba(41,33,28,.04);
  }

  /* PRODUCT IMAGE */

  #hn-new30-{{ section.id }} .hn-new30__image-link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f0eee7;
  }

  #hn-new30-{{ section.id }} .hn-new30__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;

    transition:
      transform .65s cubic-bezier(.22,.61,.36,1);
  }

  #hn-new30-{{ section.id }} .hn-new30__card:hover
  .hn-new30__image {
    transform: scale(1.05);
  }

  #hn-new30-{{ section.id }} .hn-new30__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 30px;
    background: linear-gradient(
      135deg,
      rgba(49,85,72,.12),
      rgba(255,255,255,.90)
    );
    color: var(--hn30-green);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    text-align: center;
  }

  /* NEW ARRIVAL BADGE */

  #hn-new30-{{ section.id }} .hn-new30__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;

    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
    padding: 7px 11px;

    border: 1px solid rgba(255,255,255,.32);
    border-radius: 999px;
    background: rgba(35,72,59,.93);
    color: #fff;

    box-shadow: 0 7px 18px rgba(21,46,37,.20);

    font-size: 9px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: 1.05px;
    text-transform: uppercase;
  }

  #hn-new30-{{ section.id }} .hn-new30__badge::before {
    content: "";
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: #e8bd78;
    box-shadow: 0 0 0 4px rgba(232,189,120,.16);
  }

  /* PRODUCT CONTENT */

  #hn-new30-{{ section.id }} .hn-new30__content {
    display: block;
    padding: 14px 15px 15px;
  }

  #hn-new30-{{ section.id }} .hn-new30__vendor {
    margin: 0 0 5px;
    overflow: hidden;
    color: var(--hn30-green);
    font-size: 9px;
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: 1.2px;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #hn-new30-{{ section.id }} .hn-new30__product-title {
    min-height: 44px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.32;
  }

  #hn-new30-{{ section.id }} .hn-new30__product-title a {
    display: -webkit-box;
    overflow: hidden;
    color: var(--hn30-heading);
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color .22s ease;
  }

  #hn-new30-{{ section.id }} .hn-new30__product-title a:hover {
    color: var(--hn30-green);
  }

  /* PRICE AND BUTTON */

  #hn-new30-{{ section.id }} .hn-new30__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(49,85,72,.09);
  }

  #hn-new30-{{ section.id }} .hn-new30__prices {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    min-width: 0;
  }

  #hn-new30-{{ section.id }} .hn-new30__price {
    color: var(--hn30-heading);
    font-size: 17px;
    font-weight: 750;
    line-height: 1.25;
  }

  #hn-new30-{{ section.id }} .hn-new30__compare-price {
    color: var(--hn30-muted);
    font-size: 11px;
    line-height: 1.25;
    text-decoration: line-through;
  }

  #hn-new30-{{ section.id }} .hn-new30__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 118px;
    min-height: 44px;
    padding: 9px 15px;

    border: 1px solid var(--hn30-green);
    border-radius: 999px;

    background: linear-gradient(
      135deg,
      var(--hn30-green),
      var(--hn30-green-dark)
    );

    color: #fff;
    font-family: inherit;
    font-size: 11px;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;

    box-shadow:
      0 7px 16px rgba(32,63,53,.18),
      inset 0 1px 0 rgba(255,255,255,.13);

    transition:
      transform .25s ease,
      background .25s ease,
      opacity .25s ease;
  }

  #hn-new30-{{ section.id }} .hn-new30__add:hover {
    transform: translateY(-2px);
    background: linear-gradient(
      135deg,
      #c69a58,
      #a87738
    );
  }

  #hn-new30-{{ section.id }} .hn-new30__cart-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    border-radius: 50%;
    background: rgba(255,255,255,.14);
  }

  #hn-new30-{{ section.id }} .hn-new30__cart-symbol svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #hn-new30-{{ section.id }} .hn-new30__add.is-loading {
    pointer-events: none;
    opacity: .62;
  }

  #hn-new30-{{ section.id }} .hn-new30__add.is-added {
    background: #4f8062;
    border-color: #4f8062;
  }

  #hn-new30-{{ section.id }} .hn-new30__add:disabled {
    transform: none;
    border-color: #d2cec4;
    background: #d2cec4;
    color: #716e67;
    box-shadow: none;
    cursor: not-allowed;
  }

  /* EMPTY STATE */

  #hn-new30-{{ section.id }} .hn-new30__empty {
    padding: 35px 20px;
    border: 1px solid var(--hn30-border);
    border-radius: 16px;
    background: #fff;
    color: var(--hn30-text);
    font-size: 13px;
    text-align: center;
  }

  /* CART NOTIFICATION */

  #hn-new30-{{ section.id }} .hn-new30__toast {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 999999;

    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(420px,calc(100vw - 30px));
    padding: 13px 15px;

    border: 1px solid rgba(255,255,255,.14);
    border-radius: 13px;
    background: rgba(32,63,53,.97);
    color: #fff;
    box-shadow: 0 17px 42px rgba(0,0,0,.22);

    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);

    transition:
      opacity .3s ease,
      visibility .3s ease,
      transform .3s ease;
  }

  #hn-new30-{{ section.id }} .hn-new30__toast.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #hn-new30-{{ section.id }} .hn-new30__toast-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex: 0 0 25px;
    border-radius: 50%;
    background: rgba(255,255,255,.14);
    color: #f0cb8a;
    font-weight: 800;
  }

  #hn-new30-{{ section.id }} .hn-new30__toast [data-hn-toast-message] {
    font-size: 12px;
    font-weight: 650;
    line-height: 1.4;
  }

  #hn-new30-{{ section.id }} .hn-new30__toast a {
    margin-left: auto;
    color: #f3ce8c;
    font-size: 11px;
    font-weight: 750;
    white-space: nowrap;
    text-decoration: underline;
  }

  /* TABLET */

  @media (max-width: 1120px) {
    #hn-new30-{{ section.id }} .hn-new30__card {
      flex-basis: calc((100% - 40px) / 3);
    }
  }

  @media (max-width: 820px) {
    #hn-new30-{{ section.id }} .hn-new30__card {
      flex-basis: calc((100% - 20px) / 2);
    }

    #hn-new30-{{ section.id }} .hn-new30__inner {
      padding: 0 22px;
    }
  }

  /* MOBILE */

  @media (max-width: 580px) {
    #hn-new30-{{ section.id }} {
      --hn30-gap: 14px;
      padding: 28px 0 32px;
    }

    #hn-new30-{{ section.id }} .hn-new30__inner {
      padding: 0 14px;
    }

    #hn-new30-{{ section.id }} .hn-new30__header {
      margin-bottom: 17px;
    }

    #hn-new30-{{ section.id }} .hn-new30__eyebrow {
      margin-bottom: 7px;
      font-size: 9px;
      letter-spacing: 1.35px;
    }

    #hn-new30-{{ section.id }} .hn-new30__eyebrow::before,
    #hn-new30-{{ section.id }} .hn-new30__eyebrow::after {
      width: 20px;
    }

    #hn-new30-{{ section.id }} .hn-new30__title {
      font-size: 29px;
    }

    #hn-new30-{{ section.id }} .hn-new30__description {
      margin-top: 8px;
      font-size: 12.5px;
      line-height: 1.55;
    }

    #hn-new30-{{ section.id }} .hn-new30__card {
      flex-basis: 100%;
      border-radius: 16px;
    }

    #hn-new30-{{ section.id }} .hn-new30__content {
      padding: 13px 13px 14px;
    }

    #hn-new30-{{ section.id }} .hn-new30__product-title {
      min-height: 42px;
      font-size: 16px;
    }

    #hn-new30-{{ section.id }} .hn-new30__price {
      font-size: 16px;
    }

    #hn-new30-{{ section.id }} .hn-new30__add {
      min-width: 112px;
      min-height: 44px;
      padding: 8px 12px;
      font-size: 10.5px;
    }

    #hn-new30-{{ section.id }} .hn-new30__divider {
      margin: 21px 0 15px;
    }

    #hn-new30-{{ section.id }} .hn-new30__toast {
      right: 14px;
      bottom: 14px;
    }
  }

  @media (max-width: 370px) {
    #hn-new30-{{ section.id }} .hn-new30__add {
      min-width: 94px;
      padding: 8px 10px;
    }

    #hn-new30-{{ section.id }} .hn-new30__cart-symbol {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #hn-new30-{{ section.id }} .hn-new30__track,
    #hn-new30-{{ section.id }} .hn-new30__card,
    #hn-new30-{{ section.id }} .hn-new30__image,
    #hn-new30-{{ section.id }} .hn-new30__arrow,
    #hn-new30-{{ section.id }} .hn-new30__add {
      transition-duration: .01ms !important;
    }
  }
</style>

<script>
(function () {
  "use strict";

  const sectionId = {{ section.id | json }};

  function initialise() {
    const root = document.getElementById(
      "hn-new30-" + sectionId
    );

    if (!root || root.dataset.hnReady === "true") {
      return;
    }

    root.dataset.hnReady = "true";

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const autoplayEnabled =
      root.dataset.autoplay === "true";

    const addUrl =
      {{ routes.cart_add_url | append: '.js' | json }};

    const cartUrl =
      {{ routes.cart_url | append: '.js' | json }};

    const toast = root.querySelector("[data-hn-toast]");
    const toastMessage = root.querySelector(
      "[data-hn-toast-message]"
    );

    let toastTimer = null;

    /* ===========================================
       INFINITE PRODUCT CAROUSEL
    =========================================== */

    function initialiseCarousel(carousel) {
      const viewport = carousel.querySelector(
        ".hn-new30__viewport"
      );
      const track = carousel.querySelector(
        ".hn-new30__track"
      );
      const controls = carousel.querySelector(
        ".hn-new30__controls"
      );

      if (!viewport || !track || !controls) {
        return;
      }

      const originals = Array.from(
        track.querySelectorAll(".hn-new30__card")
      );

      const count = originals.length;

      if (!count) {
        return;
      }

      const cloneCount =
        count > 1 ? Math.min(4, count) : 0;

      function cloneCard(card) {
        const clone = card.cloneNode(true);

        clone.setAttribute("aria-hidden", "true");

        clone
          .querySelectorAll("a, button")
          .forEach(function (element) {
            element.setAttribute("tabindex", "-1");
          });

        return clone;
      }

      if (cloneCount) {
        const before = originals
          .slice(-cloneCount)
          .map(cloneCard);

        const after = originals
          .slice(0, cloneCount)
          .map(cloneCard);

        before.forEach(function (card) {
          track.insertBefore(card, track.firstChild);
        });

        after.forEach(function (card) {
          track.appendChild(card);
        });
      }

      let index = cloneCount;
      let cardWidth = 0;
      let gap = 20;
      let visibleCount = 4;
      let canMove = false;
      let animating = false;

      let autoplayTimer = null;
      let resizeTimer = null;
      let isHovering = false;
      let hasFocus = false;
      let isTouching = false;
      let isVisible =
        !("IntersectionObserver" in window);

      let touchStartX = 0;

      const delay = Number(
        carousel.dataset.delay || 3400
      );

      function getVisibleCount() {
        const width = viewport.clientWidth;

        if (width <= 580) return 1;
        if (width <= 820) return 2;
        if (width <= 1120) return 3;

        return 4;
      }

      function setPosition(animated) {
        track.style.transition =
          animated && !reduceMotion
            ? "transform .55s cubic-bezier(.22,.61,.36,1)"
            : "none";

        const distance =
          index * (cardWidth + gap);

        track.style.transform =
          "translate3d(-" + distance + "px,0,0)";
      }

      function normalisePosition() {
        if (!cloneCount) {
          animating = false;
          return;
        }

        if (index >= cloneCount + count) {
          index -= count;
          setPosition(false);
        } else if (index < cloneCount) {
          index += count;
          setPosition(false);
        }

        animating = false;
      }

      function move(direction) {
        if (!canMove || animating) {
          return;
        }

        index += direction;
        animating = !reduceMotion;

        setPosition(!reduceMotion);

        if (reduceMotion) {
          normalisePosition();
        }
      }

      track.addEventListener(
        "transitionend",
        function (event) {
          if (
            event.target === track &&
            event.propertyName === "transform"
          ) {
            normalisePosition();
          }
        }
      );

      function stopAutoplay() {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }

      function startAutoplay() {
        stopAutoplay();

        if (
          !autoplayEnabled ||
          reduceMotion ||
          !canMove ||
          !isVisible ||
          isHovering ||
          hasFocus ||
          isTouching ||
          document.hidden
        ) {
          return;
        }

        autoplayTimer = window.setInterval(
          function () {
            move(1);
          },
          delay
        );
      }

      function updateSizes() {
        if (animating) {
          animating = false;
          normalisePosition();
        }

        const styles = window.getComputedStyle(track);

        gap = parseFloat(styles.columnGap) || 20;

        visibleCount = Math.min(
          count,
          getVisibleCount()
        );

        cardWidth =
          (
            viewport.clientWidth -
            gap * (visibleCount - 1)
          ) / visibleCount;

        track.querySelectorAll(
          ".hn-new30__card"
        ).forEach(function (card) {
          card.style.flexBasis = cardWidth + "px";
          card.style.width = cardWidth + "px";
        });

        canMove = count > visibleCount;

        controls.hidden = !canMove;

        setPosition(false);
        startAutoplay();
      }

      const prev = carousel.querySelector(
        "[data-hn-prev]"
      );

      const next = carousel.querySelector(
        "[data-hn-next]"
      );

      if (prev) {
        prev.addEventListener("click", function () {
          move(-1);
          startAutoplay();
        });
      }

      if (next) {
        next.addEventListener("click", function () {
          move(1);
          startAutoplay();
        });
      }

      carousel.addEventListener(
        "mouseenter",
        function () {
          isHovering = true;
          stopAutoplay();
        }
      );

      carousel.addEventListener(
        "mouseleave",
        function () {
          isHovering = false;
          startAutoplay();
        }
      );

      carousel.addEventListener(
        "focusin",
        function () {
          hasFocus = true;
          stopAutoplay();
        }
      );

      carousel.addEventListener(
        "focusout",
        function (event) {
          if (
            !event.relatedTarget ||
            !carousel.contains(event.relatedTarget)
          ) {
            hasFocus = false;
            startAutoplay();
          }
        }
      );

      viewport.addEventListener(
        "touchstart",
        function (event) {
          isTouching = true;

          touchStartX =
            event.changedTouches[0].screenX;

          stopAutoplay();
        },
        { passive: true }
      );

      viewport.addEventListener(
        "touchend",
        function (event) {
          const touchEndX =
            event.changedTouches[0].screenX;

          const difference =
            touchStartX - touchEndX;

          if (Math.abs(difference) > 45) {
            move(difference > 0 ? 1 : -1);
          }

          isTouching = false;
          startAutoplay();
        },
        { passive: true }
      );

      viewport.addEventListener(
        "touchcancel",
        function () {
          isTouching = false;
          startAutoplay();
        },
        { passive: true }
      );

      window.addEventListener(
        "resize",
        function () {
          window.clearTimeout(resizeTimer);

          resizeTimer = window.setTimeout(
            updateSizes,
            120
          );
        },
        { passive: true }
      );

      document.addEventListener(
        "visibilitychange",
        function () {
          startAutoplay();
        }
      );

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              isVisible = entry.isIntersecting;
              startAutoplay();
            });
          },
          {
            threshold: 0.12
          }
        );

        observer.observe(carousel);
      }

      updateSizes();

      // Recalculate once after layout settles.
      window.requestAnimationFrame(updateSizes);
    }

    root.querySelectorAll(
      "[data-hn-carousel]"
    ).forEach(initialiseCarousel);

    /* ===========================================
       CART NOTIFICATION
    =========================================== */

    function showToast(message, error) {
      if (!toast || !toastMessage) {
        return;
      }

      toastMessage.textContent = message;

      toast.style.background = error
        ? "rgba(132,48,48,.97)"
        : "rgba(32,63,53,.97)";

      toast.classList.add("is-visible");

      window.clearTimeout(toastTimer);

      toastTimer = window.setTimeout(function () {
        toast.classList.remove("is-visible");
      }, 3200);
    }

    /* ===========================================
       REFRESH THEME CART COUNT
    =========================================== */

    async function refreshCart() {
      try {
        const response = await fetch(cartUrl, {
          method: "GET",
          credentials: "same-origin",
          cache: "no-store",
          headers: {
            "Accept": "application/json"
          }
        });

        if (!response.ok) {
          return;
        }

        const cart = await response.json();

        const count = cart.item_count;

        document.querySelectorAll(
          "[data-cart-count], " +
          ".cart-count-bubble span[aria-hidden='true'], " +
          ".cart-count-number, " +
          ".cart-count, " +
          "#CartCount"
        ).forEach(function (element) {
          element.textContent = count;
        });

        document.querySelectorAll(
          ".cart-count-bubble"
        ).forEach(function (bubble) {
          bubble.hidden = count === 0;
        });

        [
          "cart:updated",
          "cart:refresh",
          "cart:change"
        ].forEach(function (eventName) {
          document.dispatchEvent(
            new CustomEvent(eventName, {
              bubbles: true,
              detail: { cart: cart }
            })
          );
        });
      } catch (error) {
        console.warn(
          "Hertha Nest cart refresh:",
          error
        );
      }
    }

    /* ===========================================
       AJAX ADD TO CART
    =========================================== */

    root.addEventListener(
      "click",
      async function (event) {
        const button = event.target.closest(
          "[data-hn-add]"
        );

        if (
          !button ||
          !root.contains(button) ||
          button.disabled ||
          button.classList.contains("is-loading")
        ) {
          return;
        }

        const variantId = Number(
          button.dataset.variantId
        );

        if (!Number.isSafeInteger(variantId) || variantId <= 0) {
          return;
        }

        const productTitle =
          button.dataset.productTitle || "Product";

        const buttonText = button.querySelector(
          ".hn-new30__button-text"
        );

        const originalText = buttonText
          ? buttonText.textContent.trim()
          : "Add to cart";

        button.disabled = true;
        button.classList.add("is-loading");

        if (buttonText) {
          buttonText.textContent = "Adding...";
        }

        try {
          const response = await fetch(addUrl, {
            method: "POST",
            credentials: "same-origin",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(
              data.description ||
              data.message ||
              "This product could not be added."
            );
          }

          button.classList.add("is-added");

          if (buttonText) {
            buttonText.textContent = "Added";
          }

          showToast(
            productTitle + " added to your cart.",
            false
          );

          await refreshCart();

        } catch (error) {
          showToast(
            error.message ||
            "Unable to add this product.",
            true
          );

        } finally {
          window.setTimeout(function () {
            button.disabled = false;

            button.classList.remove(
              "is-loading",
              "is-added"
            );

            if (buttonText) {
              buttonText.textContent = originalText;
            }
          }, 1500);
        }
      }
    );
  }

  initialise();

  document.addEventListener(
    "shopify:section:load",
    function (event) {
      if (
        event.detail &&
        String(event.detail.sectionId) ===
        String(sectionId)
      ) {
        initialise();
      }
    }
  );
})();
</script>

{% schema %}
{
  "name": "Hertha Nest Latest 30",
  "tag": "section",
  "class": "hn-new30-section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Product Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Latest products collection",
      "info": "Choose the collection that contains your latest arrivals."
    },
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "New at Hertha Nest"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The New Décor Edit"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our latest handcrafted additions, thoughtfully selected to bring fresh character, colour and timeless charm into your home."
    },
    {
      "type": "header",
      "content": "Product Cards"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": true
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable automatic sliding",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hertha Nest Latest 30"
    }
  ]
}
{% endschema %}
