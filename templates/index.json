to\n      0;\n\n\n    padding:\n\n      7px\n      11px;\n\n\n    color:\n      #3e2d25;\n\n\n    text-align:\n      center;\n\n\n    font-size:\n      12.7px;\n\n\n    font-weight:\n      600;\n\n\n    line-height:\n      1.45;\n\n\n    border:\n\n      1px solid\n      rgba(255,255,255,.26);\n\n\n    border-radius:\n      8px;\n\n\n    background:\n\n      rgba(255,248,237,.45);\n\n\n    box-shadow:\n\n      0\n      4px\n      15px\n      rgba(78,49,28,.05);\n\n\n    backdrop-filter:\n      blur(3px);\n\n\n    -webkit-backdrop-filter:\n      blur(3px);\n\n  }\n\n\n\n  .hn-mobile-only-slide\n  .hn-premium-description {\n\n    margin-top:\n      0;\n\n  }\n\n\n\n  /* CTA */\n\n  .hn-premium-button {\n\n    min-width:\n      195px;\n\n\n    margin-top:\n      13px;\n\n\n    padding:\n\n      12px\n      18px;\n\n\n    gap:\n      11px;\n\n\n    border-radius:\n      5px;\n\n\n    font-size:\n      12px;\n\n  }\n\n\n\n  .hn-premium-button svg {\n\n    width:\n      16px;\n\n\n    height:\n      16px;\n\n\n    flex-basis:\n      16px;\n\n  }\n\n\n\n  .hn-premium-features {\n\n    display:\n      none;\n\n  }\n\n\n\n  /* DOTS */\n\n  .hn-premium-dots {\n\n    bottom:\n      14px;\n\n\n    gap:\n      7px;\n\n\n    padding:\n\n      7px\n      10px;\n\n  }\n\n\n\n  .hn-premium-dot {\n\n    width:\n      6px;\n\n\n    height:\n      6px;\n\n\n    min-width:\n      6px;\n\n  }\n\n\n\n  .hn-premium-dot.is-active {\n\n    width:\n      22px;\n\n  }\n\n}\n\n\n\n/* =========================================================\nSMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 420px) {\n\n\n  .hn-premium-content,\n  .hn-content-left\n  .hn-premium-content,\n  .hn-content-right\n  .hn-premium-content {\n\n    padding:\n\n      25px\n      14px\n      58px;\n\n  }\n\n\n\n  .hn-premium-heading {\n\n    font-size:\n      29px;\n\n  }\n\n\n\n  .hn-premium-description {\n\n    max-width:\n      340px;\n\n\n    font-size:\n      12px;\n\n  }\n\n\n\n  .hn-premium-button {\n\n    margin-top:\n      11px;\n\n\n    min-width:\n      185px;\n\n  }\n\n}\n\n\n\n/* =========================================================\nVERY SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 350px) {\n\n\n  .hn-premium-content,\n  .hn-content-left\n  .hn-premium-content,\n  .hn-content-right\n  .hn-premium-content {\n\n    padding-top:\n      20px;\n\n  }\n\n\n\n  .hn-premium-eyebrow {\n\n    margin-bottom:\n      6px;\n\n\n    font-size:\n      7.5px;\n\n  }\n\n\n\n  .hn-premium-heading {\n\n    font-size:\n      26px;\n\n  }\n\n\n\n  .hn-premium-description {\n\n    max-width:\n      300px;\n\n\n    padding:\n\n      6px\n      8px;\n\n\n    font-size:\n      11px;\n\n  }\n\n\n\n  .hn-premium-button {\n\n    min-width:\n      170px;\n\n\n    padding:\n\n      10px\n      15px;\n\n\n    font-size:\n      11px;\n\n  }\n\n}\n\n\n\n/* =========================================================\nREDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n\n  .hn-premium-slide,\n  .hn-premium-image,\n  .hn-premium-copy,\n  .hn-premium-dot,\n  .hn-premium-button,\n  .hn-premium-button svg,\n  .hn-feature-icon {\n\n    transition:\n      none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n  CONFIG\n  ===================================================== */\n\n  var MOBILE_QUERY =\n    window.matchMedia(\n      \"(max-width: 749px)\"\n    );\n\n\n  var REDUCED_MOTION_QUERY =\n    window.matchMedia(\n      \"(prefers-reduced-motion: reduce)\"\n    );\n\n\n  var AUTOPLAY_DELAY =\n    5500;\n\n\n\n  /* =====================================================\n  AGGRESSIVELY REMOVE CUSTOM HTML TOP SPACE\n\n  This specifically targets the white strip visible\n  between the site header and the hero section.\n  ===================================================== */\n\n  function removeSectionGap() {\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-premium-slider]\"\n      );\n\n\n    function zeroOuterSpacing(\n      element\n    ) {\n\n      if (!element) {\n        return;\n      }\n\n\n      [\n        \"margin-top\",\n        \"margin-bottom\",\n        \"margin-block-start\",\n        \"margin-block-end\",\n        \"padding-top\",\n        \"padding-bottom\",\n        \"padding-block-start\",\n        \"padding-block-end\"\n      ].forEach(\n        function (propertyName) {\n\n          element.style.setProperty(\n            propertyName,\n            \"0\",\n            \"important\"\n          );\n\n        }\n      );\n\n\n      element.style.setProperty(\n        \"min-height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      [\n        \"--section-padding-top\",\n        \"--section-padding-bottom\",\n        \"--section-spacing-top\",\n        \"--section-spacing-bottom\",\n        \"--spacing-top\",\n        \"--spacing-bottom\"\n      ].forEach(\n        function (variableName) {\n\n          element.style.setProperty(\n            variableName,\n            \"0px\",\n            \"important\"\n          );\n\n        }\n      );\n\n    }\n\n\n    function isThemeHeadingShell(\n      element,\n      slider\n    ) {\n\n      if (\n        !element ||\n        element === slider ||\n        element.contains(slider)\n      ) {\n\n        return false;\n\n      }\n\n\n      var identity =\n\n        (\n          String(\n            element.className || \"\"\n          ) +\n          \" \" +\n          String(\n            element.id || \"\"\n          )\n        )\n        .toLowerCase();\n\n\n      var classLooksLikeHeading =\n\n        /section[-_\\s]*(heading|header|title)|(?:heading|title)[-_\\s]*wrapper|sectionhead/.test(\n          identity\n        );\n\n\n      var containsHeading =\n\n        Boolean(\n          element.querySelector(\n            \"h1,h2,h3,h4,h5,h6\"\n          )\n        );\n\n\n      var containsRealContent =\n\n        Boolean(\n          element.querySelector(\n            \"img,picture,video,iframe,canvas,form,input,select,textarea,button,a[href]\"\n          )\n        );\n\n\n      return (\n        classLooksLikeHeading ||\n        (\n          containsHeading &&\n          !containsRealContent\n        )\n      );\n\n    }\n\n\n    function isBlankSpacer(\n      element,\n      slider\n    ) {\n\n      if (\n        !element ||\n        element === slider ||\n        element.contains(slider)\n      ) {\n\n        return false;\n\n      }\n\n\n      var hasText =\n        String(\n          element.textContent || \"\"\n        ).trim().length > 0;\n\n\n      var hasRealContent =\n        Boolean(\n          element.querySelector(\n            \"img,picture,video,iframe,canvas,svg,form,input,select,textarea,button,a[href]\"\n          )\n        );\n\n\n      return (\n        !hasText &&\n        !hasRealContent\n      );\n\n    }\n\n\n    function collapseElement(\n      element\n    ) {\n\n      if (!element) {\n        return;\n      }\n\n\n      element.style.setProperty(\n        \"display\",\n        \"none\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"min-height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"max-height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"margin\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"padding\",\n        \"0\",\n        \"important\"\n      );\n\n    }\n\n\n    sliders.forEach(\n      function (slider) {\n\n\n        /*\n          Find the Shopify section that owns ONLY this\n          Custom HTML block.\n        */\n\n        var section =\n          slider.closest(\n            \".shopify-section\"\n          );\n\n\n        /*\n          Fallback for themes where the standard Shopify\n          section class is wrapped differently.\n        */\n\n        if (!section) {\n\n          var fallback =\n            slider.parentElement;\n\n\n          while (\n            fallback &&\n            fallback !== document.body\n          ) {\n\n            if (\n              fallback.id &&\n              fallback.id.indexOf(\n                \"shopify-section-\"\n              ) === 0\n            ) {\n\n              section =\n                fallback;\n\n              break;\n\n            }\n\n\n            fallback =\n              fallback.parentElement;\n\n          }\n\n        }\n\n\n        /*\n          Walk from the hero to its section wrapper.\n\n          At every wrapper level:\n          - remove top/bottom spacing\n          - remove empty structural spacer siblings\n          - remove the theme's own Section Heading shell\n        */\n\n        var branch =\n          slider;\n\n\n        while (\n          branch &&\n          branch.parentElement &&\n          branch !== section &&\n          branch.parentElement !== document.body\n        ) {\n\n          var parent =\n            branch.parentElement;\n\n\n          zeroOuterSpacing(\n            parent\n          );\n\n\n          Array.prototype.forEach.call(\n            parent.children,\n            function (sibling) {\n\n\n              if (\n                sibling === branch ||\n                sibling.contains(slider)\n              ) {\n\n                return;\n\n              }\n\n\n              if (\n                isThemeHeadingShell(\n                  sibling,\n                  slider\n                ) ||\n                isBlankSpacer(\n                  sibling,\n                  slider\n                )\n              ) {\n\n                collapseElement(\n                  sibling\n                );\n\n              }\n\n            }\n          );\n\n\n          branch =\n            parent;\n\n        }\n\n\n        if (section) {\n\n          zeroOuterSpacing(\n            section\n          );\n\n\n          /*\n            Hide known heading/title wrappers anywhere in\n            this Custom HTML section, including \"hello\" if\n            it is still present in the editor field.\n          */\n\n          var headingSelectors = [\n\n            \".section-heading\",\n            \".section__heading\",\n            \".section-title\",\n            \".section__title\",\n            \".section-header\",\n            \".section__header\",\n            \".section-head\",\n            \".heading-wrapper\",\n            \".title-wrapper\",\n            \"[class*='section-heading']\",\n            \"[class*='section__heading']\",\n            \"[class*='section-title']\",\n            \"[class*='section__title']\"\n\n          ].join(\",\");\n\n\n          section\n            .querySelectorAll(\n              headingSelectors\n            )\n            .forEach(\n              function (headingShell) {\n\n                if (\n                  !slider.contains(\n                    headingShell\n                  )\n                ) {\n\n                  collapseElement(\n                    headingShell\n                  );\n\n                }\n\n              }\n            );\n\n        }\n\n\n        zeroOuterSpacing(\n          slider\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n  INITIALIZE SINGLE SLIDER\n  ===================================================== */\n\n  function initializeSlider(\n    slider\n  ) {\n\n\n    if (\n      slider.getAttribute(\n        \"data-hn-premium-ready\"\n      ) === \"true\"\n    ) {\n\n      return;\n\n    }\n\n\n    slider.setAttribute(\n      \"data-hn-premium-ready\",\n      \"true\"\n    );\n\n\n\n    var slides =\n      Array.prototype.slice.call(\n\n        slider.querySelectorAll(\n          \"[data-hn-premium-slide]\"\n        )\n\n      );\n\n\n\n    var dots =\n      Array.prototype.slice.call(\n\n        slider.querySelectorAll(\n          \"[data-hn-premium-dot]\"\n        )\n\n      );\n\n\n\n    if (\n      !slides.length\n    ) {\n\n      return;\n\n    }\n\n\n\n    var currentSlideIndex =\n      null;\n\n\n    var autoplayTimer =\n      null;\n\n\n    var touchStartX =\n      0;\n\n\n    var touchEndX =\n      0;\n\n\n\n    /* ===================================================\n    AVAILABLE SLIDES\n\n    MOBILE:\n    0 / 1 / 2\n\n    DESKTOP:\n    1 / 2\n    =================================================== */\n\n    function getAvailableIndexes() {\n\n\n      if (\n        MOBILE_QUERY.matches\n      ) {\n\n        return [\n          0,\n          1,\n          2\n        ];\n\n      }\n\n\n      return [\n        1,\n        2\n      ];\n\n    }\n\n\n\n    function isAvailable(\n      index\n    ) {\n\n\n      return (\n\n        getAvailableIndexes()\n        .indexOf(\n          index\n        ) !== -1\n\n      );\n\n    }\n\n\n\n    /* ===================================================\n    SHOW SLIDE\n    =================================================== */\n\n    function showSlide(\n      index\n    ) {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      if (\n        !isAvailable(\n          index\n        )\n      ) {\n\n        index =\n          available[0];\n\n      }\n\n\n\n      slides.forEach(\n        function (slide) {\n\n\n          var slideIndex =\n            parseInt(\n\n              slide.getAttribute(\n                \"data-hn-premium-slide\"\n              ),\n\n              10\n\n            );\n\n\n          var active =\n\n            slideIndex === index &&\n            isAvailable(\n              slideIndex\n            );\n\n\n\n          slide.classList.toggle(\n            \"is-active\",\n            active\n          );\n\n\n          slide.setAttribute(\n\n            \"aria-hidden\",\n\n            active\n              ? \"false\"\n              : \"true\"\n\n          );\n\n        }\n      );\n\n\n\n      dots.forEach(\n        function (dot) {\n\n\n          var dotIndex =\n            parseInt(\n\n              dot.getAttribute(\n                \"data-hn-premium-dot\"\n              ),\n\n              10\n\n            );\n\n\n          var availableDot =\n            isAvailable(\n              dotIndex\n            );\n\n\n          var active =\n\n            dotIndex === index &&\n            availableDot;\n\n\n\n          dot.classList.toggle(\n            \"is-active\",\n            active\n          );\n\n\n          dot.setAttribute(\n\n            \"aria-current\",\n\n            active\n              ? \"true\"\n              : \"false\"\n\n          );\n\n\n          dot.setAttribute(\n\n            \"aria-hidden\",\n\n            availableDot\n              ? \"false\"\n              : \"true\"\n\n          );\n\n        }\n      );\n\n\n      currentSlideIndex =\n        index;\n\n    }\n\n\n\n    /* ===================================================\n    NEXT\n    =================================================== */\n\n    function nextSlide() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      var currentPosition =\n        available.indexOf(\n          currentSlideIndex\n        );\n\n\n      if (\n        currentPosition === -1\n      ) {\n\n\n        showSlide(\n          available[0]\n        );\n\n\n        return;\n\n      }\n\n\n      var nextPosition =\n        currentPosition + 1;\n\n\n      if (\n        nextPosition >=\n        available.length\n      ) {\n\n        nextPosition =\n          0;\n\n      }\n\n\n      showSlide(\n        available[\n          nextPosition\n        ]\n      );\n\n    }\n\n\n\n    /* ===================================================\n    PREVIOUS\n    =================================================== */\n\n    function previousSlide() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      var currentPosition =\n        available.indexOf(\n          currentSlideIndex\n        );\n\n\n      if (\n        currentPosition === -1\n      ) {\n\n\n        showSlide(\n          available[0]\n        );\n\n\n        return;\n\n      }\n\n\n      var previousPosition =\n        currentPosition - 1;\n\n\n      if (\n        previousPosition < 0\n      ) {\n\n        previousPosition =\n          available.length - 1;\n\n      }\n\n\n      showSlide(\n        available[\n          previousPosition\n        ]\n      );\n\n    }\n\n\n\n    /* ===================================================\n    AUTOPLAY\n    =================================================== */\n\n    function stopAutoplay() {\n\n\n      if (\n        autoplayTimer !== null\n      ) {\n\n\n        clearInterval(\n          autoplayTimer\n        );\n\n\n        autoplayTimer =\n          null;\n\n      }\n\n    }\n\n\n\n    function startAutoplay() {\n\n\n      stopAutoplay();\n\n\n      if (\n        REDUCED_MOTION_QUERY.matches\n      ) {\n\n        return;\n\n      }\n\n\n      autoplayTimer =\n        setInterval(\n\n          nextSlide,\n\n          AUTOPLAY_DELAY\n\n        );\n\n    }\n\n\n\n    /* ===================================================\n    DOT CLICK\n    =================================================== */\n\n    dots.forEach(\n      function (dot) {\n\n\n        dot.addEventListener(\n          \"click\",\n          function () {\n\n\n            var index =\n              parseInt(\n\n                dot.getAttribute(\n                  \"data-hn-premium-dot\"\n                ),\n\n                10\n\n              );\n\n\n            if (\n              isNaN(index) ||\n              !isAvailable(index)\n            ) {\n\n              return;\n\n            }\n\n\n            showSlide(\n              index\n            );\n\n\n            startAutoplay();\n\n          }\n        );\n\n      }\n    );\n\n\n\n    /* ===================================================\n    DESKTOP HOVER\n    =================================================== */\n\n    slider.addEventListener(\n      \"mouseenter\",\n      function () {\n\n\n        if (\n          !MOBILE_QUERY.matches\n        ) {\n\n          stopAutoplay();\n\n        }\n\n      }\n    );\n\n\n\n    slider.addEventListener(\n      \"mouseleave\",\n      function () {\n\n\n        if (\n          !MOBILE_QUERY.matches\n        ) {\n\n          startAutoplay();\n\n        }\n\n      }\n    );\n\n\n\n    /* ===================================================\n    MOBILE SWIPE\n    =================================================== */\n\n    slider.addEventListener(\n\n      \"touchstart\",\n\n      function (event) {\n\n\n        if (\n          !event.touches.length\n        ) {\n\n          return;\n\n        }\n\n\n        touchStartX =\n          event.touches[0].clientX;\n\n      },\n\n      {\n        passive: true\n      }\n\n    );\n\n\n\n    slider.addEventListener(\n\n      \"touchend\",\n\n      function (event) {\n\n\n        if (\n          !event.changedTouches.length\n        ) {\n\n          return;\n\n        }\n\n\n        touchEndX =\n          event.changedTouches[0].clientX;\n\n\n        var difference =\n          touchStartX -\n          touchEndX;\n\n\n        if (\n          Math.abs(\n            difference\n          ) < 45\n        ) {\n\n          return;\n\n        }\n\n\n        if (\n          difference > 0\n        ) {\n\n          nextSlide();\n\n        } else {\n\n          previousSlide();\n\n        }\n\n\n        startAutoplay();\n\n      },\n\n      {\n        passive: true\n      }\n\n    );\n\n\n\n    /* ===================================================\n    PAGE VISIBILITY\n    =================================================== */\n\n    document.addEventListener(\n\n      \"visibilitychange\",\n\n      function () {\n\n\n        if (\n          document.hidden\n        ) {\n\n          stopAutoplay();\n\n        } else {\n\n          startAutoplay();\n\n        }\n\n      }\n\n    );\n\n\n\n    /* ===================================================\n    BREAKPOINT CHANGE\n    =================================================== */\n\n    function handleBreakpointChange() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      if (\n        available.indexOf(\n          currentSlideIndex\n        ) === -1\n      ) {\n\n        showSlide(\n          available[0]\n        );\n\n      }\n\n\n      startAutoplay();\n\n    }\n\n\n\n    if (\n      MOBILE_QUERY.addEventListener\n    ) {\n\n\n      MOBILE_QUERY.addEventListener(\n\n        \"change\",\n\n        handleBreakpointChange\n\n      );\n\n\n    } else {\n\n\n      MOBILE_QUERY.addListener(\n        handleBreakpointChange\n      );\n\n    }\n\n\n\n    /* ===================================================\n    INITIAL\n    =================================================== */\n\n    var initialIndexes =\n      getAvailableIndexes();\n\n\n    showSlide(\n      initialIndexes[0]\n    );\n\n\n    startAutoplay();\n\n  }\n\n\n\n  /* =====================================================\n  INITIALIZE ALL\n  ===================================================== */\n\n  function initializeAll() {\n\n\n    removeSectionGap();\n\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-premium-slider]\"\n      );\n\n\n    sliders.forEach(\n      initializeSlider\n    );\n\n  }\n\n\n\n  initializeAll();\n\n\n\n  /*\n  Re-run after theme CSS has fully initialized.\n  Important inside Shopify theme editor.\n  */\n\n  requestAnimationFrame(\n    function () {\n\n      removeSectionGap();\n\n    }\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    50\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    200\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    700\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    1500\n  );\n\n\n\n  /* =====================================================\n  SHOPIFY THEME EDITOR\n  ===================================================== */\n\n  document.addEventListener(\n\n    \"shopify:section:load\",\n\n    function () {\n\n\n      initializeAll();\n\n\n      setTimeout(\n        removeSectionGap,\n        50\n      );\n\n\n      setTimeout(\n        removeSectionGap,\n        300\n      );\n\n    }\n\n  );\n\n\n})();\n\n</script>"
      }
    },
    "custom_html_qXDxfa": {
      "type": "custom-html",
      "name": "Crousal",
      "settings": {
        "section_padding_top": 0,
        "section_padding_bottom": 0,
        "section_padding_top_ip": 0,
        "section_padding_bottom_ip": 0,
        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 0,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<!--\n  Hertha Nest: Latest 30 Products — Two Connected Carousels\n\n  PERFORMANCE OPTIMIZED VERSION\n\n  Fixes:\n  1. Responsive Shopify CDN product images\n  2. Removed forced 800px image download\n  3. Browser selects 240 / 320 / 400 / 480 / 600px version\n  4. Responsive sizes attribute added\n  5. Lazy loading retained\n  6. Async image decoding retained\n  7. Image aspect ratio preserved\n  8. Existing functionality/design preserved\n  9. Product request reduced from 250 to 40 items\n 10. Cache-busting/no-store removed from product feed\n 11. Infinite carousel clones reduced from 15 to 4 per row\n\n  Top carousel: Products 1–15\n  Bottom carousel: Products 16–30\n-->\n\n<section class=\"hn-new30\" data-top-count=\"15\" data-bottom-count=\"15\" aria-labelledby=\"hn-new30-heading\">\n\n  <div class=\"hn-new30__inner\">\n\n    <header class=\"hn-new30__header\">\n\n      <span class=\"hn-new30__eyebrow\">\n        New at Hertha Nest\n      </span>\n\n      <h2 class=\"hn-new30__title\" id=\"hn-new30-heading\">\n        The New Décor Edit\n      </h2>\n\n      <p class=\"hn-new30__description\">\n        Explore our latest handcrafted additions, thoughtfully selected to\n        bring fresh character, colour and timeless charm into your home.\n      </p>\n\n    </header>\n\n\n    <div class=\"hn-new30__main-loading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-new30__loader\" aria-hidden=\"true\"></span>\n\n      <span>\n        Discovering our latest arrivals...\n      </span>\n    </div>\n\n\n    <!-- =====================================================\n         PRODUCTS 1–15\n    ====================================================== -->\n\n    <div class=\"hn-new30__carousel hn-new30__carousel--top\" data-carousel-position=\"top\" hidden=\"\">\n\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Latest fifteen products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"hn-new30__divider\" hidden=\"\" aria-hidden=\"true\">\n      <span></span>\n    </div>\n\n\n    <!-- =====================================================\n         PRODUCTS 16–30\n    ====================================================== -->\n\n    <div class=\"hn-new30__carousel hn-new30__carousel--bottom\" data-carousel-position=\"bottom\" hidden=\"\">\n\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Next fifteen newly added products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"hn-new30__empty\" hidden=\"\">\n      New products will appear here as soon as they are published.\n    </div>\n\n  </div>\n\n\n  <!-- =====================================================\n       CART TOAST\n  ====================================================== -->\n\n  <div class=\"hn-new30__toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">\n\n    <span class=\"hn-new30__toast-icon\" aria-hidden=\"true\">\n      ✓\n    </span>\n\n    <span class=\"hn-new30__toast-message\">\n      Product added to your cart.\n    </span>\n\n    <a href=\"/cart\">\n      View cart\n    </a>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* =========================================================\n   CUSTOM HTML THEME-SHELL HARD RESET\n========================================================= */\n\n/*\n  The blank white area shown in the theme editor is NOT created\n  by .hn-new30. It is the theme's own Custom HTML \"Section\n  Heading\" shell.\n\n  This block removes that shell and all OUTER top/bottom spacing.\n*/\n\n.shopify-section:has(.hn-new30) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  margin-block: 0 !important;\n\n  padding: 0 !important;\n  padding-block: 0 !important;\n\n  min-height: 0 !important;\n\n  overflow: visible !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Reset common Custom HTML wrappers around this section */\n\n.shopify-section:has(.hn-new30) > div,\n.shopify-section:has(.hn-new30) > div > div,\n.shopify-section:has(.hn-new30) .section,\n.shopify-section:has(.hn-new30) .section-padding,\n.shopify-section:has(.hn-new30) .section__wrapper,\n.shopify-section:has(.hn-new30) .section-wrapper,\n.shopify-section:has(.hn-new30) .custom-html,\n.shopify-section:has(.hn-new30) .custom-html__inner,\n.shopify-section:has(.hn-new30) .custom-html-wrapper,\n.shopify-section:has(.hn-new30) .custom-html-section,\n.shopify-section:has(.hn-new30) .page-width,\n.shopify-section:has(.hn-new30) .container,\n.shopify-section:has(.hn-new30) .container-fluid {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  margin-block: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n  padding-block: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Remove theme width restrictions around the custom block */\n\n.shopify-section:has(.hn-new30) .page-width,\n.shopify-section:has(.hn-new30) .container,\n.shopify-section:has(.hn-new30) .container-fluid,\n.shopify-section:has(.hn-new30) .custom-html,\n.shopify-section:has(.hn-new30) .custom-html__inner,\n.shopify-section:has(.hn-new30) .custom-html-wrapper,\n.shopify-section:has(.hn-new30) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n/*\n  Hide the theme-generated heading/title shell completely.\n  This also hides test text such as \"hello\" if it is still\n  entered in the theme editor's Section title field.\n*/\n\n.shopify-section:has(.hn-new30) .section-heading,\n.shopify-section:has(.hn-new30) .section__heading,\n.shopify-section:has(.hn-new30) .section-title,\n.shopify-section:has(.hn-new30) .section__title,\n.shopify-section:has(.hn-new30) .section-header,\n.shopify-section:has(.hn-new30) .section__header,\n.shopify-section:has(.hn-new30) .section-head,\n.shopify-section:has(.hn-new30) .heading-wrapper,\n.shopify-section:has(.hn-new30) .title-wrapper,\n.shopify-section:has(.hn-new30) [class*=\"section-heading\"],\n.shopify-section:has(.hn-new30) [class*=\"section__heading\"],\n.shopify-section:has(.hn-new30) [class*=\"section-title\"],\n.shopify-section:has(.hn-new30) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n\n  overflow: hidden !important;\n}\n\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.hn-new30 {\n\n  --hn30-green: #315548;\n  --hn30-green-dark: #203f35;\n  --hn30-gold: #bd9152;\n  --hn30-white: #ffffff;\n  --hn30-heading: #29211c;\n  --hn30-text: rgba(41,33,28,.70);\n  --hn30-muted: rgba(41,33,28,.52);\n  --hn30-border: rgba(49,85,72,.14);\n  --hn30-gap: 20px;\n\n  position: relative;\n\n  left: 50%;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin:\n    0\n    0\n    0\n    -50vw;\n\n  padding:\n    38px\n    0\n    44px;\n\n  overflow: hidden;\n\n  color: var(--hn30-heading);\n\n  background:\n    radial-gradient(\n      circle at 5% 0%,\n      rgba(189,145,82,.14),\n      transparent 27%\n    ),\n    radial-gradient(\n      circle at 95% 100%,\n      rgba(49,85,72,.10),\n      transparent 28%\n    ),\n    linear-gradient(\n      135deg,\n      #f8f6ef 0%,\n      #fffdf8 48%,\n      #f4f3ec 100%\n    );\n}\n\n\n.hn-new30 *,\n.hn-new30 *::before,\n.hn-new30 *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   INNER\n========================================================= */\n\n.hn-new30__inner {\n  width: 100%;\n  max-width: 1520px;\n\n  margin: 0 auto;\n\n  padding:\n    0\n    32px;\n}\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n.hn-new30__header {\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n  justify-content: center;\n\n  max-width: 850px;\n\n  margin:\n    0\n    auto\n    22px;\n\n  text-align: center;\n}\n\n\n.hn-new30__eyebrow {\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 9px;\n\n  margin:\n    0\n    0\n    9px;\n\n  color: var(--hn30-green);\n\n  font-size: 11px;\n  font-weight: 750;\n\n  line-height: 1.3;\n\n  letter-spacing: 1.8px;\n\n  text-transform: uppercase;\n}\n\n\n.hn-new30__eyebrow::before,\n.hn-new30__eyebrow::after {\n\n  content: \"\";\n\n  width: 28px;\n  height: 1px;\n\n  background: var(--hn30-gold);\n}\n\n\n.hn-new30__title {\n\n  margin: 0;\n\n  color: var(--hn30-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      29px,\n      3.5vw,\n      44px\n    );\n\n  font-weight: 500;\n\n  line-height: 1.12;\n\n  letter-spacing: -.5px;\n}\n\n\n.hn-new30__description {\n\n  max-width: 720px;\n\n  margin:\n    10px\n    auto\n    0;\n\n  color: var(--hn30-text);\n\n  font-size: 14px;\n\n  line-height: 1.65;\n}\n\n\n/* =========================================================\n   CAROUSEL\n========================================================= */\n\n.hn-new30__carousel {\n  width: 100%;\n}\n\n\n.hn-new30__carousel[hidden],\n.hn-new30__divider[hidden],\n.hn-new30__empty[hidden],\n.hn-new30__main-loading[hidden] {\n  display: none !important;\n}\n\n\n/* =========================================================\n   CONTROLS\n========================================================= */\n\n.hn-new30__controls {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 9px;\n\n  min-height: 44px;\n\n  margin:\n    0\n    0\n    17px;\n}\n\n\n.hn-new30__controls[hidden] {\n  display: none !important;\n}\n\n\n.hn-new30__arrow {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 44px;\n  height: 44px;\n\n  min-width: 44px;\n  min-height: 44px;\n\n  padding: 0;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius: 50%;\n\n  background:\n    rgba(\n      255,\n      255,\n      255,\n      .86\n    );\n\n  color:\n    var(--hn30-green-dark);\n\n  box-shadow:\n    0 7px 18px\n    rgba(32,63,53,.08),\n    inset 0 1px 0\n    rgba(255,255,255,.9);\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    background .25s ease,\n    color .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-new30__arrow:hover {\n\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hn30-green);\n\n  background:\n    var(--hn30-green);\n\n  color: #ffffff;\n\n  box-shadow:\n    0 10px 22px\n    rgba(32,63,53,.18);\n}\n\n\n.hn-new30__arrow:focus-visible {\n\n  outline:\n    2px\n    solid\n    var(--hn30-gold);\n\n  outline-offset: 3px;\n}\n\n\n.hn-new30__arrow svg {\n\n  width: 17px;\n  height: 17px;\n\n  fill: none;\n\n  stroke: currentColor;\n\n  stroke-width: 1.8;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* =========================================================\n   VIEWPORT\n========================================================= */\n\n.hn-new30__viewport {\n\n  width: 100%;\n\n  overflow: hidden;\n\n  touch-action: pan-y;\n}\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hn-new30__track {\n\n  display: flex;\n\n  align-items: stretch;\n\n  gap:\n    var(--hn30-gap);\n\n  width: max-content;\n\n  will-change: transform;\n\n  transition:\n    transform\n    .55s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n/* =========================================================\n   DIVIDER\n========================================================= */\n\n.hn-new30__divider {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n\n  margin:\n    26px\n    0\n    18px;\n}\n\n\n.hn-new30__divider span {\n\n  position: relative;\n\n  display: block;\n\n  width:\n    min(\n      620px,\n      75%\n    );\n\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(49,85,72,.16),\n      rgba(189,145,82,.36),\n      rgba(49,85,72,.16),\n      transparent\n    );\n}\n\n\n.hn-new30__divider span::before {\n\n  content: \"\";\n\n  position: absolute;\n\n  top: 50%;\n  left: 50%;\n\n  width: 7px;\n  height: 7px;\n\n  border:\n    1px\n    solid\n    rgba(189,145,82,.55);\n\n  background: #f8f6ef;\n\n  transform:\n    translate(-50%,-50%)\n    rotate(45deg);\n}\n\n\n/* =========================================================\n   PRODUCT CARD\n========================================================= */\n\n.hn-new30__card {\n\n  position: relative;\n\n  flex:\n    0\n    0\n    auto;\n\n  min-width: 0;\n\n  overflow: hidden;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius: 18px;\n\n  background:\n    var(--hn30-white);\n\n  box-shadow:\n    0 10px 25px\n    rgba(41,33,28,.06),\n    0 2px 5px\n    rgba(41,33,28,.025);\n\n  transition:\n    transform .3s ease,\n    border-color .3s ease,\n    box-shadow .3s ease;\n}\n\n\n.hn-new30__card:hover {\n\n  transform:\n    translateY(-5px);\n\n  border-color:\n    rgba(189,145,82,.38);\n\n  box-shadow:\n    0 18px 38px\n    rgba(41,33,28,.11),\n    0 4px 10px\n    rgba(41,33,28,.04);\n}\n\n\n/* =========================================================\n   PRODUCT IMAGE\n========================================================= */\n\n.hn-new30__image-link {\n\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  aspect-ratio:\n    1 / 1;\n\n  overflow: hidden;\n\n  background: #f0eee7;\n}\n\n\n.hn-new30__image {\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  object-position:\n    center\n    center;\n\n  transition:\n    transform\n    .65s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n.hn-new30__card:hover\n.hn-new30__image {\n\n  transform:\n    scale(1.05);\n}\n\n\n.hn-new30__image-placeholder {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  height: 100%;\n\n  padding: 30px;\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(49,85,72,.12),\n      rgba(255,255,255,.90)\n    );\n\n  color:\n    var(--hn30-green);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size: 17px;\n\n  line-height: 1.4;\n\n  text-align: center;\n}\n\n\n/* =========================================================\n   BADGE\n========================================================= */\n\n.hn-new30__badge {\n\n  position: absolute;\n\n  top: 12px;\n  left: 12px;\n\n  z-index: 2;\n\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 7px;\n\n  min-height: 28px;\n\n  padding:\n    7px\n    11px;\n\n  border:\n    1px\n    solid\n    rgba(255,255,255,.32);\n\n  border-radius:\n    999px;\n\n  background:\n    rgba(35,72,59,.93);\n\n  color:\n    #ffffff;\n\n  box-shadow:\n    0 7px 18px\n    rgba(21,46,37,.20);\n\n  backdrop-filter:\n    blur(9px);\n\n  -webkit-backdrop-filter:\n    blur(9px);\n\n  font-size: 9px;\n\n  font-weight: 750;\n\n  line-height: 1;\n\n  letter-spacing: 1.05px;\n\n  text-transform:\n    uppercase;\n}\n\n\n.hn-new30__badge::before {\n\n  content: \"\";\n\n  width: 6px;\n  height: 6px;\n\n  flex:\n    0\n    0\n    6px;\n\n  border-radius:\n    50%;\n\n  background:\n    #e8bd78;\n\n  box-shadow:\n    0 0 0 4px\n    rgba(232,189,120,.16);\n}\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hn-new30__content {\n\n  display: block;\n\n  padding:\n    14px\n    15px\n    15px;\n}\n\n\n.hn-new30__vendor {\n\n  margin:\n    0\n    0\n    5px;\n\n  overflow: hidden;\n\n  color:\n    var(--hn30-green);\n\n  font-size: 9px;\n\n  font-weight: 750;\n\n  line-height: 1.3;\n\n  letter-spacing: 1.2px;\n\n  text-overflow:\n    ellipsis;\n\n  text-transform:\n    uppercase;\n\n  white-space:\n    nowrap;\n}\n\n\n/* =========================================================\n   PRODUCT TITLE\n==========================================