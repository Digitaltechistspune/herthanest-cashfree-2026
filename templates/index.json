        "custom_html": "<!--\n  Hertha Nest: Latest 30 Products — Two Connected Carousels\n\n  PERFORMANCE OPTIMIZED VERSION\n\n  Fixes:\n  1. Responsive Shopify CDN product images\n  2. Removed forced 800px image download\n  3. Browser selects 240 / 320 / 400 / 480 / 600px version\n  4. Responsive sizes attribute added\n  5. Lazy loading retained\n  6. Async image decoding retained\n  7. Image aspect ratio preserved\n  8. Existing functionality/design preserved\n\n  Top carousel: Products 1–15\n  Bottom carousel: Products 16–30\n-->\n\n<section class=\"hn-new30\" data-top-count=\"15\" data-bottom-count=\"15\" aria-labelledby=\"hn-new30-heading\">\n\n  <div class=\"hn-new30__inner\">\n\n    <header class=\"hn-new30__header\">\n\n      <span class=\"hn-new30__eyebrow\">\n        New at Hertha Nest\n      </span>\n\n      <h2 class=\"hn-new30__title\" id=\"hn-new30-heading\">\n        The New Décor Edit\n      </h2>\n\n      <p class=\"hn-new30__description\">\n        Explore our latest handcrafted additions, thoughtfully selected to\n        bring fresh character, colour and timeless charm into your home.\n      </p>\n\n    </header>\n\n\n    <div class=\"hn-new30__main-loading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-new30__loader\" aria-hidden=\"true\"></span>\n\n      <span>\n        Discovering our latest arrivals...\n      </span>\n    </div>\n\n\n    <!-- =====================================================\n         PRODUCTS 1–15\n    ====================================================== -->\n\n    <div class=\"hn-new30__carousel hn-new30__carousel--top\" data-carousel-position=\"top\" hidden=\"\">\n\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Latest fifteen products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"hn-new30__divider\" hidden=\"\" aria-hidden=\"true\">\n      <span></span>\n    </div>\n\n\n    <!-- =====================================================\n         PRODUCTS 16–30\n    ====================================================== -->\n\n    <div class=\"hn-new30__carousel hn-new30__carousel--bottom\" data-carousel-position=\"bottom\" hidden=\"\">\n\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Next fifteen newly added products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"hn-new30__empty\" hidden=\"\">\n      New products will appear here as soon as they are published.\n    </div>\n\n  </div>\n\n\n  <!-- =====================================================\n       CART TOAST\n  ====================================================== -->\n\n  <div class=\"hn-new30__toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">\n\n    <span class=\"hn-new30__toast-icon\" aria-hidden=\"true\">\n      ✓\n    </span>\n\n    <span class=\"hn-new30__toast-message\">\n      Product added to your cart.\n    </span>\n\n    <a href=\"/cart\">\n      View cart\n    </a>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* =========================================================\n   SHOPIFY SECTION RESET\n========================================================= */\n\n.shopify-section:has(.hn-new30) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  overflow: visible !important;\n}\n\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.hn-new30 {\n\n  --hn30-green: #315548;\n  --hn30-green-dark: #203f35;\n  --hn30-gold: #bd9152;\n  --hn30-white: #ffffff;\n  --hn30-heading: #29211c;\n  --hn30-text: rgba(41,33,28,.70);\n  --hn30-muted: rgba(41,33,28,.52);\n  --hn30-border: rgba(49,85,72,.14);\n  --hn30-gap: 20px;\n\n  position: relative;\n\n  left: 50%;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin:\n    0\n    0\n    30px\n    -50vw;\n\n  padding:\n    38px\n    0\n    44px;\n\n  overflow: hidden;\n\n  color: var(--hn30-heading);\n\n  background:\n    radial-gradient(\n      circle at 5% 0%,\n      rgba(189,145,82,.14),\n      transparent 27%\n    ),\n    radial-gradient(\n      circle at 95% 100%,\n      rgba(49,85,72,.10),\n      transparent 28%\n    ),\n    linear-gradient(\n      135deg,\n      #f8f6ef 0%,\n      #fffdf8 48%,\n      #f4f3ec 100%\n    );\n}\n\n\n.hn-new30 *,\n.hn-new30 *::before,\n.hn-new30 *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   INNER\n========================================================= */\n\n.hn-new30__inner {\n  width: 100%;\n  max-width: 1520px;\n\n  margin: 0 auto;\n\n  padding:\n    0\n    32px;\n}\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n.hn-new30__header {\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n  justify-content: center;\n\n  max-width: 850px;\n\n  margin:\n    0\n    auto\n    22px;\n\n  text-align: center;\n}\n\n\n.hn-new30__eyebrow {\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 9px;\n\n  margin:\n    0\n    0\n    9px;\n\n  color: var(--hn30-green);\n\n  font-size: 11px;\n  font-weight: 750;\n\n  line-height: 1.3;\n\n  letter-spacing: 1.8px;\n\n  text-transform: uppercase;\n}\n\n\n.hn-new30__eyebrow::before,\n.hn-new30__eyebrow::after {\n\n  content: \"\";\n\n  width: 28px;\n  height: 1px;\n\n  background: var(--hn30-gold);\n}\n\n\n.hn-new30__title {\n\n  margin: 0;\n\n  color: var(--hn30-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      29px,\n      3.5vw,\n      44px\n    );\n\n  font-weight: 500;\n\n  line-height: 1.12;\n\n  letter-spacing: -.5px;\n}\n\n\n.hn-new30__description {\n\n  max-width: 720px;\n\n  margin:\n    10px\n    auto\n    0;\n\n  color: var(--hn30-text);\n\n  font-size: 14px;\n\n  line-height: 1.65;\n}\n\n\n/* =========================================================\n   CAROUSEL\n========================================================= */\n\n.hn-new30__carousel {\n  width: 100%;\n}\n\n\n.hn-new30__carousel[hidden],\n.hn-new30__divider[hidden],\n.hn-new30__empty[hidden],\n.hn-new30__main-loading[hidden] {\n  display: none !important;\n}\n\n\n/* =========================================================\n   CONTROLS\n========================================================= */\n\n.hn-new30__controls {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 9px;\n\n  min-height: 44px;\n\n  margin:\n    0\n    0\n    17px;\n}\n\n\n.hn-new30__controls[hidden] {\n  display: none !important;\n}\n\n\n.hn-new30__arrow {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 44px;\n  height: 44px;\n\n  min-width: 44px;\n  min-height: 44px;\n\n  padding: 0;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius: 50%;\n\n  background:\n    rgba(\n      255,\n      255,\n      255,\n      .86\n    );\n\n  color:\n    var(--hn30-green-dark);\n\n  box-shadow:\n    0 7px 18px\n    rgba(32,63,53,.08),\n    inset 0 1px 0\n    rgba(255,255,255,.9);\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    background .25s ease,\n    color .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-new30__arrow:hover {\n\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hn30-green);\n\n  background:\n    var(--hn30-green);\n\n  color: #ffffff;\n\n  box-shadow:\n    0 10px 22px\n    rgba(32,63,53,.18);\n}\n\n\n.hn-new30__arrow:focus-visible {\n\n  outline:\n    2px\n    solid\n    var(--hn30-gold);\n\n  outline-offset: 3px;\n}\n\n\n.hn-new30__arrow svg {\n\n  width: 17px;\n  height: 17px;\n\n  fill: none;\n\n  stroke: currentColor;\n\n  stroke-width: 1.8;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* =========================================================\n   VIEWPORT\n========================================================= */\n\n.hn-new30__viewport {\n\n  width: 100%;\n\n  overflow: hidden;\n\n  touch-action: pan-y;\n}\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hn-new30__track {\n\n  display: flex;\n\n  align-items: stretch;\n\n  gap:\n    var(--hn30-gap);\n\n  width: max-content;\n\n  will-change: transform;\n\n  transition:\n    transform\n    .55s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n/* =========================================================\n   DIVIDER\n========================================================= */\n\n.hn-new30__divider 