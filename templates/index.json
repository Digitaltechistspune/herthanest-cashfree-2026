    "custom_html_rY9Y3i": {
      "type": "custom-html",
      "name": "Custom html",
      "settings": {
        "section_padding_top": 0,
        "section_padding_bottom": 80,
        "section_padding_top_ip": 0,
        "section_padding_bottom_ip": 80,
        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 60,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<!-- =========================================================\nHERTHA NEST — PREMIUM HERO PRODUCT\nCUSTOM HTML VERSION\n\nNO LIQUID REQUIRED\n\nPRODUCT HANDLE:\nwooden-horse-decor-with-bells-8-12-inches\n\nFEATURES:\n- Dynamically fetches Shopify product\n- Product image\n- Live price\n- Compare-at price\n- Availability\n- Variants\n- Quantity\n- Add to Cart via Shopify AJAX API\n- Direct Buy Now\n- Premium podium\n- Responsive\n========================================================= -->\n\n\n<section class=\"hnx-hero-product\" id=\"hnxHeroProduct\" aria-labelledby=\"hnxHeroTitle\">\n\n  <!-- BACKGROUND DECOR -->\n\n  <div class=\"hnx-background\" aria-hidden=\"true\">\n\n    <span class=\"hnx-light hnx-light-one\"></span>\n\n    <span class=\"hnx-light hnx-light-two\"></span>\n\n    <div class=\"hnx-arch\"></div>\n\n  </div>\n\n\n  <div class=\"hnx-container\">\n\n\n    <!-- =====================================================\n      LEFT — CONTENT\n    ====================================================== -->\n\n    <div class=\"hnx-content\">\n\n      <div class=\"hnx-eyebrow\">\n\n        <span class=\"hnx-eyebrow-line\"></span>\n\n        <span>\n          HERTHA NEST SIGNATURE\n        </span>\n\n      </div>\n\n\n      <p class=\"hnx-kicker\">\n        Crafted to make a statement.\n      </p>\n\n\n      <h2 class=\"hnx-title\" id=\"hnxHeroTitle\">\n\n        <span id=\"hnxTitleMain\">\n          Horse Décor\n        </span>\n\n        <em id=\"hnxTitleAccent\">\n          with Bells\n        </em>\n\n      </h2>\n\n\n      <!-- PRICE -->\n\n      <div class=\"hnx-price-row\">\n\n        <span class=\"hnx-price\" id=\"hnxPrice\">\n          Loading...\n        </span>\n\n\n        <span class=\"hnx-compare-price\" id=\"hnxComparePrice\" hidden=\"\"></span>\n\n\n        <span class=\"hnx-stock\" id=\"hnxStock\">\n          Checking availability\n        </span>\n\n      </div>\n\n\n      <!-- DESCRIPTION -->\n\n      <p class=\"hnx-description\">\n\n        A distinctive heritage-inspired décor piece designed\n        to bring colour, craftsmanship and character into\n        beautiful modern homes.\n\n      </p>\n\n\n      <!-- DETAILS -->\n\n      <div class=\"hnx-details\">\n\n\n        <div class=\"hnx-detail\">\n\n          <span class=\"hnx-detail-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n              <path d=\"M4 4h16v16H4V4M8 4v4M4 8h4M16 4v4M16 8h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"></path>\n\n            </svg>\n\n          </span>\n\n\n          <span>\n\n            <small>\n              SIZE\n            </small>\n\n            8 × 12 Inches\n\n          </span>\n\n        </div>\n\n\n\n        <div class=\"hnx-detail\">\n\n          <span class=\"hnx-detail-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n              <path d=\"M12 3c2.6 3 4 5.3 4 7.5a4 4 0 1 1-8 0C8 8.3 9.4 6 12 3Zm0 11v7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n            </svg>\n\n          </span>\n\n\n          <span>\n\n            <small>\n              STYLE\n            </small>\n\n            Heritage Décor\n\n          </span>\n\n        </div>\n\n\n\n        <div class=\"hnx-detail\">\n\n          <span class=\"hnx-detail-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n              <path d=\"M6 5h12v10H6V5Zm-2 10h16v4H4v-4M8 9h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n            </svg>\n\n          </span>\n\n\n          <span>\n\n            <small>\n              DETAIL\n            </small>\n\n            Artisan Finish\n\n          </span>\n\n        </div>\n\n      </div>\n\n\n\n      <!-- =====================================================\n        VARIANT\n      ====================================================== -->\n\n      <div class=\"hnx-variant-wrap\" id=\"hnxVariantWrap\" hidden=\"\">\n\n        <label class=\"hnx-label\" for=\"hnxVariant\">\n          Choose option\n        </label>\n\n\n        <select class=\"hnx-variant\" id=\"hnxVariant\"></select>\n\n      </div>\n\n\n\n      <!-- =====================================================\n        BUY CONTROLS\n      ====================================================== -->\n\n      <div class=\"hnx-actions\">\n\n\n        <!-- QUANTITY -->\n\n        <div class=\"hnx-quantity\" aria-label=\"Quantity selector\">\n\n          <button type=\"button\" id=\"hnxMinus\" aria-label=\"Decrease quantity\">\n            −\n          </button>\n\n\n          <input id=\"hnxQuantity\" type=\"number\" value=\"1\" min=\"1\" inputmode=\"numeric\" aria-label=\"Quantity\">\n\n\n          <button type=\"button\" id=\"hnxPlus\" aria-label=\"Increase quantity\">\n            +\n          </button>\n\n        </div>\n\n\n\n        <!-- ADD TO CART -->\n\n        <button type=\"button\" class=\"hnx-add-cart\" id=\"hnxAddCart\" disabled>\n\n          <span id=\"hnxAddCartText\">\n            Loading Product\n          </span>\n\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </button>\n\n      </div>\n\n\n\n      <!-- BUY NOW -->\n\n      <button type=\"button\" class=\"hnx-buy-now\" id=\"hnxBuyNow\" disabled>\n\n        Buy It Now\n\n        <span aria-hidden=\"true\">\n          ↗\n        </span>\n\n      </button>\n\n\n\n      <!-- CART MESSAGE -->\n\n      <div class=\"hnx-message\" id=\"hnxMessage\" role=\"status\" aria-live=\"polite\"></div>\n\n\n\n      <!-- PRODUCT DETAILS LINK -->\n\n      <a class=\"hnx-product-link\" id=\"hnxProductLink\" href=\"/collections/festival-specials\">\n\n        View full product details\n\n        <span>\n          ↗\n        </span>\n\n      </a>\n\n    </div>\n\n\n\n    <!-- =====================================================\n      RIGHT — PRODUCT STAGE\n    ====================================================== -->\n\n    <div class=\"hnx-stage\">\n\n\n      <!-- ARTISAN BADGE -->\n\n      <div class=\"hnx-badge\">\n\n        <span class=\"hnx-badge-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          HANDPICKED\n\n          <strong>\n            HOME DÉCOR\n          </strong>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- FLOATING PRICE -->\n\n      <div class=\"hnx-floating-price\" id=\"hnxFloatingPrice\"></div>\n\n\n\n      <!-- PRODUCT IMAGE -->\n\n      <a class=\"hnx-product-image-link\" id=\"hnxImageLink\" href=\"/collections/festival-specials\" aria-label=\"View product\">\n\n        <img class=\"hnx-product-image\" id=\"hnxProductImage\" src=\"\" alt=\"\" width=\"700\" height=\"700\">\n\n      </a>\n\n\n\n      <!-- SHADOW -->\n\n      <div class=\"hnx-product-shadow\" aria-hidden=\"true\"></div>\n\n\n\n      <!-- PODIUM -->\n\n      <div class=\"hnx-podium\" aria-hidden=\"true\">\n\n        <div class=\"hnx-podium-top\"></div>\n\n        <div class=\"hnx-podium-body\"></div>\n\n      </div>\n\n\n\n      <!-- FLOATING DESIGN CARD -->\n\n      <div class=\"hnx-floating-card\">\n\n        <span class=\"hnx-star\">\n          ✦\n        </span>\n\n\n        <span>\n\n          Crafted for\n\n          <strong>\n            expressive homes.\n          </strong>\n\n        </span>\n\n      </div>\n\n\n      <!-- DECORATIVE RINGS -->\n\n      <div class=\"hnx-stage-ring hnx-ring-one\" aria-hidden=\"true\"></div>\n\n\n      <div class=\"hnx-stage-ring hnx-ring-two\" aria-hidden=\"true\"></div>\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n    PREMIUM INFORMATION BAR\n  ====================================================== -->\n\n  <div class=\"hnx-benefits\">\n\n\n    <div class=\"hnx-benefit\">\n\n      <small>\n        CRAFT\n      </small>\n\n      <strong>\n        Artisan Inspired\n      </strong>\n\n    </div>\n\n\n    <span class=\"hnx-benefit-divider\"></span>\n\n\n    <div class=\"hnx-benefit\">\n\n      <small>\n        STYLE\n      </small>\n\n      <strong>\n        Statement Décor\n      </strong>\n\n    </div>\n\n\n    <span class=\"hnx-benefit-divider\"></span>\n\n\n    <div class=\"hnx-benefit\">\n\n      <small>\n        COLLECTION\n      </small>\n\n      <strong>\n        Festival Specials\n      </strong>\n\n    </div>\n\n\n    <span class=\"hnx-benefit-divider\"></span>\n\n\n    <div class=\"hnx-benefit\">\n\n      <small>\n        SHOPPING\n      </small>\n\n      <strong>\n        Secure Checkout\n      </strong>\n\n    </div>\n\n\n    <span class=\"hnx-benefit-divider\"></span>\n\n\n    <div class=\"hnx-benefit\">\n\n      <small>\n        DISCOVER\n      </small>\n\n      <strong>\n        Hertha Nest\n      </strong>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\n   HERTHA NEST HERO PRODUCT\n========================================================= */\n\n.hnx-hero-product {\n\n  --hnx-bg: #fbf7ef;\n\n  --hnx-bg-2: #f2e6d7;\n\n  --hnx-dark: #342219;\n\n  --hnx-text: #635248;\n\n  --hnx-rust: #a64317;\n\n  --hnx-rust-dark: #812e0d;\n\n  --hnx-gold: #b77b39;\n\n\n  position: relative;\n\n  width: 100%;\n\n  margin: 0;\n\n  padding:\n\n    clamp(65px, 6vw, 110px)\n\n    clamp(24px, 6vw, 110px)\n\n    0;\n\n\n  overflow: hidden;\n\n\n  background:\n\n    linear-gradient(\n      135deg,\n      #fffdf9 0%,\n      #faf6ef 45%,\n      #f2e7da 100%\n    );\n\n\n  color:\n    var(--hnx-dark);\n\n\n  isolation:\n    isolate;\n\n}\n\n\n.hnx-hero-product *,\n.hnx-hero-product *::before,\n.hnx-hero-product *::after {\n\n  box-sizing:\n    border-box;\n\n}\n\n\n\n/* =========================================================\n   BACKGROUND\n========================================================= */\n\n.hnx-background {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n\n}\n\n\n.hnx-light {\n\n  position: absolute;\n\n  display: block;\n\n  border-radius: 50%;\n\n}\n\n\n.hnx-light-one {\n\n  width: 500px;\n\n  height: 500px;\n\n  top: -250px;\n\n  right: -120px;\n\n\n  background:\n\n    radial-gradient(\n      circle,\n      rgba(191,131,64,.18),\n      rgba(191,131,64,0) 70%\n    );\n\n}\n\n\n.hnx-light-two {\n\n  width: 420px;\n\n  height: 420px;\n\n  left: -180px;\n\n  bottom: -200px;\n\n\n  background:\n\n    radial-gradient(\n      circle,\n      rgba(157,73,30,.11),\n      rgba(157,73,30,0) 70%\n    );\n\n}\n\n\n.hnx-arch {\n\n  position: absolute;\n\n\n  width:\n    min(38vw, 580px);\n\n\n  height:\n    78%;\n\n\n  top:\n    45px;\n\n\n  right:\n    7%;\n\n\n  border:\n\n    1px solid\n    rgba(123,77,44,.09);\n\n\n  border-bottom:\n    0;\n\n\n  border-radius:\n\n    320px\n    320px\n    0\n    0;\n\n\n  background:\n\n    linear-gradient(\n      180deg,\n      rgba(255,255,255,.42),\n      rgba(255,255,255,.03)\n    );\n\n}\n\n\n\n/* =========================================================\n   CONTAINER\n========================================================= */\n\n.hnx-container {\n\n  display: grid;\n\n\n  grid-template-columns:\n\n    minmax(0, .94fr)\n\n    minmax(480px, 1.06fr);\n\n\n  align-items:\n    center;\n\n\n  gap:\n\n    clamp(\n      30px,\n      5vw,\n      90px\n    );\n\n\n  width:\n    100%;\n\n\n  max-width:\n    1480px;\n\n\n  min-height:\n    650px;\n\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hnx-content {\n\n  position: relative;\n\n  z-index: 5;\n\n  width: 100%;\n\n  max-width: 620px;\n\n}\n\n\n\n/* =========================================================\n   EYEBROW\n========================================================= */\n\n.hnx-eyebrow {\n\n  display: flex;\n\n  align-items: center;\n\n  gap: 12px;\n\n\n  margin-bottom:\n    19px;\n\n\n  color:\n    #86562d;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      9px,\n      .72vw,\n      11px\n    );\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .22em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n.hnx-eyebrow-line {\n\n  display: block;\n\n  width: 28px;\n\n  height: 1px;\n\n  background: currentColor;\n\n  opacity: .65;\n\n}\n\n\n\n/* =========================================================\n   KICKER\n========================================================= */\n\n.hnx-kicker {\n\n  margin:\n\n    0\n    0\n    9px;\n\n\n  color:\n    #4b3e36;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      17px,\n      1.3vw,\n      21px\n    );\n\n\n  line-height:\n    1.4;\n\n}\n\n\n\n/* =========================================================\n   TITLE\n========================================================= */\n\n.hnx-title {\n\n  margin: 0;\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n\n    clamp(\n      50px,\n      5vw,\n      86px\n    );\n\n\n  font-weight:\n    500;\n\n\n  line-height:\n    .94;\n\n\n  letter-spacing:\n    -.05em;\n\n\n  color:\n    var(--hnx-dark);\n\n}\n\n\n.hnx-title > span {\n\n  display:\n    block;\n\n}\n\n\n.hnx-title em {\n\n  display:\n    block;\n\n\n  margin-top:\n    8px;\n\n\n  color:\n    var(--hnx-rust);\n\n\n  font-size:\n    .77em;\n\n\n  font-weight:\n    400;\n\n\n  font-style:\n    italic;\n\n\n  letter-spacing:\n    -.035em;\n\n}\n\n\n\n/* =========================================================\n   PRICE\n========================================================= */\n\n.hnx-price-row {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  flex-wrap:\n    wrap;\n\n\n  gap:\n    12px;\n\n\n  margin-top:\n    24px;\n\n}\n\n\n.hnx-price {\n\n  color:\n    var(--hnx-rust-dark);\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n    25px;\n\n\n  font-weight:\n    600;\n\n}\n\n\n.hnx-compare-price {\n\n  color:\n    #a49386;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    14px;\n\n\n  text-decoration:\n    line-through;\n\n}\n\n\n.hnx-stock {\n\n  display:\n    inline-flex;\n\n\n  align-items:\n    center;\n\n\n  padding:\n\n    5px\n    10px;\n\n\n  border-radius:\n    50px;\n\n\n  background:\n    #f0ebe6;\n\n\n  color:\n    #66564a;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    9px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .08em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n.hnx-stock.is-available {\n\n  background:\n    #ebf4e6;\n\n\n  color:\n    #466c37;\n\n}\n\n\n.hnx-stock.is-sold {\n\n  background:\n    #f6e4df;\n\n\n  color:\n    #89371f;\n\n}\n\n\n\n/* =========================================================\n   DESCRIPTION\n========================================================= */\n\n.hnx-description {\n\n  max-width:\n    550px;\n\n\n  margin:\n\n    20px\n    0\n    0;\n\n\n  color:\n    var(--hnx-text);\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      14px,\n      1vw,\n      17px\n    );\n\n\n  line-height:\n    1.72;\n\n}\n\n\n\n/* =========================================================\n   PRODUCT DETAILS\n========================================================= */\n\n.hnx-details {\n\n  display:\n    flex;\n\n\n  flex-wrap:\n    wrap;\n\n\n  align-items:\n    center;\n\n\n  gap:\n\n    15px\n    24px;\n\n\n  margin-top:\n    25px;\n\n}\n\n\n.hnx-detail {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    9px;\n\n\n  color:\n    #4e4037;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    11px;\n\n\n  line-height:\n    1.25;\n\n}\n\n\n.hnx-detail small {\n\n  display:\n    block;\n\n\n  margin-bottom:\n    3px;\n\n\n  color:\n    #967253;\n\n\n  font-size:\n    8px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .14em;\n\n}\n\n\n.hnx-detail-icon {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  width:\n    36px;\n\n\n  height:\n    36px;\n\n\n  flex:\n    0 0 36px;\n\n\n  border:\n\n    1px solid\n    rgba(128,79,43,.31);\n\n\n  border-radius:\n    50%;\n\n\n  color:\n    #87532a;\n\n}\n\n\n.hnx-detail-icon svg {\n\n  width: 18px;\n\n  height: 18px;\n\n}\n\n\n\n/* =========================================================\n   VARIANT\n========================================================= */\n\n.hnx-variant-wrap {\n\n  max-width:\n    540px;\n\n\n  margin-top:\n    25px;\n\n}\n\n\n.hnx-label {\n\n  display:\n    block;\n\n\n  margin-bottom:\n    7px;\n\n\n  color:\n    #65493a;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    10px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .1em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n.hnx-variant {\n\n  width:\n    100%;\n\n\n  min-height:\n    48px;\n\n\n  padding:\n\n    0\n    15px;\n\n\n  border:\n\n    1px solid\n    rgba(104,67,44,.25);\n\n\n  border-radius:\n    7px;\n\n\n  background:\n    rgba(255,255,255,.70);\n\n\n  color:\n    #3d2d23;\n\n\n  font-size:\n    14px;\n\n\n  outline:\n    none;\n\n}\n\n\n\n/* =========================================================\n   ACTIONS\n========================================================= */\n\n.hnx-actions {\n\n  display:\n    grid;\n\n\n  grid-template-columns:\n\n    116px\n    minmax(200px, 1fr);\n\n\n  gap:\n    11px;\n\n\n  width:\n    100%;\n\n\n  max-width:\n    540px;\n\n\n  margin-top:\n    30px;\n\n}\n\n\n\n/* =========================================================\n   QUANTITY\n========================================================= */\n\n.hnx-quantity {\n\n  display:\n    grid;\n\n\n  grid-template-columns:\n\n    36px\n    1fr\n    36px;\n\n\n  min-height:\n    54px;\n\n\n  overflow:\n    hidden;\n\n\n  border:\n\n    1px solid\n    rgba(102,67,44,.24);\n\n\n  border-radius:\n    7px;\n\n\n  background:\n    rgba(255,255,255,.68);\n\n}\n\n\n.hnx-quantity button {\n\n  border: 0;\n\n\n  background:\n    transparent;\n\n\n  color:\n    #634637;\n\n\n  font-size:\n    20px;\n\n\n  cursor:\n    pointer;\n\n}\n\n\n.hnx-quantity button:hover {\n\n  background:\n    rgba(126,75,42,.07);\n\n}\n\n\n.hnx-quantity input {\n\n  width:\n    100%;\n\n\n  min-width:\n    0;\n\n\n  border:\n    0;\n\n\n  outline:\n    none;\n\n\n  background:\n    transparent;\n\n\n  color:\n    #35251c;\n\n\n  text-align:\n    center;\n\n\n  font-size:\n    14px;\n\n\n  font-weight:\n    600;\n\n\n  appearance:\n    textfield;\n\n\n  -moz-appearance:\n    textfield;\n\n}\n\n\n.hnx-quantity input::-webkit-inner-spin-button,\n.hnx-quantity input::-webkit-outer-spin-button {\n\n  appearance:\n    none;\n\n\n  -webkit-appearance:\n    none;\n\n}\n\n\n\n/* =========================================================\n   ADD CART\n========================================================= */\n\n.hnx-add-cart {\n\n  position:\n    relative;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  gap:\n    16px;\n\n\n  min-height:\n    54px;\n\n\n  padding:\n\n    0\n    25px;\n\n\n  overflow:\n    hidden;\n\n\n  border:\n\n    1px solid\n    #842c0c;\n\n\n  border-radius:\n    7px;\n\n\n  background:\n\n    linear-gradient(\n      135deg,\n      #ad4617,\n      #852d0d\n    );\n\n\n  box-shadow:\n\n    0\n    13px\n    28px\n    rgba(104,45,17,.20);\n\n\n  color:\n    #fff;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    14px;\n\n\n  font-weight:\n    700;\n\n\n  cursor:\n    pointer;\n\n\n  transition:\n\n    transform .25s ease,\n    box-shadow .25s ease;\n\n}\n\n\n.hnx-add-cart::before {\n\n  content:\n    \"\";\n\n\n  position:\n    absolute;\n\n\n  top: 0;\n\n  left: -70%;\n\n\n  width:\n    45%;\n\n\n  height:\n    100%;\n\n\n  background:\n\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.18),\n      transparent\n    );\n\n\n  transform:\n    skewX(-22deg);\n\n\n  transition:\n    left .65s ease;\n\n}\n\n\n.hnx-add-cart:hover:not(:disabled) {\n\n  transform:\n    translateY(-2px);\n\n\n  box-shadow:\n\n    0\n    18px\n    36px\n    rgba(104,45,17,.28);\n\n}\n\n\n.hnx-add-cart:hover:not(:disabled)::before {\n\n  left:\n    130%;\n\n}\n\n\n.hnx-add-cart span,\n.hnx-add-cart svg {\n\n  position:\n    relative;\n\n\n  z-index:\n    2;\n\n}\n\n\n.hnx-add-cart svg {\n\n  width:\n    19px;\n\n\n  height:\n    19px;\n\n\n  transition:\n    transform .25s ease;\n\n}\n\n\n.hnx-add-cart:hover svg {\n\n  transform:\n    translateX(4px);\n\n}\n\n\n.hnx-add-cart:disabled {\n\n  border-color:\n    #a5968c;\n\n\n  background:\n    #a5968c;\n\n\n  box-shadow:\n    none;\n\n\n  cursor:\n    not-allowed;\n\n}\n\n\n\n/* =========================================================\n   BUY NOW\n========================================================= */\n\n.hnx-buy-now {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  gap:\n    9px;\n\n\n  width:\n    100%;\n\n\n  max-width:\n    540px;\n\n\n  min-height:\n    52px;\n\n\n  margin-top:\n    11px;\n\n\n  border:\n\n    1px solid\n    rgba(109,63,36,.30);\n\n\n  border-radius:\n    7px;\n\n\n  background:\n    rgba(255,255,255,.63);\n\n\n  color:\n    #6f361c;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    14px;\n\n\n  font-weight:\n    700;\n\n\n  cursor:\n    pointer;\n\n\n  transition:\n\n    background .25s ease,\n    transform .25s ease,\n    box-shadow .25s ease;\n\n}\n\n\n.hnx-buy-now:hover:not(:disabled) {\n\n  background:\n    #ffffff;\n\n\n  transform:\n    translateY(-2px);\n\n\n  box-shadow:\n\n    0\n    12px\n    28px\n    rgba(100,58,32,.10);\n\n}\n\n\n.hnx-buy-now:disabled {\n\n  opacity:\n    .55;\n\n\n  cursor:\n    not-allowed;\n\n}\n\n\n\n/* =========================================================\n   MESSAGE\n========================================================= */\n\n.hnx-message {\n\n  min-height:\n    20px;\n\n\n  max-width:\n    540px;\n\n\n  margin-top:\n    9px;\n\n\n  color:\n    #4d6b3c;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    11px;\n\n\n  font-weight:\n    600;\n\n}\n\n\n.hnx-message.is-error {\n\n  color:\n    #9a3921;\n\n}\n\n\n\n/* =========================================================\n   PRODUCT LINK\n========================================================= */\n\n.hnx-product-link {\n\n  display:\n    inline-flex;\n\n\n  gap:\n    7px;\n\n\n  align-items:\n    center;\n\n\n  margin-top:\n    11px;\n\n\n  border-bottom:\n\n    1px solid\n    rgba(98,67,49,.32);\n\n\n  color:\n    #614637 !important;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    11px;\n\n\n  font-weight:\n    600;\n\n\n  line-height:\n    1.6;\n\n\n  text-decoration:\n    none !important;\n\n}\n\n\n\n/* =========================================================\n   PRODUCT STAGE\n========================================================= */\n\n.hnx-stage {\n\n  position:\n    relative;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    flex-end;\n\n\n  justify-content:\n    center;\n\n\n  min-height:\n    620px;\n\n\n  isolation:\n    isolate;\n\n}\n\n\n\n/* =========================================================\n   PRODUCT IMAGE\n========================================================= */\n\n.hnx-product-image-link {\n\n  position:\n    absolute;\n\n\n  z-index:\n    8;\n\n\n  left:\n    50%;\n\n\n  bottom:\n    142px;\n\n\n  width:\n    min(73%, 510px);\n\n\n  transform:\n    translateX(-50%);\n\n\n  text-decoration:\n    none;\n\n}\n\n\n.hnx-product-image {\n\n  display:\n    block;\n\n\n  width:\n    100%;\n\n\n  height:\n    460px;\n\n\n  object-fit:\n    contain;\n\n\n  opacity:\n    0;\n\n\n  mix-blend-mode:\n    multiply;\n\n\n  filter:\n\n    drop-shadow(\n      0\n      27px\n      24px\n      rgba(69,40,23,.17)\n    );\n\n\n  transition:\n\n    opacity .4s ease,\n    transform .55s cubic-bezier(.22,.61,.36,1),\n    filter .55s ease;\n\n}\n\n\n.hnx-product-image.is-loaded {\n\n  opacity:\n    1;\n\n}\n\n\n.hnx-product-image-link:hover\n.hnx-product-image {\n\n  transform:\n\n    translateY(-8px)\n    scale(1.025);\n\n\n  filter:\n\n    drop-shadow(\n      0\n      34px\n      28px\n      rgba(69,40,23,.22)\n    );\n\n}\n\n\n\n/* =========================================================\n   PRODUCT SHADOW\n========================================================= */\n\n.hnx-product-shadow {\n\n  position:\n    absolute;\n\n\n  z-index:\n    4;\n\n\n  left:\n    50%;\n\n\n  bottom:\n    128px;\n\n\n  width:\n    330px;\n\n\n  height:\n    48px;\n\n\n  border-radius:\n    50%;\n\n\n  background:\n\n    radial-gradient(\n      ellipse,\n      rgba(89,54,30,.20),\n      rgba(89,54,30,0)\n      70%\n    );\n\n\n  filter:\n    blur(3px);\n\n\n  transform:\n    translateX(-50%);\n\n}\n\n\n\n/* =========================================================\n   PODIUM\n========================================================= */\n\n.hnx-podium {\n\n  position:\n    relative;\n\n\n  z-index:\n    3;\n\n\n  width:\n    min(82%, 520px);\n\n\n  height:\n    160px;\n\n\n  margin-bottom:\n    39px;\n\n\n  filter:\n\n    drop-shadow(\n      0\n      31px\n      30px\n      rgba(94,56,31,.14)\n    );\n\n}\n\n\n.hnx-podium-top {\n\n  position:\n    absolute;\n\n\n  z-index:\n    3;\n\n\n  top:\n    -25px;\n\n\n  left:\n    0;\n\n\n  width:\n    100%;\n\n\n  height:\n    73px;\n\n\n  border:\n\n    1px solid\n    rgba(151,107,72,.17);\n\n\n  border-radius:\n    50%;\n\n\n  background:\n\n    radial-gradient(\n      ellipse at 45% 25%,\n      #fffaf3,\n      #ead5bc 62%,\n      #d1ad89 100%\n    );\n\n\n  box-shadow:\n\n    inset\n    0\n    7px\n    13px\n    rgba(255,255,255,.68);\n\n}\n\n\n.hnx-podium-body {\n\n  position:\n    absolute;\n\n\n  top:\n    11px;\n\n\n  left:\n    4%;\n\n\n  width:\n    92%;\n\n\n  height:\n    130px;\n\n\n  border-radius:\n\n    0\n    0\n    42%\n    42%\n    /\n    0\n    0\n    23%\n    23%;\n\n\n  background:\n\n    linear-gradient(\n      90deg,\n      #d0af8d 0%,\n      #ebd3b9 25%,\n      #f6e2cc 53%,\n      #cca783 100%\n    );\n\n\n  box-shadow:\n\n    inset 16px 0 24px rgba(102,65,38,.08),\n    inset -16px 0 24px rgba(102,65,38,.10);\n\n}\n\n\n\n/* =========================================================\n   BADGE\n========================================================= */\n\n.hnx-badge {\n\n  position:\n    absolute;\n\n\n  z-index:\n    12;\n\n\n  top:\n    55px;\n\n\n  right:\n    3%;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    10px;\n\n\n  padding:\n\n    11px\n    15px;\n\n\n  border:\n\n    1px solid\n    rgba(130,83,45,.20);\n\n\n  border-radius:\n    100px;\n\n\n  background:\n    rgba(255,249,241,.78);\n\n\n  box-shadow:\n\n    0\n    13px\n    32px\n    rgba(94,56,30,.08);\n\n\n  backdrop-filter:\n    blur(8px);\n\n\n  -webkit-backdrop-filter:\n    blur(8px);\n\n\n  color:\n    #6b4632;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    8px;\n\n\n  letter-spacing:\n    .08em;\n\n\n  line-height:\n    1.25;\n\n}\n\n\n.hnx-badge strong {\n\n  display:\n    block;\n\n\n  margin-top:\n    2px;\n\n\n  font-size:\n    9px;\n\n}\n\n\n.hnx-badge-icon {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  width:\n    32px;\n\n\n  height:\n    32px;\n\n\n  border:\n\n    1px solid\n    rgba(133,82,42,.34);\n\n\n  border-radius:\n    50%;\n\n}\n\n\n.hnx-badge-icon svg {\n\n  width:\n    18px;\n\n\n  height:\n    18px;\n\n}\n\n\n\n/* =========================================================\n   FLOATING PRICE\n========================================================= */\n\n.hnx-floating-price {\n\n  position:\n    absolute;\n\n\n  z-index:\n    11;\n\n\n  right:\n    5%;\n\n\n  top:\n    48%;\n\n\n  color:\n    rgba(119,72,46,.70);\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n    18px;\n\n\n  font-weight:\n    600;\n\n\n  transform:\n    rotate(-90deg);\n\n}\n\n\n\n/* =========================================================\n   FLOATING CARD\n========================================================= */\n\n.hnx-floating-card {\n\n  position:\n    absolute;\n\n\n  z-index:\n    11;\n\n\n  right:\n    0;\n\n\n  bottom:\n    70px;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    10px;\n\n\n  min-width:\n    184px;\n\n\n  padding:\n\n    13px\n    16px;\n\n\n  border:\n\n    1px solid\n    rgba(126,80,45,.17);\n\n\n  border-radius:\n    18px;\n\n\n  background:\n    rgba(255,249,241,.80);\n\n\n  box-shadow:\n\n    0\n    16px\n    34px\n    rgba(92,53,29,.10);\n\n\n  backdrop-filter:\n    blur(9px);\n\n\n  -webkit-backdrop-filter:\n    blur(9px);\n\n\n  color:\n    #704c39;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    10px;\n\n\n  line-height:\n    1.4;\n\n}\n\n\n.hnx-floating-card strong {\n\n  display:\n    block;\n\n\n  color:\n    #3f2a20;\n\n}\n\n\n.hnx-star {\n\n  color:\n    var(--hnx-gold);\n\n\n  font-size:\n    20px;\n\n}\n\n\n\n/* =========================================================\n   STAGE RINGS\n========================================================= */\n\n.hnx-stage-ring {\n\n  position:\n    absolute;\n\n\n  z-index:\n    1;\n\n\n  left:\n    50%;\n\n\n  border:\n\n    1px solid\n    rgba(143,91,49,.08);\n\n\n  border-radius:\n    50%;\n\n\n  transform:\n    translateX(-50%);\n\n}\n\n\n.hnx-ring-one {\n\n  width:\n    510px;\n\n\n  height:\n    510px;\n\n\n  top:\n    54px;\n\n}\n\n\n.hnx-ring-two {\n\n  width:\n    430px;\n\n\n  height:\n    430px;\n\n\n  top:\n    95px;\n\n}\n\n\n\n/* =========================================================\n   BENEFITS\n========================================================= */\n\n.hnx-benefits {\n\n  position:\n    relative;\n\n\n  z-index:\n    20;\n\n\n  display:\n    grid;\n\n\n  grid-template-columns:\n\n    1fr auto\n    1fr auto\n    1fr auto\n    1fr auto\n    1fr;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    22px;\n\n\n  width:\n    100%;\n\n\n  max-width:\n    1480px;\n\n\n  min-height:\n    115px;\n\n\n  margin:\n\n    25px\n    auto\n    0;\n\n\n  padding:\n\n    22px\n    clamp(\n      25px,\n      4vw,\n      65px\n    );\n\n\n  background:\n\n    linear-gradient(\n      135deg,\n      #d7ba9b,\n      #caaa88\n    );\n\n\n  color:\n    #ffffff;\n\n}\n\n\n.hnx-benefit {\n\n  text-align:\n    center;\n\n\n  font-family:\n    Arial, sans-serif;\n\n}\n\n\n.hnx-benefit small {\n\n  display:\n    block;\n\n\n  margin-bottom:\n    7px;\n\n\n  color:\n    rgba(255,255,255,.70);\n\n\n  font-size:\n    8px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .14em;\n\n}\n\n\n.hnx-benefit strong {\n\n  font-size:\n    13px;\n\n\n  font-weight:\n    600;\n\n}\n\n\n.hnx-benefit-divider {\n\n  width:\n    1px;\n\n\n  height:\n    37px;\n\n\n  background:\n    rgba(255,255,255,.23);\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and (max-width: 1100px) {\n\n  .hnx-hero-product {\n\n    padding-left:\n      35px;\n\n\n    padding-right:\n      35px;\n\n  }\n\n\n  .hnx-container {\n\n    grid-template-columns:\n\n      minmax(0, 1fr)\n\n      minmax(390px, .92fr);\n\n\n    min-height:\n      610px;\n\n  }\n\n\n  .hnx-title {\n\n    font-size:\n\n      clamp(\n        46px,\n        6vw,\n        66px\n      );\n\n  }\n\n\n  .hnx-product-image-link {\n\n    width:\n      min(77%, 430px);\n\n  }\n\n\n  .hnx-product-image {\n\n    height:\n      420px;\n\n  }\n\n\n  .hnx-benefits {\n\n    gap:\n      13px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .hnx-hero-product {\n\n    padding:\n\n      50px\n      18px\n      0;\n\n  }\n\n\n  .hnx-arch {\n\n    width:\n      110vw;\n\n\n    height:\n      540px;\n\n\n    top:\n      auto;\n\n\n    bottom:\n      160px;\n\n\n    right:\n      -25%;\n\n  }\n\n\n  .hnx-container {\n\n    display:\n      flex;\n\n\n    flex-direction:\n      column;\n\n\n    gap:\n      22px;\n\n\n    min-height:\n      0;\n\n  }\n\n\n  .hnx-content {\n\n    max-width:\n      580px;\n\n\n    text-align:\n      center;\n\n  }\n\n\n  .hnx-eyebrow {\n\n    justify-content:\n      center;\n\n  }\n\n\n  .hnx-title {\n\n    font-size:\n\n      clamp(\n        43px,\n        13vw,\n        63px\n      );\n\n  }\n\n\n  .hnx-price-row {\n\n    justify-content:\n      center;\n\n  }\n\n\n  .hnx-description {\n\n    margin:\n\n      18px\n      auto\n      0;\n\n\n    font-size:\n      13px;\n\n  }\n\n\n  .hnx-details {\n\n    justify-content:\n      center;\n\n  }\n\n\n  .hnx-variant-wrap {\n\n    margin:\n\n      23px\n      auto\n      0;\n\n  }\n\n\n  .hnx-actions {\n\n    margin:\n\n      25px\n      auto\n      0;\n\n  }\n\n\n  .hnx-buy-now {\n\n    margin:\n\n      10px\n      auto\n      0;\n\n  }\n\n\n  .hnx-message {\n\n    margin-left:\n      auto;\n\n\n    margin-right:\n      auto;\n\n  }\n\n\n  .hnx-stage {\n\n    width:\n      100%;\n\n\n    min-height:\n      510px;\n\n  }\n\n\n  .hnx-product-image-link {\n\n    width:\n      min(82%, 390px);\n\n\n    bottom:\n      127px;\n\n  }\n\n\n  .hnx-product-image {\n\n    height:\n      390px;\n\n  }\n\n\n  .hnx-product-shadow {\n\n    bottom:\n      115px;\n\n\n    width:\n      260px;\n\n  }\n\n\n  .hnx-podium {\n\n    width:\n      min(91%, 430px);\n\n\n    height:\n      140px;\n\n\n    margin-bottom:\n      30px;\n\n  }\n\n\n  .hnx-badge {\n\n    top:\n      17px;\n\n\n    right:\n      0;\n\n  }\n\n\n  .hnx-floating-price {\n\n    display:\n      none;\n\n  }\n\n\n  .hnx-floating-card {\n\n    bottom:\n      42px;\n\n\n    right:\n      0;\n\n  }\n\n\n  .hnx-ring-one {\n\n    width:\n      420px;\n\n\n    height:\n      420px;\n\n  }\n\n\n  .hnx-ring-two {\n\n    width:\n      350px;\n\n\n    height:\n      350px;\n\n  }\n\n\n  .hnx-benefits {\n\n    grid-template-columns:\n      1fr 1fr;\n\n\n    gap:\n      0;\n\n\n    min-height:\n      0;\n\n\n    padding:\n      10px;\n\n  }\n\n\n  .hnx-benefit {\n\n    padding:\n\n      17px\n      8px;\n\n\n    border-bottom:\n\n      1px solid\n      rgba(255,255,255,.20);\n\n  }\n\n\n  .hnx-benefit:last-of-type {\n\n    grid-column:\n      1 / -1;\n\n  }\n\n\n  .hnx-benefit-divider {\n\n    display:\n      none;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 450px) {\n\n  .hnx-title {\n\n    font-size:\n      43px;\n\n  }\n\n\n  .hnx-details {\n\n    display:\n      grid;\n\n\n    grid-template-columns:\n      1fr 1fr;\n\n\n    max-width:\n      340px;\n\n\n    margin-left:\n      auto;\n\n\n    margin-right:\n      auto;\n\n  }\n\n\n  .hnx-detail:last-child {\n\n    grid-column:\n      1 / -1;\n\n\n    justify-content:\n      center;\n\n  }\n\n\n  .hnx-actions {\n\n    grid-template-columns:\n      1fr;\n\n  }\n\n\n  .hnx-quantity {\n\n    width:\n      130px;\n\n\n    margin:\n      0 auto;\n\n  }\n\n\n  .hnx-stage {\n\n    min-height:\n      440px;\n\n  }\n\n\n  .hnx-product-image-link {\n\n    width:\n      min(86%, 350px);\n\n\n    bottom:\n      115px;\n\n  }\n\n\n  .hnx-product-image {\n\n    height:\n      340px;\n\n  }\n\n\n  .hnx-badge {\n\n    transform:\n      scale(.85);\n\n\n    transform-origin:\n      right top;\n\n  }\n\n\n  .hnx-floating-card {\n\n    transform:\n      scale(.88);\n\n\n    transform-origin:\n      right bottom;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   ACCESSIBILITY\n========================================================= */\n\n.hnx-add-cart:focus-visible,\n.hnx-buy-now:focus-visible,\n.hnx-quantity button:focus-visible,\n.hnx-quantity input:focus-visible,\n.hnx-variant:focus-visible,\n.hnx-product-image-link:focus-visible {\n\n  outline:\n\n    3px solid\n    rgba(137,67,28,.34);\n\n\n  outline-offset:\n    3px;\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hnx-product-image,\n  .hnx-add-cart,\n  .hnx-add-cart::before,\n  .hnx-add-cart svg,\n  .hnx-buy-now {\n\n    transition:\n      none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =========================================================\n     PRODUCT CONFIGURATION\n  ========================================================= */\n\n  var PRODUCT_HANDLE =\n    \"wooden-horse-decor-with-bells-8-12-inches\";\n\n\n  var section =\n    document.getElementById(\n      \"hnxHeroProduct\"\n    );\n\n\n  if (!section) {\n    return;\n  }\n\n\n\n  /* =========================================================\n     ELEMENTS\n  ========================================================= */\n\n  var priceElement =\n    document.getElementById(\n      \"hnxPrice\"\n    );\n\n\n  var comparePriceElement =\n    document.getElementById(\n      \"hnxComparePrice\"\n    );\n\n\n  var floatingPriceElement =\n    document.getElementById(\n      \"hnxFloatingPrice\"\n    );\n\n\n  var stockElement =\n    document.getElementById(\n      \"hnxStock\"\n    );\n\n\n  var imageElement =\n    document.getElementById(\n      \"hnxProductImage\"\n    );\n\n\n  var imageLink =\n    document.getElementById(\n      \"hnxImageLink\"\n    );\n\n\n  var productLink =\n    document.getElementById(\n      \"hnxProductLink\"\n    );\n\n\n  var variantWrap =\n    document.getElementById(\n      \"hnxVariantWrap\"\n    );\n\n\n  var variantSelect =\n    document.getElementById(\n      \"hnxVariant\"\n    );\n\n\n  var quantityInput =\n    document.getElementById(\n      \"hnxQuantity\"\n    );\n\n\n  var minusButton =\n    document.getElementById(\n      \"hnxMinus\"\n    );\n\n\n  var plusButton =\n    document.getElementById(\n      \"hnxPlus\"\n    );\n\n\n  var addCartButton =\n    document.getElementById(\n      \"hnxAddCart\"\n    );\n\n\n  var addCartText =\n    document.getElementById(\n      \"hnxAddCartText\"\n    );\n\n\n  var buyNowButton =\n    document.getElementById(\n      \"hnxBuyNow\"\n    );\n\n\n  var messageElement =\n    document.getElementById(\n      \"hnxMessage\"\n    );\n\n\n\n  var productData =\n    null;\n\n\n  var currentVariant =\n    null;\n\n\n\n  /* =========================================================\n     MONEY\n  ========================================================= */\n\n  function formatMoney(cents) {\n\n    if (\n      typeof cents !== \"number\"\n    ) {\n\n      return \"\";\n\n    }\n\n\n    return new Intl.NumberFormat(\n      \"en-IN\",\n      {\n        style: \"currency\",\n        currency: \"INR\",\n        maximumFractionDigits: 0\n      }\n    ).format(\n      cents / 100\n    );\n\n  }\n\n\n\n  /* =========================================================\n     GET QUANTITY\n  ========================================================= */\n\n  function getQuantity() {\n\n    var value =\n      parseInt(\n        quantityInput.value,\n        10\n      );\n\n\n    if (\n      !value ||\n      value < 1\n    ) {\n\n      value = 1;\n\n    }\n\n\n    quantityInput.value =\n      value;\n\n\n    return value;\n\n  }\n\n\n\n  /* =========================================================\n     SHOW MESSAGE\n  ========================================================= */\n\n  function showMessage(\n    text,\n    error\n  ) {\n\n    messageElement.textContent =\n      text || \"\";\n\n\n    messageElement.classList.toggle(\n      \"is-error\",\n      !!error\n    );\n\n  }\n\n\n\n  /* =========================================================\n     UPDATE VARIANT UI\n  ========================================================= */\n\n  function updateVariant(\n    variant\n  ) {\n\n    if (!variant) {\n      return;\n    }\n\n\n    currentVariant =\n      variant;\n\n\n\n    /* PRICE */\n\n    var price =\n      formatMoney(\n        variant.price\n      );\n\n\n    priceElement.textContent =\n      price;\n\n\n    floatingPriceElement.textContent =\n      price;\n\n\n\n    /* COMPARE PRICE */\n\n    if (\n      variant.compare_at_price &&\n      variant.compare_at_price > variant.price\n    ) {\n\n      comparePriceElement.textContent =\n        formatMoney(\n          variant.compare_at_price\n        );\n\n\n      comparePriceElement.hidden =\n        false;\n\n    } else {\n\n      comparePriceElement.hidden =\n        true;\n\n    }\n\n\n\n    /* AVAILABILITY */\n\n    stockElement.classList.remove(\n      \"is-available\",\n      \"is-sold\"\n    );\n\n\n    if (variant.available) {\n\n      stockElement.textContent =\n        \"In stock\";\n\n\n      stockElement.classList.add(\n        \"is-available\"\n      );\n\n\n      addCartButton.disabled =\n        false;\n\n\n      buyNowButton.disabled =\n        false;\n\n\n      addCartText.textContent =\n        \"Add to Cart\";\n\n    } else {\n\n      stockElement.textContent =\n        \"Sold out\";\n\n\n      stockElement.classList.add(\n        \"is-sold\"\n      );\n\n\n      addCartButton.disabled =\n        true;\n\n\n      buyNowButton.disabled =\n        true;\n\n\n      addCartText.textContent =\n        \"Sold Out\";\n\n    }\n\n\n\n    /* VARIANT IMAGE */\n\n    if (\n      variant.featured_image &&\n      variant.featured_image.src\n    ) {\n\n      imageElement.classList.remove(\n        \"is-loaded\"\n      );\n\n\n      imageElement.src =\n        variant.featured_image.src;\n\n    }\n\n  }\n\n\n\n  /* =========================================================\n     LOAD PRODUCT\n  ========================================================= */\n\n  fetch(\n    \"/products/\" +\n    PRODUCT_HANDLE +\n    \".js\",\n    {\n      credentials:\n        \"same-origin\"\n    }\n  )\n\n  .then(\n    function (response) {\n\n      if (!response.ok) {\n\n        throw new Error(\n          \"Unable to load product.\"\n        );\n\n      }\n\n\n      return response.json();\n\n    }\n  )\n\n  .then(\n    function (product) {\n\n      productData =\n        product;\n\n\n\n      /* PRODUCT URL */\n\n      var productUrl =\n        \"/products/\" +\n        PRODUCT_HANDLE;\n\n\n      productLink.href =\n        productUrl;\n\n\n      imageLink.href =\n        productUrl;\n\n\n\n      /* IMAGE */\n\n      if (\n        product.featured_image\n      ) {\n\n        imageElement.src =\n          product.featured_image;\n\n\n        imageElement.alt =\n          product.title;\n\n\n        imageElement.addEventListener(\n          \"load\",\n          function () {\n\n            imageElement.classList.add(\n              \"is-loaded\"\n            );\n\n          },\n          {\n            once:\n              false\n          }\n        );\n\n      }\n\n\n\n      /* VARIANTS */\n\n      if (\n        !product.variants ||\n        !product.variants.length\n      ) {\n\n        throw new Error(\n          \"No purchasable variants found.\"\n        );\n\n      }\n\n\n\n      currentVariant =\n        product.variants.find(\n          function (variant) {\n\n            return variant.available;\n\n          }\n        ) || product.variants[0];\n\n\n\n      if (\n        product.variants.length > 1\n      ) {\n\n        variantSelect.innerHTML =\n          \"\";\n\n\n        product.variants.forEach(\n          function (variant) {\n\n            var option =\n              document.createElement(\n                \"option\"\n              );\n\n\n            option.value =\n              variant.id;\n\n\n            option.textContent =\n              variant.title +\n              (\n                variant.available\n                  ? \"\"\n                  : \" — Sold out\"\n              );\n\n\n            option.disabled =\n              !variant.available;\n\n\n            if (\n              variant.id ===\n              currentVariant.id\n            ) {\n\n              option.selected =\n                true;\n\n            }\n\n\n            variantSelect.appendChild(\n              option\n            );\n\n          }\n        );\n\n\n        variantWrap.hidden =\n          false;\n\n      }\n\n\n\n      updateVariant(\n        currentVariant\n      );\n\n\n      showMessage(\n        \"\"\n      );\n\n    }\n  )\n\n  .catch(\n    function (error) {\n\n      console.error(\n        \"Hertha Nest hero product:\",\n        error\n      );\n\n\n      priceElement.textContent =\n        \"Unavailable\";\n\n\n      stockElement.textContent =\n        \"Product unavailable\";\n\n\n      stockElement.classList.add(\n        \"is-sold\"\n      );\n\n\n      addCartText.textContent =\n        \"Unavailable\";\n\n\n      showMessage(\n        \"This product could not be loaded. Please open the product page.\",\n        true\n      );\n\n    }\n  );\n\n\n\n  /* =========================================================\n     IMAGE LOAD\n  ========================================================= */\n\n  imageElement.addEventListener(\n    \"load\",\n    function () {\n\n      imageElement.classList.add(\n        \"is-loaded\"\n      );\n\n    }\n  );\n\n\n\n  /* =========================================================\n     VARIANT CHANGE\n  ========================================================= */\n\n  variantSelect.addEventListener(\n    \"change\",\n    function () {\n\n      if (!productData) {\n        return;\n      }\n\n\n      var variantId =\n        parseInt(\n          variantSelect.value,\n          10\n        );\n\n\n      var variant =\n        productData.variants.find(\n          function (item) {\n\n            return item.id === variantId;\n\n          }\n        );\n\n\n      updateVariant(\n        variant\n      );\n\n\n      showMessage(\n        \"\"\n      );\n\n    }\n  );\n\n\n\n  /* =========================================================\n     QUANTITY\n  ========================================================= */\n\n  minusButton.addEventListener(\n    \"click\",\n    function () {\n\n      var quantity =\n        getQuantity();\n\n\n      quantityInput.value =\n        Math.max(\n          1,\n          quantity - 1\n        );\n\n    }\n  );\n\n\n  plusButton.addEventListener(\n    \"click\",\n    function () {\n\n      var quantity =\n        getQuantity();\n\n\n      quantityInput.value =\n        quantity + 1;\n\n    }\n  );\n\n\n  quantityInput.addEventListener(\n    \"change\",\n    getQuantity\n  );\n\n\n\n  /* =========================================================\n     ADD TO CART\n  ========================================================= */\n\n  addCartButton.addEventListener(\n    \"click\",\n    function () {\n\n      if (\n        !currentVariant ||\n        !currentVariant.available\n      ) {\n\n        return;\n\n      }\n\n\n      var quantity =\n        getQuantity();\n\n\n\n      addCartButton.disabled =\n        true;\n\n\n      addCartText.textContent =\n        \"Adding...\";\n\n\n      showMessage(\n        \"\"\n      );\n\n\n\n      fetch(\n        \"/cart/add.js\",\n        {\n\n          method:\n            \"POST\",\n\n\n          credentials:\n            \"same-origin\",\n\n\n          headers: {\n\n            \"Content-Type\":\n              \"application/json\",\n\n\n            \"Accept\":\n              \"application/json\"\n\n          },\n\n\n          body:\n            JSON.stringify(\n              {\n\n                items: [\n                  {\n\n                    id:\n                      currentVariant.id,\n\n\n                    quantity:\n                      quantity\n\n                  }\n                ]\n\n              }\n            )\n\n        }\n      )\n\n\n      .then(\n        function (response) {\n\n          if (!response.ok) {\n\n            return response.json()\n              .then(\n                function (error) {\n\n                  throw new Error(\n                    error.description ||\n                    \"Unable to add product.\"\n                  );\n\n                }\n              );\n\n          }\n\n\n          return response.json();\n\n        }\n      )\n\n\n      .then(\n        function () {\n\n          showMessage(\n            \"Added to your cart successfully.\"\n          );\n\n\n          addCartText.textContent =\n            \"Added to Cart\";\n\n\n          /*\n            Shopify themes listen differently\n            for cart refreshes.\n\n            This event gives compatible themes/apps\n            an opportunity to respond.\n          */\n\n          document.dispatchEvent(\n            new CustomEvent(\n              \"cart:refresh\"\n            )\n          );\n\n\n          setTimeout(\n            function () {\n\n              if (\n                currentVariant &&\n                currentVariant.available\n              ) {\n\n                addCartButton.disabled =\n                  false;\n\n\n                addCartText.textContent =\n                  \"Add to Cart\";\n\n              }\n\n            },\n            1200\n          );\n\n        }\n      )\n\n\n      .catch(\n        function (error) {\n\n          console.error(\n            error\n          );\n\n\n          showMessage(\n            error.message ||\n            \"Unable to add this product to cart.\",\n            true\n          );\n\n\n          addCartButton.disabled =\n            false;\n\n\n          addCartText.textContent =\n            \"Add to Cart\";\n\n        }\n      );\n\n    }\n  );\n\n\n\n  /* =========================================================\n     BUY NOW\n  ========================================================= */\n\n  buyNowButton.addEventListener(\n    \"click\",\n    function () {\n\n      if (\n        !currentVariant ||\n        !currentVariant.available\n      ) {\n\n        return;\n\n      }\n\n\n      var quantity =\n        getQuantity();\n\n\n      /*\n        Shopify Cart Permalink\n\n        Goes directly toward checkout\n        with the selected product.\n      */\n\n      window.location.href =\n\n        \"/cart/\" +\n        currentVariant.id +\n        \":\" +\n        quantity +\n        \"?checkout\";\n\n    }\n  );\n\n\n})();\n\n</script>"
      }
    },
    "custom_html_qXDxfa": {
      "type": "custom-html",
      "name": "Custom html",
      "settings": {
        "section_padding_top": 0,
        "section_padding_bottom": 0,
        "section_padding_top_ip": 0,
        "section_padding_bottom_ip": 0,
        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 0,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<!--\n  Hertha Nest: Latest 30 Products — Two Connected Carousels\n\n  PERFORMANCE OPTIMIZED VERSION\n\n  Fixes:\n  1. Responsive Shopify CDN product images\n  2. Removed forced 800px image download\n  3. Browser selects 240 / 320 / 400 / 480 / 600px version\n  4. Responsive sizes attribute added\n  5. Lazy loading retained\n  6. Async image decoding retained\n  7. Image aspect ratio preserved\n  8. Existing functionality/design preserved\n  9. Product request reduced from 250 to 40 items\n 10. Cache-busting/no-store removed from product feed\n 11. Infinite carousel clones reduced from 15 to 4 per row\n\n  Top carousel: Products 1–15\n  Bottom carousel: Products 16–30\n-->\n\n<section class=\"hn-new30\" data-top-count=\"15\" data-bottom-count=\"15\" aria-labelledby=\"hn-new30-heading\">\n\n  <div class=\"hn-new30__inner\">\n\n    <header class=\"hn-new30__header\">\n\n      <span class=\"hn-new30__eyebrow\">\n        New at Hertha Nest\n      </span>\n\n      <h2 class=\"hn-new30__title\" id=\"hn-new30-heading\">\n        The New Décor Edit\n      </h2>\n\n      <p class=\"hn-new30__description\">\n        Explore our latest handcrafted additions, thoughtfully selected to\n        bring fresh character, colour and timeless charm into your home.\n      </p>\n\n    </header>\n\n\n    <div class=\"hn-new30__main-loading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-new30__loader\" aria-hidden=\"true\"></span>\n\n      <span>\n        Discovering our latest arrivals...\n      </span>\n    </div>\n\n\n    <!-- =====================================================\n         PRODUCTS 1–15\n    ====================================================== -->\n\n    <div class=\"hn-new30__carousel hn-new30__carousel--top\" data-carousel-position=\"top\" hidden=\"\">\n\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Latest fifteen products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"hn-new30__divider\" hidden=\"\" aria-hidden=\"true\">\n      <span></span>\n    </div>\n\n\n    <!-- =====================================================\n         PRODUCTS 16–30\n    ====================================================== -->\n\n    <div class=\"hn-new30__carousel hn-new30__carousel--bottom\" data-carousel-position=\"bottom\" hidden=\"\">\n\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Next fifteen newly added products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n\n    </div>\n\n\n    <div class=\"hn-new30__empty\" hidden=\"\">\n      New products will appear here as soon as they are published.\n    </div>\n\n  </div>\n\n\n  <!-- =====================================================\n       CART TOAST\n  ====================================================== -->\n\n  <div class=\"hn-new30__toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">\n\n    <span class=\"hn-new30__toast-icon\" aria-hidden=\"true\">\n      ✓\n    </span>\n\n    <span class=\"hn-new30__toast-message\">\n      Product added to your cart.\n    </span>\n\n    <a href=\"/cart\">\n      View cart\n    </a>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* =========================================================\n   SHOPIFY SECTION RESET\n========================================================= */\n\n.shopify-section:has(.hn-new30) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  overflow: visible !important;\n}\n\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.hn-new30 {\n\n  --hn30-green: #315548;\n  --hn30-green-dark: #203f35;\n  --hn30-gold: #bd9152;\n  --hn30-white: #ffffff;\n  --hn30-heading: #29211c;\n  --hn30-text: rgba(41,33,28,.70);\n  --hn30-muted: rgba(41,33,28,.52);\n  --hn30-border: rgba(49,85,72,.14);\n  --hn30-gap: 20px;\n\n  position: relative;\n\n  left: 50%;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin:\n    0\n    0\n    30px\n    -50vw;\n\n  padding:\n    38px\n    0\n    44px;\n\n  overflow: hidden;\n\n  color: var(--hn30-heading);\n\n  background:\n    radial-gradient(\n      circle at 5% 0%,\n      rgba(189,145,82,.14),\n      transparent 27%\n    ),\n    radial-gradient(\n      circle at 95% 100%,\n      rgba(49,85,72,.10),\n      transparent 28%\n    ),\n    linear-gradient(\n      135deg,\n      #f8f6ef 0%,\n      #fffdf8 48%,\n      #f4f3ec 100%\n    );\n}\n\n\n.hn-new30 *,\n.hn-new30 *::before,\n.hn-new30 *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   INNER\n========================================================= */\n\n.hn-new30__inner {\n  width: 100%;\n  max-width: 1520px;\n\n  margin: 0 auto;\n\n  padding:\n    0\n    32px;\n}\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n.hn-new30__header {\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n  justify-content: center;\n\n  max-width: 850px;\n\n  margin:\n    0\n    auto\n    22px;\n\n  text-align: center;\n}\n\n\n.hn-new30__eyebrow {\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 9px;\n\n  margin:\n    0\n    0\n    9px;\n\n  color: var(--hn30-green);\n\n  font-size: 11px;\n  font-weight: 750;\n\n  line-height: 1.3;\n\n  letter-spacing: 1.8px;\n\n  text-transform: uppercase;\n}\n\n\n.hn-new30__eyebrow::before,\n.hn-new30__eyebrow::after {\n\n  content: \"\";\n\n  width: 28px;\n  height: 1px;\n\n  background: var(--hn30-gold);\n}\n\n\n.hn-new30__title {\n\n  margin: 0;\n\n  color: var(--hn30-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      29px,\n      3.5vw,\n      44px\n    );\n\n  font-weight: 500;\n\n  line-height: 1.12;\n\n  letter-spacing: -.5px;\n}\n\n\n.hn-new30__description {\n\n  max-width: 720px;\n\n  margin:\n    10px\n    auto\n    0;\n\n  color: var(--hn30-text);\n\n  font-size: 14px;\n\n  line-height: 1.65;\n}\n\n\n/* =========================================================\n   CAROUSEL\n========================================================= */\n\n.hn-new30__carousel {\n  width: 100%;\n}\n\n\n.hn-new30__carousel[hidden],\n.hn-new30__divider[hidden],\n.hn-new30__empty[hidden],\n.hn-new30__main-loading[hidden] {\n  display: none !important;\n}\n\n\n/* =========================================================\n   CONTROLS\n========================================================= */\n\n.hn-new30__controls {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 9px;\n\n  min-height: 44px;\n\n  margin:\n    0\n    0\n    17px;\n}\n\n\n.hn-new30__controls[hidden] {\n  display: none !important;\n}\n\n\n.hn-new30__arrow {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 44px;\n  height: 44px;\n\n  min-width: 44px;\n  min-height: 44px;\n\n  padding: 0;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius: 50%;\n\n  background:\n    rgba(\n      255,\n      255,\n      255,\n      .86\n    );\n\n  color:\n    var(--hn30-green-dark);\n\n  box-shadow:\n    0 7px 18px\n    rgba(32,63,53,.08),\n    inset 0 1px 0\n    rgba(255,255,255,.9);\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    background .25s ease,\n    color .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-new30__arrow:hover {\n\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hn30-green);\n\n  background:\n    var(--hn30-green);\n\n  color: #ffffff;\n\n  box-shadow:\n    0 10px 22px\n    rgba(32,63,53,.18);\n}\n\n\n.hn-new30__arrow:focus-visible {\n\n  outline:\n    2px\n    solid\n    var(--hn30-gold);\n\n  outline-offset: 3px;\n}\n\n\n.hn-new30__arrow svg {\n\n  width: 17px;\n  height: 17px;\n\n  fill: none;\n\n  stroke: currentColor;\n\n  stroke-width: 1.8;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* =========================================================\n   VIEWPORT\n========================================================= */\n\n.hn-new30__viewport {\n\n  width: 100%;\n\n  overflow: hidden;\n\n  touch-action: pan-y;\n}\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hn-new30__track {\n\n  display: flex;\n\n  align-items: stretch;\n\n  gap:\n    var(--hn30-gap);\n\n  width: max-content;\n\n  will-change: transform;\n\n  transition:\n    transform\n    .55s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n/* =========================================================\n   DIVIDER\n========================================================= */\n\n.hn-new30__divider {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n\n  margin:\n    26px\n    0\n    18px;\n}\n\n\n.hn-new30__divider span {\n\n  position: relative;\n\n  display: block;\n\n  width:\n    min(\n      620px,\n      75%\n    );\n\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(49,85,72,.16),\n      rgba(189,145,82,.36),\n      rgba(49,85,72,.16),\n      transparent\n    );\n}\n\n\n.hn-new30__divider span::before {\n\n  content: \"\";\n\n  position: absolute;\n\n  top: 50%;\n  left: 50%;\n\n  width: 7px;\n  height: 7px;\n\n  border:\n    1px\n    solid\n    rgba(189,145,82,.55);\n\n  background: #f8f6ef;\n\n  transform:\n    translate(-50%,-50%)\n    rotate(45deg);\n}\n\n\n/* =========================================================\n   PRODUCT CARD\n========================================================= */\n\n.hn-new30__card {\n\n  position: relative;\n\n  flex:\n    0\n    0\n    auto;\n\n  min-width: 0;\n\n  overflow: hidden;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius: 18px;\n\n  background:\n    var(--hn30-white);\n\n  box-shadow:\n    0 10px 25px\n    rgba(41,33,28,.06),\n    0 2px 5px\n    rgba(41,33,28,.025);\n\n  transition:\n    transform .3s ease,\n    border-color .3s ease,\n    box-shadow .3s ease;\n}\n\n\n.hn-new30__card:hover {\n\n  transform:\n    translateY(-5px);\n\n  border-color:\n    rgba(189,145,82,.38);\n\n  box-shadow:\n    0 18px 38px\n    rgba(41,33,28,.11),\n    0 4px 10px\n    rgba(41,33,28,.04);\n}\n\n\n/* =========================================================\n   PRODUCT IMAGE\n========================================================= */\n\n.hn-new30__image-link {\n\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  aspect-ratio:\n    1 / 1;\n\n  overflow: hidden;\n\n  background: #f0eee7;\n}\n\n\n.hn-new30__image {\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  object-position:\n    center\n    center;\n\n  transition:\n    transform\n    .65s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n.hn-new30__card:hover\n.hn-new30__image {\n\n  transform:\n    scale(1.05);\n}\n\n\n.hn-new30__image-placeholder {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  height: 100%;\n\n  padding: 30px;\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(49,85,72,.12),\n      rgba(255,255,255,.90)\n    );\n\n  color:\n    var(--hn30-green);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size: 17px;\n\n  line-height: 1.4;\n\n  text-align: center;\n}\n\n\n/* =========================================================\n   BADGE\n========================================================= */\n\n.hn-new30__badge {\n\n  position: absolute;\n\n  top: 12px;\n  left: 12px;\n\n  z-index: 2;\n\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 7px;\n\n  min-height: 28px;\n\n  padding:\n    7px\n    11px;\n\n  border:\n    1px\n    solid\n    rgba(255,255,255,.32);\n\n  border-radius:\n    999px;\n\n  background:\n    rgba(35,72,59,.93);\n\n  color:\n    #ffffff;\n\n  box-shadow:\n    0 7px 18px\n    rgba(21,46,37,.20);\n\n  backdrop-filter:\n    blur(9px);\n\n  -webkit-backdrop-filter:\n    blur(9px);\n\n  font-size: 9px;\n\n  font-weight: 750;\n\n  line-height: 1;\n\n  letter-spacing: 1.05px;\n\n  text-transform:\n    uppercase;\n}\n\n\n.hn-new30__badge::before {\n\n  content: \"\";\n\n  width: 6px;\n  height: 6px;\n\n  flex:\n    0\n    0\n    6px;\n\n  border-radius:\n    50%;\n\n  background:\n    #e8bd78;\n\n  box-shadow:\n    0 0 0 4px\n    rgba(232,189,120,.16);\n}\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hn-new30__content {\n\n  display: block;\n\n  padding:\n    14px\n    15px\n    15px;\n}\n\n\n.hn-new30__vendor {\n\n  margin:\n    0\n    0\n    5px;\n\n  overflow: hidden;\n\n  color:\n    var(--hn30-green);\n\n  font-size: 9px;\n\n  font-weight: 750;\n\n  line-height: 1.3;\n\n  letter-spacing: 1.2px;\n\n  text-overflow:\n    ellipsis;\n\n  text-transform:\n    uppercase;\n\n  white-space:\n    nowrap;\n}\n\n\n/* =========================================================\n   PRODUCT TITLE\n========================================================= */\n\n.hn-new30__product-title {\n\n  min-height: 44px;\n\n  margin: 0;\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size: 17px;\n\n  font-weight: 500;\n\n  line-height: 1.32;\n}\n\n\n.hn-new30__product-title a {\n\n  display:\n    -webkit-box;\n\n  overflow: hidden;\n\n  color:\n    var(--hn30-heading);\n\n  text-decoration:\n    none;\n\n  -webkit-box-orient:\n    vertical;\n\n  -webkit-line-clamp:\n    2;\n\n  transition:\n    color\n    .22s\n    ease;\n}\n\n\n.hn-new30__product-title a:hover {\n\n  color:\n    var(--hn30-green);\n}\n\n\n/* =========================================================\n   PRICE + BUTTON\n========================================================= */\n\n.hn-new30__bottom {\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content:\n    space-between;\n\n  gap: 10px;\n\n  margin-top: 12px;\n\n  padding-top: 12px;\n\n  border-top:\n    1px\n    solid\n    rgba(49,85,72,.09);\n}\n\n\n.hn-new30__prices {\n\n  display: flex;\n\n  flex-direction:\n    column;\n\n  align-items:\n    flex-start;\n\n  gap: 1px;\n\n  min-width: 0;\n}\n\n\n.hn-new30__price {\n\n  color:\n    var(--hn30-heading);\n\n  font-size: 17px;\n\n  font-weight: 750;\n\n  line-height: 1.25;\n}\n\n\n.hn-new30__compare-price {\n\n  color:\n    var(--hn30-muted);\n\n  font-size: 11px;\n\n  line-height: 1.25;\n\n  text-decoration:\n    line-through;\n}\n\n\n/* =========================================================\n   ADD TO CART\n========================================================= */\n\n.hn-new30__add {\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 8px;\n\n  min-width: 118px;\n  min-height: 44px;\n\n  padding:\n    9px\n    15px;\n\n  border:\n    1px\n    solid\n    var(--hn30-green);\n\n  border-radius:\n    999px;\n\n  background:\n    linear-gradient(\n      135deg,\n      var(--hn30-green) 0%,\n      var(--hn30-green-dark) 100%\n    );\n\n  color:\n    #ffffff;\n\n  box-shadow:\n    0 7px 16px\n    rgba(32,63,53,.18),\n    inset 0 1px 0\n    rgba(255,255,255,.13);\n\n  font-family:\n    inherit;\n\n  font-size: 11px;\n\n  font-weight: 750;\n\n  line-height: 1;\n\n  white-space:\n    nowrap;\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    background .25s ease,\n    box-shadow .25s ease,\n    opacity .25s ease;\n}\n\n\n.hn-new30__add:hover {\n\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hn30-gold);\n\n  background:\n    linear-gradient(\n      135deg,\n      #c69a58 0%,\n      #a87738 100%\n    );\n\n  box-shadow:\n    0 9px 20px\n    rgba(145,101,48,.23);\n}\n\n\n.hn-new30__add:focus-visible {\n\n  outline:\n    2px\n    solid\n    var(--hn30-gold);\n\n  outline-offset:\n    3px;\n}\n\n\n.hn-new30__cart-symbol {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 20px;\n  height: 20px;\n\n  flex:\n    0\n    0\n    20px;\n\n  border-radius:\n    50%;\n\n  background:\n    rgba(255,255,255,.14);\n}\n\n\n.hn-new30__cart-symbol svg {\n\n  width: 12px;\n  height: 12px;\n\n  fill: none;\n\n  stroke:\n    currentColor;\n\n  stroke-width:\n    1.8;\n\n  stroke-linecap:\n    round;\n\n  stroke-linejoin:\n    round;\n}\n\n\n.hn-new30__add.is-loading {\n\n  pointer-events:\n    none;\n\n  opacity:\n    .62;\n}\n\n\n.hn-new30__add.is-added {\n\n  border-color:\n    #4f8062;\n\n  background:\n    #4f8062;\n}\n\n\n.hn-new30__add:disabled {\n\n  min-width:\n    105px;\n\n  transform:\n    none;\n\n  border-color:\n    #d2cec4;\n\n  background:\n    #d2cec4;\n\n  color:\n    #716e67;\n\n  box-shadow:\n    none;\n\n  cursor:\n    not-allowed;\n\n  opacity:\n    .9;\n}\n\n\n/* =========================================================\n   LOADING\n========================================================= */\n\n.hn-new30__main-loading {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 11px;\n\n  min-height: 210px;\n\n  color:\n    var(--hn30-text);\n\n  font-size: 13px;\n}\n\n\n.hn-new30__loader {\n\n  width: 23px;\n  height: 23px;\n\n  border:\n    3px\n    solid\n    rgba(49,85,72,.16);\n\n  border-top-color:\n    var(--hn30-green);\n\n  border-radius:\n    50%;\n\n  animation:\n    hnNew30Spin\n    .8s\n    linear\n    infinite;\n}\n\n\n@keyframes hnNew30Spin {\n\n  to {\n    transform:\n      rotate(360deg);\n  }\n\n}\n\n\n/* =========================================================\n   EMPTY\n========================================================= */\n\n.hn-new30__empty {\n\n  padding:\n    35px\n    20px;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius:\n    16px;\n\n  background:\n    #ffffff;\n\n  color:\n    var(--hn30-text);\n\n  font-size: 13px;\n\n  line-height: 1.6;\n\n  text-align:\n    center;\n}\n\n\n/* =========================================================\n   TOAST\n========================================================= */\n\n.hn-new30__toast {\n\n  position: fixed;\n\n  right: 20px;\n  bottom: 20px;\n\n  z-index: 999999;\n\n  display: flex;\n\n  align-items: center;\n\n  gap: 10px;\n\n  max-width:\n    min(\n      420px,\n      calc(100vw - 30px)\n    );\n\n  padding:\n    13px\n    15px;\n\n  border:\n    1px\n    solid\n    rgba(255,255,255,.14);\n\n  border-radius:\n    13px;\n\n  background:\n    rgba(32,63,53,.97);\n\n  color:\n    #ffffff;\n\n  box-shadow:\n    0 17px 42px\n    rgba(0,0,0,.22);\n\n  opacity: 0;\n\n  visibility:\n    hidden;\n\n  transform:\n    translateY(14px);\n\n  transition:\n    opacity .3s ease,\n    visibility .3s ease,\n    transform .3s ease;\n}\n\n\n.hn-new30__toast.is-visible {\n\n  opacity: 1;\n\n  visibility:\n    visible;\n\n  transform:\n    translateY(0);\n}\n\n\n.hn-new30__toast-icon {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 25px;\n  height: 25px;\n\n  flex:\n    0\n    0\n    25px;\n\n  border-radius:\n    50%;\n\n  background:\n    rgba(255,255,255,.14);\n\n  color:\n    #f0cb8a;\n\n  font-size: 13px;\n\n  font-weight: 800;\n}\n\n\n.hn-new30__toast-message {\n\n  font-size: 12px;\n\n  font-weight: 650;\n\n  line-height: 1.4;\n}\n\n\n.hn-new30__toast a {\n\n  margin-left:\n    auto;\n\n  color:\n    #f3ce8c;\n\n  font-size: 11px;\n\n  font-weight: 750;\n\n  white-space:\n    nowrap;\n\n  text-decoration:\n    underline;\n\n  text-underline-offset:\n    3px;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 900px) {\n\n  .hn-new30 {\n    padding:\n      32px\n      0\n      38px;\n  }\n\n\n  .hn-new30__inner {\n    padding:\n      0\n      22px;\n  }\n\n\n  .hn-new30__header {\n    margin-bottom:\n      20px;\n  }\n\n\n  .hn-new30__divider {\n    margin-top:\n      23px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 580px) {\n\n  .hn-new30 {\n\n    --hn30-gap:\n      14px;\n\n    margin-bottom:\n      20px;\n\n    padding:\n      28px\n      0\n      32px;\n  }\n\n\n  .hn-new30__inner {\n\n    padding:\n      0\n      14px;\n  }\n\n\n  .hn-new30__header {\n\n    margin-bottom:\n      17px;\n  }\n\n\n  .hn-new30__eyebrow {\n\n    margin-bottom:\n      7px;\n\n    font-size:\n      9px;\n\n    letter-spacing:\n      1.35px;\n  }\n\n\n  .hn-new30__eyebrow::before,\n  .hn-new30__eyebrow::after {\n\n    width:\n      20px;\n  }\n\n\n  .hn-new30__title {\n\n    font-size:\n      29px;\n  }\n\n\n  .hn-new30__description {\n\n    margin-top:\n      8px;\n\n    font-size:\n      12.5px;\n\n    line-height:\n      1.55;\n  }\n\n\n  .hn-new30__controls {\n\n    margin-bottom:\n      14px;\n  }\n\n\n  .hn-new30__arrow {\n\n    width:\n      44px;\n\n    height:\n      44px;\n\n    min-width:\n      44px;\n\n    min-height:\n      44px;\n  }\n\n\n  .hn-new30__divider {\n\n    margin:\n      21px\n      0\n      15px;\n  }\n\n\n  .hn-new30__divider span {\n\n    width:\n      82%;\n  }\n\n\n  .hn-new30__card {\n\n    border-radius:\n      16px;\n  }\n\n\n  .hn-new30__content {\n\n    padding:\n      13px\n      13px\n      14px;\n  }\n\n\n  .hn-new30__product-title {\n\n    min-height:\n      42px;\n\n    font-size:\n      16px;\n  }\n\n\n  .hn-new30__bottom {\n\n    margin-top:\n      10px;\n\n    padding-top:\n      10px;\n  }\n\n\n  .hn-new30__price {\n\n    font-size:\n      16px;\n  }\n\n\n  .hn-new30__add {\n\n    min-width:\n      112px;\n\n    min-height:\n      44px;\n\n    padding:\n      8px\n      12px;\n\n    font-size:\n      10.5px;\n  }\n\n\n  .hn-new30__toast {\n\n    right:\n      14px;\n\n    bottom:\n      14px;\n  }\n\n}\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media (max-width: 370px) {\n\n  .hn-new30__add {\n\n    min-width:\n      94px;\n\n    padding:\n      8px\n      10px;\n  }\n\n\n  .hn-new30__cart-symbol {\n\n    display:\n      none;\n  }\n\n}\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hn-new30__track,\n  .hn-new30__card,\n  .hn-new30__image,\n  .hn-new30__arrow,\n  .hn-new30__add {\n\n    transition-duration:\n      .01ms !important;\n  }\n\n\n  .hn-new30__loader {\n\n    animation:\n      none;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n     INITIALIZE SECTION\n  ===================================================== */\n\n  function initialiseNewThirtySection(root) {\n\n    if (\n      !root ||\n      root.dataset.initialised === \"true\"\n    ) {\n      return;\n    }\n\n\n    root.dataset.initialised =\n      \"true\";\n\n\n    const mainLoading =\n      root.querySelector(\n        \".hn-new30__main-loading\"\n      );\n\n\n    const emptyMessage =\n      root.querySelector(\n        \".hn-new30__empty\"\n      );\n\n\n    const divider =\n      root.querySelector(\n        \".hn-new30__divider\"\n      );\n\n\n    const carousels =\n      Array.from(\n        root.querySelectorAll(\n          \".hn-new30__carousel\"\n        )\n      );\n\n\n    const toast =\n      root.querySelector(\n        \".hn-new30__toast\"\n      );\n\n\n    const toastMessage =\n      root.querySelector(\n        \".hn-new30__toast-message\"\n      );\n\n\n    const toastCartLink =\n      root.querySelector(\n        \".hn-new30__toast a\"\n      );\n\n\n    const topCount =\n      Math.min(\n        Math.max(\n          Number(\n            root.dataset.topCount || 15\n          ),\n          1\n        ),\n        30\n      );\n\n\n    const bottomCount =\n      Math.min(\n        Math.max(\n          Number(\n            root.dataset.bottomCount || 15\n          ),\n          1\n        ),\n        30\n      );\n\n\n    const totalProductCount =\n      Math.min(\n        topCount + bottomCount,\n        30\n      );\n\n\n    const shopRoot =\n      window.Shopify &&\n      window.Shopify.routes &&\n      window.Shopify.routes.root\n        ? window.Shopify.routes.root\n        : \"/\";\n\n\n    const activeCurrency =\n      window.Shopify &&\n      window.Shopify.currency &&\n      window.Shopify.currency.active\n        ? window.Shopify.currency.active\n        : \"INR\";\n\n\n    const storeLanguage =\n      document.documentElement.lang ||\n      \"en-IN\";\n\n\n    const reducedMotion =\n      window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      ).matches;\n\n\n    let toastTimer =\n      null;\n\n\n    /* ===================================================\n       CREATE STORE URL\n    =================================================== */\n\n    function createStoreUrl(path) {\n\n      return (\n        shopRoot +\n        String(path || \"\")\n          .replace(/^\\/+/, \"\")\n      );\n\n    }\n\n\n    /* ===================================================\n       ESCAPE HTML\n    =================================================== */\n\n    function escapeHtml(value) {\n\n      return String(\n        value == null\n          ? \"\"\n          : value\n      )\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#039;\");\n\n    }\n\n\n    /* ===================================================\n       FORMAT MONEY\n    =================================================== */\n\n    function formatMoney(value) {\n\n      const amount =\n        Number(value || 0);\n\n\n      try {\n\n        return new Intl.NumberFormat(\n          storeLanguage,\n          {\n            style: \"currency\",\n            currency: activeCurrency,\n\n            maximumFractionDigits:\n              amount % 1 === 0\n                ? 0\n                : 2\n          }\n        ).format(amount);\n\n\n      } catch (error) {\n\n        return (\n          activeCurrency +\n          \" \" +\n          amount.toFixed(2)\n        );\n\n      }\n\n    }\n\n\n    /* ===================================================\n       PRODUCT TIMESTAMP\n    =================================================== */\n\n    function getProductTimestamp(product) {\n\n      if (!product) {\n        return 0;\n      }\n\n\n      const possibleDates = [\n\n        product.created_at,\n        product.published_at,\n        product.updated_at\n\n      ];\n\n\n      for (\n        const dateValue\n        of possibleDates\n      ) {\n\n        if (!dateValue) {\n          continue;\n        }\n\n\n        const timestamp =\n          new Date(\n            dateValue\n          ).getTime();\n\n\n        if (\n          !Number.isNaN(\n            timestamp\n          )\n        ) {\n          return timestamp;\n        }\n\n      }\n\n\n      return Number(\n        product.id || 0\n      );\n\n    }\n\n\n    /* ===================================================\n       SORT NEWEST PRODUCTS\n    =================================================== */\n\n    function sortNewestProducts(productList) {\n\n      return productList\n        .slice()\n        .sort(\n          function (\n            firstProduct,\n            secondProduct\n          ) {\n\n            const timestampDifference =\n              getProductTimestamp(\n                secondProduct\n              ) -\n              getProductTimestamp(\n                firstProduct\n              );\n\n\n            if (\n              timestampDifference !== 0\n            ) {\n\n              return timestampDifference;\n\n            }\n\n\n            return (\n              Number(\n                secondProduct.id || 0\n              ) -\n              Number(\n                firstProduct.id || 0\n              )\n            );\n\n          }\n        );\n\n    }\n\n\n    /* ===================================================\n       REMOVE DUPLICATES\n    =================================================== */\n\n    function removeDuplicateProducts(productList) {\n\n      const uniqueProducts =\n        new Map();\n\n\n      productList.forEach(\n        function (product) {\n\n          if (!product) {\n            return;\n          }\n\n\n          const uniqueKey =\n            product.id ||\n            product.handle;\n\n\n          if (!uniqueKey) {\n            return;\n          }\n\n\n          uniqueProducts.set(\n            String(uniqueKey),\n            product\n          );\n\n        }\n      );\n\n\n      return Array.from(\n        uniqueProducts.values()\n      );\n\n    }\n\n\n    /* ===================================================\n       CHECK ORDER\n    =================================================== */\n\n    function looksNewestFirst(productList) {\n\n      let previousTimestamp =\n        Number.POSITIVE_INFINITY;\n\n\n      let checkedProducts =\n        0;\n\n\n      for (\n        const product\n        of productList\n      ) {\n\n        const currentTimestamp =\n          getProductTimestamp(\n            product\n          );\n\n\n        if (!currentTimestamp) {\n          continue;\n        }\n\n\n        if (\n          currentTimestamp >\n          previousTimestamp\n        ) {\n\n          return false;\n\n        }\n\n\n        previousTimestamp =\n          currentTimestamp;\n\n\n        checkedProducts +=\n          1;\n\n\n        if (\n          checkedProducts >= 40\n        ) {\n          break;\n        }\n\n      }\n\n\n      return (\n        checkedProducts >= 2\n      );\n\n    }\n\n\n    /* ===================================================\n       REQUEST PRODUCTS\n    =================================================== */\n\n    async function requestProductPage(\n      basePath,\n      pageNumber,\n      includeSort\n    ) {\n\n      const separator =\n        basePath.indexOf(\"?\") === -1\n          ? \"?\"\n          : \"&\";\n\n\n      /*\n       * PERFORMANCE OPTIMIZATION:\n       *\n       * This section only displays 30 products.\n       * We request 40 products to keep a small safety buffer\n       * while avoiding the previous 250-product payload.\n       *\n       * Cache-busting and cache:\"no-store\" have also been removed\n       * so the browser/CDN can reuse the response when appropriate.\n       */\n\n      const query = [\n\n        \"limit=40\",\n\n        \"page=\" +\n        pageNumber,\n\n        includeSort\n          ? \"sort_by=created-descending\"\n          : \"\"\n\n      ]\n        .filter(Boolean)\n        .join(\"&\");\n\n\n      const response =\n        await fetch(\n          createStoreUrl(\n            basePath +\n            separator +\n            query\n          ),\n          {\n            method: \"GET\",\n\n            credentials:\n              \"same-origin\",\n\n            headers: {\n\n              \"Accept\":\n                \"application/json\",\n\n              \"X-Requested-With\":\n                \"XMLHttpRequest\"\n\n            }\n          }\n        );\n\n\n      if (!response.ok) {\n\n        throw new Error(\n          \"Product request failed with status \" +\n          response.status +\n          \".\"\n        );\n\n      }\n\n\n      const data =\n        await response.json();\n\n\n      if (\n        !data ||\n        !Array.isArray(\n          data.products\n        )\n      ) {\n\n        throw new Error(\n          \"Shopify returned an invalid product response.\"\n        );\n\n      }\n\n\n      return data.products;\n\n    }\n\n\n    /* ===================================================\n       FETCH PRODUCT SOURCE\n    =================================================== */\n\n    async function fetchProductsFromSource(\n      basePath,\n      includeSort\n    ) {\n\n      const pageSize =\n        40;\n\n\n      const maximumPages =\n        1;\n\n\n      const collectedProducts =\n        [];\n\n\n      for (\n        let pageNumber = 1;\n        pageNumber <= maximumPages;\n        pageNumber += 1\n      ) {\n\n        const pageProducts =\n          await requestProductPage(\n            basePath,\n            pageNumber,\n            includeSort\n          );\n\n\n        if (\n          !pageProducts.length\n        ) {\n          break;\n        }\n\n\n        collectedProducts.push.apply(\n          collectedProducts,\n          pageProducts\n        );\n\n\n        if (\n          pageNumber === 1 &&\n          pageProducts.length === pageSize &&\n          looksNewestFirst(\n            pageProducts\n          )\n        ) {\n\n          break;\n\n        }\n\n\n        if (\n          pageProducts.length < pageSize\n        ) {\n\n          break;\n\n        }\n\n      }\n\n\n      return removeDuplicateProducts(\n        collectedProducts\n      );\n\n    }\n\n\n    /* ===================================================\n       FETCH NEWEST PRODUCTS\n    =================================================== */\n\n    async function fetchNewestProducts() {\n\n      const sources = [\n\n        {\n          path:\n            \"collections/all/products.json\",\n\n          includeSort:\n            true\n        },\n\n        {\n          path:\n            \"products.json\",\n\n          includeSort:\n            false\n        }\n\n      ];\n\n\n      let finalError =\n        null;\n\n\n      for (\n        const source\n        of sources\n      ) {\n\n        try {\n\n          const products =\n            await fetchProductsFromSource(\n              source.path,\n              source.includeSort\n            );\n\n\n          if (\n            products.length\n          ) {\n\n            console.info(\n              \"Hertha Nest latest-products section loaded \" +\n              products.length +\n              \" unique published products.\"\n            );\n\n\n            return products;\n\n          }\n\n\n        } catch (error) {\n\n          finalError =\n            error;\n\n\n          console.warn(\n            \"Hertha Nest product source failed:\",\n            source.path,\n            error\n          );\n\n        }\n\n      }\n\n\n      throw (\n        finalError ||\n        new Error(\n          \"Products could not be loaded.\"\n        )\n      );\n\n    }\n\n\n    /* ===================================================\n       AVAILABLE VARIANT\n    =================================================== */\n\n    function getAvailableVariant(product) {\n\n      if (\n        !product ||\n        !Array.isArray(\n          product.variants\n        ) ||\n        !product.variants.length\n      ) {\n\n        return null;\n\n      }\n\n\n      return (\n        product.variants.find(\n          function (variant) {\n\n            return (\n              variant.available === true\n            );\n\n          }\n        ) ||\n        product.variants[0]\n      );\n\n    }\n\n\n    /* ===================================================\n       ORIGINAL IMAGE SOURCE\n    =================================================== */\n\n    function getImageSource(\n      product,\n      variant\n    ) {\n\n      if (\n        variant &&\n        variant.featured_image &&\n        variant.featured_image.src\n      ) {\n\n        return (\n          variant.featured_image.src\n        );\n\n      }\n\n\n      if (\n        product.featured_image &&\n        typeof product.featured_image ===\n        \"string\"\n      ) {\n\n        return (\n          product.featured_image\n        );\n\n      }\n\n\n      if (\n        product.featured_image &&\n        product.featured_image.src\n      ) {\n\n        return (\n          product.featured_image.src\n        );\n\n      }\n\n\n      if (\n        Array.isArray(\n          product.images\n        ) &&\n        product.images.length\n      ) {\n\n        return (\n          typeof product.images[0] ===\n          \"string\"\n\n            ? product.images[0]\n\n            : product.images[0].src\n        );\n\n      }\n\n\n      return \"\";\n\n    }\n\n\n    /* ===================================================\n       RESPONSIVE IMAGE URL\n\n       Replaces any existing Shopify ?width=\n       instead of continuously appending parameters.\n    =================================================== */\n\n    function getImageUrlAtWidth(\n      imageUrl,\n      width\n    ) {\n\n      if (!imageUrl) {\n        return \"\";\n      }\n\n\n      try {\n\n        const url =\n          new URL(\n            imageUrl,\n            window.location.origin\n          );\n\n\n        url.searchParams.set(\n          \"width\",\n          String(width)\n        );\n\n\n        return url.toString();\n\n\n      } catch (error) {\n\n\n        const widthPattern =\n          /([?&])width=\\d+/i;\n\n\n        if (\n          widthPattern.test(\n            imageUrl\n          )\n        ) {\n\n          return imageUrl.replace(\n            widthPattern,\n            \"$1width=\" + width\n          );\n\n        }\n\n\n        return (\n          imageUrl +\n          (\n            imageUrl.indexOf(\"?\") === -1\n              ? \"?\"\n              : \"&\"\n          ) +\n          \"width=\" +\n          width\n        );\n\n      }\n\n    }\n\n\n    /* ===================================================\n       RESPONSIVE SRCSET\n\n       Browser chooses only the width it needs.\n    =================================================== */\n\n    function createImageSrcSet(\n      imageUrl\n    ) {\n\n      if (!imageUrl) {\n        return \"\";\n      }\n\n\n      const widths = [\n\n        240,\n        320,\n        400,\n        480,\n        600\n\n      ];\n\n\n      return widths\n        .map(\n          function (width) {\n\n            return (\n              escapeHtml(\n                getImageUrlAtWidth(\n                  imageUrl,\n                  width\n                )\n              ) +\n              \" \" +\n              width +\n              \"w\"\n            );\n\n          }\n        )\n        .join(\", \");\n\n    }\n\n\n    /* ===================================================\n       PRODUCT CARD\n    =================================================== */\n\n    function createProductCard(\n      product,\n      isDuplicate\n    ) {\n\n      const variant =\n        getAvailableVariant(\n          product\n        );\n\n\n      const productUrl =\n        createStoreUrl(\n          \"products/\" +\n          encodeURIComponent(\n            product.handle || \"\"\n          )\n        );\n\n\n      const productTitle =\n        escapeHtml(\n          product.title ||\n          \"Product\"\n        );\n\n\n      const vendor =\n        escapeHtml(\n          product.vendor ||\n          \"\"\n        );\n\n\n      /*\n       * ==================================================\n       * RESPONSIVE IMAGE FIX\n       * ==================================================\n       *\n       * Previous:\n       * Every card received width=800.\n       *\n       * New:\n       * src fallback = 480px\n       * srcset = 240–600px\n       *\n       * Browser chooses correct width.\n       */\n\n      const originalImageSource =\n        getImageSource(\n          product,\n          variant\n        );\n\n\n      const imageSource =\n        getImageUrlAtWidth(\n          originalImageSource,\n          480\n        );\n\n\n      const imageSrcSet =\n        createImageSrcSet(\n          originalImageSource\n        );\n\n\n      const available =\n        Boolean(\n          variant &&\n          variant.available !== false\n        );\n\n\n      const price =\n        variant\n          ? formatMoney(\n              variant.price\n            )\n          : \"\";\n\n\n      const comparePrice =\n\n        variant &&\n\n        Number(\n          variant.compare_at_price\n        ) >\n\n        Number(\n          variant.price\n        )\n\n          ? formatMoney(\n              variant.compare_at_price\n            )\n\n          : \"\";\n\n\n      const duplicateAttributes =\n        isDuplicate\n          ? ' aria-hidden=\"true\"'\n          : \"\";\n\n\n      const duplicateTabIndex =\n        isDuplicate\n          ? ' tabindex=\"-1\"'\n          : \"\";\n\n\n      /* =================================================\n         RESPONSIVE PRODUCT IMAGE MARKUP\n      ================================================= */\n\n      const imageMarkup =\n        imageSource\n\n          ? (\n\n            '<img' +\n\n            ' class=\"hn-new30__image\"' +\n\n            ' src=\"' +\n            escapeHtml(\n              imageSource\n            ) +\n            '\"' +\n\n            ' srcset=\"' +\n            imageSrcSet +\n            '\"' +\n\n            ' sizes=\"' +\n\n              '(max-width: 580px) calc(100vw - 28px), ' +\n\n              '(max-width: 820px) calc((100vw - 58px) / 2), ' +\n\n              '(max-width: 1120px) calc((100vw - 84px) / 3), ' +\n\n              '360px' +\n\n            '\"' +\n\n            ' alt=\"' +\n            productTitle +\n            '\"' +\n\n            ' loading=\"lazy\"' +\n\n            ' decoding=\"async\"' +\n\n            ' width=\"600\"' +\n\n            ' height=\"600\"' +\n\n            '>'\n\n          )\n\n          : (\n\n            '<div class=\"hn-new30__image-placeholder\">' +\n\n            productTitle +\n\n            '</div>'\n\n          );\n\n\n      const comparePriceMarkup =\n        comparePrice\n\n          ? (\n\n            '<span class=\"hn-new30__compare-price\">' +\n\n            comparePrice +\n\n            '</span>'\n\n          )\n\n          : \"\";\n\n\n      /* =================================================\n         ADD TO CART BUTTON\n      ================================================= */\n\n      const addButtonMarkup =\n        variant &&\n        available\n\n          ? (\n\n            '<button' +\n\n            ' type=\"button\"' +\n\n            ' class=\"hn-new30__add\"' +\n\n            ' data-variant-id=\"' +\n            escapeHtml(\n              variant.id\n            ) +\n            '\"' +\n\n            ' data-product-title=\"' +\n            productTitle +\n            '\"' +\n\n            duplicateTabIndex +\n\n            '>' +\n\n\n              '<span class=\"hn-new30__cart-symbol\">' +\n\n                '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n\n                  '<path d=\"M6 7h12l-1 13H7L6 7Z\"></path>' +\n\n                  '<path d=\"M9 9V6a3 3 0 0 1 6 0v3\"></path>' +\n\n                '</svg>' +\n\n              '</span>' +\n\n\n              '<span class=\"hn-new30__button-text\">' +\n\n                'Add to cart' +\n\n              '</span>' +\n\n\n            '</button>'\n\n          )\n\n          : (\n\n            '<button' +\n\n            ' type=\"button\"' +\n\n            ' class=\"hn-new30__add\"' +\n\n            ' disabled' +\n\n            duplicateTabIndex +\n\n            '>' +\n\n              '<span class=\"hn-new30__button-text\">' +\n\n                'Sold out' +\n\n              '</span>' +\n\n            '</button>'\n\n          );\n\n\n      return (\n\n        '<article class=\"hn-new30__card\"' +\n        duplicateAttributes +\n        '>' +\n\n\n          '<a' +\n\n          ' href=\"' +\n          productUrl +\n          '\"' +\n\n          ' class=\"hn-new30__image-link\"' +\n\n          duplicateTabIndex +\n\n          '>' +\n\n\n            '<span class=\"hn-new30__badge\">' +\n\n              'Just Unveiled' +\n\n            '</span>' +\n\n\n            imageMarkup +\n\n\n          '</a>' +\n\n\n          '<div class=\"hn-new30__content\">' +\n\n\n            (\n              vendor\n\n                ? (\n\n                  '<div class=\"hn-new30__vendor\">' +\n\n                  vendor +\n\n                  '</div>'\n\n                )\n\n                : ''\n            ) +\n\n\n            '<h3 class=\"hn-new30__product-title\">' +\n\n\n              '<a' +\n\n              ' href=\"' +\n              productUrl +\n              '\"' +\n\n              duplicateTabIndex +\n\n              '>' +\n\n                productTitle +\n\n              '</a>' +\n\n\n            '</h3>' +\n\n\n            '<div class=\"hn-new30__bottom\">' +\n\n\n              '<div class=\"hn-new30__prices\">' +\n\n                '<span class=\"hn-new30__price\">' +\n\n                  price +\n\n                '</span>' +\n\n                comparePriceMarkup +\n\n              '</div>' +\n\n\n              addButtonMarkup +\n\n\n            '</div>' +\n\n\n          '</div>' +\n\n\n        '</article>'\n\n      );\n\n    }\n\n\n    /* ===================================================\n       CREATE CAROUSEL\n    =================================================== */\n\n    function createCarousel(\n      carousel,\n      productList,\n      autoplayDelay\n    ) {\n\n      if (\n        !carousel ||\n        !productList.length\n      ) {\n\n        return null;\n\n      }\n\n\n      const viewport =\n        carousel.querySelector(\n          \".hn-new30__viewport\"\n        );\n\n\n      const track =\n        carousel.querySelector(\n          \".hn-new30__track\"\n        );\n\n\n      const previousButton =\n        carousel.querySelector(\n          \".hn-new30__previous\"\n        );\n\n\n      const nextButton =\n        carousel.querySelector(\n          \".hn-new30__next\"\n        );\n\n\n      const controls =\n        carousel.querySelector(\n          \".hn-new30__controls\"\n        );\n\n\n      const productCount =\n        productList.length;\n\n\n      const originalCards =\n        productList.map(\n          function (product) {\n\n            return createProductCard(\n              product,\n              false\n            );\n\n          }\n        ).join(\"\");\n\n\n      /*\n       * Infinite-loop optimization:\n       * only clone the first 4 cards because desktop shows\n       * a maximum of 4 products at once. Previously all 15\n       * products were duplicated, creating 30 cards per row.\n       */\n      const duplicateCount =\n        Math.min(\n          4,\n          productCount\n        );\n\n\n      const duplicateCards =\n        productCount > 1\n\n          ? productList\n              .slice(\n                0,\n                duplicateCount\n              )\n              .map(\n                function (product) {\n\n                  return createProductCard(\n                    product,\n                    true\n                  );\n\n                }\n              )\n              .join(\"\")\n\n          : \"\";\n\n\n      track.innerHTML =\n        originalCards +\n        duplicateCards;\n\n\n      carousel.hidden =\n        false;\n\n\n      if (\n        productCount <= 1\n      ) {\n\n        controls.hidden =\n          true;\n\n      }\n\n\n      const state = {\n\n        index: 0,\n\n        cardWidth: 0,\n\n        gap: 20,\n\n        autoplayTimer: null,\n\n        resetTimer: null,\n\n        resizeTimer: null,\n\n        touchStartX: 0,\n\n        touchEndX: 0,\n\n        isVisible: true\n\n      };\n\n\n      const transitionDuration =\n        550;\n\n\n      /* =================================================\n         PRODUCTS PER VIEW\n      ================================================= */\n\n      function getProductsPerView() {\n\n        const viewportWidth =\n          viewport.clientWidth;\n\n\n        if (\n          viewportWidth <= 580\n        ) {\n\n          return 1;\n\n        }\n\n\n        if (\n          viewportWidth <= 820\n        ) {\n\n          return 2;\n\n        }\n\n\n        if (\n          viewportWidth <= 1120\n        ) {\n\n          return 3;\n\n        }\n\n\n        return 4;\n\n      }\n\n\n      /* =================================================\n         POSITION\n      ================================================= */\n\n      function setPosition(\n        animate\n      ) {\n\n        track.style.transition =\n          animate &&\n          !reducedMotion\n\n            ? \"transform .55s cubic-bezier(.22,.61,.36,1)\"\n\n            : \"none\";\n\n\n        track.style.transform =\n\n          \"translate3d(-\" +\n\n          state.index *\n          (\n            state.cardWidth +\n            state.gap\n          ) +\n\n          \"px,0,0)\";\n\n      }\n\n\n      /* =================================================\n         CARD WIDTH\n      ================================================= */\n\n      function updateCardSizes() {\n\n        const computedStyles =\n          window.getComputedStyle(\n            track\n          );\n\n\n        state.gap =\n          parseFloat(\n\n            computedStyles.columnGap ||\n\n            computedStyles.gap ||\n\n            \"20\"\n\n          ) || 20;\n\n\n        const productsPerView =\n          Math.max(\n\n            1,\n\n            Math.min(\n\n              productCount,\n\n              getProductsPerView()\n\n            )\n\n          );\n\n\n        state.cardWidth =\n\n          (\n            viewport.clientWidth -\n\n            state.gap *\n            (\n              productsPerView - 1\n            )\n          )\n\n          /\n\n          productsPerView;\n\n\n        track\n          .querySelectorAll(\n            \".hn-new30__card\"\n          )\n          .forEach(\n            function (card) {\n\n              card.style.width =\n                state.cardWidth +\n                \"px\";\n\n            }\n          );\n\n\n        setPosition(\n          false\n        );\n\n      }\n\n\n      /* =================================================\n         NEXT\n      ================================================= */\n\n      function moveNext() {\n\n        if (\n          productCount <= 1\n        ) {\n          return;\n        }\n\n\n        window.clearTimeout(\n          state.resetTimer\n        );\n\n\n        state.index +=\n          1;\n\n\n        setPosition(\n          true\n        );\n\n\n        if (\n          state.index >=\n          productCount\n        ) {\n\n          state.resetTimer =\n            window.setTimeout(\n              function () {\n\n                state.index =\n                  0;\n\n\n                setPosition(\n                  false\n                );\n\n              },\n\n              reducedMotion\n                ? 20\n                : transitionDuration + 40\n            );\n\n        }\n\n      }\n\n\n      /* =================================================\n         PREVIOUS\n      ================================================= */\n\n      function movePrevious() {\n\n        if (\n          productCount <= 1\n        ) {\n          return;\n        }\n\n\n        window.clearTimeout(\n          state.resetTimer\n        );\n\n\n        if (\n          state.index <= 0\n        ) {\n\n          state.index =\n            productCount;\n\n\n          setPosition(\n            false\n          );\n\n\n          window.requestAnimationFrame(\n            function () {\n\n              window.requestAnimationFrame(\n                function () {\n\n                  state.index =\n                    productCount - 1;\n\n\n                  setPosition(\n                    true\n                  );\n\n                }\n              );\n\n            }\n          );\n\n\n        } else {\n\n\n          state.index -=\n            1;\n\n\n          setPosition(\n            true\n          );\n\n        }\n\n      }\n\n\n      /* =================================================\n         AUTOPLAY\n      ================================================= */\n\n      function stopAutoplay() {\n\n        window.clearInterval(\n          state.autoplayTimer\n        );\n\n\n        state.autoplayTimer =\n          null;\n\n      }\n\n\n      function startAutoplay() {\n\n        stopAutoplay();\n\n\n        if (\n\n          reducedMotion ||\n\n          productCount <= 1 ||\n\n          !state.isVisible ||\n\n          document.hidden\n\n        ) {\n\n          return;\n\n        }\n\n\n        state.autoplayTimer =\n          window.setInterval(\n            moveNext,\n            autoplayDelay\n          );\n\n      }\n\n\n      /* =================================================\n         BUTTONS\n      ================================================= */\n\n      previousButton.addEventListener(\n        \"click\",\n        function () {\n\n          movePrevious();\n\n          startAutoplay();\n\n        }\n      );\n\n\n      nextButton.addEventListener(\n        \"click\",\n        function () {\n\n          moveNext();\n\n          startAutoplay();\n\n        }\n      );\n\n\n      /* =================================================\n         HOVER / FOCUS\n      ================================================= */\n\n      viewport.addEventListener(\n        \"mouseenter\",\n        stopAutoplay\n      );\n\n\n      viewport.addEventListener(\n        \"mouseleave\",\n        startAutoplay\n      );\n\n\n      viewport.addEventListener(\n        \"focusin\",\n        stopAutoplay\n      );\n\n\n      viewport.addEventListener(\n        \"focusout\",\n        startAutoplay\n      );\n\n\n      /* =================================================\n         MOBILE SWIPE\n      ================================================= */\n\n      viewport.addEventListener(\n        \"touchstart\",\n        function (event) {\n\n          state.touchStartX =\n            event.changedTouches[0]\n              .screenX;\n\n\n          stopAutoplay();\n\n        },\n        {\n          passive:\n            true\n        }\n      );\n\n\n      viewport.addEventListener(\n        \"touchend\",\n        function (event) {\n\n          state.touchEndX =\n            event.changedTouches[0]\n              .screenX;\n\n\n          const swipeDistance =\n\n            state.touchStartX -\n\n            state.touchEndX;\n\n\n          if (\n            Math.abs(\n              swipeDistance\n            ) > 45\n          ) {\n\n            if (\n              swipeDistance > 0\n            ) {\n\n              moveNext();\n\n            } else {\n\n              movePrevious();\n\n            }\n\n          }\n\n\n          startAutoplay();\n\n        },\n        {\n          passive:\n            true\n        }\n      );\n\n\n      /* =================================================\n         RESIZE\n      ================================================= */\n\n      window.addEventListener(\n        \"resize\",\n        function () {\n\n          window.clearTimeout(\n            state.resizeTimer\n          );\n\n\n          state.resizeTimer =\n            window.setTimeout(\n              updateCardSizes,\n              120\n            );\n\n        },\n        {\n          passive:\n            true\n        }\n      );\n\n\n      /* =================================================\n         PAGE VISIBILITY\n      ================================================= */\n\n      document.addEventListener(\n        \"visibilitychange\",\n        function () {\n\n          if (\n            document.hidden\n          ) {\n\n            stopAutoplay();\n\n          } else {\n\n            startAutoplay();\n\n          }\n\n        }\n      );\n\n\n      /* =================================================\n         SECTION VISIBILITY\n      ================================================= */\n\n      if (\n        \"IntersectionObserver\"\n        in window\n      ) {\n\n        const observer =\n          new IntersectionObserver(\n            function (entries) {\n\n              entries.forEach(\n                function (entry) {\n\n                  state.isVisible =\n                    entry.isIntersecting;\n\n\n                  if (\n                    state.isVisible\n                  ) {\n\n                    startAutoplay();\n\n                  } else {\n\n                    stopAutoplay();\n\n                  }\n\n                }\n              );\n\n            },\n            {\n              threshold:\n                0.12\n            }\n          );\n\n\n        observer.observe(\n          carousel\n        );\n\n      }\n\n\n      /* =================================================\n         INITIALIZE CAROUSEL\n      ================================================= */\n\n      window.requestAnimationFrame(\n        function () {\n\n          updateCardSizes();\n\n          setPosition(\n            false\n          );\n\n          startAutoplay();\n\n        }\n      );\n\n\n      return state;\n\n    }\n\n\n    /* ===================================================\n       TOAST\n    =================================================== */\n\n    function showToast(\n      message,\n      isError\n    ) {\n\n      if (\n        !toast ||\n        !toastMessage\n      ) {\n        return;\n      }\n\n\n      toastMessage.textContent =\n        message;\n\n\n      toast.style.background =\n        isError\n\n          ? \"rgba(132,48,48,.97)\"\n\n          : \"rgba(32,63,53,.97)\";\n\n\n      toast.classList.add(\n        \"is-visible\"\n      );\n\n\n      window.clearTimeout(\n        toastTimer\n      );\n\n\n      toastTimer =\n        window.setTimeout(\n          function () {\n\n            toast.classList.remove(\n              \"is-visible\"\n            );\n\n          },\n          3200\n        );\n\n    }\n\n\n    /* ===================================================\n       UPDATE CART COUNT\n    =================================================== */\n\n    function updateThemeCartCount(\n      itemCount\n    ) {\n\n      const selectors = [\n\n        \"[data-cart-count]\",\n\n        \".cart-count-bubble span[aria-hidden='true']\",\n\n        \".cart-count-number\",\n\n        \".cart-count\",\n\n        \"#CartCount\"\n\n      ];\n\n\n      document\n        .querySelectorAll(\n          selectors.join(\",\")\n        )\n        .forEach(\n          function (element) {\n\n            element.textContent =\n              itemCount;\n\n\n            element.hidden =\n              false;\n\n\n            element.removeAttribute(\n              \"hidden\"\n            );\n\n          }\n        );\n\n\n      document\n        .querySelectorAll(\n          \".cart-count-bubble\"\n        )\n        .forEach(\n          function (bubble) {\n\n            bubble.hidden =\n              false;\n\n\n            bubble.classList.remove(\n              \"hidden\"\n            );\n\n\n            bubble.removeAttribute(\n              \"hidden\"\n            );\n\n          }\n        );\n\n    }\n\n\n    /* ===================================================\n       CURRENT CART\n    =================================================== */\n\n    async function fetchCurrentCart() {\n\n      try {\n\n        const response =\n          await fetch(\n            createStoreUrl(\n              \"cart.js\"\n            ),\n            {\n              method:\n                \"GET\",\n\n              cache:\n                \"no-store\",\n\n              credentials:\n                \"same-origin\",\n\n              headers: {\n\n                \"Accept\":\n                  \"application/json\",\n\n                \"X-Requested-With\":\n                  \"XMLHttpRequest\"\n\n              }\n            }\n          );\n\n\n        if (\n          !response.ok\n        ) {\n\n          return null;\n\n        }\n\n\n        return await response.json();\n\n\n      } catch (error) {\n\n\n        return null;\n\n      }\n\n    }\n\n\n    /* ===================================================\n       THEME CART EVENTS\n    =================================================== */\n\n    function notifyThemeAboutCart(\n      cart\n    ) {\n\n      [\n        \"cart:updated\",\n        \"cart:refresh\",\n        \"cart:change\"\n      ].forEach(\n        function (eventName) {\n\n          document.dispatchEvent(\n            new CustomEvent(\n              eventName,\n              {\n                bubbles:\n                  true,\n\n                detail:\n                  {\n                    cart:\n                      cart\n                  }\n              }\n            )\n          );\n\n        }\n      );\n\n    }\n\n\n    /* ===================================================\n       ADD PRODUCT TO CART\n    =================================================== */\n\n    async function addProductToCart(\n      button\n    ) {\n\n      const variantId =\n        Number(\n          button.dataset.variantId\n        );\n\n\n      const productTitle =\n        button.dataset.productTitle ||\n        \"Product\";\n\n\n      if (\n        !variantId ||\n        button.classList.contains(\n          \"is-loading\"\n        )\n      ) {\n\n        return;\n\n      }\n\n\n      const buttonText =\n        button.querySelector(\n          \".hn-new30__button-text\"\n        );\n\n\n      const originalText =\n        buttonText\n          ? buttonText.textContent\n          : \"Add to cart\";\n\n\n      button.classList.add(\n        \"is-loading\"\n      );\n\n\n      if (\n        buttonText\n      ) {\n\n        buttonText.textContent =\n          \"Adding...\";\n\n      }\n\n\n      try {\n\n        const response =\n          await fetch(\n            createStoreUrl(\n              \"cart/add.js\"\n            ),\n            {\n              method:\n                \"POST\",\n\n              credentials:\n                \"same-origin\",\n\n              headers: {\n\n                \"Content-Type\":\n                  \"application/json\",\n\n                \"Accept\":\n                  \"application/json\",\n\n                \"X-Requested-With\":\n                  \"XMLHttpRequest\"\n\n              },\n\n              body:\n                JSON.stringify(\n                  {\n                    items: [\n                      {\n                        id:\n                          variantId,\n\n                        quantity:\n                          1\n                      }\n                    ]\n                  }\n                )\n            }\n          );\n\n\n        const data =\n          await response.json();\n\n\n        if (\n          !response.ok\n        ) {\n\n          throw new Error(\n\n            data.description ||\n\n            data.message ||\n\n            \"This product could not be added.\"\n\n          );\n\n        }\n\n\n        button.classList.remove(\n          \"is-loading\"\n        );\n\n\n        button.classList.add(\n          \"is-added\"\n        );\n\n\n        if (\n          buttonText\n        ) {\n\n          buttonText.textContent =\n            \"Added\";\n\n        }\n\n\n        showToast(\n\n          productTitle +\n          \" added to your cart.\",\n\n          false\n\n        );\n\n\n        window.setTimeout(\n          async function () {\n\n            const cart =\n              await fetchCurrentCart();\n\n\n            if (\n              cart\n            ) {\n\n              updateThemeCartCount(\n                cart.item_count\n              );\n\n\n              notifyThemeAboutCart(\n                cart\n              );\n\n            }\n\n          },\n          300\n        );\n\n\n        window.setTimeout(\n          function () {\n\n            button.classList.remove(\n              \"is-added\"\n            );\n\n\n            if (\n              buttonText\n            ) {\n\n              buttonText.textContent =\n                originalText;\n\n            }\n\n          },\n          1900\n        );\n\n\n      } catch (error) {\n\n\n        button.classList.remove(\n          \"is-loading\"\n        );\n\n\n        if (\n          buttonText\n        ) {\n\n          buttonText.textContent =\n            originalText;\n\n        }\n\n\n        showToast(\n\n          error.message ||\n          \"This product could not be added.\",\n\n          true\n\n        );\n\n      }\n\n    }\n\n\n    /* ===================================================\n       ADD TO CART CLICK\n    =================================================== */\n\n    root.addEventListener(\n      \"click\",\n      function (event) {\n\n        const addButton =\n          event.target.closest(\n            \".hn-new30__add\"\n          );\n\n\n        if (\n          !addButton ||\n          addButton.disabled\n        ) {\n\n          return;\n\n        }\n\n\n        addProductToCart(\n          addButton\n        );\n\n      }\n    );\n\n\n    if (\n      toastCartLink\n    ) {\n\n      toastCartLink.href =\n        createStoreUrl(\n          \"cart\"\n        );\n\n    }\n\n\n    /* ===================================================\n       LOAD PRODUCTS\n    =================================================== */\n\n    fetchNewestProducts()\n\n      .then(\n        function (fetchedProducts) {\n\n          const newestThirty =\n            sortNewestProducts(\n              fetchedProducts\n            ).slice(\n              0,\n              totalProductCount\n            );\n\n\n          const topProducts =\n            newestThirty.slice(\n              0,\n              topCount\n            );\n\n\n          const bottomProducts =\n            newestThirty.slice(\n              topCount,\n              topCount +\n              bottomCount\n            );\n\n\n          if (\n            mainLoading\n          ) {\n\n            mainLoading.hidden =\n              true;\n\n          }\n\n\n          if (\n            !topProducts.length\n          ) {\n\n            if (\n              emptyMessage\n            ) {\n\n              emptyMessage.hidden =\n                false;\n\n            }\n\n            return;\n\n          }\n\n\n          createCarousel(\n\n            carousels[0],\n\n            topProducts,\n\n            3400\n\n          );\n\n\n          if (\n            bottomProducts.length &&\n            carousels[1]\n          ) {\n\n            if (\n              divider\n            ) {\n\n              divider.hidden =\n                false;\n\n            }\n\n\n            createCarousel(\n\n              carousels[1],\n\n              bottomProducts,\n\n              3900\n\n            );\n\n          }\n\n        }\n      )\n\n      .catch(\n        function (error) {\n\n          console.error(\n            \"Hertha Nest latest 30 products error:\",\n            error\n          );\n\n\n          if (\n            mainLoading\n          ) {\n\n            mainLoading.hidden =\n              true;\n\n          }\n\n\n          if (\n            emptyMessage\n          ) {\n\n            emptyMessage.hidden =\n              false;\n\n\n            emptyMessage.textContent =\n\n              \"The newest products could not be loaded. Please refresh the page.\";\n\n          }\n\n        }\n      );\n\n  }\n\n\n  /* =====================================================\n     INITIALIZE ALL INSTANCES\n  ===================================================== */\n\n  function initialiseAllNewThirtySections(\n    scope\n  ) {\n\n    const searchArea =\n      scope ||\n      document;\n\n\n    searchArea\n      .querySelectorAll(\n        \".hn-new30\"\n      )\n      .forEach(\n        function (section) {\n\n          initialiseNewThirtySection(\n            section\n          );\n\n        }\n      );\n\n  }\n\n\n  initialiseAllNewThirtySections(\n    document\n  );\n\n\n  /* Shopify Theme Editor support */\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    function (event) {\n\n      initialiseAllNewThirtySections(\n        event.target\n      );\n\n    }\n  );\n\n})();\n\n</script>"
      }
    },
