        "custom_html": "<!-- =========================================================\nHERTHA NEST — MULTICOLOUR JEWELLERY BOX\nCUSTOM HTML — STANDALONE SECTION\n\nPRODUCT LEFT\nCONTENT RIGHT\n\nEASY FUTURE EDITING\n---------------------------------------------------------\nEDIT PRODUCT URL HERE:\ndata-product-url=\"...\"\n\nEDIT PRODUCT IMAGE HERE:\n<img src=\"...\">\n\nCURRENT PRODUCT:\nhttps://herthanest.in/collections/festival-specials/products/hand-painted-multicolour-jewellery-storage-box\n\nCURRENT IMAGE:\nhttps://cdn.shopify.com/s/files/1/0677/4649/6670/files/000_8a9720bd-b679-4835-8277-dcd8ca2e808f.png?v=1788946121\n========================================================= -->\n\n\n<section class=\"hnmulti-product\" id=\"hnmultiProduct\" data-product-url=\"https://herthanest.in/collections/festival-specials/products/hand-painted-multicolour-jewellery-storage-box\" aria-labelledby=\"hnmultiTitle\">\n\n\n  <div class=\"hnmulti-bg\" aria-hidden=\"true\">\n\n    <span class=\"hnmulti-glow hnmulti-glow-1\"></span>\n\n    <span class=\"hnmulti-glow hnmulti-glow-2\"></span>\n\n    <span class=\"hnmulti-arch hnmulti-arch-1\"></span>\n\n    <span class=\"hnmulti-arch hnmulti-arch-2\"></span>\n\n  </div>\n\n\n\n  <div class=\"hnmulti-inner\">\n\n\n    <!-- =====================================================\n    LEFT — PRODUCT VISUAL\n    ====================================================== -->\n\n    <div class=\"hnmulti-visual\">\n\n\n      <div class=\"hnmulti-badge\">\n\n        <span class=\"hnmulti-badge-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n\n        </span>\n\n\n        <span>\n          HAND-PAINTED\n          <strong>HERITAGE CRAFT</strong>\n        </span>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-side-price\" id=\"hnmultiSidePrice\" aria-hidden=\"true\">\n        ₹1,200\n      </div>\n\n\n\n      <!-- =================================================\n      EDIT PRODUCT IMAGE HERE\n      ================================================== -->\n\n      <a class=\"hnmulti-image-link\" id=\"hnmultiImageLink\" href=\"https://herthanest.in/collections/festival-specials/products/hand-painted-multicolour-jewellery-storage-box\">\n\n        <img class=\"hnmulti-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/000_8a9720bd-b679-4835-8277-dcd8ca2e808f.png?v=1788946121\" width=\"1100\" height=\"1100\" alt=\"Hand-Painted Multicolour Jewellery Storage Box\">\n\n      </a>\n\n\n\n      <span class=\"hnmulti-shadow\" aria-hidden=\"true\"></span>\n\n\n\n      <!-- PODIUM -->\n\n      <div class=\"hnmulti-podium\" aria-hidden=\"true\">\n\n        <div class=\"hnmulti-podium-top\"></div>\n\n        <div class=\"hnmulti-podium-edge\"></div>\n\n        <div class=\"hnmulti-podium-body\"></div>\n\n        <div class=\"hnmulti-podium-highlight\"></div>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-floating\">\n\n        <span>✦</span>\n\n        <span>\n          Colour that brings\n          <strong>character home.</strong>\n        </span>\n\n      </div>\n\n\n      <span class=\"hnmulti-halo hnmulti-halo-1\" aria-hidden=\"true\"></span>\n\n      <span class=\"hnmulti-halo hnmulti-halo-2\" aria-hidden=\"true\"></span>\n\n    </div>\n\n\n\n    <!-- =====================================================\n    RIGHT — CONTENT\n    ====================================================== -->\n\n    <div class=\"hnmulti-content\">\n\n\n      <div class=\"hnmulti-eyebrow\">\n\n        <span></span>\n\n        ART • STORAGE • INDIAN CRAFT\n\n      </div>\n\n\n\n      <p class=\"hnmulti-kicker\">\n        Functional storage, transformed into art.\n      </p>\n\n\n\n      <h2 class=\"hnmulti-title\" id=\"hnmultiTitle\">\n\n        <span>\n          Multicolour\n        </span>\n\n        <em>\n          Jewellery Box\n        </em>\n\n      </h2>\n\n\n\n      <div class=\"hnmulti-ornament\" aria-hidden=\"true\">\n\n        <span></span>\n\n        <i></i>\n\n        <span></span>\n\n      </div>\n\n\n\n      <!-- NO LOADING / NO CHECKING AVAILABILITY -->\n\n      <div class=\"hnmulti-price-row\">\n\n        <span class=\"hnmulti-price\" id=\"hnmultiPrice\">\n          ₹1,200\n        </span>\n\n\n        <span class=\"hnmulti-compare\" id=\"hnmultiCompare\" hidden=\"\"></span>\n\n      </div>\n\n\n\n      <p class=\"hnmulti-description\">\n        A colourful hand-painted organiser combining traditional\n        Pichwai-inspired motifs, practical storage and a distinctive\n        elephant-shaped base for a striking decorative statement.\n      </p>\n\n\n\n      <!-- PREMIUM SPECS -->\n\n      <div class=\"hnmulti-specs\">\n\n\n        <div class=\"hnmulti-spec\">\n\n          <span class=\"hnmulti-spec-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M4 5h16v14H4V5m4 0v4M4 9h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n\n          </span>\n\n\n          <span>\n\n            <small>STORAGE</small>\n\n            <strong>\n              Jewellery &amp; Keepsakes\n            </strong>\n\n            <em>\n              Organise beautifully\n            </em>\n\n          </span>\n\n        </div>\n\n\n\n        <div class=\"hnmulti-spec\">\n\n          <span class=\"hnmulti-spec-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n\n          </span>\n\n\n          <span>\n\n            <small>DESIGN</small>\n\n            <strong>\n              Elephant Base\n            </strong>\n\n            <em>\n              Distinctive craftsmanship\n            </em>\n\n          </span>\n\n        </div>\n\n\n\n        <div class=\"hnmulti-spec\">\n\n          <span class=\"hnmulti-spec-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M5 6h14v12H5V6m3 3h8M8 13h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n\n          </span>\n\n\n          <span>\n\n            <small>FINISH</small>\n\n            <strong>\n              Vibrant Multicolour\n            </strong>\n\n            <em>\n              Hand-painted detailing\n            </em>\n\n          </span>\n\n        </div>\n\n\n      </div>\n\n\n\n      <!-- CTA -->\n\n      <div class=\"hnmulti-actions\">\n\n        <a class=\"hnmulti-button\" id=\"hnmultiProductButton\" href=\"https://herthanest.in/collections/festival-specials/products/hand-painted-multicolour-jewellery-storage-box\">\n\n          <span>\n            View Product Details\n          </span>\n\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n\n        </a>\n\n\n\n        <a class=\"hnmulti-collection\" href=\"https://herthanest.in/collections/festival-specials\">\n\n          Explore Festival Specials\n\n          <span>↗</span>\n\n        </a>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-trust\">\n\n        <span>\n          ✦\n        </span>\n\n\n        <p>\n          More than storage — a\n          <strong>decorative expression of Indian craft.</strong>\n        </p>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n  PREMIUM BOTTOM BAR\n  ====================================================== -->\n\n  <div class=\"hnmulti-benefit-wrap\">\n\n    <div class=\"hnmulti-benefits\">\n\n\n      <div class=\"hnmulti-benefit\">\n\n        <span class=\"hnmulti-benefit-icon\">\n          ✦\n        </span>\n\n        <span>\n          <small>ARTWORK</small>\n          <strong>Pichwai Inspired</strong>\n          <em>Traditional visual language</em>\n        </span>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-benefit\">\n\n        <span class=\"hnmulti-benefit-icon\">\n          ◇\n        </span>\n\n        <span>\n          <small>COLOUR</small>\n          <strong>Vibrant Multicolour</strong>\n          <em>Designed to stand out</em>\n        </span>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-benefit\">\n\n        <span class=\"hnmulti-benefit-icon\">\n          □\n        </span>\n\n        <span>\n          <small>STORAGE</small>\n          <strong>Practical Organisation</strong>\n          <em>Jewellery &amp; small treasures</em>\n        </span>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-benefit\">\n\n        <span class=\"hnmulti-benefit-icon\">\n          ✧\n        </span>\n\n        <span>\n          <small>GIFTING</small>\n          <strong>Thoughtfully Distinctive</strong>\n          <em>Festivals &amp; celebrations</em>\n        </span>\n\n      </div>\n\n\n\n      <div class=\"hnmulti-benefit\">\n\n        <span class=\"hnmulti-benefit-icon\">\n          ✓\n        </span>\n\n        <span>\n          <small>CRAFT</small>\n          <strong>Hand-Painted Finish</strong>\n          <em>Every piece has character</em>\n        </span>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\nMULTICOLOUR SECTION\n========================================================= */\n\n.hnmulti-product {\n  --hnm-red: #922f2e;\n  --hnm-red-dark: #691d21;\n\n  --hnm-purple: #4c335b;\n\n  --hnm-rust: #ac481b;\n\n  --hnm-brown: #39251d;\n\n  --hnm-gold: #c49348;\n  --hnm-gold-light: #ebcc90;\n\n  --hnm-muted: #75645a;\n\n\n  position: relative;\n\n\n  width: 100vw;\n  max-width: 100vw;\n\n\n  margin-left:\n    calc(50% - 50vw);\n\n  margin-right:\n    calc(50% - 50vw);\n\n\n  padding:\n\n    clamp(\n      65px,\n      5.5vw,\n      105px\n    )\n\n    clamp(\n      24px,\n      6.5vw,\n      125px\n    )\n\n    0;\n\n\n  overflow:\n    hidden;\n\n\n  background:\n\n    radial-gradient(\n      circle at 20% 31%,\n      rgba(193,110,68,.18),\n      transparent 27%\n    ),\n\n    linear-gradient(\n      135deg,\n      #fffdf9 0%,\n      #f8f0e6 50%,\n      #edddcd 100%\n    );\n\n\n  color:\n    var(--hnm-brown);\n\n\n  isolation:\n    isolate;\n}\n\n\n.hnmulti-product *,\n.hnmulti-product *::before,\n.hnmulti-product *::after {\n  box-sizing:\n    border-box;\n}\n\n\n/* =========================================================\nCUSTOM HTML THEME WRAPPER RESET — STRONG VERSION\n---------------------------------------------------------\nThe theme is reserving an empty block ABOVE the Custom HTML\ncontent. In the editor this appears as the white strip inside\nthe blue section outline.\n\nThis reset:\n1. Removes margin/padding from every ancestor between this\n   custom section and Shopify's .shopify-section wrapper.\n2. Removes min-height / fixed-height left by theme wrappers.\n3. Hides known empty heading wrappers.\n4. Keeps .hnmulti-product's OWN internal premium spacing.\n========================================================= */\n\n/* Shopify section itself */\n.shopify-section:has(.hnmulti-product) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  min-height: 0 !important;\n  height: auto !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/*\nVERY IMPORTANT:\nTarget every structural ancestor that CONTAINS .hnmulti-product\nwithout touching .hnmulti-product itself.\n\nThis is stronger than relying only on guessed theme class names.\n*/\n.shopify-section:has(.hnmulti-product)\n:is(div, section, article, main):has(.hnmulti-product):not(.hnmulti-product) {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  min-height: 0 !important;\n  height: auto !important;\n  max-height: none !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Common Custom HTML wrappers */\n.shopify-section:has(.hnmulti-product) .section,\n.shopify-section:has(.hnmulti-product) .section-padding,\n.shopify-section:has(.hnmulti-product) .section__wrapper,\n.shopify-section:has(.hnmulti-product) .section-wrapper,\n.shopify-section:has(.hnmulti-product) .custom-html,\n.shopify-section:has(.hnmulti-product) .custom-html-wrapper,\n.shopify-section:has(.hnmulti-product) .custom-html-section,\n.shopify-section:has(.hnmulti-product) .page-width,\n.shopify-section:has(.hnmulti-product) .container,\n.shopify-section:has(.hnmulti-product) .container-fluid,\n.shopify-section:has(.hnmulti-product) .row {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  min-height: 0 !important;\n}\n\n\n/* Full-width wrapper */\n.shopify-section:has(.hnmulti-product) .page-width,\n.shopify-section:has(.hnmulti-product) .container,\n.shopify-section:has(.hnmulti-product) .container-fluid,\n.shopify-section:has(.hnmulti-product) .custom-html,\n.shopify-section:has(.hnmulti-product) .custom-html-wrapper,\n.shopify-section:has(.hnmulti-product) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n/*\nHide known THEME heading containers.\nOur actual product heading is .hnmulti-title and is not targeted.\n*/\n.shopify-section:has(.hnmulti-product) .section-heading,\n.shopify-section:has(.hnmulti-product) .section__heading,\n.shopify-section:has(.hnmulti-product) .section-title,\n.shopify-section:has(.hnmulti-product) .section__title,\n.shopify-section:has(.hnmulti-product) .section-header,\n.shopify-section:has(.hnmulti-product) .section__header,\n.shopify-section:has(.hnmulti-product) .section-head,\n.shopify-section:has(.hnmulti-product) .heading-wrapper,\n.shopify-section:has(.hnmulti-product) .title-wrapper,\n.shopify-section:has(.hnmulti-product) .section-title-wrapper,\n.shopify-section:has(.hnmulti-product) [class*=\"section-heading\"],\n.shopify-section:has(.hnmulti-product) [class*=\"section__heading\"],\n.shopify-section:has(.hnmulti-product) [class*=\"section-title\"],\n.shopify-section:has(.hnmulti-product) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n  overflow: hidden !important;\n}\n\n\n/*\nTheme-generated empty wrappers/spacers are also collapsed.\nThis does NOT target anything inside .hnmulti-product.\n*/\n.shopify-section:has(.hnmulti-product)\n:where(\n  .section-heading,\n  .section__heading,\n  .section-title,\n  .section__title,\n  .section-header,\n  .section__header,\n  .section-head,\n  .heading-wrapper,\n  .title-wrapper,\n  .section-title-wrapper\n):empty {\n  display: none !important;\n}\n\n\n/* Prevent first/last child theme spacing */\n.shopify-section:has(.hnmulti-product) > *:first-child {\n  margin-top: 0 !important;\n}\n\n.shopify-