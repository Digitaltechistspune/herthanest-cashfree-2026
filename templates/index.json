    "custom_html_rY9Y3i": {
      "type": "custom-html",
      "name": "Blue",
      "settings": {
        "section_padding_top": 0,
        "section_padding_bottom": 80,
        "section_padding_top_ip": 0,
        "section_padding_bottom_ip": 80,
        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 60,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<!-- =========================================================\nHERTHA NEST — BLUE PICHHWAI FEATURE PRODUCT\nCUSTOM HTML — STANDALONE SECTION\n\nEASY FUTURE EDITING\n---------------------------------------------------------\nEDIT PRODUCT URL HERE:\ndata-product-url=\"...\"\n\nEDIT PRODUCT IMAGE HERE:\n<img src=\"...\">\n\nCurrent product:\nhttps://herthanest.in/collections/festival-specials/products/xs\n\nCurrent transparent image:\nhttps://cdn.shopify.com/s/files/1/0677/4649/6670/files/0_72539fff-d896-423b-b112-d19fab87a411.png?v=1788944054\n========================================================= -->\n\n\n<section class=\"hnblue-product\" id=\"hnblueProduct\" data-product-url=\"https://herthanest.in/collections/festival-specials/products/xs\" aria-labelledby=\"hnblueTitle\">\n\n  <!-- BACKGROUND DECOR -->\n\n  <div class=\"hnblue-bg\" aria-hidden=\"true\">\n    <span class=\"hnblue-glow hnblue-glow-1\"></span>\n    <span class=\"hnblue-glow hnblue-glow-2\"></span>\n\n    <span class=\"hnblue-arch hnblue-arch-1\"></span>\n    <span class=\"hnblue-arch hnblue-arch-2\"></span>\n  </div>\n\n\n  <div class=\"hnblue-inner\">\n\n\n    <!-- =====================================================\n    LEFT CONTENT\n    ====================================================== -->\n\n    <div class=\"hnblue-content\">\n\n      <div class=\"hnblue-eyebrow\">\n        <span></span>\n        HERTHA NEST SIGNATURE\n      </div>\n\n\n      <p class=\"hnblue-kicker\">\n        Where artistry meets everyday function.\n      </p>\n\n\n      <h2 class=\"hnblue-title\" id=\"hnblueTitle\">\n        <span>\n          Pichwai Jewellery\n        </span>\n\n        <em>\n          Storage Box\n        </em>\n      </h2>\n\n\n      <div class=\"hnblue-ornament\" aria-hidden=\"true\">\n        <span></span>\n        <i></i>\n        <span></span>\n      </div>\n\n\n      <!-- NO LOADING / NO AVAILABILITY TEXT -->\n\n      <div class=\"hnblue-price-row\">\n\n        <span class=\"hnblue-price\" id=\"hnbluePrice\">\n          ₹1,000\n        </span>\n\n        <span class=\"hnblue-compare\" id=\"hnblueCompare\" hidden=\"\"></span>\n\n      </div>\n\n\n      <p class=\"hnblue-description\">\n        A vibrant Pichwai-inspired storage piece that blends expressive\n        Indian artwork, functional organisation and distinctive\n        elephant-based craftsmanship.\n      </p>\n\n\n\n      <!-- PREMIUM SPECS -->\n\n      <div class=\"hnblue-specs\">\n\n\n        <div class=\"hnblue-spec\">\n\n          <span class=\"hnblue-spec-icon\">\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M4 5h16v14H4V5m4 0v4M4 9h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n          </span>\n\n          <span>\n            <small>FUNCTION</small>\n            <strong>Practical Storage</strong>\n            <em>Jewellery &amp; keepsakes</em>\n          </span>\n\n        </div>\n\n\n\n        <div class=\"hnblue-spec\">\n\n          <span class=\"hnblue-spec-icon\">\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n          </span>\n\n          <span>\n            <small>ART</small>\n            <strong>Pichwai Inspired</strong>\n            <em>Traditional motifs</em>\n          </span>\n\n        </div>\n\n\n\n        <div class=\"hnblue-spec\">\n\n          <span class=\"hnblue-spec-icon\">\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M5 6h14v12H5V6m3 3h8M8 13h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n          </span>\n\n          <span>\n            <small>FINISH</small>\n            <strong>Hand-Painted</strong>\n            <em>Artisan detailing</em>\n          </span>\n\n        </div>\n\n      </div>\n\n\n\n      <!-- CTA -->\n\n      <div class=\"hnblue-actions\">\n\n        <a class=\"hnblue-button\" id=\"hnblueProductButton\" href=\"https://herthanest.in/collections/festival-specials/products/xs\">\n\n          <span>\n            View Product Details\n          </span>\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n\n        </a>\n\n\n        <a class=\"hnblue-collection\" href=\"https://herthanest.in/collections/festival-specials\">\n          Explore Festival Specials\n          <span>↗</span>\n        </a>\n\n      </div>\n\n\n      <div class=\"hnblue-trust\">\n\n        <span>✦</span>\n\n        <p>\n          Crafted for homes where\n          <strong>utility deserves artistry.</strong>\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n    RIGHT PRODUCT\n    ====================================================== -->\n\n    <div class=\"hnblue-visual\">\n\n\n      <div class=\"hnblue-badge\">\n\n        <span class=\"hnblue-badge-icon\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </span>\n\n        <span>\n          HANDCRAFTED\n          <strong>INDIAN ARTISTRY</strong>\n        </span>\n\n      </div>\n\n\n\n      <div class=\"hnblue-side-price\" id=\"hnblueSidePrice\" aria-hidden=\"true\">\n        ₹1,000\n      </div>\n\n\n\n      <!-- =================================================\n      EDIT PRODUCT IMAGE HERE\n      ================================================== -->\n\n      <a class=\"hnblue-image-link\" id=\"hnblueImageLink\" href=\"https://herthanest.in/collections/festival-specials/products/xs\">\n\n        <img class=\"hnblue-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/0_72539fff-d896-423b-b112-d19fab87a411.png?v=1788944054\" width=\"1100\" height=\"1100\" alt=\"Hand-Painted Pichwai Jewellery Storage Box\">\n\n      </a>\n\n\n      <span class=\"hnblue-shadow\" aria-hidden=\"true\"></span>\n\n\n\n      <!-- PODIUM -->\n\n      <div class=\"hnblue-podium\" aria-hidden=\"true\">\n        <div class=\"hnblue-podium-top\"></div>\n        <div class=\"hnblue-podium-edge\"></div>\n        <div class=\"hnblue-podium-body\"></div>\n        <div class=\"hnblue-podium-highlight\"></div>\n      </div>\n\n\n\n      <div class=\"hnblue-floating\">\n\n        <span>✦</span>\n\n        <span>\n          Crafted to be\n          <strong>remembered.</strong>\n        </span>\n\n      </div>\n\n\n      <span class=\"hnblue-halo hnblue-halo-1\" aria-hidden=\"true\"></span>\n\n      <span class=\"hnblue-halo hnblue-halo-2\" aria-hidden=\"true\"></span>\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n  PREMIUM BENEFIT BAR\n  ====================================================== -->\n\n  <div class=\"hnblue-benefit-wrap\">\n\n    <div class=\"hnblue-benefits\">\n\n\n      <div class=\"hnblue-benefit\">\n        <span class=\"hnblue-benefit-icon\">✦</span>\n        <span>\n          <small>ARTWORK</small>\n          <strong>Pichwai Inspired</strong>\n          <em>Rooted in Indian tradition</em>\n        </span>\n      </div>\n\n\n      <div class=\"hnblue-benefit\">\n        <span class=\"hnblue-benefit-icon\">◇</span>\n        <span>\n          <small>DETAIL</small>\n          <strong>Hand-Painted Finish</strong>\n          <em>Rich artisan character</em>\n        </span>\n      </div>\n\n\n      <div class=\"hnblue-benefit\">\n        <span class=\"hnblue-benefit-icon\">□</span>\n        <span>\n          <small>FUNCTION</small>\n          <strong>Useful Storage</strong>\n          <em>Jewellery &amp; keepsakes</em>\n        </span>\n      </div>\n\n\n      <div class=\"hnblue-benefit\">\n        <span class=\"hnblue-benefit-icon\">✧</span>\n        <span>\n          <small>DESIGN</small>\n          <strong>Elephant Base</strong>\n          <em>A distinctive statement</em>\n        </span>\n      </div>\n\n\n      <div class=\"hnblue-benefit\">\n        <span class=\"hnblue-benefit-icon\">✓</span>\n        <span>\n          <small>DISCOVER</small>\n          <strong>Hertha Nest</strong>\n          <em>Crafted for better homes</em>\n        </span>\n      </div>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\nBLUE SECTION — FULL WIDTH\n========================================================= */\n\n.hnblue-product {\n  --hnblue-navy: #102b4d;\n  --hnblue-deep: #071a31;\n  --hnblue-rust: #a54619;\n  --hnblue-brown: #38261d;\n  --hnblue-muted: #716158;\n  --hnblue-gold: #c69245;\n  --hnblue-gold-light: #e7c98d;\n\n  position: relative;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin-left: calc(50% - 50vw);\n  margin-right: calc(50% - 50vw);\n\n  padding:\n    clamp(65px, 5.5vw, 105px)\n    clamp(24px, 6.5vw, 125px)\n    0;\n\n  overflow: hidden;\n\n  background:\n    radial-gradient(\n      circle at 81% 31%,\n      rgba(207, 168, 111, .25),\n      transparent 27%\n    ),\n    linear-gradient(\n      135deg,\n      #fffdf9 0%,\n      #f8f2e9 50%,\n      #eee0cf 100%\n    );\n\n  color: var(--hnblue-brown);\n\n  isolation: isolate;\n}\n\n\n.hnblue-product *,\n.hnblue-product *::before,\n.hnblue-product *::after {\n  box-sizing: border-box;\n}\n\n\n.shopify-section:has(.hnblue-product) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Reset common wrappers created around Custom HTML */\n\n.shopify-section:has(.hnblue-product) > div,\n.shopify-section:has(.hnblue-product) > div > div,\n.shopify-section:has(.hnblue-product) .section,\n.shopify-section:has(.hnblue-product) .section-padding,\n.shopify-section:has(.hnblue-product) .section__wrapper,\n.shopify-section:has(.hnblue-product) .section-wrapper,\n.shopify-section:has(.hnblue-product) .custom-html,\n.shopify-section:has(.hnblue-product) .custom-html-wrapper,\n.shopify-section:has(.hnblue-product) .custom-html-section,\n.shopify-section:has(.hnblue-product) .page-width,\n.shopify-section:has(.hnblue-product) .container,\n.shopify-section:has(.hnblue-product) .container-fluid {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  min-height: 0 !important;\n\n  row-gap: 0 !important;\n  column-gap: 0 !important;\n  gap: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Keep the Custom HTML content full width */\n\n.shopify-section:has(.hnblue-product) .page-width,\n.shopify-section:has(.hnblue-product) .container,\n.shopify-section:has(.hnblue-product) .container-fluid,\n.shopify-section:has(.hnblue-product) .custom-html,\n.shopify-section:has(.hnblue-product) .custom-html-wrapper,\n.shopify-section:has(.hnblue-product) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n/*\nHide theme-generated Section Heading/Title blocks.\nThis does NOT target the custom .hnblue-title heading.\n*/\n\n.shopify-section:has(.hnblue-product) .section-heading,\n.shopify-section:has(.hnblue-product) .section__heading,\n.shopify-section:has(.hnblue-product) .section-title,\n.shopify-section:has(.hnblue-product) .section__title,\n.shopify-section:has(.hnblue-product) .section-header,\n.shopify-section:has(.hnblue-product) .section__header,\n.shopify-section:has(.hnblue-product) .section-head,\n.shopify-section:has(.hnblue-product) .heading-wrapper,\n.shopify-section:has(.hnblue-product) .title-wrapper,\n.shopify-section:has(.hnblue-product) .section-title-wrapper,\n.shopify-section:has(.hnblue-product) [class*=\"section-heading\"],\n.shopify-section:has(.hnblue-product) [class*=\"section__heading\"],\n.shopify-section:has(.hnblue-product) [class*=\"section-title\"],\n.shopify-section:has(.hnblue-product) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n  overflow: hidden !important;\n}\n\n\n.shopify-section:has(.hnblue-product) > *:first-child {\n  margin-top: 0 !important;\n}\n\n\n.shopify-section:has(.hnblue-product) > *:last-child {\n  margin-bottom: 0 !important;\n}\n\n\n\n/* BACKGROUND */\n\n.hnblue-bg {\n  position: absolute;\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n}\n\n\n.hnblue-glow {\n  position: absolute;\n\n  border-radius: 50%;\n}\n\n\n.hnblue-glow-1 {\n  width: 600px;\n  height: 600px;\n\n  top: -310px;\n  right: -110px;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(198,146,69,.19),\n      transparent 70%\n    );\n}\n\n\n.hnblue-glow-2 {\n  width: 460px;\n  height: 460px;\n\n  left: -190px;\n  bottom: -230px;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(16,43,77,.09),\n      transparent 72%\n    );\n}\n\n\n.hnblue-arch {\n  position: absolute;\n\n  border: 1px solid rgba(117,79,46,.09);\n  border-bottom: 0;\n\n  border-radius: 320px 320px 0 0;\n}\n\n\n.hnblue-arch-1 {\n  width: min(39vw, 620px);\n  height: 74%;\n\n  top: 63px;\n  right: 7%;\n}\n\n\n.hnblue-arch-2 {\n  width: min(31vw, 495px);\n  height: 64%;\n\n  top: 125px;\n  right: 10.5%;\n}\n\n\n\n/* GRID */\n\n.hnblue-inner {\n  position: relative;\n\n  z-index: 5;\n\n  display: grid;\n\n  grid-template-columns:\n    minmax(0,.92fr)\n    minmax(500px,1.08fr);\n\n  align-items: center;\n\n  gap: clamp(40px,5vw,95px);\n\n  width: 100%;\n  max-width: 1580px;\n\n  min-height: 675px;\n\n  margin: 0 auto;\n}\n\n\n\n/* CONTENT */\n\n.hnblue-content {\n  position: relative;\n\n  z-index: 20;\n\n  width: 100%;\n  max-width: 675px;\n}\n\n\n.hnblue-eyebrow {\n  display: flex;\n  align-items: center;\n\n  gap: 12px;\n\n  margin-bottom: 19px;\n\n  color: #88562e;\n\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: clamp(9px,.7vw,11px);\n  font-weight: 700;\n\n  letter-spacing: .24em;\n\n  text-transform: uppercase;\n}\n\n\n.hnblue-eyebrow > span {\n  display: block;\n\n  width: 30px;\n  height: 1px;\n\n  background: currentColor;\n\n  opacity: .7;\n}\n\n\n.hnblue-kicker {\n  margin: 0 0 9px;\n\n  color: #4f4037;\n\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: clamp(17px,1.3vw,22px);\n\n  line-height: 1.4;\n}\n\n\n.hnblue-title {\n  margin: 0;\n\n  color: var(--hnblue-brown);\n\n  font-family: Georgia, \"Times New Roman\", serif;\n\n  font-size: clamp(50px,4.6vw,82px);\n\n  font-weight: 500;\n\n  line-height: .95;\n\n  letter-spacing: -.05em;\n}\n\n\n.hnblue-title span,\n.hnblue-title em {\n  display: block;\n}\n\n\n.hnblue-title em {\n  margin-top: 8px;\n\n  color: var(--hnblue-rust);\n\n  font-size: .77em;\n  font-weight: 400;\n  font-style: italic;\n\n  letter-spacing: -.03em;\n}\n\n\n.hnblue-ornament {\n  display: flex;\n  align-items: center;\n\n  gap: 8px;\n\n  width: 80px;\n\n  margin-top: 21px;\n}\n\n\n.hnblue-ornament span {\n  width: 28px;\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      rgba(148,99,48,.18),\n      rgba(148,99,48,.78)\n    );\n}\n\n\n.hnblue-ornament span:last-child {\n  background:\n    linear-gradient(\n      90deg,\n      rgba(148,99,48,.78),\n      rgba(148,99,48,.18)\n    );\n}\n\n\n.hnblue-ornament i {\n  width: 6px;\n  height: 6px;\n\n  border: 1px solid rgba(148,99,48,.8);\n\n  background: #f7eee2;\n\n  transform: rotate(45deg);\n}\n\n\n\n/* PRICE — IMMEDIATE / NO LOADING */\n\n.hnblue-price-row {\n  display: flex;\n  align-items: center;\n\n  gap: 12px;\n\n  margin-top: 22px;\n}\n\n\n.hnblue-price {\n  color: var(--hnblue-navy);\n\n  font-family: Georgia, \"Times New Roman\", serif;\n\n  font-size: 28px;\n  font-weight: 700;\n}\n\n\n.hnblue-compare {\n  color: #a1948a;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 14px;\n\n  text-decoration: line-through;\n}\n\n\n\n/* DESCRIPTION */\n\n.hnblue-description {\n  max-width: 580px;\n\n  margin: 20px 0 0;\n\n  color: var(--hnblue-muted);\n\n  font-family: Arial, Helvetica, sans-serif;\n\n  font-size: clamp(14px,.98vw,16.5px);\n\n  line-height: 1.72;\n}\n\n\n\n/* SPEC CARDS */\n\n.hnblue-specs {\n  display: grid;\n\n  grid-template-columns: repeat(3,minmax(0,1fr));\n\n  gap: 11px;\n\n  max-width: 630px;\n\n  margin-top: 28px;\n}\n\n\n.hnblue-spec {\n  position: relative;\n\n  display: flex;\n  align-items: center;\n\n  gap: 11px;\n\n  min-height: 78px;\n\n  padding: 13px;\n\n  border: 1px solid rgba(16,43,77,.10);\n\n  border-radius: 14px;\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.64),\n      rgba(255,255,255,.25)\n    );\n\n  box-shadow:\n    0 12px 30px rgba(57,40,29,.05),\n    inset 0 1px 0 rgba(255,255,255,.7);\n\n  backdrop-filter: blur(6px);\n  -webkit-backdrop-filter: blur(6px);\n}\n\n\n.hnblue-spec::after {\n  content: \"\";\n\n  position: absolute;\n\n  left: 10%;\n  right: 10%;\n  bottom: 0;\n\n  height: 2px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      var(--hnblue-gold),\n      transparent\n    );\n\n  opacity: .48;\n}\n\n\n.hnblue-spec-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 42px;\n  height: 42px;\n\n  flex: 0 0 42px;\n\n  border: 1px solid rgba(198,146,69,.38);\n\n  border-radius: 50%;\n\n  background:\n    linear-gradient(\n      135deg,\n      #fffdf8,\n      #eadbc7\n    );\n\n  color: var(--hnblue-navy);\n}\n\n\n.hnblue-spec-icon svg {\n  width: 20px;\n  height: 20px;\n}\n\n\n.hnblue-spec > span:last-child {\n  min-width: 0;\n\n  font-family: Arial, sans-serif;\n}\n\n\n.hnblue-spec small {\n  display: block;\n\n  margin-bottom: 4px;\n\n  color: #a06e36;\n\n  font-size: 7px;\n  font-weight: 700;\n\n  letter-spacing: .15em;\n}\n\n\n.hnblue-spec strong {\n  display: block;\n\n  color: #44352c;\n\n  font-size: 10.5px;\n}\n\n\n.hnblue-spec em {\n  display: block;\n\n  margin-top: 3px;\n\n  color: #887970;\n\n  font-size: 8px;\n  font-style: normal;\n}\n\n\n\n/* ACTIONS */\n\n.hnblue-actions {\n  display: flex;\n  align-items: center;\n\n  flex-wrap: wrap;\n\n  gap: 20px;\n\n  margin-top: 30px;\n}\n\n\n.hnblue-button {\n  position: relative;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  gap: 18px;\n\n  min-width: 265px;\n  min-height: 57px;\n\n  padding: 0 27px;\n\n  overflow: hidden;\n\n  border: 1px solid #071a31;\n\n  border-radius: 7px;\n\n  background:\n    linear-gradient(\n      135deg,\n      #143b68,\n      #071c36\n    );\n\n  box-shadow:\n    0 15px 31px rgba(6,27,53,.21);\n\n  color: #fff !important;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 14px;\n  font-weight: 700;\n\n  text-decoration: none !important;\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hnblue-button::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: -75%;\n\n  width: 45%;\n  height: 100%;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.18),\n      transparent\n    );\n\n  transform: skewX(-22deg);\n\n  transition: left .65s ease;\n}\n\n\n.hnblue-button span,\n.hnblue-button svg {\n  position: relative;\n\n  z-index: 2;\n}\n\n\n.hnblue-button svg {\n  width: 19px;\n  height: 19px;\n\n  transition: transform .25s ease;\n}\n\n\n.hnblue-button:hover {\n  transform: translateY(-3px);\n\n  box-shadow:\n    0 20px 39px rgba(6,27,53,.28);\n}\n\n\n.hnblue-button:hover::before {\n  left: 130%;\n}\n\n\n.hnblue-button:hover svg {\n  transform: translateX(5px);\n}\n\n\n.hnblue-collection {\n  display: inline-flex;\n  align-items: center;\n\n  gap: 7px;\n\n  padding-bottom: 4px;\n\n  border-bottom: 1px solid rgba(16,43,77,.25);\n\n  color: var(--hnblue-navy) !important;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 12px;\n  font-weight: 700;\n\n  text-decoration: none !important;\n}\n\n\n\n/* TRUST */\n\n.hnblue-trust {\n  display: flex;\n  align-items: flex-start;\n\n  gap: 9px;\n\n  margin-top: 22px;\n\n  color: #83746b;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 10.5px;\n\n  line-height: 1.5;\n}\n\n\n.hnblue-trust > span {\n  color: var(--hnblue-gold);\n\n  font-size: 16px;\n}\n\n\n.hnblue-trust p {\n  margin: 0;\n}\n\n\n.hnblue-trust strong {\n  color: #55463d;\n}\n\n\n\n/* VISUAL */\n\n.hnblue-visual {\n  position: relative;\n\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n\n  width: 100%;\n  min-height: 640px;\n\n  isolation: isolate;\n}\n\n\n.hnblue-image-link {\n  position: absolute;\n\n  z-index: 12;\n\n  left: 50%;\n  bottom: 123px;\n\n  width: min(82%,610px);\n\n  transform: translateX(-50%);\n}\n\n\n.hnblue-image {\n  display: block;\n\n  width: 100%;\n  height: 525px;\n\n  object-fit: contain;\n  object-position: center bottom;\n\n  background: transparent;\n\n  filter:\n    drop-shadow(\n      0 29px 25px rgba(19,29,37,.20)\n    );\n\n  transition:\n    transform .65s cubic-bezier(.22,.61,.36,1),\n    filter .65s ease;\n}\n\n\n.hnblue-image-link:hover .hnblue-image {\n  transform:\n    translateY(-9px)\n    scale(1.018);\n\n  filter:\n    drop-shadow(\n      0 37px 31px rgba(19,29,37,.25)\n    );\n}\n\n\n.hnblue-shadow {\n  position: absolute;\n\n  z-index: 5;\n\n  left: 50%;\n  bottom: 110px;\n\n  width: 420px;\n  height: 60px;\n\n  border-radius: 50%;\n\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(14,33,54,.20),\n      transparent 72%\n    );\n\n  filter: blur(4px);\n\n  transform: translateX(-50%);\n}\n\n\n\n/* PODIUM */\n\n.hnblue-podium {\n  position: relative;\n\n  z-index: 4;\n\n  width: min(90%,595px);\n  height: 155px;\n\n  margin-bottom: 34px;\n\n  filter:\n    drop-shadow(\n      0 30px 31px rgba(65,45,31,.14)\n    );\n}\n\n\n.hnblue-podium-top {\n  position: absolute;\n\n  z-index: 5;\n\n  top: -28px;\n  left: 0;\n\n  width: 100%;\n  height: 78px;\n\n  border: 1px solid rgba(142,102,68,.18);\n\n  border-radius: 50%;\n\n  background:\n    radial-gradient(\n      ellipse at 45% 22%,\n      #fffaf0,\n      #ead8c0 55%,\n      #ceb292\n    );\n}\n\n\n.hnblue-podium-edge {\n  position: absolute;\n\n  z-index: 4;\n\n  top: 12px;\n  left: 4%;\n\n  width: 92%;\n  height: 15px;\n\n  border-radius: 50%;\n\n  background:\n    linear-gradient(\n      90deg,\n      #a67a4d,\n      #e0bb83,\n      #b08354\n    );\n}\n\n\n.hnblue-podium-body {\n  position: absolute;\n\n  z-index: 3;\n\n  top: 15px;\n  left: 4%;\n\n  width: 92%;\n  height: 122px;\n\n  border-radius:\n    0 0 42% 42% /\n    0 0 23% 23%;\n\n  background:\n    linear-gradient(\n      90deg,\n      #c5a47d,\n      #e4c9a7 24%,\n      #f2dec1 52%,\n      #c09d76\n    );\n}\n\n\n.hnblue-podium-highlight {\n  position: absolute;\n\n  z-index: 6;\n\n  left: 21%;\n  bottom: 18px;\n\n  width: 58%;\n  height: 2px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,241,207,.8),\n      transparent\n    );\n}\n\n\n\n/* BADGE */\n\n.hnblue-badge {\n  position: absolute;\n\n  z-index: 20;\n\n  top: 45px;\n  right: 2%;\n\n  display: flex;\n  align-items: center;\n\n  gap: 10px;\n\n  padding: 11px 15px;\n\n  border: 1px solid rgba(198,146,69,.28);\n\n  border-radius: 100px;\n\n  background: rgba(255,249,239,.80);\n\n  box-shadow:\n    0 14px 35px rgba(67,46,30,.09);\n\n  backdrop-filter: blur(9px);\n  -webkit-backdrop-filter: blur(9px);\n\n  color: #6d4a36;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 7.5px;\n\n  letter-spacing: .09em;\n}\n\n\n.hnblue-badge strong {\n  display: block;\n\n  margin-top: 2px;\n\n  color: var(--hnblue-navy);\n\n  font-size: 9px;\n}\n\n\n.hnblue-badge-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 34px;\n  height: 34px;\n\n  border: 1px solid rgba(198,146,69,.38);\n\n  border-radius: 50%;\n\n  color: var(--hnblue-navy);\n}\n\n\n.hnblue-badge-icon svg {\n  width: 18px;\n  height: 18px;\n}\n\n\n.hnblue-side-price {\n  position: absolute;\n\n  z-index: 20;\n\n  top: 48%;\n  right: 3.5%;\n\n  color: rgba(16,43,77,.55);\n\n  font-family: Georgia, serif;\n\n  font-size: 19px;\n  font-weight: 700;\n\n  transform: rotate(-90deg);\n}\n\n\n.hnblue-floating {\n  position: absolute;\n\n  z-index: 21;\n\n  right: 0;\n  bottom: 61px;\n\n  display: flex;\n  align-items: center;\n\n  gap: 10px;\n\n  padding: 14px 17px;\n\n  border: 1px solid rgba(198,146,69,.24);\n\n  border-radius: 17px;\n\n  background: rgba(255,249,239,.82);\n\n  box-shadow:\n    0 17px 36px rgba(70,47,30,.11);\n\n  color: #756052;\n\n  font-family: Arial, sans-serif;\n\n  font-size: 10px;\n}\n\n\n.hnblue-floating > span:first-child {\n  color: var(--hnblue-gold);\n\n  font-size: 21px;\n}\n\n\n.hnblue-floating strong {\n  display: block;\n\n  color: var(--hnblue-navy);\n}\n\n\n\n/* HALO */\n\n.hnblue-halo {\n  position: absolute;\n\n  z-index: 1;\n\n  left: 50%;\n\n  border: 1px solid rgba(16,43,77,.065);\n\n  border-radius: 50%;\n\n  transform: translateX(-50%);\n}\n\n\n.hnblue-halo-1 {\n  width: 540px;\n  height: 540px;\n\n  top: 55px;\n}\n\n\n.hnblue-halo-2 {\n  width: 455px;\n  height: 455px;\n\n  top: 98px;\n}\n\n\n\n/* BENEFIT BAR */\n\n.hnblue-benefit-wrap {\n  position: relative;\n\n  z-index: 30;\n\n  left: 50%;\n\n  width: 100vw;\n\n  margin-left: -50vw;\n  margin-top: 28px;\n\n  padding:\n    21px\n    clamp(25px,5.5vw,105px);\n\n  background:\n    radial-gradient(\n      circle at 50% 0%,\n      rgba(43,80,119,.58),\n      transparent 42%\n    ),\n    linear-gradient(\n      135deg,\n      #12365f,\n      #081f3a 48%,\n      #05172c\n    );\n}\n\n\n.hnblue-benefits {\n  display: grid;\n\n  grid-template-columns: repeat(5,minmax(0,1fr));\n\n  gap: 11px;\n\n  max-width: 1580px;\n\n  margin: 0 auto;\n}\n\n\n.hnblue-benefit {\n  display: flex;\n  align-items: center;\n\n  gap: 12px;\n\n  min-height: 87px;\n\n  padding: 12px 15px;\n\n  border: 1px solid rgba(255,255,255,.09);\n\n  border-radius: 13px;\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    );\n}\n\n\n.hnblue-benefit-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 43px;\n  height: 43px;\n\n  flex: 0 0 43px;\n\n  border: 1px solid rgba(229,195,138,.38);\n\n  border-radius: 50%;\n\n  color: var(--hnblue-gold-light);\n\n  font-size: 18px;\n}\n\n\n.hnblue-benefit small,\n.hnblue-benefit strong,\n.hnblue-benefit em {\n  display: block;\n\n  font-family: Arial, sans-serif;\n}\n\n\n.hnblue-benefit small {\n  margin-bottom: 4px;\n\n  color: var(--hnblue-gold-light);\n\n  font-size: 7px;\n  font-weight: 700;\n\n  letter-spacing: .17em;\n}\n\n\n.hnblue-benefit strong {\n  color: #fff;\n\n  font-size: 11.5px;\n}\n\n\n.hnblue-benefit em {\n  margin-top: 4px;\n\n  color: rgba(255,255,255,.58);\n\n  font-size: 8.5px;\n  font-style: normal;\n}\n\n\n\n/* TABLET */\n\n@media screen and (max-width: 1150px) {\n\n  .hnblue-product {\n    padding-left: 40px;\n    padding-right: 40px;\n  }\n\n\n  .hnblue-inner {\n    grid-template-columns:\n      minmax(0,1fr)\n      minmax(410px,.95fr);\n\n    gap: 30px;\n  }\n\n\n  .hnblue-title {\n    font-size:\n      clamp(44px,5.6vw,66px);\n  }\n\n\n  .hnblue-image {\n    height: 455px;\n  }\n\n\n  .hnblue-benefits {\n    grid-template-columns:\n      repeat(3,1fr);\n  }\n\n}\n\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .hnblue-product {\n    padding:\n      50px\n      18px\n      0;\n  }\n\n\n  .hnblue-inner {\n    display: flex;\n    flex-direction: column;\n\n    gap: 22px;\n\n    min-height: 0;\n  }\n\n\n  .hnblue-content {\n    text-align: center;\n  }\n\n\n  .hnblue-eyebrow,\n  .hnblue-price-row,\n  .hnblue-actions {\n    justify-content: center;\n  }\n\n\n  .hnblue-title {\n    font-size:\n      clamp(42px,12vw,61px);\n  }\n\n\n  .hnblue-ornament {\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n\n  .hnblue-description {\n    margin:\n      19px\n      auto\n      0;\n\n    font-size: 13px;\n  }\n\n\n  .hnblue-specs {\n    grid-template-columns: 1fr;\n\n    max-width: 430px;\n\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n\n  .hnblue-spec {\n    text-align: left;\n  }\n\n\n  .hnblue-trust {\n    justify-content: center;\n  }\n\n\n  .hnblue-visual {\n    min-height: 500px;\n  }\n\n\n  .hnblue-image-link {\n    width: min(90%,430px);\n\n    bottom: 106px;\n  }\n\n\n  .hnblue-image {\n    height: 390px;\n  }\n\n\n  .hnblue-podium {\n    width: min(94%,455px);\n\n    height: 135px;\n\n    margin-bottom: 23px;\n  }\n\n\n  .hnblue-side-price {\n    display: none;\n  }\n\n\n  .hnblue-floating {\n    bottom: 30px;\n  }\n\n\n  .hnblue-benefits {\n    grid-template-columns:\n      1fr 1fr;\n  }\n\n\n  .hnblue-benefit:last-child {\n    grid-column: 1 / -1;\n  }\n\n}\n\n\n\n/* SMALL MOBILE */\n\n@media screen and (max-width: 450px) {\n\n  .hnblue-title {\n    font-size: 41px;\n  }\n\n\n  .hnblue-actions {\n    flex-direction: column;\n\n    gap: 15px;\n  }\n\n\n  .hnblue-button {\n    width: 100%;\n    max-width: 345px;\n  }\n\n\n  .hnblue-visual {\n    min-height: 420px;\n  }\n\n\n  .hnblue-image {\n    height: 325px;\n  }\n\n\n  .hnblue-benefits {\n    grid-template-columns: 1fr;\n  }\n\n\n  .hnblue-benefit:last-child {\n    grid-column: auto;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n  REMOVE CUSTOM HTML TOP/BOTTOM WHITE GAP\n  ---------------------------------------------------------\n  The theme may inject a blank title/spacer block before the\n  actual Custom HTML content. This cleanup only affects\n  wrappers OUTSIDE .hnblue-product.\n  ===================================================== */\n\n  function removeBlueCustomHtmlGap() {\n\n    var customSections =\n      document.querySelectorAll(\n        \".hnblue-product\"\n      );\n\n\n    customSections.forEach(\n      function (customSection) {\n\n        var parent =\n          customSection.parentElement;\n\n\n        /* Reset ancestor wrappers up to .shopify-section */\n\n        while (\n          parent &&\n          parent !== document.body\n        ) {\n\n          [\n            \"margin-top\",\n            \"margin-bottom\",\n            \"padding-top\",\n            \"padding-bottom\",\n            \"margin-block-start\",\n            \"margin-block-end\",\n            \"padding-block-start\",\n            \"padding-block-end\",\n            \"min-height\",\n            \"row-gap\",\n            \"column-gap\",\n            \"gap\"\n          ].forEach(\n            function (property) {\n\n              parent.style.setProperty(\n                property,\n                \"0\",\n                \"important\"\n              );\n\n            }\n          );\n\n\n          [\n            \"--section-padding-top\",\n            \"--section-padding-bottom\",\n            \"--section-spacing-top\",\n            \"--section-spacing-bottom\",\n            \"--spacing-top\",\n            \"--spacing-bottom\"\n          ].forEach(\n            function (property) {\n\n              parent.style.setProperty(\n                property,\n                \"0px\",\n                \"important\"\n              );\n\n            }\n          );\n\n\n          if (\n            parent.classList &&\n            parent.classList.contains(\n              \"shopify-section\"\n            )\n          ) {\n            break;\n          }\n\n\n          parent =\n            parent.parentElement;\n        }\n\n\n        var shopifySection =\n          customSection.closest(\n            \".shopify-section\"\n          );\n\n\n        if (!shopifySection) {\n          return;\n        }\n\n\n        /* Hide known theme heading/title wrappers */\n\n        var headingSelectors = [\n          \".section-heading\",\n          \".section__heading\",\n          \".section-title\",\n          \".section__title\",\n          \".section-header\",\n          \".section__header\",\n          \".section-head\",\n          \".heading-wrapper\",\n          \".title-wrapper\",\n          \".section-title-wrapper\",\n          '[class*=\"section-heading\"]',\n          '[class*=\"section__heading\"]',\n          '[class*=\"section-title\"]',\n          '[class*=\"section__title\"]'\n        ];\n\n\n        shopifySection\n          .querySelectorAll(\n            headingSelectors.join(\",\")\n          )\n          .forEach(\n            function (heading) {\n\n              if (\n                customSection.contains(\n                  heading\n                )\n              ) {\n                return;\n              }\n\n\n              heading.style.setProperty(\n                \"display\",\n                \"none\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"height\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"min-height\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"max-height\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"margin\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"padding\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"border\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"overflow\",\n                \"hidden\",\n                \"important\"\n              );\n\n            }\n          );\n\n\n        /*\n        Collapse anonymous EMPTY sibling blocks around the\n        branch containing .hnblue-product.\n\n        This catches a theme spacer even when its class name\n        is unknown.\n        */\n\n        var childInPath =\n          customSection;\n\n\n        var ancestor =\n          customSection.parentElement;\n\n\n        while (\n          ancestor &&\n          ancestor !== document.body\n        ) {\n\n          Array.prototype.slice\n            .call(\n              ancestor.children\n            )\n            .forEach(\n              function (sibling) {\n\n                if (\n                  sibling === childInPath ||\n                  sibling.contains(customSection) ||\n                  customSection.contains(sibling)\n                ) {\n                  return;\n                }\n\n\n                var text =\n                  (sibling.textContent || \"\")\n                    .replace(/\\s+/g, \"\");\n\n\n                var hasMeaningfulContent =\n                  sibling.querySelector(\n                    [\n                      \"img\",\n                      \"picture\",\n                      \"video\",\n                      \"iframe\",\n                      \"canvas\",\n                      \"form\",\n                      \"input\",\n                      \"select\",\n                      \"textarea\",\n                      \"button\",\n                      \"a[href]\",\n                      \"svg\",\n                      \"[role='button']\"\n                    ].join(\",\")\n                  );\n\n\n                if (\n                  text === \"\" &&\n                  !hasMeaningfulContent\n                ) {\n\n                  sibling.style.setProperty(\n                    \"display\",\n                    \"none\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"height\",\n                    \"0\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"min-height\",\n                    \"0\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"max-height\",\n                    \"0\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"margin\",\n                    \"0\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"padding\",\n                    \"0\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"border\",\n                    \"0\",\n                    \"important\"\n                  );\n\n                  sibling.style.setProperty(\n                    \"overflow\",\n                    \"hidden\",\n                    \"important\"\n                  );\n\n                }\n\n              }\n            );\n\n\n          if (\n            ancestor.classList &&\n            ancestor.classList.contains(\n              \"shopify-section\"\n            )\n          ) {\n            break;\n          }\n\n\n          childInPath =\n            ancestor;\n\n\n          ancestor =\n            ancestor.parentElement;\n        }\n\n\n        /*\n        Remove only EXTERNAL margin from the custom section.\n        Its internal top design padding remains unchanged.\n        */\n\n        customSection.style.setProperty(\n          \"margin-top\",\n          \"0\",\n          \"important\"\n        );\n\n        customSection.style.setProperty(\n          \"margin-bottom\",\n          \"0\",\n          \"important\"\n        );\n\n      }\n    );\n\n  }\n\n\n  removeBlueCustomHtmlGap();\n\n\n\n  var section =\n    document.getElementById(\n      \"hnblueProduct\"\n    );\n\n\n  if (!section) {\n    return;\n  }\n\n\n  var productUrl =\n    section.getAttribute(\n      \"data-product-url\"\n    );\n\n\n  var button =\n    document.getElementById(\n      \"hnblueProductButton\"\n    );\n\n\n  var imageLink =\n    document.getElementById(\n      \"hnblueImageLink\"\n    );\n\n\n  var price =\n    document.getElementById(\n      \"hnbluePrice\"\n    );\n\n\n  var sidePrice =\n    document.getElementById(\n      \"hnblueSidePrice\"\n    );\n\n\n  var compare =\n    document.getElementById(\n      \"hnblueCompare\"\n    );\n\n\n  if (button) {\n    button.href = productUrl;\n  }\n\n\n  if (imageLink) {\n    imageLink.href = productUrl;\n  }\n\n\n\n  /* =====================================================\n  PRICE REFRESH\n\n  IMPORTANT:\n  No \"Loading...\"\n  No \"Checking availability\"\n\n  Static ₹1,000 displays instantly.\n  Shopify silently updates it in background if changed.\n  ===================================================== */\n\n\n  function getHandle(url) {\n\n    try {\n\n      var parsed =\n        new URL(\n          url,\n          window.location.origin\n        );\n\n\n      var parts =\n        parsed.pathname\n        .split(\"/\")\n        .filter(Boolean);\n\n\n      var index =\n        parts.indexOf(\n          \"products\"\n        );\n\n\n      return (\n        index >= 0\n        ? parts[index + 1]\n        : \"\"\n      );\n\n\n    } catch (error) {\n\n      return \"\";\n\n    }\n\n  }\n\n\n\n  function money(cents) {\n\n    return new Intl.NumberFormat(\n      \"en-IN\",\n      {\n        style: \"currency\",\n        currency: \"INR\",\n        maximumFractionDigits: 0\n      }\n    ).format(\n      cents / 100\n    );\n\n  }\n\n\n\n  var handle =\n    getHandle(productUrl);\n\n\n  if (!handle) {\n    return;\n  }\n\n\n  fetch(\n    \"/products/\" +\n    handle +\n    \".js\",\n    {\n      credentials:\n        \"same-origin\"\n    }\n  )\n\n  .then(function (response) {\n\n    if (!response.ok) {\n      throw new Error();\n    }\n\n    return response.json();\n\n  })\n\n  .then(function (product) {\n\n    if (\n      !product.variants ||\n      !product.variants.length\n    ) {\n      return;\n    }\n\n\n    var variant =\n      product.variants[0];\n\n\n    var formatted =\n      money(\n        variant.price\n      );\n\n\n    price.textContent =\n      formatted;\n\n\n    sidePrice.textContent =\n      formatted;\n\n\n    if (\n      variant.compare_at_price &&\n      variant.compare_at_price >\n      variant.price\n    ) {\n\n      compare.textContent =\n        money(\n          variant.compare_at_price\n        );\n\n\n      compare.hidden =\n        false;\n\n    } else {\n\n      compare.hidden =\n        true;\n\n    }\n\n  })\n\n  .catch(function () {\n\n    /*\n    Intentionally do nothing.\n\n    Static ₹1,000 remains visible.\n    No error/loading message is shown to customer.\n    */\n\n  });\n\n\n\n\n  /* =====================================================\n  RE-APPLY GAP FIX AFTER SHOPIFY/THEME RENDERING\n  ===================================================== */\n\n  requestAnimationFrame(\n    function () {\n      removeBlueCustomHtmlGap();\n    }\n  );\n\n\n  setTimeout(\n    removeBlueCustomHtmlGap,\n    50\n  );\n\n\n  setTimeout(\n    removeBlueCustomHtmlGap,\n    250\n  );\n\n\n  setTimeout(\n    removeBlueCustomHtmlGap,\n    700\n  );\n\n\n  setTimeout(\n    removeBlueCustomHtmlGap,\n    1500\n  );\n\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    function () {\n\n      removeBlueCustomHtmlGap();\n\n\n      setTimeout(\n        removeBlueCustomHtmlGap,\n        100\n      );\n\n\n      setTimeout(\n        removeBlueCustomHtmlGap,\n        400\n      );\n\n    }\n  );\n\n\n})();\n\n</script>"
      }
    },
    "custom_html_kxjGNV": {
      "type": "custom-html",
      "name": "Custom html",
      "settings": {
        "section_padding_top": 0,
        "section_padding_bottom": 0,
        "section_padding_top_ip": 0,
        "section_padding_bottom_ip": 0,
        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 0,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<section class=\"hn-toys\" id=\"hnToysCollection\" data-collection-handle=\"wooden-kids-toys\" aria-labelledby=\"hnToysTitle\">\n\n  <div class=\"hn-toys__decor\" aria-hidden=\"true\">\n    <span class=\"hn-toys__orb hn-toys__orb--one\"></span>\n    <span class=\"hn-toys__orb hn-toys__orb--two\"></span>\n    <span class=\"hn-toys__accent hn-toys__accent--one\"></span>\n    <span class=\"hn-toys__accent hn-toys__accent--two\"></span>\n  </div>\n\n  <div class=\"hn-toys__shell\">\n\n    <header class=\"hn-toys__header\">\n\n      <div class=\"hn-toys__header-copy\">\n\n        <div class=\"hn-toys__eyebrow\">\n          <span></span>\n          WOODEN KIDS TOYS\n        </div>\n\n        <h2 class=\"hn-toys__title\" id=\"hnToysTitle\">\n          Wooden Wonders\n          <em>for Little Explorers</em>\n        </h2>\n\n        <p class=\"hn-toys__description\">\n          Discover thoughtfully crafted wooden kids toys designed to encourage\n          imaginative play, hands-on learning and joyful screen-free moments\n          for curious little explorers.\n        </p>\n\n      </div>\n\n      <div class=\"hn-toys__header-side\">\n\n        <span class=\"hn-toys__count\" id=\"hnToysCount\">\n          Loading collection…\n        </span>\n\n        <a class=\"hn-toys__view-all\" href=\"/collections/wooden-kids-toys\" aria-label=\"Explore the Wooden Kids Toys collection\">\n          <span>Explore Collection</span>\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </a>\n\n      </div>\n\n    </header>\n\n    <div class=\"hn-toys__toolbar\">\n\n      <div class=\"hn-toys__toolbar-note\">\n        <span class=\"hn-toys__toolbar-icon\" aria-hidden=\"true\">✦</span>\n\n        <span>\n          A playful edit of\n          <strong>wooden toys made for curious minds</strong>\n        </span>\n      </div>\n\n      <div class=\"hn-toys__controls\">\n\n        <button type=\"button\" class=\"hn-toys__arrow hn-toys__arrow--prev\" aria-label=\"View previous wooden kids toys\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </button>\n\n        <button type=\"button\" class=\"hn-toys__arrow hn-toys__arrow--next\" aria-label=\"View next wooden kids toys\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n    </div>\n\n    <div class=\"hn-toys__loading\" id=\"hnToysLoading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-toys__loader\" aria-hidden=\"true\"></span>\n      <span>Loading wooden kids toys…</span>\n    </div>\n\n    <div class=\"hn-toys__viewport\" id=\"hnToysViewport\" aria-label=\"Wooden Kids Toys products\" hidden=\"\">\n      <div class=\"hn-toys__track\" id=\"hnToysTrack\"></div>\n    </div>\n\n    <div class=\"hn-toys__empty\" id=\"hnToysEmpty\" hidden=\"\">\n      The Wooden Kids Toys collection could not be loaded right now.\n      Please use the Explore Collection button to view all products.\n    </div>\n\n    <noscript>\n      <div class=\"hn-toys__noscript\">\n        <a href=\"/collections/wooden-kids-toys\">\n          View the Wooden Kids Toys Collection\n        </a>\n      </div>\n    </noscript>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* =========================================================\n   THEME / CUSTOM HTML WRAPPER RESET\n========================================================= */\n\n.shopify-section:has(.hn-toys) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n.shopify-section:has(.hn-toys) > div,\n.shopify-section:has(.hn-toys) > div > div,\n.shopify-section:has(.hn-toys) .section,\n.shopify-section:has(.hn-toys) .section-padding,\n.shopify-section:has(.hn-toys) .section__wrapper,\n.shopify-section:has(.hn-toys) .section-wrapper,\n.shopify-section:has(.hn-toys) .custom-html,\n.shopify-section:has(.hn-toys) .custom-html-wrapper,\n.shopify-section:has(.hn-toys) .custom-html-section,\n.shopify-section:has(.hn-toys) .page-width,\n.shopify-section:has(.hn-toys) .container,\n.shopify-section:has(.hn-toys) .container-fluid {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  min-height: 0 !important;\n\n  gap: 0 !important;\n  row-gap: 0 !important;\n  column-gap: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n.shopify-section:has(.hn-toys) .page-width,\n.shopify-section:has(.hn-toys) .container,\n.shopify-section:has(.hn-toys) .container-fluid,\n.shopify-section:has(.hn-toys) .custom-html,\n.shopify-section:has(.hn-toys) .custom-html-wrapper,\n.shopify-section:has(.hn-toys) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n.shopify-section:has(.hn-toys) .section-heading,\n.shopify-section:has(.hn-toys) .section__heading,\n.shopify-section:has(.hn-toys) .section-title,\n.shopify-section:has(.hn-toys) .section__title,\n.shopify-section:has(.hn-toys) .section-header,\n.shopify-section:has(.hn-toys) .section__header,\n.shopify-section:has(.hn-toys) .section-head,\n.shopify-section:has(.hn-toys) .heading-wrapper,\n.shopify-section:has(.hn-toys) .title-wrapper,\n.shopify-section:has(.hn-toys) .section-title-wrapper,\n.shopify-section:has(.hn-toys) [class*=\"section-heading\"],\n.shopify-section:has(.hn-toys) [class*=\"section__heading\"],\n.shopify-section:has(.hn-toys) [class*=\"section-title\"],\n.shopify-section:has(.hn-toys) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n  overflow: hidden !important;\n}\n\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.hn-toys {\n  --hnt-blue: #2f665e;\n  --hnt-blue-dark: #214b46;\n\n  --hnt-coral: #e5a23c;\n  --hnt-coral-dark: #b9781f;\n\n  --hnt-gold: #d9a84e;\n\n  --hnt-bg: #f3f7ef;\n  --hnt-bg-warm: #fff4df;\n\n  --hnt-heading: #243a34;\n  --hnt-text: #6c786f;\n\n  position: relative;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin:\n    0\n    calc(50% - 50vw);\n\n  padding: 0 !important;\n\n  overflow: hidden;\n\n  background:\n    radial-gradient(\n      circle at 6% 8%,\n      rgba(229,162,60,.18),\n      transparent 25%\n    ),\n    radial-gradient(\n      circle at 96% 92%,\n      rgba(47,102,94,.14),\n      transparent 29%\n    ),\n    linear-gradient(\n      135deg,\n      #f1f7f1 0%,\n      #fbf7ec 52%,\n      #fff0d7 100%\n    );\n\n  color: var(--hnt-heading);\n\n  isolation: isolate;\n}\n\n\n.hn-toys *,\n.hn-toys *::before,\n.hn-toys *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   DECOR\n========================================================= */\n\n.hn-toys__decor {\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n}\n\n\n.hn-toys__orb {\n  position: absolute;\n\n  border-radius: 50%;\n}\n\n\n.hn-toys__orb--one {\n  width: 500px;\n  height: 500px;\n\n  top: -340px;\n  right: 8%;\n\n  border:\n    1px solid\n    rgba(47,102,94,.10);\n\n  box-shadow:\n    0 0 0 62px rgba(47,102,94,.024),\n    0 0 0 124px rgba(47,102,94,.016);\n}\n\n\n.hn-toys__orb--two {\n  width: 420px;\n  height: 420px;\n\n  left: -225px;\n  bottom: -275px;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(229,162,60,.16),\n      transparent 70%\n    );\n}\n\n\n.hn-toys__accent {\n  position: absolute;\n\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(47,102,94,.11),\n      transparent\n    );\n}\n\n\n.hn-toys__accent--one {\n  width: 47%;\n\n  left: -8%;\n  top: 18%;\n\n  transform: rotate(-8deg);\n}\n\n\n.hn-toys__accent--two {\n  width: 45%;\n\n  right: -8%;\n  bottom: 14%;\n\n  transform: rotate(8deg);\n}\n\n\n/* =========================================================\n   INTERNAL LAYOUT\n   Outer .hn-toys has ZERO padding.\n========================================================= */\n\n.hn-toys__shell {\n  position: relative;\n\n  z-index: 5;\n\n  width: 100%;\n  max-width: 1540px;\n\n  margin: 0 auto;\n\n  padding:\n    clamp(44px, 4.7vw, 72px)\n    clamp(22px, 4.8vw, 72px)\n    clamp(44px, 4.7vw, 72px);\n}\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n.hn-toys__header {\n  display: flex;\n\n  align-items: flex-end;\n  justify-content: space-between;\n\n  gap: 36px;\n}\n\n\n.hn-toys__header-copy {\n  max-width: 820px;\n}\n\n\n.hn-toys__eyebrow {\n  display: flex;\n\n  align-items: center;\n\n  gap: 11px;\n\n  margin-bottom: 12px;\n\n  color: var(--hnt-coral-dark);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size: 9px;\n  font-weight: 800;\n\n  line-height: 1.3;\n\n  letter-spacing: .21em;\n\n  text-transform: uppercase;\n}\n\n\n.hn-toys__eyebrow > span {\n  display: block;\n\n  width: 28px;\n  height: 1px;\n\n  background: currentColor;\n}\n\n\n.hn-toys__title {\n  margin: 0;\n\n  color: var(--hnt-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      38px,\n      4vw,\n      64px\n    );\n\n  font-weight: 500;\n\n  line-height: .98;\n\n  letter-spacing: -.045em;\n}\n\n\n.hn-toys__title em {\n  display: inline;\n\n  color: var(--hnt-coral);\n\n  font-weight: 400;\n  font-style: italic;\n}\n\n\n.hn-toys__description {\n  max-width: 740px;\n\n  margin:\n    16px\n    0\n    0;\n\n  color: var(--hnt-text);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n    clamp(\n      13px,\n      .95vw,\n      15.5px\n    );\n\n  line-height: 1.68;\n}\n\n\n/* =========================================================\n   HEADER SIDE\n========================================================= */\n\n.hn-toys__header-side {\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: flex-end;\n\n  gap: 13px;\n\n  flex:\n    0 0 auto;\n}\n\n\n.hn-toys__count {\n  display: inline-flex;\n\n  align-items: center;\n\n  min-height: 31px;\n\n  padding:\n    7px\n    12px;\n\n  border:\n    1px solid\n    rgba(47,102,94,.12);\n\n  border-radius: 999px;\n\n  background:\n    rgba(255,255,255,.56);\n\n  color: var(--hnt-blue);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 8px;\n  font-weight: 800;\n\n  line-height: 1;\n\n  letter-spacing: .09em;\n\n  text-transform: uppercase;\n}\n\n\n.hn-toys__view-all {\n  position: relative;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 13px;\n\n  min-height: 48px;\n\n  padding:\n    12px\n    18px;\n\n  overflow: hidden;\n\n  border:\n    1px solid\n    var(--hnt-blue-dark);\n\n  border-radius: 8px;\n\n  background:\n    linear-gradient(\n      135deg,\n      var(--hnt-blue),\n      var(--hnt-blue-dark)\n    );\n\n  box-shadow:\n    0 12px 26px\n    rgba(33,75,70,.16);\n\n  color: #ffffff !important;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 11.5px;\n  font-weight: 700;\n\n  text-decoration: none !important;\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-toys__view-all:hover {\n  transform:\n    translateY(-2px);\n\n  box-shadow:\n    0 17px 31px\n    rgba(33,75,70,.22);\n}\n\n\n.hn-toys__view-all:focus-visible {\n  outline:\n    2px solid\n    var(--hnt-coral);\n\n  outline-offset: 3px;\n}\n\n\n.hn-toys__view-all svg {\n  width: 17px;\n  height: 17px;\n\n  transition:\n    transform .25s ease;\n}\n\n\n.hn-toys__view-all:hover svg {\n  transform:\n    translateX(4px);\n}\n\n\n/* =========================================================\n   TOOLBAR\n========================================================= */\n\n.hn-toys__toolbar {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 24px;\n\n  margin-top: 31px;\n\n  padding-top: 20px;\n\n  border-top:\n    1px solid\n    rgba(47,102,94,.10);\n}\n\n\n.hn-toys__toolbar-note {\n  display: flex;\n\n  align-items: center;\n\n  gap: 9px;\n\n  color: #798491;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 10px;\n\n  line-height: 1.4;\n}\n\n\n.hn-toys__toolbar-note strong {\n  color: var(--hnt-blue);\n\n  font-weight: 700;\n}\n\n\n.hn-toys__toolbar-icon {\n  color: var(--hnt-coral);\n\n  font-size: 17px;\n}\n\n\n/* =========================================================\n   CONTROLS\n========================================================= */\n\n.hn-toys__controls {\n  display: flex;\n\n  align-items: center;\n\n  gap: 8px;\n}\n\n\n.hn-toys__arrow {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 42px;\n  height: 42px;\n\n  min-width: 42px;\n  min-height: 42px;\n\n  padding: 0;\n\n  border:\n    1px solid\n    rgba(47,102,94,.14);\n\n  border-radius: 50%;\n\n  background:\n    rgba(255,255,255,.72);\n\n  color: var(--hnt-blue);\n\n  box-shadow:\n    0 7px 18px\n    rgba(33,75,70,.06);\n\n  cursor: pointer;\n\n  transition:\n    color .25s ease,\n    background .25s ease,\n    border-color .25s ease,\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-toys__arrow:hover {\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hnt-coral);\n\n  background:\n    var(--hnt-coral);\n\n  color: #ffffff;\n\n  box-shadow:\n    0 10px 21px\n    rgba(185,120,31,.18);\n}\n\n\n.hn-toys__arrow:focus-visible {\n  outline:\n    2px solid\n    var(--hnt-coral);\n\n  outline-offset: 3px;\n}\n\n\n.hn-toys__arrow svg {\n  width: 17px;\n  height: 17px;\n}\n\n\n/* =========================================================\n   CAROUSEL\n========================================================= */\n\n.hn-toys__viewport {\n  width: 100%;\n\n  margin-top: 18px;\n\n  overflow: hidden;\n\n  touch-action: pan-y;\n}\n\n\n.hn-toys__viewport[hidden],\n.hn-toys__loading[hidden],\n.hn-toys__empty[hidden] {\n  display: none !important;\n}\n\n\n.hn-toys__track {\n  display: flex;\n\n  align-items: stretch;\n\n  gap: 18px;\n\n  width: max-content;\n\n  will-change: transform;\n\n  transform:\n    translate3d(\n      0,\n      0,\n      0\n    );\n}\n\n\n/* =========================================================\n   PRODUCT CARD\n========================================================= */\n\n.hn-toys__card {\n  position: relative;\n\n  flex:\n    0\n    0\n    auto;\n\n  min-width: 0;\n\n  overflow: hidden;\n\n  border:\n    1px solid\n    rgba(47,102,94,.11);\n\n  border-radius: 18px;\n\n  background:\n    rgba(255,255,255,.84);\n\n  box-shadow:\n    0 13px 28px\n    rgba(33,75,70,.07);\n\n  transition:\n    transform .30s ease,\n    border-color .30s ease,\n    box-shadow .30s ease;\n}\n\n\n.hn-toys__card:hover {\n  transform:\n    translateY(-5px);\n\n  border-color:\n    rgba(229,162,60,.36);\n\n  box-shadow:\n    0 20px 38px\n    rgba(33,75,70,.12);\n}\n\n\n/* =========================================================\n   IMAGE\n========================================================= */\n\n.hn-toys__image-link {\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  aspect-ratio: 1 / 1;\n\n  overflow: hidden;\n\n  background:\n    linear-gradient(\n      145deg,\n      #f3f4ec,\n      #e7eee8\n    );\n}\n\n\n.hn-toys__image {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n  object-position: center;\n\n  transition:\n    transform\n    .65s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n.hn-toys__card:hover\n.hn-toys__image {\n  transform:\n    scale(1.05);\n}\n\n\n.hn-toys__image-placeholder {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  height: 100%;\n\n  padding: 28px;\n\n  color: var(--hnt-blue);\n\n  font-family:\n    Georgia,\n    serif;\n\n  font-size: 17px;\n\n  line-height: 1.4;\n\n  text-align: center;\n}\n\n\n/* =========================================================\n   BADGES\n========================================================= */\n\n.hn-toys__badge {\n  position: absolute;\n\n  z-index: 3;\n\n  top: 12px;\n  left: 12px;\n\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 6px;\n\n  min-height: 27px;\n\n  padding:\n    6px\n    10px;\n\n  border:\n    1px solid\n    rgba(255,255,255,.30);\n\n  border-radius: 999px;\n\n  background:\n    rgba(47,102,94,.93);\n\n  color: #ffffff;\n\n  box-shadow:\n    0 8px 18px\n    rgba(33,75,70,.18);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 7.5px;\n  font-weight: 800;\n\n  line-height: 1;\n\n  letter-spacing: .09em;\n\n  text-transform: uppercase;\n}\n\n\n.hn-toys__badge::before {\n  content: \"\";\n\n  width: 5px;\n  height: 5px;\n\n  flex:\n    0\n    0\n    5px;\n\n  border-radius: 50%;\n\n  background: #f0ac83;\n}\n\n\n.hn-toys__sold-out {\n  position: absolute;\n\n  z-index: 3;\n\n  top: 12px;\n  right: 12px;\n\n  display: inline-flex;\n\n  align-items: center;\n\n  min-height: 27px;\n\n  padding:\n    6px\n    9px;\n\n  border-radius: 999px;\n\n  background:\n    rgba(229,162,60,.96);\n\n  color: #ffffff;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 7px;\n  font-weight: 800;\n\n  line-height: 1;\n\n  letter-spacing: .08em;\n\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   CARD CONTENT\n========================================================= */\n\n.hn-toys__card-content {\n  padding:\n    15px\n    15px\n    16px;\n}\n\n\n.hn-toys__vendor {\n  margin:\n    0\n    0\n    5px;\n\n  overflow: hidden;\n\n  color: var(--hnt-coral-dark);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 7.5px;\n  font-weight: 800;\n\n  line-height: 1.3;\n\n  letter-spacing: .12em;\n\n  text-overflow: ellipsis;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n\n.hn-toys__product-title {\n  min-height: 46px;\n\n  margin: 0;\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size: 16.5px;\n  font-weight: 500;\n\n  line-height: 1.33;\n}\n\n\n.hn-toys__product-title a {\n  display:\n    -webkit-box;\n\n  overflow: hidden;\n\n  color: var(--hnt-heading);\n\n  text-decoration: none;\n\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n\n  transition:\n    color .22s ease;\n}\n\n\n.hn-toys__product-title a:hover {\n  color: var(--hnt-coral-dark);\n}\n\n\n/* =========================================================\n   PRICE + LINK\n========================================================= */\n\n.hn-toys__card-bottom {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 10px;\n\n  margin-top: 13px;\n\n  padding-top: 12px;\n\n  border-top:\n    1px solid\n    rgba(47,102,94,.08);\n}\n\n\n.hn-toys__prices {\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: flex-start;\n\n  gap: 2px;\n\n  min-width: 0;\n}\n\n\n.hn-toys__price {\n  color: var(--hnt-blue-dark);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 15px;\n  font-weight: 800;\n\n  line-height: 1.2;\n}\n\n\n.hn-toys__compare {\n  color: #9299a4;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 9.5px;\n\n  line-height: 1.2;\n\n  text-decoration: line-through;\n}\n\n\n.hn-toys__product-link {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-height: 38px;\n\n  padding:\n    9px\n    13px;\n\n  border:\n    1px solid\n    rgba(47,102,94,.14);\n\n  border-radius: 999px;\n\n  background:\n    var(--hnt-blue);\n\n  color: #ffffff !important;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 9.5px;\n  font-weight: 750;\n\n  line-height: 1;\n\n  white-space: nowrap;\n\n  text-decoration: none !important;\n\n  transition:\n    background .25s ease,\n    border-color .25s ease,\n    transform .25s ease;\n}\n\n\n.hn-toys__product-link:hover {\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hnt-coral);\n\n  background:\n    var(--hnt-coral);\n}\n\n\n.hn-toys__product-link:focus-visible {\n  outline:\n    2px solid\n    var(--hnt-coral);\n\n  outline-offset: 3px;\n}\n\n\n/* =========================================================\n   LOADING\n========================================================= */\n\n.hn-toys__loading {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 11px;\n\n  min-height: 250px;\n\n  color: #75818e;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 11px;\n}\n\n\n.hn-toys__loader {\n  width: 24px;\n  height: 24px;\n\n  border:\n    3px solid\n    rgba(47,102,94,.12);\n\n  border-top-color:\n    var(--hnt-coral);\n\n  border-radius: 50%;\n\n  animation:\n    hnToysSpin\n    .8s\n    linear\n    infinite;\n}\n\n\n@keyframes hnToysSpin {\n  to {\n    transform:\n      rotate(360deg);\n  }\n}\n\n\n/* =========================================================\n   EMPTY / NOSCRIPT\n========================================================= */\n\n.hn-toys__empty,\n.hn-toys__noscript {\n  margin-top: 20px;\n\n  padding:\n    30px\n    20px;\n\n  border:\n    1px solid\n    rgba(47,102,94,.10);\n\n  border-radius: 15px;\n\n  background:\n    rgba(255,255,255,.72);\n\n  color: var(--hnt-text);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 12px;\n\n  line-height: 1.6;\n\n  text-align: center;\n}\n\n\n.hn-toys__noscript a {\n  color: var(--hnt-blue);\n\n  font-weight: 700;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and (max-width: 1050px) {\n\n  .hn-toys__header {\n    align-items: flex-start;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL TABLET\n========================================================= */\n\n@media screen and (max-width: 820px) {\n\n  .hn-toys__header {\n    flex-direction: column;\n\n    gap: 20px;\n  }\n\n\n  .hn-toys__header-side {\n    align-items: flex-start;\n\n    flex-direction: row;\n\n    flex-wrap: wrap;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 580px) {\n\n  .hn-toys__shell {\n    padding:\n      38px\n      14px\n      40px;\n  }\n\n\n  .hn-toys__title {\n    font-size: 36px;\n\n    line-height: 1.02;\n  }\n\n\n  .hn-toys__title em {\n    display: block;\n\n    margin-top: 4px;\n  }\n\n\n  .hn-toys__description {\n    font-size: 12.5px;\n\n    line-height: 1.62;\n  }\n\n\n  .hn-toys__header-side {\n    width: 100%;\n\n    align-items: stretch;\n\n    flex-direction: column;\n  }\n\n\n  .hn-toys__view-all {\n    width: 100%;\n  }\n\n\n  .hn-toys__toolbar {\n    align-items: flex-end;\n\n    margin-top: 23px;\n  }\n\n\n  .hn-toys__toolbar-note {\n    max-width: 210px;\n\n    font-size: 9px;\n  }\n\n\n  .hn-toys__controls {\n    flex:\n      0\n      0\n      auto;\n  }\n\n\n  .hn-toys__arrow {\n    width: 44px;\n    height: 44px;\n\n    min-width: 44px;\n    min-height: 44px;\n  }\n\n\n  .hn-toys__card-content {\n    padding:\n      14px\n      14px\n      15px;\n  }\n\n\n  .hn-toys__product-title {\n    min-height: 43px;\n\n    font-size: 16px;\n  }\n\n\n  .hn-toys__card-bottom {\n    align-items: flex-end;\n  }\n\n}\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 370px) {\n\n  .hn-toys__product-link {\n    padding:\n      9px\n      11px;\n\n    font-size: 9px;\n  }\n\n}\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hn-toys__track,\n  .hn-toys__card,\n  .hn-toys__image,\n  .hn-toys__arrow,\n  .hn-toys__view-all,\n  .hn-toys__view-all svg,\n  .hn-toys__product-link {\n    transition:\n      none !important;\n  }\n\n\n  .hn-toys__loader {\n    animation:\n      none;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  function initialiseToysCollection(root) {\n\n    if (\n      !root ||\n      root.dataset.initialised === \"true\"\n    ) {\n      return;\n    }\n\n\n    root.dataset.initialised =\n      \"true\";\n\n\n    var handle =\n      root.getAttribute(\n        \"data-collection-handle\"\n      ) ||\n      \"wooden-kids-toys\";\n\n\n    var loading =\n      root.querySelector(\n        \"#hnToysLoading\"\n      );\n\n\n    var empty =\n      root.querySelector(\n        \"#hnToysEmpty\"\n      );\n\n\n    var viewport =\n      root.querySelector(\n        \"#hnToys