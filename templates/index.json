\n  left:\n    50%;\n\n\n  width:\n    100vw;\n\n\n  margin-top:\n    30px;\n\n\n  margin-left:\n    -50vw;\n\n\n  padding:\n\n    22px\n    clamp(\n      25px,\n      5.5vw,\n      105px\n    );\n\n\n  border-top:\n\n    1px solid\n    rgba(\n      229,\n      195,\n      138,\n      .25\n    );\n\n\n  border-bottom:\n\n    1px solid\n    rgba(\n      229,\n      195,\n      138,\n      .20\n    );\n\n\n  background:\n\n    radial-gradient(\n\n      circle at 50% 0%,\n\n      rgba(\n        43,\n        80,\n        119,\n        .58\n      ),\n\n      transparent\n      42%\n\n    ),\n\n    linear-gradient(\n\n      135deg,\n\n      #12365f 0%,\n\n      #081f3a 48%,\n\n      #05172c 100%\n\n    );\n\n\n  box-shadow:\n\n    inset\n    0\n    1px\n    0\n    rgba(\n      255,\n      255,\n      255,\n      .06\n    );\n\n}\n\n\n\n/* =========================================================\n   BENEFITS GRID\n========================================================= */\n\n.hnhero-benefits {\n\n  display:\n    grid;\n\n\n  grid-template-columns:\n\n    repeat(\n      5,\n      minmax(\n        0,\n        1fr\n      )\n    );\n\n\n  gap:\n    12px;\n\n\n  width:\n    100%;\n\n\n  max-width:\n    1580px;\n\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* =========================================================\n   BENEFIT CARD\n========================================================= */\n\n.hnhero-benefit {\n\n  position:\n    relative;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    13px;\n\n\n  min-height:\n    89px;\n\n\n  padding:\n\n    12px\n    16px;\n\n\n  border:\n\n    1px solid\n    rgba(\n      255,\n      255,\n      255,\n      .09\n    );\n\n\n  border-radius:\n    13px;\n\n\n  background:\n\n    linear-gradient(\n\n      135deg,\n\n      rgba(\n        255,\n        255,\n        255,\n        .075\n      ),\n\n      rgba(\n        255,\n        255,\n        255,\n        .025\n      )\n\n    );\n\n\n  box-shadow:\n\n    inset\n    0\n    1px\n    0\n    rgba(\n      255,\n      255,\n      255,\n      .06\n    );\n\n\n  backdrop-filter:\n    blur(6px);\n\n\n  -webkit-backdrop-filter:\n    blur(6px);\n\n\n  transition:\n\n    transform\n    .25s\n    ease,\n\n    border-color\n    .25s\n    ease,\n\n    background\n    .25s\n    ease;\n\n}\n\n\n\n.hnhero-benefit:hover {\n\n  transform:\n    translateY(-3px);\n\n\n  border-color:\n\n    rgba(\n      229,\n      195,\n      138,\n      .29\n    );\n\n\n  background:\n\n    linear-gradient(\n\n      135deg,\n\n      rgba(\n        255,\n        255,\n        255,\n        .11\n      ),\n\n      rgba(\n        255,\n        255,\n        255,\n        .04\n      )\n\n    );\n\n}\n\n\n\n.hnhero-benefit-icon {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  width:\n    44px;\n\n\n  height:\n    44px;\n\n\n  flex:\n\n    0\n    0\n    44px;\n\n\n  border:\n\n    1px solid\n    rgba(\n      229,\n      195,\n      138,\n      .38\n    );\n\n\n  border-radius:\n    50%;\n\n\n  background:\n\n    radial-gradient(\n\n      circle at 35% 30%,\n\n      rgba(\n        229,\n        195,\n        138,\n        .25\n      ),\n\n      rgba(\n        229,\n        195,\n        138,\n        .06\n      )\n\n    );\n\n\n  color:\n    var(--hn-gold-soft);\n\n\n  box-shadow:\n\n    0\n    8px\n    20px\n    rgba(\n      0,\n      0,\n      0,\n      .10\n    );\n\n}\n\n\n\n.hnhero-benefit-icon svg {\n\n  width:\n    21px;\n\n\n  height:\n    21px;\n\n}\n\n\n\n.hnhero-benefit > span:last-child {\n\n  display:\n    block;\n\n\n  min-width:\n    0;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  line-height:\n    1.25;\n\n}\n\n\n\n.hnhero-benefit small {\n\n  display:\n    block;\n\n\n  margin-bottom:\n    4px;\n\n\n  color:\n    var(--hn-gold-soft);\n\n\n  font-size:\n    7px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .17em;\n\n}\n\n\n\n.hnhero-benefit strong {\n\n  display:\n    block;\n\n\n  color:\n    #ffffff;\n\n\n  font-size:\n    11.5px;\n\n\n  font-weight:\n    700;\n\n\n  line-height:\n    1.25;\n\n}\n\n\n\n.hnhero-benefit em {\n\n  display:\n    block;\n\n\n  margin-top:\n    4px;\n\n\n  color:\n\n    rgba(\n      255,\n      255,\n      255,\n      .58\n    );\n\n\n  font-size:\n    8.5px;\n\n\n  font-style:\n    normal;\n\n\n  line-height:\n    1.25;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and (max-width: 1150px) {\n\n\n  .hnhero-product {\n\n    padding-left:\n      40px;\n\n\n    padding-right:\n      40px;\n\n  }\n\n\n\n  .hnhero-inner {\n\n    grid-template-columns:\n\n      minmax(\n        0,\n        1fr\n      )\n\n      minmax(\n        410px,\n        .95fr\n      );\n\n\n    gap:\n      30px;\n\n\n    min-height:\n      650px;\n\n  }\n\n\n\n  .hnhero-title {\n\n    font-size:\n\n      clamp(\n        46px,\n        5.8vw,\n        68px\n      );\n\n  }\n\n\n\n  .hnhero-specs {\n\n    gap:\n      8px;\n\n  }\n\n\n\n  .hnhero-spec-card {\n\n    padding:\n\n      11px\n      10px;\n\n  }\n\n\n\n  .hnhero-spec-copy strong {\n\n    font-size:\n      9px;\n\n  }\n\n\n\n  .hnhero-spec-copy em {\n\n    font-size:\n      7.5px;\n\n  }\n\n\n\n  .hnhero-image-link {\n\n    width:\n\n      min(\n        85%,\n        500px\n      );\n\n  }\n\n\n\n  .hnhero-image {\n\n    height:\n      465px;\n\n  }\n\n\n\n  .hnhero-benefits {\n\n    grid-template-columns:\n\n      repeat(\n        3,\n        1fr\n      );\n\n  }\n\n\n\n  .hnhero-benefit:nth-child(4),\n  .hnhero-benefit:nth-child(5) {\n\n    grid-column:\n      span 1;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n\n  .hnhero-product {\n\n    padding:\n\n      52px\n      18px\n      0;\n\n  }\n\n\n\n  .hnhero-inner {\n\n    display:\n      flex;\n\n\n    flex-direction:\n      column;\n\n\n    gap:\n      22px;\n\n\n    min-height:\n      0;\n\n  }\n\n\n\n  .hnhero-content {\n\n    width:\n      100%;\n\n\n    max-width:\n      600px;\n\n\n    text-align:\n      center;\n\n  }\n\n\n\n  .hnhero-eyebrow {\n\n    justify-content:\n      center;\n\n  }\n\n\n\n  .hnhero-kicker {\n\n    font-size:\n      16px;\n\n  }\n\n\n\n  .hnhero-title {\n\n    font-size:\n\n      clamp(\n        43px,\n        13vw,\n        63px\n      );\n\n  }\n\n\n\n  .hnhero-ornament {\n\n    justify-content:\n      center;\n\n\n    margin-left:\n      auto;\n\n\n    margin-right:\n      auto;\n\n  }\n\n\n\n  .hnhero-price-row {\n\n    justify-content:\n      center;\n\n  }\n\n\n\n  .hnhero-description {\n\n    margin:\n\n      19px\n      auto\n      0;\n\n\n    max-width:\n      510px;\n\n\n    font-size:\n      13px;\n\n  }\n\n\n\n  /* PRODUCT SPECS */\n\n  .hnhero-specs {\n\n    grid-template-columns:\n      1fr;\n\n\n    max-width:\n      430px;\n\n\n    margin:\n\n      25px\n      auto\n      0;\n\n  }\n\n\n\n  .hnhero-spec-card {\n\n    min-height:\n      69px;\n\n\n    padding:\n\n      11px\n      15px;\n\n\n    text-align:\n      left;\n\n  }\n\n\n\n  .hnhero-spec-copy strong {\n\n    font-size:\n      10.5px;\n\n  }\n\n\n\n  .hnhero-spec-copy em {\n\n    font-size:\n      8px;\n\n  }\n\n\n\n  /* CTA */\n\n  .hnhero-actions {\n\n    justify-content:\n      center;\n\n\n    margin-top:\n      27px;\n\n  }\n\n\n\n  .hnhero-trust {\n\n    justify-content:\n      center;\n\n\n    margin-left:\n      auto;\n\n\n    margin-right:\n      auto;\n\n\n    text-align:\n      left;\n\n  }\n\n\n\n  /* PRODUCT */\n\n  .hnhero-visual {\n\n    min-height:\n      520px;\n\n  }\n\n\n\n  .hnhero-image-link {\n\n    width:\n\n      min(\n        90%,\n        430px\n      );\n\n\n    bottom:\n      111px;\n\n  }\n\n\n\n  .hnhero-image {\n\n    height:\n      405px;\n\n  }\n\n\n\n  .hnhero-floor-shadow {\n\n    bottom:\n      96px;\n\n\n    width:\n      300px;\n\n  }\n\n\n\n  .hnhero-podium {\n\n    width:\n\n      min(\n        94%,\n        455px\n      );\n\n\n    height:\n      135px;\n\n\n    margin-bottom:\n      25px;\n\n  }\n\n\n\n  .hnhero-badge {\n\n    top:\n      15px;\n\n\n    right:\n      0;\n\n  }\n\n\n\n  .hnhero-side-price {\n\n    display:\n      none;\n\n  }\n\n\n\n  .hnhero-floating-card {\n\n    right:\n      0;\n\n\n    bottom:\n      32px;\n\n  }\n\n\n\n  .hnhero-halo-1 {\n\n    width:\n      430px;\n\n\n    height:\n      430px;\n\n  }\n\n\n\n  .hnhero-halo-2 {\n\n    width:\n      350px;\n\n\n    height:\n      350px;\n\n  }\n\n\n\n  /* BOTTOM BENEFITS */\n\n  .hnhero-benefit-wrap {\n\n    margin-top:\n      20px;\n\n\n    padding:\n\n      18px\n      15px;\n\n  }\n\n\n\n  .hnhero-benefits {\n\n    grid-template-columns:\n\n      1fr\n      1fr;\n\n\n    gap:\n      9px;\n\n  }\n\n\n\n  .hnhero-benefit {\n\n    min-height:\n      83px;\n\n\n    padding:\n\n      11px\n      12px;\n\n  }\n\n\n\n  .hnhero-benefit:last-child {\n\n    grid-column:\n      1 / -1;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 450px) {\n\n\n  .hnhero-title {\n\n    font-size:\n      42px;\n\n  }\n\n\n\n  .hnhero-primary-button {\n\n    width:\n      100%;\n\n\n    max-width:\n      350px;\n\n  }\n\n\n\n  .hnhero-actions {\n\n    display:\n      flex;\n\n\n    flex-direction:\n      column;\n\n\n    gap:\n      16px;\n\n  }\n\n\n\n  .hnhero-visual {\n\n    min-height:\n      435px;\n\n  }\n\n\n\n  .hnhero-image-link {\n\n    width:\n      min(94%, 370px);\n\n\n    bottom:\n      100px;\n\n  }\n\n\n\n  .hnhero-image {\n\n    height:\n      345px;\n\n  }\n\n\n\n  .hnhero-podium {\n\n    width:\n      96%;\n\n\n    height:\n      122px;\n\n  }\n\n\n\n  .hnhero-badge {\n\n    transform:\n      scale(.84);\n\n\n    transform-origin:\n      right top;\n\n  }\n\n\n\n  .hnhero-floating-card {\n\n    bottom:\n      29px;\n\n\n    transform:\n      scale(.86);\n\n\n    transform-origin:\n      right bottom;\n\n  }\n\n\n\n  .hnhero-benefits {\n\n    grid-template-columns:\n      1fr;\n\n  }\n\n\n\n  .hnhero-benefit:last-child {\n\n    grid-column:\n      auto;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   ACCESSIBILITY\n========================================================= */\n\n.hnhero-primary-button:focus-visible,\n.hnhero-secondary-link:focus-visible,\n.hnhero-image-link:focus-visible {\n\n  outline:\n\n    3px solid\n    rgba(\n      198,\n      146,\n      69,\n      .50\n    );\n\n\n  outline-offset:\n    4px;\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (\n  prefers-reduced-motion:\n  reduce\n) {\n\n\n  .hnhero-image,\n  .hnhero-primary-button,\n  .hnhero-primary-button::before,\n  .hnhero-primary-button svg,\n  .hnhero-spec-card,\n  .hnhero-benefit {\n\n    transition:\n      none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =========================================================\n     SECTION\n  ========================================================= */\n\n  var section =\n    document.getElementById(\n      \"hnheroProduct\"\n    );\n\n\n  if (!section) {\n    return;\n  }\n\n\n\n  /* =========================================================\n     EASY PRODUCT CONFIGURATION\n\n     PRODUCT URL comes directly from:\n\n     data-product-url=\"...\"\n\n     at the TOP of the HTML section.\n\n     You do NOT need to change the JavaScript when\n     switching products.\n  ========================================================= */\n\n  var PRODUCT_URL =\n    section.getAttribute(\n      \"data-product-url\"\n    );\n\n\n  if (!PRODUCT_URL) {\n    return;\n  }\n\n\n\n  /* =========================================================\n     GET SHOPIFY PRODUCT HANDLE FROM URL\n\n     Example:\n\n     /collections/festival-specials/products/xs\n\n     automatically becomes:\n\n     xs\n  ========================================================= */\n\n  function getProductHandle(\n    url\n  ) {\n\n\n    try {\n\n\n      var parsed =\n        new URL(\n          url,\n          window.location.origin\n        );\n\n\n      var parts =\n        parsed.pathname\n        .split(\"/\")\n        .filter(Boolean);\n\n\n      var productsIndex =\n        parts.indexOf(\n          \"products\"\n        );\n\n\n      if (\n        productsIndex !== -1 &&\n        parts[\n          productsIndex + 1\n        ]\n      ) {\n\n        return parts[\n          productsIndex + 1\n        ];\n\n      }\n\n\n    } catch (error) {\n\n\n      console.error(\n        \"Could not read Hertha Nest product URL.\",\n        error\n      );\n\n    }\n\n\n    return \"\";\n\n  }\n\n\n\n  var PRODUCT_HANDLE =\n    getProductHandle(\n      PRODUCT_URL\n    );\n\n\n\n  /* =========================================================\n     ELEMENTS\n  ========================================================= */\n\n  var productButton =\n    document.getElementById(\n      \"hnheroProductButton\"\n    );\n\n\n  var imageLink =\n    document.getElementById(\n      \"hnheroImageLink\"\n    );\n\n\n  var titleMain =\n    document.getElementById(\n      \"hnheroTitleMain\"\n    );\n\n\n  var titleAccent =\n    document.getElementById(\n      \"hnheroTitleAccent\"\n    );\n\n\n  var price =\n    document.getElementById(\n      \"hnheroPrice\"\n    );\n\n\n  var comparePrice =\n    document.getElementById(\n      \"hnheroComparePrice\"\n    );\n\n\n  var stock =\n    document.getElementById(\n      \"hnheroStock\"\n    );\n\n\n  var sidePrice =\n    document.getElementById(\n      \"hnheroSidePrice\"\n    );\n\n\n\n  /* =========================================================\n     USE CONFIGURED PRODUCT URL FOR ALL PRODUCT LINKS\n  ========================================================= */\n\n  if (\n    productButton\n  ) {\n\n    productButton.href =\n      PRODUCT_URL;\n\n  }\n\n\n  if (\n    imageLink\n  ) {\n\n    imageLink.href =\n      PRODUCT_URL;\n\n  }\n\n\n\n  /* =========================================================\n     MONEY FORMAT\n  ========================================================= */\n\n  function formatMoney(\n    cents\n  ) {\n\n\n    if (\n      typeof cents !==\n      \"number\"\n    ) {\n\n      return \"\";\n\n    }\n\n\n    return new Intl.NumberFormat(\n\n      \"en-IN\",\n\n      {\n\n        style:\n          \"currency\",\n\n\n        currency:\n          \"INR\",\n\n\n        maximumFractionDigits:\n          0\n\n      }\n\n    ).format(\n      cents / 100\n    );\n\n  }\n\n\n\n  /* =========================================================\n     PRODUCT TITLE FORMATTING\n\n     Splits longer titles into:\n     normal serif line +\n     italic accent line.\n\n     Your fallback HTML remains visible if product data\n     cannot be loaded.\n  ========================================================= */\n\n  function applyProductTitle(\n    productTitle\n  ) {\n\n\n    if (\n      !productTitle ||\n      !titleMain ||\n      !titleAccent\n    ) {\n\n      return;\n\n    }\n\n\n    var cleanTitle =\n      productTitle.trim();\n\n\n    var words =\n      cleanTitle.split(/\\s+/);\n\n\n    if (\n      words.length <= 2\n    ) {\n\n\n      titleMain.textContent =\n        cleanTitle;\n\n\n      titleAccent.style.display =\n        \"none\";\n\n\n      return;\n\n    }\n\n\n    /*\n      Keep approximately half the title\n      in the first line.\n    */\n\n    var splitAt =\n      Math.ceil(\n        words.length / 2\n      );\n\n\n    titleMain.textContent =\n      words\n      .slice(\n        0,\n        splitAt\n      )\n      .join(\" \");\n\n\n    titleAccent.textContent =\n      words\n      .slice(\n        splitAt\n      )\n      .join(\" \");\n\n\n    titleAccent.style.display =\n      \"\";\n\n  }\n\n\n\n  /* =========================================================\n     FETCH PRODUCT DATA\n\n     Shopify AJAX product endpoint:\n     /products/HANDLE.js\n  ========================================================= */\n\n  if (\n    !PRODUCT_HANDLE\n  ) {\n\n\n    if (price) {\n\n      price.textContent =\n        \"\";\n\n    }\n\n\n    if (stock) {\n\n      stock.textContent =\n        \"View Product\";\n\n    }\n\n\n    return;\n\n  }\n\n\n\n  fetch(\n\n    \"/products/\" +\n    PRODUCT_HANDLE +\n    \".js\",\n\n    {\n\n      credentials:\n        \"same-origin\"\n\n    }\n\n  )\n\n\n  .then(\n    function (\n      response\n    ) {\n\n\n      if (\n        !response.ok\n      ) {\n\n        throw new Error(\n          \"Product could not be loaded.\"\n        );\n\n      }\n\n\n      return response.json();\n\n    }\n  )\n\n\n  .then(\n    function (\n      product\n    ) {\n\n\n      /* =====================================================\n         TITLE\n      ====================================================== */\n\n      if (\n        product.title\n      ) {\n\n        applyProductTitle(\n          product.title\n        );\n\n      }\n\n\n\n      /* =====================================================\n         VARIANT\n      ====================================================== */\n\n      if (\n        !product.variants ||\n        !product.variants.length\n      ) {\n\n        throw new Error(\n          \"No product variants available.\"\n        );\n\n      }\n\n\n      var variant =\n        product.variants.find(\n          function (\n            item\n          ) {\n\n            return item.available;\n\n          }\n        ) ||\n        product.variants[0];\n\n\n\n      /* =====================================================\n         PRICE\n      ====================================================== */\n\n      var formattedPrice =\n        formatMoney(\n          variant.price\n        );\n\n\n      if (price) {\n\n        price.textContent =\n          formattedPrice;\n\n      }\n\n\n      if (sidePrice) {\n\n        sidePrice.textContent =\n          formattedPrice;\n\n      }\n\n\n\n      /* =====================================================\n         COMPARE PRICE\n      ====================================================== */\n\n      if (\n        comparePrice\n      ) {\n\n\n        if (\n\n          variant.compare_at_price &&\n          variant.compare_at_price >\n          variant.price\n\n        ) {\n\n\n          comparePrice.textContent =\n            formatMoney(\n              variant.compare_at_price\n            );\n\n\n          comparePrice.hidden =\n            false;\n\n\n        } else {\n\n\n          comparePrice.hidden =\n            true;\n\n        }\n\n      }\n\n\n\n      /* =====================================================\n         AVAILABILITY\n      ====================================================== */\n\n      if (stock) {\n\n\n        stock.classList.remove(\n          \"is-available\",\n          \"is-sold\"\n        );\n\n\n        if (\n          variant.available\n        ) {\n\n\n          stock.textContent =\n            \"In Stock\";\n\n\n          stock.classList.add(\n            \"is-available\"\n          );\n\n\n        } else {\n\n\n          stock.textContent =\n            \"Sold Out\";\n\n\n          stock.classList.add(\n            \"is-sold\"\n          );\n\n        }\n\n      }\n\n    }\n  )\n\n\n  .catch(\n    function (\n      error\n    ) {\n\n\n      console.error(\n        \"Hertha Nest hero product:\",\n        error\n      );\n\n\n      /*\n        Keep static title and transparent image\n        visible even if Shopify's product JSON\n        fails temporarily.\n      */\n\n\n      if (price) {\n\n        price.textContent =\n          \"\";\n\n      }\n\n\n      if (sidePrice) {\n\n        sidePrice.textContent =\n          \"\";\n\n      }\n\n\n      if (stock) {\n\n\n        stock.textContent =\n          \"View Product\";\n\n\n        stock.classList.add(\n          \"is-sold\"\n        );\n\n      }\n\n    }\n  );\n\n\n})();\n\n</script>"
      }
    },
