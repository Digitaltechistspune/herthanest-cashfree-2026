}\n\n\n\n/* SPECS */\n\n.hnmulti-specs {\n  display:\n    grid;\n\n\n  grid-template-columns:\n    repeat(3,minmax(0,1fr));\n\n\n  gap:\n    11px;\n\n\n  max-width:\n    630px;\n\n\n  margin-top:\n    28px;\n}\n\n\n.hnmulti-spec {\n  position:\n    relative;\n\n\n  display:\n    flex;\n\n  align-items:\n    center;\n\n\n  gap:\n    11px;\n\n\n  min-height:\n    78px;\n\n\n  padding:\n    13px;\n\n\n  border:\n    1px solid rgba(146,47,46,.10);\n\n\n  border-radius:\n    14px;\n\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.64),\n      rgba(255,255,255,.25)\n    );\n\n\n  box-shadow:\n    0 12px 30px rgba(57,40,29,.05),\n    inset 0 1px 0 rgba(255,255,255,.7);\n}\n\n\n.hnmulti-spec::after {\n  content:\n    \"\";\n\n\n  position:\n    absolute;\n\n\n  left:\n    10%;\n\n  right:\n    10%;\n\n  bottom:\n    0;\n\n\n  height:\n    2px;\n\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      var(--hnm-gold),\n      transparent\n    );\n\n\n  opacity:\n    .50;\n}\n\n\n.hnmulti-spec-icon {\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  justify-content:\n    center;\n\n\n  width:\n    42px;\n\n  height:\n    42px;\n\n\n  flex:\n    0 0 42px;\n\n\n  border:\n    1px solid rgba(196,147,72,.38);\n\n\n  border-radius:\n    50%;\n\n\n  background:\n    linear-gradient(\n      135deg,\n      #fffdf8,\n      #eadbc7\n    );\n\n\n  color:\n    var(--hnm-red);\n}\n\n\n.hnmulti-spec-icon svg {\n  width:\n    20px;\n\n  height:\n    20px;\n}\n\n\n.hnmulti-spec > span:last-child {\n  font-family:\n    Arial, sans-serif;\n}\n\n\n.hnmulti-spec small {\n  display:\n    block;\n\n\n  margin-bottom:\n    4px;\n\n\n  color:\n    #a56b38;\n\n\n  font-size:\n    7px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .15em;\n}\n\n\n.hnmulti-spec strong {\n  display:\n    block;\n\n\n  color:\n    #44352c;\n\n\n  font-size:\n    10.5px;\n}\n\n\n.hnmulti-spec em {\n  display:\n    block;\n\n\n  margin-top:\n    3px;\n\n\n  color:\n    #887970;\n\n\n  font-size:\n    8px;\n\n\n  font-style:\n    normal;\n}\n\n\n\n/* ACTIONS */\n\n.hnmulti-actions {\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  flex-wrap:\n    wrap;\n\n\n  gap:\n    20px;\n\n\n  margin-top:\n    30px;\n}\n\n\n.hnmulti-button {\n  position:\n    relative;\n\n\n  display:\n    inline-flex;\n\n  align-items:\n    center;\n\n  justify-content:\n    center;\n\n\n  gap:\n    18px;\n\n\n  min-width:\n    265px;\n\n  min-height:\n    57px;\n\n\n  padding:\n    0 27px;\n\n\n  overflow:\n    hidden;\n\n\n  border:\n    1px solid #641b20;\n\n\n  border-radius:\n    7px;\n\n\n  background:\n    linear-gradient(\n      135deg,\n      #a43b38,\n      #681c22\n    );\n\n\n  box-shadow:\n    0 15px 31px rgba(101,29,31,.21);\n\n\n  color:\n    #fff !important;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    14px;\n\n  font-weight:\n    700;\n\n\n  text-decoration:\n    none !important;\n\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hnmulti-button::before {\n  content:\n    \"\";\n\n\n  position:\n    absolute;\n\n\n  top:\n    0;\n\n  left:\n    -75%;\n\n\n  width:\n    45%;\n\n  height:\n    100%;\n\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.18),\n      transparent\n    );\n\n\n  transform:\n    skewX(-22deg);\n\n\n  transition:\n    left .65s ease;\n}\n\n\n.hnmulti-button span,\n.hnmulti-button svg {\n  position:\n    relative;\n\n\n  z-index:\n    2;\n}\n\n\n.hnmulti-button svg {\n  width:\n    19px;\n\n  height:\n    19px;\n\n\n  transition:\n    transform .25s ease;\n}\n\n\n.hnmulti-button:hover {\n  transform:\n    translateY(-3px);\n\n\n  box-shadow:\n    0 20px 39px rgba(101,29,31,.28);\n}\n\n\n.hnmulti-button:hover::before {\n  left:\n    130%;\n}\n\n\n.hnmulti-button:hover svg {\n  transform:\n    translateX(5px);\n}\n\n\n.hnmulti-collection {\n  display:\n    inline-flex;\n\n  align-items:\n    center;\n\n\n  gap:\n    7px;\n\n\n  padding-bottom:\n    4px;\n\n\n  border-bottom:\n    1px solid rgba(146,47,46,.25);\n\n\n  color:\n    var(--hnm-red-dark) !important;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    12px;\n\n\n  font-weight:\n    700;\n\n\n  text-decoration:\n    none !important;\n}\n\n\n\n/* TRUST */\n\n.hnmulti-trust {\n  display:\n    flex;\n\n  align-items:\n    flex-start;\n\n\n  gap:\n    9px;\n\n\n  margin-top:\n    22px;\n\n\n  color:\n    #83746b;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    10.5px;\n\n\n  line-height:\n    1.5;\n}\n\n\n.hnmulti-trust > span {\n  color:\n    var(--hnm-gold);\n\n\n  font-size:\n    16px;\n}\n\n\n.hnmulti-trust p {\n  margin:\n    0;\n}\n\n\n.hnmulti-trust strong {\n  color:\n    #573b34;\n}\n\n\n\n/* BENEFIT BAR */\n\n.hnmulti-benefit-wrap {\n  position:\n    relative;\n\n\n  z-index:\n    30;\n\n\n  left:\n    50%;\n\n\n  width:\n    100vw;\n\n\n  margin-left:\n    -50vw;\n\n  margin-top:\n    28px;\n\n\n  padding:\n    21px\n    clamp(25px,5.5vw,105px);\n\n\n  background:\n    radial-gradient(\n      circle at 50% 0%,\n      rgba(146,47,46,.58),\n      transparent 42%\n    ),\n\n    linear-gradient(\n      135deg,\n      #6f1f26,\n      #4b1822 48%,\n      #29101a\n    );\n}\n\n\n.hnmulti-benefits {\n  display:\n    grid;\n\n\n  grid-template-columns:\n    repeat(5,minmax(0,1fr));\n\n\n  gap:\n    11px;\n\n\n  max-width:\n    1580px;\n\n\n  margin:\n    0 auto;\n}\n\n\n.hnmulti-benefit {\n  display:\n    flex;\n\n  align-items:\n    center;\n\n\n  gap:\n    12px;\n\n\n  min-height:\n    87px;\n\n\n  padding:\n    12px 15px;\n\n\n  border:\n    1px solid rgba(255,255,255,.09);\n\n\n  border-radius:\n    13px;\n\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(255,255,255,.075),\n      rgba(255,255,255,.025)\n    );\n}\n\n\n.hnmulti-benefit-icon {\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  justify-content:\n    center;\n\n\n  width:\n    43px;\n\n  height:\n    43px;\n\n\n  flex:\n    0 0 43px;\n\n\n  border:\n    1px solid rgba(235,204,144,.40);\n\n\n  border-radius:\n    50%;\n\n\n  color:\n    var(--hnm-gold-light);\n\n\n  font-size:\n    18px;\n}\n\n\n.hnmulti-benefit small,\n.hnmulti-benefit strong,\n.hnmulti-benefit em {\n  display:\n    block;\n\n\n  font-family:\n    Arial, sans-serif;\n}\n\n\n.hnmulti-benefit small {\n  margin-bottom:\n    4px;\n\n\n  color:\n    var(--hnm-gold-light);\n\n\n  font-size:\n    7px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .17em;\n}\n\n\n.hnmulti-benefit strong {\n  color:\n    #fff;\n\n\n  font-size:\n    11.5px;\n}\n\n\n.hnmulti-benefit em {\n  margin-top:\n    4px;\n\n\n  color:\n    rgba(255,255,255,.58);\n\n\n  font-size:\n    8.5px;\n\n\n  font-style:\n    normal;\n}\n\n\n\n/* TABLET */\n\n@media screen and (max-width: 1150px) {\n\n  .hnmulti-product {\n    padding-left:\n      40px;\n\n    padding-right:\n      40px;\n  }\n\n\n  .hnmulti-inner {\n    grid-template-columns:\n      minmax(410px,.95fr)\n      minmax(0,1fr);\n\n\n    gap:\n      30px;\n  }\n\n\n  .hnmulti-title {\n    font-size:\n      clamp(44px,5.6vw,66px);\n  }\n\n\n  .hnmulti-image {\n    height:\n      455px;\n  }\n\n\n  .hnmulti-benefits {\n    grid-template-columns:\n      repeat(3,1fr);\n  }\n\n}\n\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .hnmulti-product {\n    padding:\n      50px\n      18px\n      0;\n  }\n\n\n  .hnmulti-inner {\n    display:\n      flex;\n\n    flex-direction:\n      column;\n\n\n    gap:\n      22px;\n  }\n\n\n  /*\n  On mobile content appears first,\n  product below it.\n  */\n\n  .hnmulti-content {\n    order:\n      1;\n\n\n    text-align:\n      center;\n  }\n\n\n  .hnmulti-visual {\n    order:\n      2;\n\n\n    min-height:\n      500px;\n  }\n\n\n  .hnmulti-eyebrow,\n  .hnmulti-price-row,\n  .hnmulti-actions {\n    justify-content:\n      center;\n  }\n\n\n  .hnmulti-title {\n    font-size:\n      clamp(42px,12vw,61px);\n  }\n\n\n  .hnmulti-ornament {\n    margin-left:\n      auto;\n\n    margin-right:\n      auto;\n  }\n\n\n  .hnmulti-description {\n    margin:\n      19px\n      auto\n      0;\n\n\n    font-size:\n      13px;\n  }\n\n\n  .hnmulti-specs {\n    grid-template-columns:\n      1fr;\n\n\n    max-width:\n      430px;\n\n\n    margin-left:\n      auto;\n\n    margin-right:\n      auto;\n  }\n\n\n  .hnmulti-spec {\n    text-align:\n      left;\n  }\n\n\n  .hnmulti-trust {\n    justify-content:\n      center;\n  }\n\n\n  .hnmulti-image-link {\n    width:\n      min(90%,430px);\n\n\n    bottom:\n      106px;\n  }\n\n\n  .hnmulti-image {\n    height:\n      390px;\n  }\n\n\n  .hnmulti-podium {\n    width:\n      min(94%,455px);\n\n\n    height:\n      135px;\n\n\n    margin-bottom:\n      23px;\n  }\n\n\n  .hnmulti-side-price {\n    display:\n      none;\n  }\n\n\n  .hnmulti-floating {\n    bottom:\n      30px;\n  }\n\n\n  .hnmulti-benefits {\n    grid-template-columns:\n      1fr 1fr;\n  }\n\n\n  .hnmulti-benefit:last-child {\n    grid-column:\n      1 / -1;\n  }\n\n}\n\n\n\n/* SMALL MOBILE */\n\n@media screen and (max-width: 450px) {\n\n  .hnmulti-title {\n    font-size:\n      41px;\n  }\n\n\n  .hnmulti-actions {\n    flex-direction:\n      column;\n\n\n    gap:\n      15px;\n  }\n\n\n  .hnmulti-button {\n    width:\n      100%;\n\n\n    max-width:\n      345px;\n  }\n\n\n  .hnmulti-visual {\n    min-height:\n      420px;\n  }\n\n\n  .hnmulti-image {\n    height:\n      325px;\n  }\n\n\n  .hnmulti-benefits {\n    grid-template-columns:\n      1fr;\n  }\n\n\n  .hnmulti-benefit:last-child {\n    grid-column:\n      auto;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n  REMOVE CUSTOM HTML TOP/BOTTOM GAP\n  ---------------------------------------------------------\n  The theme can add spacing outside this custom section,\n  including an empty Section Heading area.\n\n  This cleanup only touches ancestors/wrappers around\n  .hnmulti-product. It does NOT remove this section's own\n  intentional internal padding.\n  ===================================================== */\n\n  function removeCustomHtmlGap() {\n\n    var customSections =\n      document.querySelectorAll(\n        \".hnmulti-product\"\n      );\n\n\n    customSections.forEach(\n      function (customSection) {\n\n        var shopifySection =\n          customSection.closest(\n            \".shopify-section\"\n          );\n\n\n        /*\n        ---------------------------------------------------\n        1. RESET EVERY ANCESTOR BETWEEN OUR SECTION AND\n           THE SHOPIFY SECTION WRAPPER\n        ---------------------------------------------------\n        */\n\n        var current =\n          customSection.parentElement;\n\n\n        while (\n          current &&\n          current !== document.body\n        ) {\n\n          current.style.setProperty(\n            \"margin-top\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"margin-bottom\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"padding-top\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"padding-bottom\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"margin-block-start\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"margin-block-end\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"padding-block-start\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"padding-block-end\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"min-height\",\n            \"0\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"height\",\n            \"auto\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"max-height\",\n            \"none\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"--section-padding-top\",\n            \"0px\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"--section-padding-bottom\",\n            \"0px\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"--section-spacing-top\",\n            \"0px\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"--section-spacing-bottom\",\n            \"0px\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"--spacing-top\",\n            \"0px\",\n            \"important\"\n          );\n\n          current.style.setProperty(\n            \"--spacing-bottom\",\n            \"0px\",\n            \"important\"\n          );\n\n\n          if (\n            current === shopifySection ||\n            (\n              current.classList &&\n              current.classList.contains(\n                \"shopify-section\"\n              )\n            )\n          ) {\n            break;\n          }\n\n\n          current =\n            current.parentElement;\n\n        }\n\n\n        if (!shopifySection) {\n          return;\n        }\n\n\n        /*\n        ---------------------------------------------------\n        2. HIDE KNOWN THEME HEADING WRAPPERS\n        ---------------------------------------------------\n        */\n\n        var headingSelectors = [\n          \".section-heading\",\n          \".section__heading\",\n          \".section-title\",\n          \".section__title\",\n          \".section-header\",\n          \".section__header\",\n          \".section-head\",\n          \".heading-wrapper\",\n          \".title-wrapper\",\n          \".section-title-wrapper\",\n          '[class*=\"section-heading\"]',\n          '[class*=\"section__heading\"]',\n          '[class*=\"section-title\"]',\n          '[class*=\"section__title\"]'\n        ];\n\n\n        shopifySection\n          .querySelectorAll(\n            headingSelectors.join(\",\")\n          )\n          .forEach(\n            function (heading) {\n\n              if (\n                customSection.contains(\n                  heading\n                )\n              ) {\n                return;\n              }\n\n\n              heading.style.setProperty(\n                \"display\",\n                \"none\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"width\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"height\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"min-height\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"max-height\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"margin\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"padding\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"border\",\n                \"0\",\n                \"important\"\n              );\n\n              heading.style.setProperty(\n                \"overflow\",\n                \"hidden\",\n                \"important\"\n              );\n\n            }\n          );\n\n\n        /*\n        ---------------------------------------------------\n        3. COLLAPSE EMPTY PRECEDING SIBLINGS\n\n        THIS IS THE EXTRA FIX FOR THE WHITE STRIP.\n\n        Your theme is creating an additional blank element\n        before the Custom HTML output. It does not necessarily\n        use a predictable \"section-title\" class, so the old\n        selector could miss it.\n\n        We inspect every level of the wrapper chain and hide\n        ONLY empty/non-functional siblings that appear before\n        the element containing .hnmulti-product.\n        ---------------------------------------------------\n        */\n\n        var childInPath =\n          customSection;\n\n\n        var parentInPath =\n          customSection.parentElement;\n\n\n        while (\n          parentInPath &&\n          parentInPath !== document.body\n        ) {\n\n          var sibling =\n            childInPath.previousElementSibling;\n\n\n          while (sibling) {\n\n            var previousSibling =\n              sibling.previousElementSibling;\n\n\n            var text =\n              (\n                sibling.textContent ||\n                \"\"\n              )\n              .replace(\n                /\\s+/g,\n                \"\"\n              );\n\n\n            var hasMeaningfulElement =\n              sibling.querySelector(\n                \"img, picture, video, iframe, canvas, form, input, select, textarea, button, a[href], [role='button']\"\n              );\n\n\n            /*\n            STYLE and SCRIPT tags never create visible spacing,\n            so leave those alone.\n            */\n\n            var tagName =\n              sibling.tagName\n                ? sibling.tagName.toLowerCase()\n                : \"\";\n\n\n            var canCollapse =\n              tagName !== \"style\" &&\n              tagName !== \"script\" &&\n              text === \"\" &&\n              !hasMeaningfulElement;\n\n\n            if (canCollapse) {\n\n              sibling.style.setProperty(\n                \"display\",\n                \"none\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"height\",\n                \"0\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"min-height\",\n                \"0\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"max-height\",\n                \"0\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"margin\",\n                \"0\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"padding\",\n                \"0\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"border\",\n                \"0\",\n                \"important\"\n              );\n\n              sibling.style.setProperty(\n                \"overflow\",\n                \"hidden\",\n                \"important\"\n              );\n\n            }\n\n\n            sibling =\n              previousSibling;\n\n          }\n\n\n          /*\n          Remove possible flex/grid gap on the wrapper that\n          holds the empty heading + our Custom HTML.\n          */\n\n          parentInPath.style.setProperty(\n            \"row-gap\",\n            \"0\",\n            \"important\"\n          );\n\n          parentInPath.style.setProperty(\n            \"column-gap\",\n            \"0\",\n            \"important\"\n          );\n\n\n          if (\n            parentInPath === shopifySection\n          ) {\n            break;\n          }\n\n\n          childInPath =\n            parentInPath;\n\n\n          parentInPath =\n            parentInPath.parentElement;\n\n        }\n\n\n        /*\n        ---------------------------------------------------\n        4. FINAL SHOPIFY SECTION RESET\n        ---------------------------------------------------\n        */\n\n        shopifySection.style.setProperty(\n          \"margin-top\",\n          \"0\",\n          \"important\"\n        );\n\n        shopifySection.style.setProperty(\n          \"margin-bottom\",\n          \"0\",\n          \"important\"\n        );\n\n        shopifySection.style.setProperty(\n          \"padding-top\",\n          \"0\",\n          \"important\"\n        );\n\n        shopifySection.style.setProperty(\n          \"padding-bottom\",\n          \"0\",\n          \"important\"\n        );\n\n        shopifySection.style.setProperty(\n          \"min-height\",\n          \"0\",\n          \"important\"\n        );\n\n        shopifySection.style.setProperty(\n          \"height\",\n          \"auto\",\n          \"important\"\n        );\n\n      }\n    );\n\n  }\n\n\n  removeCustomHtmlGap();\n\n\n  var section =\n    document.getElementById(\n      \"hnmultiProduct\"\n    );\n\n\n  if (!section) {\n    return;\n  }\n\n\n  var productUrl =\n    section.getAttribute(\n      \"data-product-url\"\n    );\n\n\n  var button =\n    document.getElementById(\n      \"hnmultiProductButton\"\n    );\n\n\n  var imageLink =\n    document.getElementById(\n      \"hnmultiImageLink\"\n    );\n\n\n  var price =\n    document.getElementById(\n      \"hnmultiPrice\"\n    );\n\n\n  var sidePrice =\n    document.getElementById(\n      \"hnmultiSidePrice\"\n    );\n\n\n  var compare =\n    document.getElementById(\n      \"hnmultiCompare\"\n    );\n\n\n  if (button) {\n    button.href =\n      productUrl;\n  }\n\n\n  if (imageLink) {\n    imageLink.href =\n      productUrl;\n  }\n\n\n\n  /*\n  STATIC PRICE IS DISPLAYED IMMEDIATELY.\n\n  There is:\n  - NO Loading...\n  - NO Checking availability\n  - NO stock flicker\n\n  Shopify silently refreshes the price only.\n  */\n\n\n  function getHandle(url) {\n\n    try {\n\n      var parsed =\n        new URL(\n          url,\n          window.location.origin\n        );\n\n\n      var pieces =\n        parsed.pathname\n        .split(\"/\")\n        .filter(Boolean);\n\n\n      var index =\n        pieces.indexOf(\n          \"products\"\n        );\n\n\n      return (\n        index >= 0\n        ? pieces[index + 1]\n        : \"\"\n      );\n\n\n    } catch (error) {\n\n      return \"\";\n\n    }\n\n  }\n\n\n\n  function money(cents) {\n\n    return new Intl.NumberFormat(\n      \"en-IN\",\n      {\n        style:\n          \"currency\",\n\n        currency:\n          \"INR\",\n\n        maximumFractionDigits:\n          0\n      }\n    ).format(\n      cents / 100\n    );\n\n  }\n\n\n\n  var handle =\n    getHandle(\n      productUrl\n    );\n\n\n  if (!handle) {\n    return;\n  }\n\n\n\n  fetch(\n    \"/products/\" +\n    handle +\n    \".js\",\n    {\n      credentials:\n        \"same-origin\"\n    }\n  )\n\n  .then(function (response) {\n\n    if (!response.ok) {\n      throw new Error();\n    }\n\n\n    return response.json();\n\n  })\n\n  .then(function (product) {\n\n    if (\n      !product.variants ||\n      !product.variants.length\n    ) {\n      return;\n    }\n\n\n    var variant =\n      product.variants[0];\n\n\n    var formattedPrice =\n      money(\n        variant.price\n      );\n\n\n    price.textContent =\n      formattedPrice;\n\n\n    sidePrice.textContent =\n      formattedPrice;\n\n\n    if (\n      variant.compare_at_price &&\n      variant.compare_at_price >\n      variant.price\n    ) {\n\n      compare.textContent =\n        money(\n          variant.compare_at_price\n        );\n\n\n      compare.hidden =\n        false;\n\n    } else {\n\n      compare.hidden =\n        true;\n\n    }\n\n  })\n\n  .catch(function () {\n\n    /*\n    Do nothing.\n\n    ₹1,200 remains visible.\n    Customer never sees an error or loading message.\n    */\n\n  });\n\n\n\n  /* =====================================================\n  RE-APPLY GAP FIX AFTER THEME RENDERING\n  ---------------------------------------------------------\n  Shopify's Theme Editor can inject/recalculate wrappers\n  after the Custom HTML itself has already rendered.\n  ===================================================== */\n\n  requestAnimationFrame(\n    function () {\n      removeCustomHtmlGap();\n    }\n  );\n\n\n  setTimeout(\n    removeCustomHtmlGap,\n    50\n  );\n\n\n  setTimeout(\n    removeCustomHtmlGap,\n    250\n  );\n\n\n  setTimeout(\n    removeCustomHtmlGap,\n    700\n  );\n\n\n  setTimeout(\n    removeCustomHtmlGap,\n    1500\n  );\n\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    function () {\n\n      removeCustomHtmlGap();\n\n\n      setTimeout(\n        removeCustomHtmlGap,\n        100\n      );\n\n\n      setTimeout(\n        removeCustomHtmlGap,\n        400\n      );\n\n    }\n  );\n\n\n})();\n\n</script>"
      }
    },
    "custom_html_eQmXCg": {
      "type": "custom-html",
      "name": "Product grid",
      "settings": {
        "section_padding_top": 0,
        "section_padding_bottom": 0,
        "section_padding_top_ip": 0,
        "section_padding_bottom_ip": 0,
        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 0,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<section class=\"hn-april\" id=\"hnAprilCollection\" data-collection-handle=\"april-special-collection\" aria-labelledby=\"hnAprilTitle\">\n\n  <div class=\"hn-april__decor\" aria-hidden=\"true\">\n    <span class=\"hn-april__orb hn-april__orb--one\"></span>\n    <span class=\"hn-april__orb hn-april__orb--two\"></span>\n    <span class=\"hn-april__accent hn-april__accent--one\"></span>\n    <span class=\"hn-april__accent hn-april__accent--two\"></span>\n  </div>\n\n  <div class=\"hn-april__shell\">\n\n    <header class=\"hn-april__header\">\n\n      <div class=\"hn-april__header-copy\">\n\n        <div class=\"hn-april__eyebrow\">\n          <span></span>\n          APRIL SPECIAL COLLECTION\n        </div>\n\n        <h2 class=\"hn-april__title\" id=\"hnAprilTitle\">\n          April Special\n          <em>Home Décor Edit</em>\n        </h2>\n\n        <p class=\"hn-april__description\">\n          Discover handcrafted home décor from our April Special Collection,\n          selected for expressive colour, artisan character and distinctive\n          details that make every corner feel more personal.\n        </p>\n\n      </div>\n\n      <div class=\"hn-april__header-side\">\n\n        <span class=\"hn-april__count\" id=\"hnAprilCount\">\n          Loading collection…\n        </span>\n\n        <a class=\"hn-april__view-all\" href=\"/collections/april-special-collection\" aria-label=\"Explore the April Special Collection\">\n          <span>Explore Collection</span>\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </a>\n\n      </div>\n\n    </header>\n\n    <div class=\"hn-april__toolbar\">\n\n      <div class=\"hn-april__toolbar-note\">\n        <span class=\"hn-april__toolbar-icon\" aria-hidden=\"true\">✦</span>\n\n        <span>\n          A rotating edit of\n          <strong>handpicked Hertha Nest pieces</strong>\n        </span>\n      </div>\n\n      <div class=\"hn-april__controls\">\n\n        <button type=\"button\" class=\"hn-april__arrow hn-april__arrow--prev\" aria-label=\"View previous April Special products\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </button>\n\n        <button type=\"button\" class=\"hn-april__arrow hn-april__arrow--next\" aria-label=\"View next April Special products\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n    </div>\n\n    <div class=\"hn-april__loading\" id=\"hnAprilLoading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-april__loader\" aria-hidden=\"true\"></span>\n      <span>Loading the April Special Collection…</span>\n    </div>\n\n    <div class=\"hn-april__viewport\" id=\"hnAprilViewport\" aria-label=\"April Special Collection products\" hidden=\"\">\n      <div class=\"hn-april__track\" id=\"hnAprilTrack\"></div>\n    </div>\n\n    <div class=\"hn-april__empty\" id=\"hnAprilEmpty\" hidden=\"\">\n      The April Special Collection could not be loaded right now.\n      Please use the Explore Collection button to view all products.\n    </div>\n\n    <noscript>\n      <div class=\"hn-april__noscript\">\n        <a href=\"/collections/april-special-collection\">\n          View the April Special Home Décor Collection\n        </a>\n      </div>\n    </noscript>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* =========================================================\n   THEME / CUSTOM HTML WRAPPER RESET\n========================================================= */\n\n.shopify-section:has(.hn-april) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n.shopify-section:has(.hn-april) > div,\n.shopify-section:has(.hn-april) > div > div,\n.shopify-section:has(.hn-april) .section,\n.shopify-section:has(.hn-april) .section-padding,\n.shopify-section:has(.hn-april) .section__wrapper,\n.shopify-section:has(.hn-april) .section-wrapper,\n.shopify-section:has(.hn-april) .custom-html,\n.shopify-section:has(.hn-april) .custom-html-wrapper,\n.shopify-section:has(.hn-april) .custom-html-section,\n.shopify-section:has(.hn-april) .page-width,\n.shopify-section:has(.hn-april) .container,\n.shopify-section:has(.hn-april) .container-fluid {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  min-height: 0 !important;\n\n  gap: 0 !important;\n  row-gap: 0 !important;\n  column-gap: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n.shopify-section:has(.hn-april) .page-width,\n.shopify-section:has(.hn-april) .container,\n.shopify-section:has(.hn-april) .container-fluid,\n.shopify-section:has(.hn-april) .custom-html,\n.shopify-section:has(.hn-april) .custom-html-wrapper,\n.shopify-section:has(.hn-april) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n.shopify-section:has(.hn-april) .section-heading,\n.shopify-section:has(.hn-april) .section__heading,\n.shopify-section:has(.hn-april) .section-title,\n.shopify-section:has(.hn-april) .section__title,\n.shopify-section:has(.hn-april) .section-header,\n.shopify-section:has(.hn-april) .section__header,\n.shopify-section:has(.hn-april) .section-head,\n.shopify-section:has(.hn-april) .heading-wrapper,\n.shopify-section:has(.hn-april) .title-wrapper,\n.shopify-section:has(.hn-april) .section-title-wrapper,\n.shopify-section:has(.hn-april) [class*=\"section-heading\"],\n.shopify-section:has(.hn-april) [class*=\"section__heading\"],\n.shopify-section:has(.hn-april) [class*=\"section-title\"],\n.shopify-section:has(.hn-april) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n  overflow: hidden !important;\n}\n\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.hn-april {\n  --hna-blue: #1f405a;\n  --hna-blue-dark: #142d43;\n\n  --hna-coral: #d8654c;\n  --hna-coral-dark: #b64e3a;\n\n  --hna-gold: #d8a85f;\n\n  --hna-bg: #eef4f6;\n  --hna-bg-warm: #f8ece5;\n\n  --hna-heading: #1b2c3d;\n  --hna-text: #687786;\n\n  position: relative;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin:\n    0\n    calc(50% - 50vw);\n\n  padding: 0 !important;\n\n  overflow: hidden;\n\n  background:\n    radial-gradient(\n      circle at 6% 8%,\n      rgba(216,101,76,.17),\n      transparent 25%\n    ),\n    radial-gradient(\n      circle at 96% 92%,\n      rgba(31,64,90,.14),\n      transparent 29%\n    ),\n    linear-gradient(\n      135deg,\n      #edf5f7 0%,\n      #f7f2ed 52%,\n      #f4e8e2 100%\n    );\n\n  color: var(--hna-heading);\n\n  isolation: isolate;\n}\n\n\n.hn-april *,\n.hn-april *::before,\n.hn-april *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   DECOR\n========================================================= */\n\n.hn-april__decor {\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n}\n\n\n.hn-april__orb {\n  position: absolute;\n\n  border-radius: 50%;\n}\n\n\n.hn-april__orb--one {\n  width: 500px;\n  height: 500px;\n\n  top: -340px;\n  right: 8%;\n\n  border:\n    1px solid\n    rgba(31,64,90,.10);\n\n  box-shadow:\n    0 0 0 62px rgba(31,64,90,.024),\n    0 0 0 124px rgba(31,64,90,.016);\n}\n\n\n.hn-april__orb--two {\n  width: 420px;\n  height: 420px;\n\n  left: -225px;\n  bottom: -275px;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(216,101,76,.15),\n      transparent 70%\n    );\n}\n\n\n.hn-april__accent {\n  position: absolute;\n\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(31,64,90,.11),\n      transparent\n    );\n}\n\n\n.hn-april__accent--one {\n  width: 47%;\n\n  left: -8%;\n  top: 18%;\n\n  transform: rotate(-8deg);\n}\n\n\n.hn-april__accent--two {\n  width: 45%;\n\n  right: -8%;\n  bottom: 14%;\n\n  transform: rotate(8deg);\n}\n\n\n/* =========================================================\n   INTERNAL LAYOUT\n   Outer .hn-april has ZERO padding.\n========================================================= */\n\n.hn-april__shell {\n  position: relative;\n\n  z-index: 5;\n\n  width: 100%;\n  max-width: 1540px;\n\n  margin: 0 auto;\n\n  padding:\n    clamp(44px, 4.7vw, 72px)\n    clamp(22px, 4.8vw, 72px)\n    clamp(44px, 4.7vw, 72px);\n}\n\n\n/* =========================================================\n   HEADER\n========================================================= */\n\n.hn-april__header {\n  display: flex;\n\n  align-items: flex-end;\n  justify-content: space-between;\n\n  gap: 36px;\n}\n\n\n.hn-april__header-copy {\n  max-width: 820px;\n}\n\n\n.hn-april__eyebrow {\n  display: flex;\n\n  align-items: center;\n\n  gap: 11px;\n\n  margin-bottom: 12px;\n\n  color: var(--hna-coral-dark);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size: 9px;\n  font-weight: 800;\n\n  line-height: 1.3;\n\n  letter-spacing: .21em;\n\n  text-transform: uppercase;\n}\n\n\n.hn-april__eyebrow > span {\n  display: block;\n\n  width: 28px;\n  height: 1px;\n\n  background: currentColor;\n}\n\n\n.hn-april__title {\n  margin: 0;\n\n  color: var(--hna-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      38px,\n      4vw,\n      64px\n    );\n\n  font-weight: 500;\n\n  line-height: .98;\n\n  letter-spacing: -.045em;\n}\n\n\n.hn-april__title em {\n  display: inline;\n\n  color: var(--hna-coral);\n\n  font-weight: 400;\n  font-style: italic;\n}\n\n\n.hn-april__description {\n  max-width: 740px;\n\n  margin:\n    16px\n    0\n    0;\n\n  color: var(--hna-text);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n    clamp(\n      13px,\n      .95vw,\n      15.5px\n    );\n\n  line-height: 1.68;\n}\n\n\n/* =========================================================\n   HEADER SIDE\n========================================================= */\n\n.hn-april__header-side {\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: flex-end;\n\n  gap: 13px;\n\n  flex:\n    0 0 auto;\n}\n\n\n.hn-april__count {\n  display: inline-flex;\n\n  align-items: center;\n\n  min-height: 31px;\n\n  padding:\n    7px\n    12px;\n\n  border:\n    1px solid\n    rgba(31,64,90,.12);\n\n  border-radius: 999px;\n\n  background:\n    rgba(255,255,255,.56);\n\n  color: var(--hna-blue);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 8px;\n  font-weight: 800;\n\n  line-height: 1;\n\n  letter-spacing: .09em;\n\n  text-transform: uppercase;\n}\n\n\n.hn-april__view-all {\n  position: relative;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 13px;\n\n  min-height: 48px;\n\n  padding:\n    12px\n    18px;\n\n  overflow: hidden;\n\n  border:\n    1px solid\n    var(--hna-blue-dark);\n\n  border-radius: 8px;\n\n  background:\n    linear-gradient(\n      135deg,\n      var(--hna-blue),\n      var(--hna-blue-dark)\n    );\n\n  box-shadow:\n    0 12px 26px\n    rgba(20,45,67,.16);\n\n  color: #ffffff !important;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 11.5px;\n  font-weight: 700;\n\n  text-decoration: none !important;\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-april__view-all:hover {\n  transform:\n    translateY(-2px);\n\n  box-shadow:\n    0 17px 31px\n    rgba(20,45,67,.22);\n}\n\n\n.hn-april__view-all:focus-visible {\n  outline:\n    2px solid\n    var(--hna-coral);\n\n  outline-offset: 3px;\n}\n\n\n.hn-april__view-all svg {\n  width: 17px;\n  height: 17px;\n\n  transition:\n    transform .25s ease;\n}\n\n\n.hn-april__view-all:hover svg {\n  transform:\n    translateX(4px);\n}\n\n\n/* =========================================================\n   TOOLBAR\n========================================================= */\n\n.hn-april__toolbar {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 24px;\n\n  margin-top: 31px;\n\n  padding-top: 20px;\n\n  border-top:\n    1px solid\n    rgba(31,64,90,.10);\n}\n\n\n.hn-april__toolbar-note {\n  display: flex;\n\n  align-items: center;\n\n  gap: 9px;\n\n  color: #798491;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 10px;\n\n  line-height: 1.4;\n}\n\n\n.hn-april__toolbar-note strong {\n  color: var(--hna-blue);\n\n  font-weight: 700;\n}\n\n\n.hn-april__toolbar-icon {\n  color: var(--hna-coral);\n\n  font-size: 17px;\n}\n\n\n/* =========================================================\n   CONTROLS\n========================================================= */\n\n.hn-april__controls {\n  display: flex;\n\n  align-items: center;\n\n  gap: 8px;\n}\n\n\n.hn-april__arrow {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 42px;\n  height: 42px;\n\n  min-width: 42px;\n  min-height: 42px;\n\n  padding: 0;\n\n  border:\n    1px solid\n    rgba(31,64,90,.14);\n\n  border-radius: 50%;\n\n  background:\n    rgba(255,255,255,.72);\n\n  color: var(--hna-blue);\n\n  box-shadow:\n    0 7px 18px\n    rgba(20,45,67,.06);\n\n  cursor: pointer;\n\n  transition:\n    color .25s ease,\n    background .25s ease,\n    border-color .25s ease,\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-april__arrow:hover {\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hna-coral);\n\n  background:\n    var(--hna-coral);\n\n  color: #ffffff;\n\n  box-shadow:\n    0 10px 21px\n    rgba(182,78,58,.18);\n}\n\n\n.hn-april__arrow:focus-visible {\n  outline:\n    2px solid\n    var(--hna-coral);\n\n  outline-offset: 3px;\n}\n\n\n.hn-april__arrow svg {\n  width: 17px;\n  height: 17px;\n}\n\n\n/* =========================================================\n   CAROUSEL\n========================================================= */\n\n.hn-april__viewport {\n  width: 100%;\n\n  margin-top: 18px;\n\n  overflow: hidden;\n\n  touch-action: pan-y;\n}\n\n\n.hn-april__viewport[hidden],\n.hn-april__loading[hidden],\n.hn-april__empty[hidden] {\n  display: none !important;\n}\n\n\n.hn-april__track {\n  display: flex;\n\n  align-items: stretch;\n\n  gap: 18px;\n\n  width: max-content;\n\n  will-change: transform;\n\n  transform:\n    translate3d(\n      0,\n      0,\n      0\n    );\n}\n\n\n/* =========================================================\n   PRODUCT CARD\n========================================================= */\n\n.hn-april__card {\n  position: relative;\n\n  flex:\n    0\n    0\n    auto;\n\n  min-width: 0;\n\n  overflow: hidden;\n\n  border:\n    1px solid\n    rgba(31,64,90,.11);\n\n  