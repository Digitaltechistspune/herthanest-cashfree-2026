;\n\n  box-shadow:\n    0 7px 16px\n    rgba(32,63,53,.18),\n    inset 0 1px 0\n    rgba(255,255,255,.13);\n\n  font-family:\n    inherit;\n\n  font-size: 11px;\n\n  font-weight: 750;\n\n  line-height: 1;\n\n  white-space:\n    nowrap;\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    background .25s ease,\n    box-shadow .25s ease,\n    opacity .25s ease;\n}\n\n\n.hn-new30__add:hover {\n\n  transform:\n    translateY(-2px);\n\n  border-color:\n    var(--hn30-gold);\n\n  background:\n    linear-gradient(\n      135deg,\n      #c69a58 0%,\n      #a87738 100%\n    );\n\n  box-shadow:\n    0 9px 20px\n    rgba(145,101,48,.23);\n}\n\n\n.hn-new30__add:focus-visible {\n\n  outline:\n    2px\n    solid\n    var(--hn30-gold);\n\n  outline-offset:\n    3px;\n}\n\n\n.hn-new30__cart-symbol {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 20px;\n  height: 20px;\n\n  flex:\n    0\n    0\n    20px;\n\n  border-radius:\n    50%;\n\n  background:\n    rgba(255,255,255,.14);\n}\n\n\n.hn-new30__cart-symbol svg {\n\n  width: 12px;\n  height: 12px;\n\n  fill: none;\n\n  stroke:\n    currentColor;\n\n  stroke-width:\n    1.8;\n\n  stroke-linecap:\n    round;\n\n  stroke-linejoin:\n    round;\n}\n\n\n.hn-new30__add.is-loading {\n\n  pointer-events:\n    none;\n\n  opacity:\n    .62;\n}\n\n\n.hn-new30__add.is-added {\n\n  border-color:\n    #4f8062;\n\n  background:\n    #4f8062;\n}\n\n\n.hn-new30__add:disabled {\n\n  min-width:\n    105px;\n\n  transform:\n    none;\n\n  border-color:\n    #d2cec4;\n\n  background:\n    #d2cec4;\n\n  color:\n    #716e67;\n\n  box-shadow:\n    none;\n\n  cursor:\n    not-allowed;\n\n  opacity:\n    .9;\n}\n\n\n/* =========================================================\n   LOADING\n========================================================= */\n\n.hn-new30__main-loading {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 11px;\n\n  min-height: 210px;\n\n  color:\n    var(--hn30-text);\n\n  font-size: 13px;\n}\n\n\n.hn-new30__loader {\n\n  width: 23px;\n  height: 23px;\n\n  border:\n    3px\n    solid\n    rgba(49,85,72,.16);\n\n  border-top-color:\n    var(--hn30-green);\n\n  border-radius:\n    50%;\n\n  animation:\n    hnNew30Spin\n    .8s\n    linear\n    infinite;\n}\n\n\n@keyframes hnNew30Spin {\n\n  to {\n    transform:\n      rotate(360deg);\n  }\n\n}\n\n\n/* =========================================================\n   EMPTY\n========================================================= */\n\n.hn-new30__empty {\n\n  padding:\n    35px\n    20px;\n\n  border:\n    1px\n    solid\n    var(--hn30-border);\n\n  border-radius:\n    16px;\n\n  background:\n    #ffffff;\n\n  color:\n    var(--hn30-text);\n\n  font-size: 13px;\n\n  line-height: 1.6;\n\n  text-align:\n    center;\n}\n\n\n/* =========================================================\n   TOAST\n========================================================= */\n\n.hn-new30__toast {\n\n  position: fixed;\n\n  right: 20px;\n  bottom: 20px;\n\n  z-index: 999999;\n\n  display: flex;\n\n  align-items: center;\n\n  gap: 10px;\n\n  max-width:\n    min(\n      420px,\n      calc(100vw - 30px)\n    );\n\n  padding:\n    13px\n    15px;\n\n  border:\n    1px\n    solid\n    rgba(255,255,255,.14);\n\n  border-radius:\n    13px;\n\n  background:\n    rgba(32,63,53,.97);\n\n  color:\n    #ffffff;\n\n  box-shadow:\n    0 17px 42px\n    rgba(0,0,0,.22);\n\n  opacity: 0;\n\n  visibility:\n    hidden;\n\n  transform:\n    translateY(14px);\n\n  transition:\n    opacity .3s ease,\n    visibility .3s ease,\n    transform .3s ease;\n}\n\n\n.hn-new30__toast.is-visible {\n\n  opacity: 1;\n\n  visibility:\n    visible;\n\n  transform:\n    translateY(0);\n}\n\n\n.hn-new30__toast-icon {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 25px;\n  height: 25px;\n\n  flex:\n    0\n    0\n    25px;\n\n  border-radius:\n    50%;\n\n  background:\n    rgba(255,255,255,.14);\n\n  color:\n    #f0cb8a;\n\n  font-size: 13px;\n\n  font-weight: 800;\n}\n\n\n.hn-new30__toast-message {\n\n  font-size: 12px;\n\n  font-weight: 650;\n\n  line-height: 1.4;\n}\n\n\n.hn-new30__toast a {\n\n  margin-left:\n    auto;\n\n  color:\n    #f3ce8c;\n\n  font-size: 11px;\n\n  font-weight: 750;\n\n  white-space:\n    nowrap;\n\n  text-decoration:\n    underline;\n\n  text-underline-offset:\n    3px;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 900px) {\n\n  .hn-new30 {\n    padding:\n      32px\n      0\n      38px;\n  }\n\n\n  .hn-new30__inner {\n    padding:\n      0\n      22px;\n  }\n\n\n  .hn-new30__header {\n    margin-bottom:\n      0;\n  }\n\n\n  .hn-new30__divider {\n    margin-top:\n      23px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 580px) {\n\n  .hn-new30 {\n\n    --hn30-gap:\n      14px;\n\n    margin-bottom:\n      0;\n\n    padding:\n      28px\n      0\n      32px;\n  }\n\n\n  .hn-new30__inner {\n\n    padding:\n      0\n      14px;\n  }\n\n\n  .hn-new30__header {\n\n    margin-bottom:\n      17px;\n  }\n\n\n  .hn-new30__eyebrow {\n\n    margin-bottom:\n      7px;\n\n    font-size:\n      9px;\n\n    letter-spacing:\n      1.35px;\n  }\n\n\n  .hn-new30__eyebrow::before,\n  .hn-new30__eyebrow::after {\n\n    width:\n      20px;\n  }\n\n\n  .hn-new30__title {\n\n    font-size:\n      29px;\n  }\n\n\n  .hn-new30__description {\n\n    margin-top:\n      8px;\n\n    font-size:\n      12.5px;\n\n    line-height:\n      1.55;\n  }\n\n\n  .hn-new30__controls {\n\n    margin-bottom:\n      14px;\n  }\n\n\n  .hn-new30__arrow {\n\n    width:\n      44px;\n\n    height:\n      44px;\n\n    min-width:\n      44px;\n\n    min-height:\n      44px;\n  }\n\n\n  .hn-new30__divider {\n\n    margin:\n      21px\n      0\n      15px;\n  }\n\n\n  .hn-new30__divider span {\n\n    width:\n      82%;\n  }\n\n\n  .hn-new30__card {\n\n    border-radius:\n      16px;\n  }\n\n\n  .hn-new30__content {\n\n    padding:\n      13px\n      13px\n      14px;\n  }\n\n\n  .hn-new30__product-title {\n\n    min-height:\n      42px;\n\n    font-size:\n      16px;\n  }\n\n\n  .hn-new30__bottom {\n\n    margin-top:\n      10px;\n\n    padding-top:\n      10px;\n  }\n\n\n  .hn-new30__price {\n\n    font-size:\n      16px;\n  }\n\n\n  .hn-new30__add {\n\n    min-width:\n      112px;\n\n    min-height:\n      44px;\n\n    padding:\n      8px\n      12px;\n\n    font-size:\n      10.5px;\n  }\n\n\n  .hn-new30__toast {\n\n    right:\n      14px;\n\n    bottom:\n      14px;\n  }\n\n}\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media (max-width: 370px) {\n\n  .hn-new30__add {\n\n    min-width:\n      94px;\n\n    padding:\n      8px\n      10px;\n  }\n\n\n  .hn-new30__cart-symbol {\n\n    display:\n      none;\n  }\n\n}\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hn-new30__track,\n  .hn-new30__card,\n  .hn-new30__image,\n  .hn-new30__arrow,\n  .hn-new30__add {\n\n    transition-duration:\n      .01ms !important;\n  }\n\n\n  .hn-new30__loader {\n\n    animation:\n      none;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n     REMOVE CUSTOM HTML OUTER GAP + THEME HEADING SHELL\n  ===================================================== */\n\n  function collapseNewThirtyThemeShell(root) {\n\n    if (!root) {\n      return;\n    }\n\n\n    function zeroOuterSpacing(element) {\n\n      if (!element) {\n        return;\n      }\n\n\n      [\n        \"margin-top\",\n        \"margin-bottom\",\n        \"margin-block-start\",\n        \"margin-block-end\",\n        \"padding-top\",\n        \"padding-bottom\",\n        \"padding-block-start\",\n        \"padding-block-end\"\n      ].forEach(\n        function (propertyName) {\n\n          element.style.setProperty(\n            propertyName,\n            \"0\",\n            \"important\"\n          );\n\n        }\n      );\n\n\n      element.style.setProperty(\n        \"min-height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      [\n        \"--section-padding-top\",\n        \"--section-padding-bottom\",\n        \"--section-spacing-top\",\n        \"--section-spacing-bottom\",\n        \"--spacing-top\",\n        \"--spacing-bottom\"\n      ].forEach(\n        function (variableName) {\n\n          element.style.setProperty(\n            variableName,\n            \"0px\",\n            \"important\"\n          );\n\n        }\n      );\n\n    }\n\n\n    function collapseElement(element) {\n\n      if (!element) {\n        return;\n      }\n\n\n      element.style.setProperty(\n        \"display\",\n        \"none\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"min-height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"max-height\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"margin\",\n        \"0\",\n        \"important\"\n      );\n\n\n      element.style.setProperty(\n        \"padding\",\n        \"0\",\n        \"important\"\n      );\n\n    }\n\n\n    function isThemeHeadingShell(\n      element\n    ) {\n\n      if (\n        !element ||\n        element === root ||\n        element.contains(root)\n      ) {\n\n        return false;\n\n      }\n\n\n      const identity =\n\n        (\n          String(\n            element.className || \"\"\n          ) +\n          \" \" +\n          String(\n            element.id || \"\"\n          )\n        )\n        .toLowerCase();\n\n\n      const classLooksLikeHeading =\n\n        /section[-_\\s]*(heading|header|title)|(?:heading|title)[-_\\s]*wrapper|sectionhead/.test(\n          identity\n        );\n\n\n      const containsHeading =\n        Boolean(\n          element.querySelector(\n            \"h1,h2,h3,h4,h5,h6\"\n          )\n        );\n\n\n      const containsRealContent =\n        Boolean(\n          element.querySelector(\n            \"img,picture,video,iframe,canvas,form,input,select,textarea,button,a[href]\"\n          )\n        );\n\n\n      return (\n        classLooksLikeHeading ||\n        (\n          containsHeading &&\n          !containsRealContent\n        )\n      );\n\n    }\n\n\n    function isBlankSpacer(\n      element\n    ) {\n\n      if (\n        !element ||\n        element === root ||\n        element.contains(root)\n      ) {\n\n        return false;\n\n      }\n\n\n      const hasText =\n        String(\n          element.textContent || \"\"\n        ).trim().length > 0;\n\n\n      const hasRealContent =\n        Boolean(\n          element.querySelector(\n            \"img,picture,video,iframe,canvas,svg,form,input,select,textarea,button,a[href]\"\n          )\n        );\n\n\n      return (\n        !hasText &&\n        !hasRealContent\n      );\n\n    }\n\n\n    let section =\n      root.closest(\n        \".shopify-section\"\n      );\n\n\n    if (!section) {\n\n      let fallback =\n        root.parentElement;\n\n\n      while (\n        fallback &&\n        fallback !== document.body\n      ) {\n\n        if (\n          fallback.id &&\n          fallback.id.indexOf(\n            \"shopify-section-\"\n          ) === 0\n        ) {\n\n          section =\n            fallback;\n\n          break;\n\n        }\n\n\n        fallback =\n          fallback.parentElement;\n\n      }\n\n    }\n\n\n    let branch =\n      root;\n\n\n    while (\n      branch &&\n      branch.parentElement &&\n      branch !== section &&\n      branch.parentElement !== document.body\n    ) {\n\n      const parent =\n        branch.parentElement;\n\n\n      zeroOuterSpacing(\n        parent\n      );\n\n\n      Array.from(\n        parent.children\n      ).forEach(\n        function (sibling) {\n\n          if (\n            sibling === branch ||\n            sibling.contains(root)\n          ) {\n\n            return;\n\n          }\n\n\n          if (\n            isThemeHeadingShell(\n              sibling\n            ) ||\n            isBlankSpacer(\n              sibling\n            )\n          ) {\n\n            collapseElement(\n              sibling\n            );\n\n          }\n\n        }\n      );\n\n\n      branch =\n        parent;\n\n    }\n\n\n    if (section) {\n\n      zeroOuterSpacing(\n        section\n      );\n\n\n      const headingSelectors = [\n\n        \".section-heading\",\n        \".section__heading\",\n        \".section-title\",\n        \".section__title\",\n        \".section-header\",\n        \".section__header\",\n        \".section-head\",\n        \".heading-wrapper\",\n        \".title-wrapper\",\n        \"[class*='section-heading']\",\n        \"[class*='section__heading']\",\n        \"[class*='section-title']\",\n        \"[class*='section__title']\"\n\n      ].join(\",\");\n\n\n      section\n        .querySelectorAll(\n          headingSelectors\n        )\n        .forEach(\n          function (headingShell) {\n\n            if (\n              !root.contains(\n                headingShell\n              )\n            ) {\n\n              collapseElement(\n                headingShell\n              );\n\n            }\n\n          }\n        );\n\n    }\n\n\n    /*\n      IMPORTANT:\n      Only OUTER spacing is removed.\n      Internal .hn-new30 padding remains so the premium\n      heading/products still have intentional breathing room.\n    */\n\n    root.style.setProperty(\n      \"margin-top\",\n      \"0\",\n      \"important\"\n    );\n\n\n    root.style.setProperty(\n      \"margin-bottom\",\n      \"0\",\n      \"important\"\n    );\n\n  }\n\n\n  /* =====================================================\n     INITIALIZE SECTION\n  ===================================================== */\n\n  function initialiseNewThirtySection(root) {\n\n    if (!root) {\n      return;\n    }\n\n\n    collapseNewThirtyThemeShell(\n      root\n    );\n\n\n    if (\n      root.dataset.initialised === \"true\"\n    ) {\n      return;\n    }\n\n\n    root.dataset.initialised =\n      \"true\";\n\n\n    const mainLoading =\n      root.querySelector(\n        \".hn-new30__main-loading\"\n      );\n\n\n    const emptyMessage =\n      root.querySelector(\n        \".hn-new30__empty\"\n      );\n\n\n    const divider =\n      root.querySelector(\n        \".hn-new30__divider\"\n      );\n\n\n    const carousels =\n      Array.from(\n        root.querySelectorAll(\n          \".hn-new30__carousel\"\n        )\n      );\n\n\n    const toast =\n      root.querySelector(\n        \".hn-new30__toast\"\n      );\n\n\n    const toastMessage =\n      root.querySelector(\n        \".hn-new30__toast-message\"\n      );\n\n\n    const toastCartLink =\n      root.querySelector(\n        \".hn-new30__toast a\"\n      );\n\n\n    const topCount =\n      Math.min(\n        Math.max(\n          Number(\n            root.dataset.topCount || 15\n          ),\n          1\n        ),\n        30\n      );\n\n\n    const bottomCount =\n      Math.min(\n        Math.max(\n          Number(\n            root.dataset.bottomCount || 15\n          ),\n          1\n        ),\n        30\n      );\n\n\n    const totalProductCount =\n      Math.min(\n        topCount + bottomCount,\n        30\n      );\n\n\n    const shopRoot =\n      window.Shopify &&\n      window.Shopify.routes &&\n      window.Shopify.routes.root\n        ? window.Shopify.routes.root\n        : \"/\";\n\n\n    const activeCurrency =\n      window.Shopify &&\n      window.Shopify.currency &&\n      window.Shopify.currency.active\n        ? window.Shopify.currency.active\n        : \"INR\";\n\n\n    const storeLanguage =\n      document.documentElement.lang ||\n      \"en-IN\";\n\n\n    const reducedMotion =\n      window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      ).matches;\n\n\n    let toastTimer =\n      null;\n\n\n    /* ===================================================\n       CREATE STORE URL\n    =================================================== */\n\n    function createStoreUrl(path) {\n\n      return (\n        shopRoot +\n        String(path || \"\")\n          .replace(/^\\/+/, \"\")\n      );\n\n    }\n\n\n    /* ===================================================\n       ESCAPE HTML\n    =================================================== */\n\n    function escapeHtml(value) {\n\n      return String(\n        value == null\n          ? \"\"\n          : value\n      )\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#039;\");\n\n    }\n\n\n    /* ===================================================\n       FORMAT MONEY\n    =================================================== */\n\n    function formatMoney(value) {\n\n      const amount =\n        Number(value || 0);\n\n\n      try {\n\n        return new Intl.NumberFormat(\n          storeLanguage,\n          {\n            style: \"currency\",\n            currency: activeCurrency,\n\n            maximumFractionDigits:\n              amount % 1 === 0\n                ? 0\n                : 2\n          }\n        ).format(amount);\n\n\n      } catch (error) {\n\n        return (\n          activeCurrency +\n          \" \" +\n          amount.toFixed(2)\n        );\n\n      }\n\n    }\n\n\n    /* ===================================================\n       PRODUCT TIMESTAMP\n    =================================================== */\n\n    function getProductTimestamp(product) {\n\n      if (!product) {\n        return 0;\n      }\n\n\n      const possibleDates = [\n\n        product.created_at,\n        product.published_at,\n        product.updated_at\n\n      ];\n\n\n      for (\n        const dateValue\n        of possibleDates\n      ) {\n\n        if (!dateValue) {\n          continue;\n        }\n\n\n        const timestamp =\n          new Date(\n            dateValue\n          ).getTime();\n\n\n        if (\n          !Number.isNaN(\n            timestamp\n          )\n        ) {\n          return timestamp;\n        }\n\n      }\n\n\n      return Number(\n        product.id || 0\n      );\n\n    }\n\n\n    /* ===================================================\n       SORT NEWEST PRODUCTS\n    =================================================== */\n\n    function sortNewestProducts(productList) {\n\n      return productList\n        .slice()\n        .sort(\n          function (\n            firstProduct,\n            secondProduct\n          ) {\n\n            const timestampDifference =\n              getProductTimestamp(\n                secondProduct\n              ) -\n              getProductTimestamp(\n                firstProduct\n              );\n\n\n            if (\n              timestampDifference !== 0\n            ) {\n\n              return timestampDifference;\n\n            }\n\n\n            return (\n              Number(\n                secondProduct.id || 0\n              ) -\n              Number(\n                firstProduct.id || 0\n              )\n            );\n\n          }\n        );\n\n    }\n\n\n    /* ===================================================\n       REMOVE DUPLICATES\n    =================================================== */\n\n    function removeDuplicateProducts(productList) {\n\n      const uniqueProducts =\n        new Map();\n\n\n      productList.forEach(\n        function (product) {\n\n          if (!product) {\n            return;\n          }\n\n\n          const uniqueKey =\n            product.id ||\n            product.handle;\n\n\n          if (!uniqueKey) {\n            return;\n          }\n\n\n          uniqueProducts.set(\n            String(uniqueKey),\n            product\n          );\n\n        }\n      );\n\n\n      return Array.from(\n        uniqueProducts.values()\n      );\n\n    }\n\n\n    /* ===================================================\n       CHECK ORDER\n    =================================================== */\n\n    function looksNewestFirst(productList) {\n\n      let previousTimestamp =\n        Number.POSITIVE_INFINITY;\n\n\n      let checkedProducts =\n        0;\n\n\n      for (\n        const product\n        of productList\n      ) {\n\n        const currentTimestamp =\n          getProductTimestamp(\n            product\n          );\n\n\n        if (!currentTimestamp) {\n          continue;\n        }\n\n\n        if (\n          currentTimestamp >\n          previousTimestamp\n        ) {\n\n          return false;\n\n        }\n\n\n        previousTimestamp =\n          currentTimestamp;\n\n\n        checkedProducts +=\n          1;\n\n\n        if (\n          checkedProducts >= 40\n        ) {\n          break;\n        }\n\n      }\n\n\n      return (\n        checkedProducts >= 2\n      );\n\n    }\n\n\n    /* ===================================================\n       REQUEST PRODUCTS\n    =================================================== */\n\n    async function requestProductPage(\n      basePath,\n      pageNumber,\n      includeSort\n    ) {\n\n      const separator =\n        basePath.indexOf(\"?\") === -1\n          ? \"?\"\n          : \"&\";\n\n\n      /*\n       * PERFORMANCE OPTIMIZATION:\n       *\n       * This section only displays 30 products.\n       * We request 40 products to keep a small safety buffer\n       * while avoiding the previous 250-product payload.\n       *\n       * Cache-busting and cache:\"no-store\" have also been removed\n       * so the browser/CDN can reuse the response when appropriate.\n       */\n\n      const query = [\n\n        \"limit=40\",\n\n        \"page=\" +\n        pageNumber,\n\n        includeSort\n          ? \"sort_by=created-descending\"\n          : \"\"\n\n      ]\n        .filter(Boolean)\n        .join(\"&\");\n\n\n      const response =\n        await fetch(\n          createStoreUrl(\n            basePath +\n            separator +\n            query\n          ),\n          {\n            method: \"GET\",\n\n            credentials:\n              \"same-origin\",\n\n            headers: {\n\n              \"Accept\":\n                \"application/json\",\n\n              \"X-Requested-With\":\n                \"XMLHttpRequest\"\n\n            }\n          }\n        );\n\n\n      if (!response.ok) {\n\n        throw new Error(\n          \"Product request failed with status \" +\n          response.status +\n          \".\"\n        );\n\n      }\n\n\n      const data =\n        await response.json();\n\n\n      if (\n        !data ||\n        !Array.isArray(\n          data.products\n        )\n      ) {\n\n        throw new Error(\n          \"Shopify returned an invalid product response.\"\n        );\n\n      }\n\n\n      return data.products;\n\n    }\n\n\n    /* ===================================================\n       FETCH PRODUCT SOURCE\n    =================================================== */\n\n    async function fetchProductsFromSource(\n      basePath,\n      includeSort\n    ) {\n\n      const pageSize =\n        40;\n\n\n      const maximumPages =\n        1;\n\n\n      const collectedProducts =\n        [];\n\n\n      for (\n        let pageNumber = 1;\n        pageNumber <= maximumPages;\n        pageNumber += 1\n      ) {\n\n        const pageProducts =\n          await requestProductPage(\n            basePath,\n            pageNumber,\n            includeSort\n          );\n\n\n        if (\n          !pageProducts.length\n        ) {\n          break;\n        }\n\n\n        collectedProducts.push.apply(\n          collectedProducts,\n          pageProducts\n        );\n\n\n        if (\n          pageNumber === 1 &&\n          pageProducts.length === pageSize &&\n          looksNewestFirst(\n            pageProducts\n          )\n        ) {\n\n          break;\n\n        }\n\n\n        if (\n          pageProducts.length < pageSize\n        ) {\n\n          break;\n\n        }\n\n      }\n\n\n      return removeDuplicateProducts(\n        collectedProducts\n      );\n\n    }\n\n\n    /* ===================================================\n       FETCH NEWEST PRODUCTS\n    =================================================== */\n\n    async function fetchNewestProducts() {\n\n      const sources = [\n\n        {\n          path:\n            \"collections/all/products.json\",\n\n          includeSort:\n            true\n        },\n\n        {\n          path:\n            \"products.json\",\n\n          includeSort:\n            false\n        }\n\n      ];\n\n\n      let finalError =\n        null;\n\n\n      for (\n        const source\n        of sources\n      ) {\n\n        try {\n\n          const products =\n            await fetchProductsFromSource(\n              source.path,\n              source.includeSort\n            );\n\n\n          if (\n            products.length\n          ) {\n\n            console.info(\n              \"Hertha Nest latest-products section loaded \" +\n              products.length +\n              \" unique published products.\"\n            );\n\n\n            return products;\n\n          }\n\n\n        } catch (error) {\n\n          finalError =\n            error;\n\n\n          console.warn(\n            \"Hertha Nest product source failed:\",\n            source.path,\n            error\n          );\n\n        }\n\n      }\n\n\n      throw (\n        finalError ||\n        new Error(\n          \"Products could not be loaded.\"\n        )\n      );\n\n    }\n\n\n    /* ===================================================\n       AVAILABLE VARIANT\n    =================================================== */\n\n    function getAvailableVariant(product) {\n\n      if (\n        !product ||\n        !Array.isArray(\n          product.variants\n        ) ||\n        !product.variants.length\n      ) {\n\n        return null;\n\n      }\n\n\n      return (\n        product.variants.find(\n          function (variant) {\n\n            return (\n              variant.available === true\n            );\n\n          }\n        ) ||\n        product.variants[0]\n      );\n\n    }\n\n\n    /* ===================================================\n       ORIGINAL IMAGE SOURCE\n    =================================================== */\n\n    function getImageSource(\n      product,\n      variant\n    ) {\n\n      if (\n        variant &&\n        variant.featured_image &&\n        variant.featured_image.src\n      ) {\n\n        return (\n          variant.featured_image.src\n        );\n\n      }\n\n\n      if (\n        product.featured_image &&\n        typeof product.featured_image ===\n        \"string\"\n      ) {\n\n        return (\n          product.featured_image\n        );\n\n      }\n\n\n      if (\n        product.featured_image &&\n        product.featured_image.src\n      ) {\n\n        return (\n          product.featured_image.src\n        );\n\n      }\n\n\n      if (\n        Array.isArray(\n          product.images\n        ) &&\n        product.images.length\n      ) {\n\n        return (\n          typeof product.images[0] ===\n          \"string\"\n\n            ? product.images[0]\n\n            : product.images[0].src\n        );\n\n      }\n\n\n      return \"\";\n\n    }\n\n\n    /* ===================================================\n       RESPONSIVE IMAGE URL\n\n       Replaces any existing Shopify ?width=\n       instead of continuously appending parameters.\n    =================================================== */\n\n    function getImageUrlAtWidth(\n      imageUrl,\n      width\n    ) {\n\n      if (!imageUrl) {\n        return \"\";\n      }\n\n\n      try {\n\n        const url =\n          new URL(\n            imageUrl,\n            window.location.origin\n          );\n\n\n        url.searchParams.set(\n          \"width\",\n          String(width)\n        );\n\n\n        return url.toString();\n\n\n      } catch (error) {\n\n\n        const widthPattern =\n          /([?&])width=\\d+/i;\n\n\n        if (\n          widthPattern.test(\n            imageUrl\n          )\n        ) {\n\n          return imageUrl.replace(\n            widthPattern,\n            \"$1width=\" + width\n          );\n\n        }\n\n\n        return (\n          imageUrl +\n          (\n            imageUrl.indexOf(\"?\") === -1\n              ? \"?\"\n              : \"&\"\n          ) +\n          \"width=\" +\n          width\n        );\n\n      }\n\n    }\n\n\n    /* ===================================================\n       RESPONSIVE SRCSET\n\n       Browser chooses only the width it needs.\n    =================================================== */\n\n    function createImageSrcSet(\n      imageUrl\n    ) {\n\n      if (!imageUrl) {\n        return \"\";\n      }\n\n\n      const widths = [\n\n        240,\n        320,\n        400,\n        480,\n        600\n\n      ];\n\n\n      return widths\n        .map(\n          function (width) {\n\n            return (\n              escapeHtml(\n                getImageUrlAtWidth(\n                  imageUrl,\n                  width\n                )\n              ) +\n              \" \" +\n              width +\n              \"w\"\n            );\n\n          }\n        )\n        .join(\", \");\n\n    }\n\n\n    /* ===================================================\n       PRODUCT CARD\n    =================================================== */\n\n    function createProductCard(\n      product,\n      isDuplicate\n    ) {\n\n      const variant =\n        getAvailableVariant(\n          product\n        );\n\n\n      const productUrl =\n        createStoreUrl(\n          \"products/\" +\n          encodeURIComponent(\n            product.handle || \"\"\n          )\n        );\n\n\n      const productTitle =\n        escapeHtml(\n          product.title ||\n          \"Product\"\n        );\n\n\n      const vendor =\n        escapeHtml(\n          product.vendor ||\n          \"\"\n        );\n\n\n      /*\n       * ==================================================\n       * RESPONSIVE IMAGE FIX\n       * ==================================================\n       *\n       * Previous:\n       * Every card received width=800.\n       *\n       * New:\n       * src fallback = 480px\n       * srcset = 240–600px\n       *\n       * Browser chooses correct width.\n       */\n\n      const originalImageSource =\n        getImageSource(\n          product,\n          variant\n        );\n\n\n      const imageSource =\n        getImageUrlAtWidth(\n          originalImageSource,\n          480\n        );\n\n\n      const imageSrcSet =\n        createImageSrcSet(\n          originalImageSource\n        );\n\n\n      const available =\n        Boolean(\n          variant &&\n          variant.available !== false\n        );\n\n\n      const price =\n        variant\n          ? formatMoney(\n              variant.price\n            )\n          : \"\";\n\n\n      const comparePrice =\n\n        variant &&\n\n        Number(\n          variant.compare_at_price\n        ) >\n\n        Number(\n          variant.price\n        )\n\n          ? formatMoney(\n              variant.compare_at_price\n            )\n\n          : \"\";\n\n\n      const duplicateAttributes =\n        isDuplicate\n          ? ' aria-hidden=\"true\"'\n          : \"\";\n\n\n      const duplicateTabIndex =\n        isDuplicate\n          ? ' tabindex=\"-1\"'\n          : \"\";\n\n\n      /* =================================================\n         RESPONSIVE PRODUCT IMAGE MARKUP\n      ================================================= */\n\n      const imageMarkup =\n        imageSource\n\n          ? (\n\n            '<img' +\n\n            ' class=\"hn-new30__image\"' +\n\n            ' src=\"' +\n            escapeHtml(\n              imageSource\n            ) +\n            '\"' +\n\n            ' srcset=\"' +\n            imageSrcSet +\n            '\"' +\n\n            ' sizes=\"' +\n\n              '(max-width: 580px) calc(100vw - 28px), ' +\n\n              '(max-width: 820px) calc((100vw - 58px) / 2), ' +\n\n              '(max-width: 1120px) calc((100vw - 84px) / 3), ' +\n\n              '360px' +\n\n            '\"' +\n\n            ' alt=\"' +\n            productTitle +\n            '\"' +\n\n            ' loading=\"lazy\"' +\n\n            ' decoding=\"async\"' +\n\n            ' width=\"600\"' +\n\n            ' height=\"600\"' +\n\n            '>'\n\n          )\n\n          : (\n\n            '<div class=\"hn-new30__image-placeholder\">' +\n\n            productTitle +\n\n            '</div>'\n\n          );\n\n\n      const comparePriceMarkup =\n        comparePrice\n\n          ? (\n\n            '<span class=\"hn-new30__compare-price\">' +\n\n            comparePrice +\n\n            '</span>'\n\n          )\n\n          : \"\";\n\n\n      /* =================================================\n         ADD TO CART BUTTON\n      ================================================= */\n\n      const addButtonMarkup =\n        variant &&\n        available\n\n          ? (\n\n            '<button' +\n\n            ' type=\"button\"' +\n\n            ' class=\"hn-new30__add\"' +\n\n            ' data-variant-id=\"' +\n            escapeHtml(\n              variant.id\n            ) +\n            '\"' +\n\n            ' data-product-title=\"' +\n            productTitle +\n            '\"' +\n\n            duplicateTabIndex +\n\n            '>' +\n\n\n              '<span class=\"hn-new30__cart-symbol\">' +\n\n                '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n\n                  '<path d=\"M6 7h12l-1 13H7L6 7Z\"></path>' +\n\n                  '<path d=\"M9 9V6a3 3 0 0 1 6 0v3\"></path>' +\n\n                '</svg>' +\n\n              '</span>' +\n\n\n              '<span class=\"hn-new30__button-text\">' +\n\n                'Add to cart' +\n\n              '</span>' +\n\n\n            '</button>'\n\n          )\n\n          : (\n\n            '<button' +\n\n            ' type=\"button\"' +\n\n            ' class=\"hn-new30__add\"' +\n\n            ' disabled' +\n\n            duplicateTabIndex +\n\n            '>' +\n\n              '<span class=\"hn-new30__button-text\">' +\n\n                'Sold out' +\n\n              '</span>' +\n\n            '</button>'\n\n          );\n\n\n      return (\n\n        '<article class=\"hn-new30__card\"' +\n        duplicateAttributes +\n        '>' +\n\n\n          '<a' +\n\n          ' href=\"' +\n          productUrl +\n          '\"' +\n\n          ' class=\"hn-new30__image-link\"' +\n\n          duplicateTabIndex +\n\n          '>' +\n\n\n            '<span class=\"hn-new30__badge\">' +\n\n              'Just Unveiled' +\n\n            '</span>' +\n\n\n            imageMarkup +\n\n\n          '</a>' +\n\n\n          '<div class=\"hn-new30__content\">' +\n\n\n            (\n              vendor\n\n                ? (\n\n                  '<div class=\"hn-new30__vendor\">' +\n\n                  vendor +\n\n                  '</div>'\n\n                )\n\n                : ''\n            ) +\n\n\n            '<h3 class=\"hn-new30__product-title\">' +\n\n\n              '<a' +\n\n              ' href=\"' +\n              productUrl +\n              '\"' +\n\n              duplicateTabIndex +\n\n              '>' +\n\n                productTitle +\n\n              '</a>' +\n\n\n            '</h3>' +\n\n\n            '<div class=\"hn-new30__bottom\">' +\n\n\n              '<div class=\"hn-new30__prices\">' +\n\n                '<span class=\"hn-new30__price\">' +\n\n                  price +\n\n                '</span>' +\n\n                comparePriceMarkup +\n\n              '</div>' +\n\n\n              addButtonMarkup +\n\n\n            '</div>' +\n\n\n          '</div>' +\n\n\n        '</article>'\n\n      );\n\n    }\n\n\n    /* ===================================================\n       CREATE CAROUSEL\n    =================================================== */\n\n    function createCarousel(\n      carousel,\n      productList,\n      autoplayDelay\n    ) {\n\n      if (\n        !carousel ||\n        !productList.length\n      ) {\n\n        return null;\n\n      }\n\n\n      const viewport =\n        carousel.querySelector(\n          \".hn-new30__viewport\"\n        );\n\n\n      const track =\n        carousel.querySelector(\n          \".hn-new30__track\"\n        );\n\n\n      const previousButton =\n        carousel.querySelector(\n          \".hn-new30__previous\"\n        );\n\n\n      const nextButton =\n        carousel.querySelector(\n          \".hn-new30__next\"\n        );\n\n\n      const controls =\n        carousel.querySelector(\n          \".hn-new30__controls\"\n        );\n\n\n      const productCount =\n        productList.length;\n\n\n      const originalCards =\n        productList.map(\n          function (product) {\n\n            return createProductCard(\n              product,\n              false\n            );\n\n          }\n        ).join(\"\");\n\n\n      /*\n       * Infinite-loop optimization:\n       * only clone the first 4 cards because desktop shows\n       * a maximum of 4 products at once. Previously all 15\n       * products were duplicated, creating 30 cards per row.\n       */\n      const duplicateCount =\n        Math.min(\n          4,\n          productCount\n        );\n\n\n      const duplicateCards =\n        productCount > 1\n\n          ? productList\n              .slice(\n                0,\n                duplicateCount\n              )\n              .map(\n                function (product) {\n\n                  return createProductCard(\n                    product,\n                    true\n                  );\n\n                }\n              )\n              .join(\"\")\n\n          : \"\";\n\n\n      track.innerHTML =\n        originalCards +\n        duplicateCards;\n\n\n      carousel.hidden =\n        false;\n\n\n      if (\n        productCount <= 1\n      ) {\n\n        controls.hidden =\n          true;\n\n      }\n\n\n      const state = {\n\n        index: 0,\n\n        cardWidth: 0,\n\n        gap: 20,\n\n        autoplayTimer: null,\n\n        resetTimer: null,\n\n        resizeTimer: null,\n\n        touchStartX: 0,\n\n        touchEndX: 0,\n\n        isVisible: true\n\n      };\n\n\n      const transitionDuration =\n        550;\n\n\n      /* =================================================\n         PRODUCTS PER VIEW\n      ================================================= */\n\n      function getProductsPerView() {\n\n        const viewportWidth =\n          viewport.clientWidth;\n\n\n        if (\n          viewportWidth <= 580\n        ) {\n\n          return 1;\n\n        }\n\n\n        if (\n          viewportWidth <= 820\n        ) {\n\n          return 2;\n\n        }\n\n\n        if (\n          viewportWidth <= 1120\n        ) {\n\n          return 3;\n\n        }\n\n\n        return 4;\n\n      }\n\n\n      /* =================================================\n         POSITION\n      ================================================= */\n\n      function setPosition(\n        animate\n      ) {\n\n        track.style.transition =\n          animate &&\n          !reducedMotion\n\n            ? \"transform .55s cubic-bezier(.22,.61,.36,1)\"\n\n            : \"none\";\n\n\n        track.style.transform =\n\n          \"translate3d(-\" +\n\n          state.index *\n          (\n            state.cardWidth +\n            state.gap\n          ) +\n\n          \"px,0,0)\";\n\n      }\n\n\n      /* =================================================\n         CARD WIDTH\n      ================================================= */\n\n      function updateCardSizes() {\n\n        const computedStyles =\n          window.getComputedStyle(\n            track\n          );\n\n\n        state.gap =\n          parseFloat(\n\n            computedStyles.columnGap ||\n\n            computedStyles.gap ||\n\n            \"20\"\n\n          ) || 20;\n\n\n        const productsPerView =\n          Math.max(\n\n            1,\n\n            Math.min(\n\n              productCount,\n\n              getProductsPerView()\n\n            )\n\n          );\n\n\n        state.cardWidth =\n\n          (\n            viewport.clientWidth -\n\n            state.gap *\n            (\n              productsPerView - 1\n            )\n          )\n\n          /\n\n          productsPerView;\n\n\n        track\n          .querySelectorAll(\n            \".hn-new30__card\"\n          )\n          .forEach(\n            function (card) {\n\n              card.style.width =\n                state.cardWidth +\n                \"px\";\n\n            }\n          );\n\n\n        setPosition(\n          false\n        );\n\n      }\n\n\n      /* =================================================\n         NEXT\n      ================================================= */\n\n      function moveNext() {\n\n        if (\n          productCount <= 1\n        ) {\n          return;\n        }\n\n\n        window.clearTimeout(\n          state.resetTimer\n        );\n\n\n        state.index +=\n          1;\n\n\n        setPosition(\n          true\n        );\n\n\n        if (\n          state.index >=\n          productCount\n        ) {\n\n          state.resetTimer =\n            window.setTimeout(\n              function () {\n\n                state.index =\n                  0;\n\n\n                setPosition(\n                  false\n                );\n\n              },\n\n              reducedMotion\n                ? 20\n                : transitionDuration + 40\n            );\n\n        }\n\n      }\n\n\n      /* =================================================\n         PREVIOUS\n      ================================================= */\n\n      function movePrevious() {\n\n        if (\n          productCount <= 1\n        ) {\n          return;\n        }\n\n\n        window.clearTimeout(\n          state.resetTimer\n        );\n\n\n        if (\n          state.index <= 0\n        ) {\n\n          state.index =\n            productCount;\n\n\n          setPosition(\n            false\n          );\n\n\n          window.requestAnimationFrame(\n            function () {\n\n              window.requestAnimationFrame(\n                function () {\n\n                  state.index =\n                    productCount - 1;\n\n\n                  setPosition(\n                    true\n                  );\n\n                }\n              );\n\n            }\n          );\n\n\n        } else {\n\n\n          state.index -=\n            1;\n\n\n          setPosition(\n            true\n          );\n\n        }\n\n      }\n\n\n      /* =================================================\n         AUTOPLAY\n      ================================================= */\n\n      function stopAutoplay() {\n\n        window.clearInterval(\n          state.autoplayTimer\n        );\n\n\n        state.autoplayTimer =\n          null;\n\n      }\n\n\n      function startAutoplay() {\n\n        stopAutoplay();\n\n\n        if (\n\n          reducedMotion ||\n\n          productCount <= 1 ||\n\n          !state.isVisible ||\n\n          document.hidden\n\n        ) {\n\n          return;\n\n        }\n\n\n        state.autoplayTimer =\n          window.setInterval(\n            moveNext,\n            autoplayDelay\n          );\n\n      }\n\n\n      /* =================================================\n         BUTTONS\n      ================================================= */\n\n      previousButton.addEventListener(\n        \"click\",\n        function () {\n\n          movePrevious();\n\n          startAutoplay();\n\n        }\n      );\n\n\n      nextButton.addEventListener(\n        \"click\",\n        function () {\n\n          moveNext();\n\n          startAutoplay();\n\n        }\n      );\n\n\n      /* =================================================\n         HOVER / FOCUS\n      ================================================= */\n\n      viewport.addEventListener(\n        \"mouseenter\",\n        stopAutoplay\n      );\n\n\n      viewport.addEventListener(\n        \"mouseleave\",\n        startAutoplay\n      );\n\n\n      viewport.addEventListener(\n        \"focusin\",\n        stopAutoplay\n      );\n\n\n      viewport.addEventListener(\n        \"focusout\",\n        startAutoplay\n      );\n\n\n      /* =================================================\n         MOBILE SWIPE\n      ================================================= */\n\n      viewport.addEventListener(\n        \"touchstart\",\n        function (event) {\n\n          state.touchStartX =\n            event.changedTouches[0]\n              .screenX;\n\n\n          stopAutoplay();\n\n        },\n        {\n          passive:\n            true\n        }\n      );\n\n\n      viewport.addEventListener(\n        \"touchend\",\n        function (event) {\n\n          state.touchEndX =\n            event.changedTouches[0]\n              .screenX;\n\n\n          const swipeDistance =\n\n            state.touchStartX -\n\n            state.touchEndX;\n\n\n          if (\n            Math.abs(\n              swipeDistance\n            ) > 45\n          ) {\n\n            if (\n              swipeDistance > 0\n            ) {\n\n              moveNext();\n\n            } else {\n\n              movePrevious();\n\n            }\n\n          }\n\n\n          startAutoplay();\n\n        },\n        {\n          passive:\n            true\n        }\n      );\n\n\n      /* =================================================\n         RESIZE\n      ================================================= */\n\n      window.addEventListener(\n        \"resize\",\n        function () {\n\n          window.clearTimeout(\n            state.resizeTimer\n          );\n\n\n          state.resizeTimer =\n            window.setTimeout(\n              updateCardSizes,\n              120\n            );\n\n        },\n        {\n          passive:\n            true\n        }\n      );\n\n\n      /* =================================================\n         PAGE VISIBILITY\n      ================================================= */\n\n      document.addEventListener(\n        \"visibilitychange\",\n        function () {\n\n          if (\n            document.hidden\n          ) {\n\n            stopAutoplay();\n\n          } else {\n\n            startAutoplay();\n\n          }\n\n        }\n      );\n\n\n      /* =================================================\n         SECTION VISIBILITY\n      ================================================= */\n\n      if (\n        \"IntersectionObserver\"\n        in window\n      ) {\n\n        const observer =\n          new IntersectionObserver(\n            function (entries) {\n\n              entries.forEach(\n                function (entry) {\n\n                  state.isVisible =\n                    entry.isIntersecting;\n\n\n                  if (\n                    state.isVisible\n                  ) {\n\n                    startAutoplay();\n\n                  } else {\n\n                    stopAutoplay();\n\n                  }\n\n                }\n              );\n\n            },\n            {\n              threshold:\n                0.12\n            }\n          );\n\n\n        observer.observe(\n          carousel\n        );\n\n      }\n\n\n      /* =================================================\n         INITIALIZE CAROUSEL\n      ================================================= */\n\n      window.requestAnimationFrame(\n        function () {\n\n          updateCardSizes();\n\n          setPosition(\n            false\n          );\n\n          startAutoplay();\n\n        }\n      );\n\n\n      return state;\n\n    }\n\n\n    /* ===================================================\n       TOAST\n    =================================================== */\n\n    function showToast(\n      message,\n      isError\n    ) {\n\n      if (\n        !toast ||\n        !toastMessage\n      ) {\n        return;\n      }\n\n\n      toastMessage.textContent =\n        message;\n\n\n      toast.style.background =\n        isError\n\n          ? \"rgba(132,48,48,.97)\"\n\n          : \"rgba(32,63,53,.97)\";\n\n\n      toast.classList.add(\n        \"is-visible\"\n      );\n\n\n      window.clearTimeout(\n        toastTimer\n      );\n\n\n      toastTimer =\n        window.setTimeout(\n          function () {\n\n            toast.classList.remove(\n              \"is-visible\"\n            );\n\n          },\n          3200\n        );\n\n    }\n\n\n    /* ===================================================\n       UPDATE CART COUNT\n    =================================================== */\n\n    function updateThemeCartCount(\n      itemCount\n    ) {\n\n      const selectors = [\n\n        \"[data-cart-count]\",\n\n        \".cart-count-bubble span[aria-hidden='true']\",\n\n        \".cart-count-number\",\n\n        \".cart-count\",\n\n        \"#CartCount\"\n\n      ];\n\n\n      document\n        .querySelectorAll(\n          selectors.join(\",\")\n        )\n        .forEach(\n          function (element) {\n\n            element.textContent =\n              itemCount;\n\n\n            element.hidden =\n              false;\n\n\n            element.removeAttribute(\n              \"hidden\"\n            );\n\n          }\n        );\n\n\n      document\n        .querySelectorAll(\n          \".cart-count-bubble\"\n        )\n        .forEach(\n          function (bubble) {\n\n            bubble.hidden =\n              false;\n\n\n            bubble.classList.remove(\n              \"hidden\"\n            );\n\n\n            bubble.removeAttribute(\n              \"hidden\"\n            );\n\n          }\n        );\n\n    }\n\n\n    /* ===================================================\n       CURRENT CART\n    =================================================== */\n\n    async function fetchCurrentCart() {\n\n      try {\n\n        const response =\n          await fetch(\n            createStoreUrl(\n              \"cart.js\"\n            ),\n            {\n              method:\n                \"GET\",\n\n              cache:\n                \"no-store\",\n\n              credentials:\n                \"same-origin\",\n\n              headers: {\n\n                \"Accept\":\n                  \"application/json\",\n\n                \"X-Requested-With\":\n                  \"XMLHttpRequest\"\n\n              }\n            }\n          );\n\n\n        if (\n          !response.ok\n        ) {\n\n          return null;\n\n        }\n\n\n        return await response.json();\n\n\n      } catch (error) {\n\n\n        return null;\n\n      }\n\n    }\n\n\n    /* ===================================================\n       THEME CART EVENTS\n    =================================================== */\n\n    function notifyThemeAboutCart(\n      cart\n    ) {\n\n      [\n        \"cart:updated\",\n        \"cart:refresh\",\n        \"cart:change\"\n      ].forEach(\n        function (eventName) {\n\n          document.dispatchEvent(\n            new CustomEvent(\n              eventName,\n              {\n                bubbles:\n                  true,\n\n                detail:\n                  {\n                    cart:\n                      cart\n                  }\n              }\n            )\n          );\n\n        }\n      );\n\n    }\n\n\n    /* ===================================================\n       ADD PRODUCT TO CART\n    =================================================== */\n\n    async function addProductToCart(\n      button\n    ) {\n\n      const variantId =\n        Number(\n          button.dataset.variantId\n        );\n\n\n      const productTitle =\n        button.dataset.productTitle ||\n        \"Product\";\n\n\n      if (\n        !variantId ||\n        button.classList.contains(\n          \"is-loading\"\n        )\n      ) {\n\n        return;\n\n      }\n\n\n      const buttonText =\n        button.querySelector(\n          \".hn-new30__button-text\"\n        );\n\n\n      const originalText =\n        buttonText\n          ? buttonText.textContent\n          : \"Add to cart\";\n\n\n      button.classList.add(\n        \"is-loading\"\n      );\n\n\n      if (\n        buttonText\n      ) {\n\n        buttonText.textContent =\n          \"Adding...\";\n\n      }\n\n\n      try {\n\n        const response =\n          await fetch(\n            createStoreUrl(\n              \"cart/add.js\"\n            ),\n            {\n              method:\n                \"POST\",\n\n              credentials:\n                \"same-origin\",\n\n              headers: {\n\n                \"Content-Type\":\n                  \"application/json\",\n\n                \"Accept\":\n                  \"application/json\",\n\n                \"X-Requested-With\":\n                  \"XMLHttpRequest\"\n\n              },\n\n              body:\n                JSON.stringify(\n                  {\n                    items: [\n                      {\n                        id:\n                          variantId,\n\n                        quantity:\n                          1\n                      }\n                    ]\n                  }\n                )\n            }\n          );\n\n\n        const data =\n          await response.json();\n\n\n        if (\n          !response.ok\n        ) {\n\n          throw new Error(\n\n            data.description ||\n\n            data.message ||\n\n            \"This product could not be added.\"\n\n          );\n\n        }\n\n\n        button.classList.remove(\n          \"is-loading\"\n        );\n\n\n        button.classList.add(\n          \"is-added\"\n        );\n\n\n        if (\n          buttonText\n        ) {\n\n          buttonText.textContent =\n            \"Added\";\n\n        }\n\n\n        showToast(\n\n          productTitle +\n          \" added to your cart.\",\n\n          false\n\n        );\n\n\n        window.setTimeout(\n          async function () {\n\n            const cart =\n              await fetchCurrentCart();\n\n\n            if (\n              cart\n            ) {\n\n              updateThemeCartCount(\n                cart.item_count\n              );\n\n\n              notifyThemeAboutCart(\n                cart\n              );\n\n            }\n\n          },\n          300\n        );\n\n\n        window.setTimeout(\n          function () {\n\n            button.classList.remove(\n              \"is-added\"\n            );\n\n\n            if (\n              buttonText\n            ) {\n\n              buttonText.textContent =\n                originalText;\n\n            }\n\n          },\n          1900\n        );\n\n\n      } catch (error) {\n\n\n        button.classList.remove(\n          \"is-loading\"\n        );\n\n\n        if (\n          buttonText\n        ) {\n\n          buttonText.textContent =\n            originalText;\n\n        }\n\n\n        showToast(\n\n          error.message ||\n          \"This product could not be added.\",\n\n          true\n\n        );\n\n      }\n\n    }\n\n\n    /* ===================================================\n       ADD TO CART CLICK\n    =================================================== */\n\n    root.addEventListener(\n      \"click\",\n      function (event) {\n\n        const addButton =\n          event.target.closest(\n            \".hn-new30__add\"\n          );\n\n\n        if (\n          !addButton ||\n          addButton.disabled\n        ) {\n\n          return;\n\n        }\n\n\n        addProductToCart(\n          addButton\n        );\n\n      }\n    );\n\n\n    if (\n      toastCartLink\n    ) {\n\n      toastCartLink.href =\n        createStoreUrl(\n          \"cart\"\n        );\n\n    }\n\n\n    /* ===================================================\n       LOAD PRODUCTS\n    =================================================== */\n\n    fetchNewestProducts()\n\n      .then(\n        function (fetchedProducts) {\n\n          const newestThirty =\n            sortNewestProducts(\n              fetchedProducts\n            ).slice(\n              0,\n              totalProductCount\n            );\n\n\n          const topProducts =\n            newestThirty.slice(\n              0,\n              topCount\n            );\n\n\n          const bottomProducts =\n            newestThirty.slice(\n              topCount,\n              topCount +\n              bottomCount\n            );\n\n\n          if (\n            mainLoading\n          ) {\n\n            mainLoading.hidden =\n              true;\n\n          }\n\n\n          if (\n            !topProducts.length\n          ) {\n\n            if (\n              emptyMessage\n            ) {\n\n              emptyMessage.hidden =\n                false;\n\n            }\n\n            return;\n\n          }\n\n\n          createCarousel(\n\n            carousels[0],\n\n            topProducts,\n\n            3400\n\n          );\n\n\n          if (\n            bottomProducts.length &&\n            carousels[1]\n          ) {\n\n            if (\n              divider\n            ) {\n\n              divider.hidden =\n                false;\n\n            }\n\n\n            createCarousel(\n\n              carousels[1],\n\n              bottomProducts,\n\n              3900\n\n            );\n\n          }\n\n        }\n      )\n\n      .catch(\n        function (error) {\n\n          console.error(\n            \"Hertha Nest latest 30 products error:\",\n            error\n          );\n\n\n          if (\n            mainLoading\n          ) {\n\n            mainLoading.hidden =\n              true;\n\n          }\n\n\n          if (\n            emptyMessage\n          ) {\n\n            emptyMessage.hidden =\n              false;\n\n\n            emptyMessage.textContent =\n\n              \"The newest products could not be loaded. Please refresh the page.\";\n\n          }\n\n        }\n      );\n\n  }\n\n\n  /* =====================================================\n     INITIALIZE ALL INSTANCES\n  ===================================================== */\n\n  function initialiseAllNewThirtySections(\n    scope\n  ) {\n\n    const searchArea =\n      scope ||\n      document;\n\n\n    searchArea\n      .querySelectorAll(\n        \".hn-new30\"\n      )\n      .forEach(\n        function (section) {\n\n          initialiseNewThirtySection(\n            section\n          );\n\n        }\n      );\n\n  }\n\n\n  initialiseAllNewThirtySections(\n    document\n  );\n\n\n  /*\n    Theme CSS/editor wrappers can finish rendering after the\n    Custom HTML code. Re-run the shell reset a few times so\n    the blank heading area cannot reappear.\n  */\n\n  [\n    50,\n    200,\n    700,\n    1500\n  ].forEach(\n    function (delay) {\n\n      window.setTimeout(\n        function () {\n\n          document\n            .querySelectorAll(\n              \".hn-new30\"\n            )\n            .forEach(\n              collapseNewThirtyThemeShell\n            );\n\n        },\n        delay\n      );\n\n    }\n  );\n\n\n  /* Shopify Theme Editor support */\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    function (event) {\n\n      initialiseAllNewThirtySections(\n        event.target\n      );\n\n    }\n  );\n\n})();\n\n</script>"
      }
    },
