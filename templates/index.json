events: none;\n\n}\n\n\n\n/* TEXT LEFT */\n\n.hn-content-left\n.hn-premium-overlay {\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(250,242,229,0.91) 0%,\n\n      rgba(250,242,229,0.80) 20%,\n\n      rgba(250,242,229,0.52) 34%,\n\n      rgba(250,242,229,0.18) 47%,\n\n      rgba(250,242,229,0.025) 59%,\n\n      rgba(250,242,229,0) 68%\n\n    );\n\n}\n\n\n\n/* TEXT RIGHT */\n\n.hn-content-right\n.hn-premium-overlay {\n\n  background:\n\n    linear-gradient(\n\n      270deg,\n\n      rgba(250,242,229,0.91) 0%,\n\n      rgba(250,242,229,0.80) 21%,\n\n      rgba(250,242,229,0.52) 35%,\n\n      rgba(250,242,229,0.17) 48%,\n\n      rgba(250,242,229,0.025) 60%,\n\n      rgba(250,242,229,0) 69%\n\n    );\n\n}\n\n\n\n/* =========================================================\n   CINEMATIC DEPTH\n========================================================= */\n\n.hn-premium-slide::after {\n\n  content: \"\";\n\n\n  position: absolute;\n\n  inset: 0;\n\n\n  z-index: 1;\n\n\n  pointer-events: none;\n\n\n  background:\n\n    linear-gradient(\n\n      180deg,\n\n      rgba(31,20,13,0.008) 0%,\n\n      rgba(31,20,13,0) 65%,\n\n      rgba(31,20,13,0.07) 100%\n\n    );\n\n}\n\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hn-premium-content {\n\n  position: relative;\n\n\n  z-index: 4;\n\n\n  display: flex;\n\n  align-items: center;\n\n\n  width: 100%;\n\n  height: 100%;\n\n\n  padding:\n\n    45px\n    clamp(\n      70px,\n      6.4vw,\n      124px\n    );\n\n}\n\n\n\n.hn-content-left\n.hn-premium-content {\n\n  justify-content:\n    flex-start;\n\n}\n\n\n\n.hn-content-right\n.hn-premium-content {\n\n  justify-content:\n    flex-end;\n\n}\n\n\n\n/* =========================================================\n   COPY\n========================================================= */\n\n.hn-premium-copy {\n\n  position: relative;\n\n\n  width: 100%;\n\n\n  max-width:\n    620px;\n\n\n  margin: 0;\n\n\n  opacity: 0;\n\n\n  transform:\n    translateY(20px);\n\n\n  transition:\n\n    opacity\n    700ms\n    ease\n    170ms,\n\n    transform\n    700ms\n    cubic-bezier(.22,.61,.36,1)\n    170ms;\n\n}\n\n\n\n.hn-premium-slide.is-active\n.hn-premium-copy {\n\n  opacity: 1;\n\n\n  transform:\n    translateY(0);\n\n}\n\n\n\n/* =========================================================\n   RIGHT-SIDE DESKTOP CONTENT\n\n   Wider so:\n   \"Tradition, Beautifully\"\n   stays in one line.\n========================================================= */\n\n@media screen and (min-width: 1101px) {\n\n  .hn-content-right\n  .hn-premium-content {\n\n    padding-left:\n      54%;\n\n\n    padding-right:\n\n      clamp(\n        48px,\n        5.2vw,\n        100px\n      );\n\n  }\n\n\n  .hn-content-right\n  .hn-premium-copy {\n\n    max-width:\n      720px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SUBTLE PREMIUM LIGHT BEHIND COPY\n========================================================= */\n\n@media screen and (min-width: 1101px) {\n\n  .hn-content-right\n  .hn-premium-copy::before {\n\n    content: \"\";\n\n\n    position: absolute;\n\n\n    z-index: -1;\n\n\n    top: -35px;\n\n    right: -45px;\n\n    bottom: -30px;\n\n    left: -55px;\n\n\n    border-radius:\n      40px;\n\n\n    background:\n\n      radial-gradient(\n\n        ellipse at center,\n\n        rgba(255,248,236,0.17) 0%,\n\n        rgba(255,248,236,0.07) 48%,\n\n        rgba(255,248,236,0) 76%\n\n      );\n\n\n    pointer-events: none;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   EYEBROW\n========================================================= */\n\n.hn-premium-eyebrow {\n\n  display: flex;\n\n  align-items: center;\n\n\n  gap: 13px;\n\n\n  width:\n    fit-content;\n\n\n  margin:\n    0\n    0\n    17px;\n\n\n  color:\n    #8d5d2f;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      9px,\n      0.67vw,\n      11px\n    );\n\n\n  font-weight: 700;\n\n\n  line-height: 1.35;\n\n\n  letter-spacing:\n    0.22em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n\n.hn-premium-eyebrow::before {\n\n  content: \"\";\n\n\n  display: block;\n\n\n  width: 25px;\n\n  height: 1px;\n\n\n  flex:\n    0\n    0\n    25px;\n\n\n  background:\n    currentColor;\n\n\n  opacity:\n    0.65;\n\n}\n\n\n\n/* =========================================================\n   STANDARD HEADING\n========================================================= */\n\n.hn-premium-heading {\n\n  display: flex;\n\n  flex-direction: column;\n\n\n  width: 100%;\n\n\n  margin: 0;\n\n\n  color:\n    var(--hn-brown);\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n\n    clamp(\n      44px,\n      4vw,\n      73px\n    );\n\n\n  font-weight: 500;\n\n\n  line-height:\n    0.97;\n\n\n  letter-spacing:\n    -0.045em;\n\n}\n\n\n\n.hn-premium-heading > span {\n\n  display: block;\n\n}\n\n\n\n.hn-premium-heading em {\n\n  display: block;\n\n\n  margin-top:\n    6px;\n\n\n  color:\n    var(--hn-rust);\n\n\n  font-weight:\n    400;\n\n\n  font-style:\n    italic;\n\n\n  font-size:\n    0.82em;\n\n\n  line-height:\n    1.08;\n\n\n  letter-spacing:\n    -0.035em;\n\n}\n\n\n\n/* =========================================================\n   TRADITION HEADING\n========================================================= */\n\n.hn-tradition-heading {\n\n  max-width:\n    720px;\n\n}\n\n\n\n.hn-tradition-first-line {\n\n  display: block;\n\n\n  white-space:\n    nowrap;\n\n}\n\n\n\n/* Keep right heading elegant and within space */\n\n@media screen and (min-width: 1101px) {\n\n  .hn-tradition-heading {\n\n    font-size:\n\n      clamp(\n        41px,\n        3.15vw,\n        62px\n      );\n\n\n    line-height:\n      0.99;\n\n  }\n\n\n  .hn-tradition-heading em {\n\n    margin-top:\n      7px;\n\n\n    font-size:\n      0.90em;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   PREMIUM ORNAMENT\n========================================================= */\n\n.hn-premium-ornament {\n\n  display: flex;\n\n  align-items: center;\n\n\n  gap:\n    8px;\n\n\n  width:\n    78px;\n\n\n  height:\n    12px;\n\n\n  margin-top:\n    22px;\n\n}\n\n\n\n.hn-premium-ornament span {\n\n  display: block;\n\n\n  width:\n    28px;\n\n\n  height:\n    1px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(139,89,43,0.18),\n\n      rgba(139,89,43,0.72)\n\n    );\n\n}\n\n\n\n.hn-premium-ornament span:last-child {\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(139,89,43,0.72),\n\n      rgba(139,89,43,0.18)\n\n    );\n\n}\n\n\n\n.hn-premium-ornament i {\n\n  display: block;\n\n\n  width:\n    6px;\n\n\n  height:\n    6px;\n\n\n  border:\n\n    1px solid\n    rgba(139,89,43,0.78);\n\n\n  transform:\n    rotate(45deg);\n\n\n  background:\n\n    rgba(255,244,226,0.55);\n\n}\n\n\n\n/* =========================================================\n   MOBILE-FIRST SLIDE\n========================================================= */\n\n.hn-mobile-only-slide\n.hn-premium-heading {\n\n  display:\n    block;\n\n}\n\n\n\n.hn-mobile-only-slide\n.hn-premium-heading em {\n\n  display:\n    block;\n\n}\n\n\n\n/* =========================================================\n   ORIGINAL DECORATIVE LINE\n========================================================= */\n\n.hn-premium-line {\n\n  display: block;\n\n\n  width: 52px;\n\n  height: 2px;\n\n\n  margin:\n\n    22px\n    0\n    17px;\n\n\n  border-radius:\n    50px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      #8c5725,\n\n      #d5a05a\n\n    );\n\n}\n\n\n\n/* =========================================================\n   DESCRIPTION\n========================================================= */\n\n.hn-premium-description {\n\n  width: 100%;\n\n\n  max-width:\n    540px;\n\n\n  margin:\n\n    17px\n    0\n    0;\n\n\n  color:\n    var(--hn-copy);\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      14px,\n      1vw,\n      17px\n    );\n\n\n  font-weight:\n    400;\n\n\n  line-height:\n    1.62;\n\n\n  letter-spacing:\n    0.002em;\n\n}\n\n\n\n.hn-mobile-only-slide\n.hn-premium-description {\n\n  margin-top:\n    0;\n\n}\n\n\n\n/* =========================================================\n   BUTTON\n========================================================= */\n\n.hn-premium-button {\n\n  position: relative;\n\n\n  display:\n    inline-flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  gap:\n    18px;\n\n\n  min-width:\n    242px;\n\n\n  margin-top:\n    27px;\n\n\n  padding:\n\n    16px\n    24px;\n\n\n  overflow:\n    hidden;\n\n\n  border:\n\n    1px solid\n    rgba(113,45,14,0.18);\n\n\n  border-radius:\n    6px;\n\n\n  background:\n\n    linear-gradient(\n\n      135deg,\n\n      #ad4818 0%,\n\n      #8c3210 100%\n\n    );\n\n\n  box-shadow:\n\n    0 12px 28px\n    rgba(109,51,22,0.20),\n\n    inset\n    0 1px 0\n    rgba(255,255,255,0.14);\n\n\n  color:\n    #ffffff !important;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n    15px;\n\n\n  font-weight:\n    600;\n\n\n  line-height:\n    1;\n\n\n  text-decoration:\n    none !important;\n\n\n  cursor:\n    pointer;\n\n\n  pointer-events:\n    auto;\n\n\n  transform:\n    translateZ(0);\n\n\n  transition:\n\n    transform\n    250ms\n    ease,\n\n    box-shadow\n    250ms\n    ease,\n\n    filter\n    250ms\n    ease;\n\n}\n\n\n\n.hn-premium-button::before {\n\n  content: \"\";\n\n\n  position:\n    absolute;\n\n\n  top: 0;\n\n  left: -75%;\n\n\n  width:\n    46%;\n\n\n  height:\n    100%;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      transparent,\n\n      rgba(255,255,255,0.18),\n\n      transparent\n\n    );\n\n\n  transform:\n    skewX(-22deg);\n\n\n  transition:\n\n    left\n    620ms\n    ease;\n\n}\n\n\n\n.hn-premium-button:hover {\n\n  transform:\n\n    translateY(-3px)\n    scale(1.01);\n\n\n  box-shadow:\n\n    0 17px 35px\n    rgba(101,44,17,0.27),\n\n    inset\n    0 1px 0\n    rgba(255,255,255,0.17);\n\n\n  filter:\n    saturate(1.04);\n\n}\n\n\n\n.hn-premium-button:hover::before {\n\n  left:\n    130%;\n\n}\n\n\n\n.hn-premium-button span {\n\n  position:\n    relative;\n\n\n  z-index:\n    2;\n\n}\n\n\n\n.hn-premium-button svg {\n\n  position:\n    relative;\n\n\n  z-index:\n    2;\n\n\n  display:\n    block;\n\n\n  width:\n    20px;\n\n\n  height:\n    20px;\n\n\n  flex:\n    0\n    0\n    20px;\n\n\n  transition:\n\n    transform\n    250ms\n    ease;\n\n}\n\n\n\n.hn-premium-button:hover svg {\n\n  transform:\n    translateX(5px);\n\n}\n\n\n\n.hn-premium-button:focus-visible {\n\n  outline:\n\n    3px solid\n    rgba(93,48,25,0.40);\n\n\n  outline-offset:\n    4px;\n\n}\n\n\n\n/* =========================================================\n   FEATURES\n========================================================= */\n\n.hn-premium-features {\n\n  display: flex;\n\n\n  align-items: center;\n\n\n  gap:\n    20px;\n\n\n  width:\n    fit-content;\n\n\n  margin-top:\n    29px;\n\n\n  padding:\n\n    3px\n    0;\n\n}\n\n\n\n.hn-premium-feature {\n\n  display: flex;\n\n\n  align-items: center;\n\n\n  gap:\n    9px;\n\n\n  color:\n    #4b3629;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n    12px;\n\n\n  font-weight:\n    500;\n\n\n  line-height:\n    1.28;\n\n}\n\n\n\n.hn-feature-icon {\n\n  display: flex;\n\n\n  align-items: center;\n\n\n  justify-content: center;\n\n\n  width:\n    39px;\n\n\n  height:\n    39px;\n\n\n  flex:\n    0\n    0\n    39px;\n\n\n  border:\n\n    1px solid\n    rgba(130,79,39,0.45);\n\n\n  border-radius:\n    50%;\n\n\n  background:\n\n    rgba(255,248,237,0.22);\n\n\n  box-shadow:\n\n    inset\n    0 1px 0\n    rgba(255,255,255,0.35);\n\n\n  color:\n    #855126;\n\n\n  transition:\n\n    transform\n    250ms\n    ease,\n\n    background\n    250ms\n    ease;\n\n}\n\n\n\n.hn-premium-feature:hover\n.hn-feature-icon {\n\n  transform:\n    translateY(-2px);\n\n\n  background:\n    rgba(255,248,237,0.45);\n\n}\n\n\n\n.hn-feature-icon svg {\n\n  width:\n    22px;\n\n\n  height:\n    22px;\n\n}\n\n\n\n.hn-feature-separator {\n\n  display:\n    block;\n\n\n  width:\n    1px;\n\n\n  height:\n    48px;\n\n\n  background:\n\n    linear-gradient(\n\n      180deg,\n\n      rgba(102,72,49,0),\n\n      rgba(102,72,49,0.24),\n\n      rgba(102,72,49,0)\n\n    );\n\n}\n\n\n\n/* =========================================================\n   DOT NAVIGATION\n========================================================= */\n\n.hn-premium-dots {\n\n  position:\n    absolute;\n\n\n  z-index:\n    30;\n\n\n  left:\n    50%;\n\n\n  bottom:\n    20px;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  gap:\n    8px;\n\n\n  padding:\n\n    7px\n    12px;\n\n\n  border:\n\n    1px solid\n    rgba(255,255,255,0.34);\n\n\n  border-radius:\n    50px;\n\n\n  background:\n\n    rgba(255,247,235,0.52);\n\n\n  box-shadow:\n\n    0 5px 18px\n    rgba(72,46,29,0.10),\n\n    inset\n    0 1px 0\n    rgba(255,255,255,0.35);\n\n\n  backdrop-filter:\n    blur(8px);\n\n\n  -webkit-backdrop-filter:\n    blur(8px);\n\n\n  transform:\n    translateX(-50%);\n\n}\n\n\n\n.hn-premium-dot {\n\n  display: block;\n\n\n  width:\n    7px;\n\n\n  height:\n    7px;\n\n\n  min-width:\n    7px;\n\n\n  margin:\n    0;\n\n\n  padding:\n    0;\n\n\n  border:\n    0;\n\n\n  border-radius:\n    100px;\n\n\n  background:\n\n    rgba(72,49,34,0.36);\n\n\n  cursor:\n    pointer;\n\n\n  appearance:\n    none;\n\n\n  -webkit-appearance:\n    none;\n\n\n  transition:\n\n    width\n    280ms\n    ease,\n\n    background\n    280ms\n    ease,\n\n    transform\n    280ms\n    ease;\n\n}\n\n\n\n.hn-premium-dot:hover {\n\n  transform:\n    scale(1.15);\n\n}\n\n\n\n.hn-premium-dot.is-active {\n\n  width:\n    27px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      #875526,\n\n      #b87936\n\n    );\n\n}\n\n\n\n.hn-premium-dot:focus-visible {\n\n  outline:\n\n    2px solid\n    #35251d;\n\n\n  outline-offset:\n    3px;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and\n(max-width: 1100px) and\n(min-width: 750px) {\n\n\n  .hn-premium-content {\n\n    padding:\n\n      30px\n      38px;\n\n  }\n\n\n  .hn-premium-copy {\n\n    width:\n      48%;\n\n\n    max-width:\n      500px;\n\n  }\n\n\n  .hn-premium-heading {\n\n    font-size:\n\n      clamp(\n        33px,\n        4.7vw,\n        50px\n      );\n\n  }\n\n\n  .hn-content-right\n  .hn-premium-content {\n\n    padding-left:\n      51%;\n\n\n    padding-right:\n      24px;\n\n  }\n\n\n  .hn-content-right\n  .hn-premium-copy {\n\n    width:\n      100%;\n\n\n    max-width:\n      520px;\n\n  }\n\n\n  .hn-tradition-heading {\n\n    font-size:\n\n      clamp(\n        31px,\n        4.1vw,\n        45px\n      );\n\n  }\n\n\n  .hn-tradition-first-line {\n\n    white-space:\n      nowrap;\n\n  }\n\n\n  .hn-premium-ornament {\n\n    margin-top:\n      15px;\n\n  }\n\n\n  .hn-premium-description {\n\n    margin-top:\n      11px;\n\n\n    font-size:\n      12.5px;\n\n\n    line-height:\n      1.48;\n\n  }\n\n\n  .hn-premium-button {\n\n    min-width:\n      195px;\n\n\n    margin-top:\n      17px;\n\n\n    padding:\n\n      12px\n      18px;\n\n\n    font-size:\n      12px;\n\n  }\n\n\n  .hn-premium-features {\n\n    gap:\n      10px;\n\n\n    margin-top:\n      18px;\n\n  }\n\n\n  .hn-premium-feature {\n\n    gap:\n      6px;\n\n\n    font-size:\n      8.5px;\n\n  }\n\n\n  .hn-feature-icon {\n\n    width:\n      29px;\n\n\n    height:\n      29px;\n\n\n    flex-basis:\n      29px;\n\n  }\n\n\n  .hn-feature-icon svg {\n\n    width:\n      16px;\n\n\n    height:\n      16px;\n\n  }\n\n\n  .hn-feature-separator {\n\n    height:\n      34px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n\n  .hn-premium-track {\n\n    aspect-ratio:\n      4 / 5;\n\n  }\n\n\n\n  .hn-premium-image {\n\n    width:\n      100%;\n\n\n    height:\n      100%;\n\n\n    object-fit:\n      cover;\n\n\n    object-position:\n      center center;\n\n\n    transform:\n      none !important;\n\n  }\n\n\n\n  /* MOBILE OVERLAY */\n\n  .hn-content-left\n  .hn-premium-overlay,\n\n  .hn-content-right\n  .hn-premium-overlay,\n\n  .hn-mobile-only-slide\n  .hn-premium-overlay {\n\n    background:\n\n      linear-gradient(\n\n        180deg,\n\n        rgba(252,244,229,0.91) 0%,\n\n        rgba(252,244,229,0.78) 15%,\n\n        rgba(252,244,229,0.49) 27%,\n\n        rgba(252,244,229,0.17) 40%,\n\n        rgba(252,244,229,0) 53%\n\n      );\n\n  }\n\n\n\n  /* CONTENT */\n\n  .hn-premium-content,\n  .hn-content-left\n  .hn-premium-content,\n  .hn-content-right\n  .hn-premium-content {\n\n    position:\n      absolute;\n\n\n    inset:\n      0;\n\n\n    display:\n      flex;\n\n\n    align-items:\n      flex-start;\n\n\n    justify-content:\n      center;\n\n\n    width:\n      100%;\n\n\n    height:\n      100%;\n\n\n    padding:\n\n      clamp(\n        27px,\n        7.5vw,\n        40px\n      )\n\n      18px\n\n      65px;\n\n  }\n\n\n\n  /* COPY */\n\n  .hn-premium-copy,\n  .hn-content-left\n  .hn-premium-copy,\n  .hn-content-right\n  .hn-premium-copy {\n\n    width:\n      100%;\n\n\n    max-width:\n      395px;\n\n\n    margin:\n\n      0\n      auto;\n\n\n    text-align:\n      center;\n\n\n    transform:\n      translateY(10px);\n\n  }\n\n\n\n  .hn-premium-slide.is-active\n  .hn-premium-copy {\n\n    transform:\n      translateY(0);\n\n  }\n\n\n\n  /* EYEBROW */\n\n  .hn-premium-eyebrow {\n\n    justify-content:\n      center;\n\n\n    width:\n      100%;\n\n\n    margin-bottom:\n      8px;\n\n\n    color:\n      #79502a;\n\n\n    font-size:\n      8.5px;\n\n\n    font-weight:\n      700;\n\n\n    letter-spacing:\n      0.15em;\n\n\n    text-align:\n      center;\n\n  }\n\n\n\n  .hn-premium-eyebrow::before {\n\n    display:\n      none;\n\n  }\n\n\n\n  /* HEADING */\n\n  .hn-premium-heading {\n\n    display:\n      block;\n\n\n    width:\n      100%;\n\n\n    max-width:\n      390px;\n\n\n    margin:\n\n      0\n      auto;\n\n\n    color:\n      #34251e;\n\n\n    text-align:\n      center;\n\n\n    font-size:\n\n      clamp(\n        29px,\n        8.3vw,\n        39px\n      );\n\n\n    line-height:\n      1.01;\n\n\n    letter-spacing:\n      -0.035em;\n\n  }\n\n\n\n  .hn-premium-heading span {\n\n    display:\n      inline;\n\n  }\n\n\n\n  .hn-premium-heading em {\n\n    display:\n      block;\n\n\n    margin-top:\n      2px;\n\n\n    color:\n      #8e451c;\n\n\n    font-size:\n      0.88em;\n\n  }\n\n\n\n  /* ALLOW MOBILE WRAPPING */\n\n  .hn-tradition-first-line {\n\n    white-space:\n      normal;\n\n  }\n\n\n\n  .hn-tradition-heading {\n\n    max-width:\n      390px;\n\n  }\n\n\n\n  /* ORNAMENT */\n\n  .hn-premium-ornament {\n\n    justify-content:\n      center;\n\n\n    margin:\n\n      10px\n      auto\n      0;\n\n  }\n\n\n\n  /* MOBILE FIRST LINE */\n\n  .hn-premium-line {\n\n    width:\n      38px;\n\n\n    height:\n      1.5px;\n\n\n    margin:\n\n      11px\n      auto\n      10px;\n\n  }\n\n\n\n  /* DESCRIPTION */\n\n  .hn-premium-description {\n\n    width:\n      auto;\n\n\n    max-width:\n      360px;\n\n\n    margin:\n\n      8px\n      auto\n      0;\n\n\n    padding:\n\n      7px\n      11px;\n\n\n    color:\n      #3e2d25;\n\n\n    text-align:\n      center;\n\n\n    font-size:\n      12.7px;\n\n\n    font-weight:\n      600;\n\n\n    line-height:\n      1.45;\n\n\n    border:\n\n      1px solid\n      rgba(255,255,255,0.26);\n\n\n    border-radius:\n      8px;\n\n\n    background:\n\n      rgba(255,248,237,0.45);\n\n\n    box-shadow:\n\n      0 4px 15px\n      rgba(78,49,28,0.05);\n\n\n    backdrop-filter:\n      blur(3px);\n\n\n    -webkit-backdrop-filter:\n      blur(3px);\n\n  }\n\n\n\n  .hn-mobile-only-slide\n  .hn-premium-description {\n\n    margin-top:\n      0;\n\n  }\n\n\n\n  /* CTA */\n\n  .hn-premium-button {\n\n    min-width:\n      195px;\n\n\n    margin-top:\n      13px;\n\n\n    padding:\n\n      12px\n      18px;\n\n\n    gap:\n      11px;\n\n\n    border-radius:\n      5px;\n\n\n    font-size:\n      12px;\n\n  }\n\n\n\n  .hn-premium-button svg {\n\n    width:\n      16px;\n\n\n    height:\n      16px;\n\n\n    flex-basis:\n      16px;\n\n  }\n\n\n\n  /* FEATURES HIDDEN MOBILE */\n\n  .hn-premium-features {\n\n    display:\n      none;\n\n  }\n\n\n\n  /* DOTS */\n\n  .hn-premium-dots {\n\n    bottom:\n      14px;\n\n\n    gap:\n      7px;\n\n\n    padding:\n\n      7px\n      10px;\n\n  }\n\n\n\n  .hn-premium-dot {\n\n    width:\n      6px;\n\n\n    height:\n      6px;\n\n\n    min-width:\n      6px;\n\n  }\n\n\n\n  .hn-premium-dot.is-active {\n\n    width:\n      22px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 420px) {\n\n\n  .hn-premium-content,\n  .hn-content-left\n  .hn-premium-content,\n  .hn-content-right\n  .hn-premium-content {\n\n    padding:\n\n      25px\n      14px\n      58px;\n\n  }\n\n\n\n  .hn-premium-heading {\n\n    font-size:\n      29px;\n\n  }\n\n\n\n  .hn-premium-description {\n\n    max-width:\n      340px;\n\n\n    font-size:\n      12px;\n\n  }\n\n\n\n  .hn-premium-button {\n\n    margin-top:\n      11px;\n\n\n    min-width:\n      185px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 350px) {\n\n\n  .hn-premium-content,\n  .hn-content-left\n  .hn-premium-content,\n  .hn-content-right\n  .hn-premium-content {\n\n    padding-top:\n      20px;\n\n  }\n\n\n\n  .hn-premium-eyebrow {\n\n    margin-bottom:\n      6px;\n\n\n    font-size:\n      7.5px;\n\n  }\n\n\n\n  .hn-premium-heading {\n\n    font-size:\n      26px;\n\n  }\n\n\n\n  .hn-premium-description {\n\n    max-width:\n      300px;\n\n\n    padding:\n\n      6px\n      8px;\n\n\n    font-size:\n      11px;\n\n  }\n\n\n\n  .hn-premium-button {\n\n    min-width:\n      170px;\n\n\n    padding:\n\n      10px\n      15px;\n\n\n    font-size:\n      11px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n\n  .hn-premium-slide,\n  .hn-premium-image,\n  .hn-premium-copy,\n  .hn-premium-dot,\n  .hn-premium-button,\n  .hn-premium-button svg,\n  .hn-feature-icon {\n\n    transition:\n      none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n     CONFIGURATION\n  ===================================================== */\n\n  var MOBILE_QUERY =\n    window.matchMedia(\n      \"(max-width: 749px)\"\n    );\n\n\n  var REDUCED_MOTION_QUERY =\n    window.matchMedia(\n      \"(prefers-reduced-motion: reduce)\"\n    );\n\n\n  var AUTOPLAY_DELAY =\n    5500;\n\n\n\n  /* =====================================================\n     REMOVE SECTION GAP\n  ===================================================== */\n\n  function removeSectionGap() {\n\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-premium-slider]\"\n      );\n\n\n    sliders.forEach(\n      function (slider) {\n\n\n        var section =\n          slider.closest(\n            \".shopify-section\"\n          );\n\n\n        if (!section) {\n          return;\n        }\n\n\n        var element =\n          slider.parentElement;\n\n\n        while (\n          element &&\n          element !== section\n        ) {\n\n\n          element.style.setProperty(\n            \"margin-top\",\n            \"0\",\n            \"important\"\n          );\n\n\n          element.style.setProperty(\n            \"padding-top\",\n            \"0\",\n            \"important\"\n          );\n\n\n          element =\n            element.parentElement;\n\n        }\n\n\n        section.style.setProperty(\n          \"margin-top\",\n          \"0\",\n          \"important\"\n        );\n\n\n        section.style.setProperty(\n          \"padding-top\",\n          \"0\",\n          \"important\"\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n     INITIALIZE SLIDER\n  ===================================================== */\n\n  function initializeSlider(slider) {\n\n\n    if (\n      slider.getAttribute(\n        \"data-hn-premium-ready\"\n      ) === \"true\"\n    ) {\n\n      return;\n\n    }\n\n\n    slider.setAttribute(\n      \"data-hn-premium-ready\",\n      \"true\"\n    );\n\n\n\n    var slides =\n      Array.prototype.slice.call(\n\n        slider.querySelectorAll(\n          \"[data-hn-premium-slide]\"\n        )\n\n      );\n\n\n\n    var dots =\n      Array.prototype.slice.call(\n\n        slider.querySelectorAll(\n          \"[data-hn-premium-dot]\"\n        )\n\n      );\n\n\n\n    if (!slides.length) {\n      return;\n    }\n\n\n\n    var currentSlideIndex =\n      null;\n\n\n    var autoplayTimer =\n      null;\n\n\n    var touchStartX =\n      0;\n\n\n    var touchEndX =\n      0;\n\n\n\n    /* ===================================================\n       AVAILABLE SLIDES\n\n       MOBILE\n       0 / 1 / 2\n\n       DESKTOP\n       1 / 2\n    =================================================== */\n\n    function getAvailableIndexes() {\n\n\n      if (\n        MOBILE_QUERY.matches\n      ) {\n\n        return [\n          0,\n          1,\n          2\n        ];\n\n      }\n\n\n      return [\n        1,\n        2\n      ];\n\n    }\n\n\n\n    function isAvailable(index) {\n\n\n      return (\n\n        getAvailableIndexes()\n        .indexOf(index) !== -1\n\n      );\n\n    }\n\n\n\n    /* ===================================================\n       SHOW SLIDE\n    =================================================== */\n\n    function showSlide(index) {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      if (\n        !isAvailable(index)\n      ) {\n\n        index =\n          available[0];\n\n      }\n\n\n\n      slides.forEach(\n        function (slide) {\n\n\n          var slideIndex =\n            parseInt(\n\n              slide.getAttribute(\n                \"data-hn-premium-slide\"\n              ),\n\n              10\n\n            );\n\n\n          var active =\n\n            slideIndex === index &&\n            isAvailable(slideIndex);\n\n\n\n          slide.classList.toggle(\n            \"is-active\",\n            active\n          );\n\n\n          slide.setAttribute(\n\n            \"aria-hidden\",\n\n            active\n              ? \"false\"\n              : \"true\"\n\n          );\n\n        }\n      );\n\n\n\n      dots.forEach(\n        function (dot) {\n\n\n          var dotIndex =\n            parseInt(\n\n              dot.getAttribute(\n                \"data-hn-premium-dot\"\n              ),\n\n              10\n\n            );\n\n\n          var availableDot =\n            isAvailable(\n              dotIndex\n            );\n\n\n          var active =\n\n            dotIndex === index &&\n            availableDot;\n\n\n\n          dot.classList.toggle(\n            \"is-active\",\n            active\n          );\n\n\n          dot.setAttribute(\n\n            \"aria-current\",\n\n            active\n              ? \"true\"\n              : \"false\"\n\n          );\n\n\n          dot.setAttribute(\n\n            \"aria-hidden\",\n\n            availableDot\n              ? \"false\"\n              : \"true\"\n\n          );\n\n        }\n      );\n\n\n\n      currentSlideIndex =\n        index;\n\n    }\n\n\n\n    /* ===================================================\n       NEXT\n    =================================================== */\n\n    function nextSlide() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      var currentPosition =\n        available.indexOf(\n          currentSlideIndex\n        );\n\n\n      if (\n        currentPosition === -1\n      ) {\n\n        showSlide(\n          available[0]\n        );\n\n\n        return;\n\n      }\n\n\n      var nextPosition =\n        currentPosition + 1;\n\n\n      if (\n        nextPosition >=\n        available.length\n      ) {\n\n        nextPosition =\n          0;\n\n      }\n\n\n      showSlide(\n        available[nextPosition]\n      );\n\n    }\n\n\n\n    /* ===================================================\n       PREVIOUS\n    =================================================== */\n\n    function previousSlide() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      var currentPosition =\n        available.indexOf(\n          currentSlideIndex\n        );\n\n\n      if (\n        currentPosition === -1\n      ) {\n\n        showSlide(\n          available[0]\n        );\n\n\n        return;\n\n      }\n\n\n      var previousPosition =\n        currentPosition - 1;\n\n\n      if (\n        previousPosition < 0\n      ) {\n\n        previousPosition =\n          available.length - 1;\n\n      }\n\n\n      showSlide(\n        available[previousPosition]\n      );\n\n    }\n\n\n\n    /* ===================================================\n       AUTOPLAY\n    =================================================== */\n\n    function stopAutoplay() {\n\n\n      if (\n        autoplayTimer !== null\n      ) {\n\n\n        clearInterval(\n          autoplayTimer\n        );\n\n\n        autoplayTimer =\n          null;\n\n      }\n\n    }\n\n\n\n    function startAutoplay() {\n\n\n      stopAutoplay();\n\n\n      if (\n        REDUCED_MOTION_QUERY.matches\n      ) {\n\n        return;\n\n      }\n\n\n      autoplayTimer =\n        setInterval(\n\n          nextSlide,\n\n          AUTOPLAY_DELAY\n\n        );\n\n    }\n\n\n\n    /* ===================================================\n       DOT CLICK\n    =================================================== */\n\n    dots.forEach(\n      function (dot) {\n\n\n        dot.addEventListener(\n\n          \"click\",\n\n          function () {\n\n\n            var index =\n              parseInt(\n\n                dot.getAttribute(\n                  \"data-hn-premium-dot\"\n                ),\n\n                10\n\n              );\n\n\n            if (\n              isNaN(index) ||\n              !isAvailable(index)\n            ) {\n\n              return;\n\n            }\n\n\n            showSlide(\n              index\n            );\n\n\n            startAutoplay();\n\n          }\n\n        );\n\n      }\n    );\n\n\n\n    /* ===================================================\n       DESKTOP HOVER PAUSE\n    =================================================== */\n\n    slider.addEventListener(\n\n      \"mouseenter\",\n\n      function () {\n\n\n        if (\n          !MOBILE_QUERY.matches\n        ) {\n\n          stopAutoplay();\n\n        }\n\n      }\n\n    );\n\n\n\n    slider.addEventListener(\n\n      \"mouseleave\",\n\n      function () {\n\n\n        if (\n          !MOBILE_QUERY.matches\n        ) {\n\n          startAutoplay();\n\n        }\n\n      }\n\n    );\n\n\n\n    /* ===================================================\n       MOBILE SWIPE\n    =================================================== */\n\n    slider.addEventListener(\n\n      \"touchstart\",\n\n      function (event) {\n\n\n        if (\n          !event.touches.length\n        ) {\n\n          return;\n\n        }\n\n\n        touchStartX =\n          event.touches[0].clientX;\n\n      },\n\n\n      {\n        passive:\n          true\n      }\n\n    );\n\n\n\n    slider.addEventListener(\n\n      \"touchend\",\n\n      function (event) {\n\n\n        if (\n          !event.changedTouches.length\n        ) {\n\n          return;\n\n        }\n\n\n        touchEndX =\n          event.changedTouches[0].clientX;\n\n\n        var difference =\n          touchStartX -\n          touchEndX;\n\n\n        if (\n          Math.abs(difference) <\n          45\n        ) {\n\n          return;\n\n        }\n\n\n        if (\n          difference > 0\n        ) {\n\n          nextSlide();\n\n        } else {\n\n          previousSlide();\n\n        }\n\n\n        startAutoplay();\n\n      },\n\n\n      {\n        passive:\n          true\n      }\n\n    );\n\n\n\n    /* ===================================================\n       TAB VISIBILITY\n    =================================================== */\n\n    document.addEventListener(\n\n      \"visibilitychange\",\n\n      function () {\n\n\n        if (\n          document.hidden\n        ) {\n\n          stopAutoplay();\n\n        } else {\n\n          startAutoplay();\n\n        }\n\n      }\n\n    );\n\n\n\n    /* ===================================================\n       RESPONSIVE BREAKPOINT\n    =================================================== */\n\n    function handleBreakpointChange() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      if (\n        available.indexOf(\n          currentSlideIndex\n        ) === -1\n      ) {\n\n        showSlide(\n          available[0]\n        );\n\n      }\n\n\n      startAutoplay();\n\n    }\n\n\n\n    if (\n      MOBILE_QUERY.addEventListener\n    ) {\n\n\n      MOBILE_QUERY.addEventListener(\n\n        \"change\",\n\n        handleBreakpointChange\n\n      );\n\n\n    } else {\n\n\n      MOBILE_QUERY.addListener(\n        handleBreakpointChange\n      );\n\n    }\n\n\n\n    /* ===================================================\n       INITIAL\n    =================================================== */\n\n    var initialIndexes =\n      getAvailableIndexes();\n\n\n    showSlide(\n      initialIndexes[0]\n    );\n\n\n    startAutoplay();\n\n  }\n\n\n\n  /* =====================================================\n     INITIALIZE ALL\n  ===================================================== */\n\n  function initializeAll() {\n\n\n    removeSectionGap();\n\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-premium-slider]\"\n      );\n\n\n    sliders.forEach(\n      initializeSlider\n    );\n\n  }\n\n\n\n  initializeAll();\n\n\n\n  setTimeout(\n    removeSectionGap,\n    200\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    700\n  );\n\n\n\n  /* =====================================================\n     SHOPIFY THEME EDITOR SUPPORT\n  ===================================================== */\n\n  document.addEventListener(\n\n    \"shopify:section:load\",\n\n    function () {\n\n\n      initializeAll();\n\n\n      setTimeout(\n        removeSectionGap,\n        100\n      );\n\n    }\n\n  );\n\n\n})();\n\n</script>"
      }
