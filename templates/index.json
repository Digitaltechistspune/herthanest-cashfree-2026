        "section_title": "",
        "custom_html": "<!-- =========================================================\nHERTHA NEST — PREMIUM CART REWARD SECTION\nSTATIC PROMOTIONAL VERSION — NO CART TRACKER\n\nOFFER:\n10% OFF on carts of ₹1,000 or above\nApplies to all products\n\nIMPORTANT:\nThe visual section only promotes the offer.\nCreate the actual discount separately in:\nShopify Admin → Discounts → Automatic Discount\n\nRIGHT-SIDE IMAGE:\nhttps://cdn.shopify.com/s/files/1/0677/4649/6670/files/10_249ed93c-f4df-4679-8c30-9d0cf8816ffe.png?v=1788953975\n========================================================= -->\n\n<section class=\"hn-reward\" id=\"hnRewardSection\" aria-labelledby=\"hnRewardTitle\">\n\n  <div class=\"hn-reward__decor\" aria-hidden=\"true\">\n    <span class=\"hn-reward__orb hn-reward__orb--one\"></span>\n    <span class=\"hn-reward__orb hn-reward__orb--two\"></span>\n    <span class=\"hn-reward__line hn-reward__line--one\"></span>\n    <span class=\"hn-reward__line hn-reward__line--two\"></span>\n    <span class=\"hn-reward__motif hn-reward__motif--one\">✦</span>\n    <span class=\"hn-reward__motif hn-reward__motif--two\">✦</span>\n  </div>\n\n\n  <div class=\"hn-reward__inner\">\n\n    <!-- =====================================================\n    LEFT — OFFER CONTENT\n    ====================================================== -->\n\n    <div class=\"hn-reward__copy\">\n\n      <div class=\"hn-reward__eyebrow\">\n        <span class=\"hn-reward__eyebrow-rule\"></span>\n        CART REWARD\n        <span class=\"hn-reward__eyebrow-rule\"></span>\n      </div>\n\n\n      <div class=\"hn-reward__headline-wrap\">\n\n        <div class=\"hn-reward__seal\" aria-label=\"10 percent off\">\n\n          <span class=\"hn-reward__seal-small\">\n            ENJOY\n          </span>\n\n          <strong>\n            10%\n          </strong>\n\n          <span class=\"hn-reward__seal-off\">\n            OFF\n          </span>\n\n        </div>\n\n\n        <div class=\"hn-reward__headline\">\n\n          <p class=\"hn-reward__kicker\">\n            A little reward for filling your home beautifully.\n          </p>\n\n          <h2 id=\"hnRewardTitle\">\n            Spend ₹1,000.\n            <em>Save 10%.</em>\n          </h2>\n\n        </div>\n\n      </div>\n\n\n      <p class=\"hn-reward__description\">\n        Shop any Hertha Nest products worth\n        <strong>₹1,000 or more</strong>\n        and enjoy\n        <strong>10% off your eligible cart.</strong>\n        A simple reason to bring home one more piece you love.\n      </p>\n\n\n      <div class=\"hn-reward__benefits\" aria-label=\"Offer highlights\">\n\n        <div class=\"hn-reward__benefit\">\n\n          <span class=\"hn-reward__benefit-icon\">\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M4 7h16v13H4V7Zm3-3h10v3H7V4Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n          </span>\n\n          <span>\n            <small>APPLIES TO</small>\n            <strong>All Products</strong>\n          </span>\n\n        </div>\n\n\n        <div class=\"hn-reward__benefit\">\n\n          <span class=\"hn-reward__benefit-icon\">\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M6 8h12l1 12H5L6 8Zm3 2V6a3 3 0 0 1 6 0v4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n          </span>\n\n          <span>\n            <small>MINIMUM CART</small>\n            <strong>₹1,000</strong>\n          </span>\n\n        </div>\n\n\n        <div class=\"hn-reward__benefit\">\n\n          <span class=\"hn-reward__benefit-icon\">\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m8 15 8-8M8.5 8.5h.01M15.5 15.5h.01\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n          </span>\n\n          <span>\n            <small>YOUR REWARD</small>\n            <strong>10% Savings</strong>\n          </span>\n\n        </div>\n\n      </div>\n\n\n      <div class=\"hn-reward__actions\">\n\n        <a class=\"hn-reward__cta\" href=\"/collections/all\">\n\n          <span>\n            Shop All Products\n          </span>\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n\n        </a>\n\n\n        <p class=\"hn-reward__terms\">\n          Minimum cart value ₹1,000. Offer applies to eligible products.\n          Discount availability and terms may apply.\n        </p>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n    RIGHT — PREMIUM OFFER VISUAL\n    ====================================================== -->\n\n    <div class=\"hn-reward__visual\">\n\n      <div class=\"hn-reward__visual-frame\">\n\n        <span class=\"hn-reward__visual-ring hn-reward__visual-ring--one\" aria-hidden=\"true\"></span>\n\n        <span class=\"hn-reward__visual-ring hn-reward__visual-ring--two\" aria-hidden=\"true\"></span>\n\n\n        <div class=\"hn-reward__visual-badge hn-reward__visual-badge--top\">\n\n          <span class=\"hn-reward__visual-badge-icon\">\n            ✦\n          </span>\n\n          <span>\n            <small>LIMITED REWARD</small>\n            <strong>10% OFF</strong>\n          </span>\n\n        </div>\n\n\n        <img class=\"hn-reward__image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/10_249ed93c-f4df-4679-8c30-9d0cf8816ffe.png?v=1788953975\" alt=\"Premium festive gift illustration representing the Hertha Nest cart reward\" width=\"1122\" height=\"1402\" loading=\"lazy\" decoding=\"async\">\n\n\n        <div class=\"hn-reward__visual-badge hn-reward__visual-badge--bottom\">\n\n          <span class=\"hn-reward__visual-badge-icon\">\n            ₹\n          </span>\n\n          <span>\n            <small>UNLOCK AT</small>\n            <strong>₹1,000 CART</strong>\n          </span>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\nTHEME CUSTOM HTML WRAPPER RESET\n---------------------------------------------------------\nRemoves the unwanted white strip / blank title area that the\ntheme inserts above or below Custom HTML sections.\n========================================================= */\n\n.shopify-section:has(.hn-reward) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n.shopify-section:has(.hn-reward) > div,\n.shopify-section:has(.hn-reward) > div > div,\n.shopify-section:has(.hn-reward) .section,\n.shopify-section:has(.hn-reward) .section-padding,\n.shopify-section:has(.hn-reward) .section__wrapper,\n.shopify-section:has(.hn-reward) .section-wrapper,\n.shopify-section:has(.hn-reward) .custom-html,\n.shopify-section:has(.hn-reward) .custom-html-wrapper,\n.shopify-section:has(.hn-reward) .custom-html-section,\n.shopify-section:has(.hn-reward) .page-width,\n.shopify-section:has(.hn-reward) .container,\n.shopify-section:has(.hn-reward) .container-fluid {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  min-height: 0 !important;\n\n  gap: 0 !important;\n  row-gap: 0 !important;\n  column-gap: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n.shopify-section:has(.hn-reward) .page-width,\n.shopify-section:has(.hn-reward) .container,\n.shopify-section:has(.hn-reward) .container-fluid,\n.shopify-section:has(.hn-reward) .custom-html,\n.shopify-section:has(.hn-reward) .custom-html-wrapper,\n.shopify-section:has(.hn-reward) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n/* THEME HEADING/TITLE */\n\n.shopify-section:has(.hn-reward) .section-heading,\n.shopify-section:has(.hn-reward) .section__heading,\n.shopify-section:has(.hn-reward) .section-title,\n.shopify-section:has(.hn-reward) .section__title,\n.shopify-section:has(.hn-reward) .section-header,\n.shopify-section:has(.hn-reward) .section__header,\n.shopify-section:has(.hn-reward) .section-head,\n.shopify-section:has(.hn-reward) .heading-wrapper,\n.shopify-section:has(.hn-reward) .title-wrapper,\n.shopify-section:has(.hn-reward) .section-title-wrapper,\n.shopify-section:has(.hn-reward) [class*=\"section-heading\"],\n.shopify-section:has(.hn-reward) [class*=\"section__heading\"],\n.shopify-section:has(.hn-reward) [class*=\"section-title\"],\n.shopify-section:has(.hn-reward) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n\n  overflow: hidden !important;\n}\n\n\n\n/* =========================================================\nSECTION\n========================================================= */\n\n.hn-reward {\n  --hnr-bg: #26151f;\n  --hnr-bg-deep: #180d14;\n\n  --hnr-wine: #7c2e42;\n  --hnr-wine-light: #9d4258;\n\n  --hnr-copper: #d59b63;\n  --hnr-copper-light: #f0c994;\n\n  --hnr-ivory: #fff7ec;\n  --hnr-ivory-soft: #f7ead8;\n\n  --hnr-text-soft: rgba(255,247,236,.72);\n\n  position: relative;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin:\n    0\n    calc(50% - 50vw);\n\n  padding:\n    clamp(48px, 4.5vw, 76px)\n    clamp(22px, 5.8vw, 110px);\n\n  overflow: hidden;\n\n  background:\n    radial-gradient(\n      circle at 8% 8%,\n      rgba(213,155,99,.18),\n      transparent 25%\n    ),\n    radial-gradient(\n      circle at 88% 100%,\n      rgba(157,66,88,.34),\n      transparent 36%\n    ),\n    linear-gradient(\n      125deg,\n      #2b1722 0%,\n      #21111a 52%,\n      #160c12 100%\n    );\n\n  color: var(--hnr-ivory);\n\n  isolation: isolate;\n}\n\n\n.hn-reward *,\n.hn-reward *::before,\n.hn-reward *::after {\n  box-sizing: border-box;\n}\n\n\n\n/* =========================================================\nBACKGROUND DECOR\n========================================================= */\n\n.hn-reward__decor {\n  position: absolute;\n\n  inset: 0;\n\n  z-index: -1;\n\n  overflow: hidden;\n\n  pointer-events: none;\n}\n\n\n.hn-reward__orb {\n  position: absolute;\n\n  border-radius: 50%;\n\n  filter: blur(2px);\n}\n\n\n.hn-reward__orb--one {\n  width: 420px;\n  height: 420px;\n\n  top: -275px;\n  left: -120px;\n\n  border: 1px solid rgba(240,201,148,.12);\n\n  box-shadow:\n    0 0 0 55px rgba(240,201,148,.025),\n    0 0 0 110px rgba(240,201,148,.018);\n}\n\n\n.hn-reward__orb--two {\n  width: 540px;\n  height: 540px;\n\n  right: -260px;\n  bottom: -340px;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(157,66,88,.30),\n      transparent 70%\n    );\n}\n\n\n.hn-reward__line {\n  position: absolute;\n\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(240,201,148,.20),\n      transparent\n    );\n}\n\n\n.hn-reward__line--one {\n  width: 46%;\n\n  top: 17%;\n  right: -7%;\n\n  transform: rotate(-13deg);\n}\n\n\n.hn-reward__line--two {\n  width: 42%;\n\n  bottom: 12%;\n  left: -8%;\n\n  transform: rotate(11deg);\n}\n\n\n.hn-reward__motif {\n  position: absolute;\n\n  color: rgba(240,201,148,.12);\n\n  font-size: 80px;\n}\n\n\n.hn-reward__motif--one {\n  top: 14%;\n  right: 3%;\n}\n\n\n.hn-reward__motif--two {\n  bottom: 4%;\n  left: 2%;\n\n  font-size: 48px;\n}\n\n\n\n/* =========================================================\nINNER\n========================================================= */\n\n.hn-reward__inner {\n  position: relative;\n\n  z-index: 5;\n\n  display: grid;\n\n  grid-template-columns:\n    minmax(0,1.05fr)\n    minmax(390px,.95fr);\n\n  align-items: center;\n\n  gap:\n    clamp(\n      38px,\n      5vw,\n      88px\n    );\n\n  width: 100%;\n  max-width: 1500px;\n\n  margin: 0 auto;\n}\n\n\n\n/* =========================================================\nLEFT COPY\n========================================================= */\n\n.hn-reward__copy {\n  width: 100%;\n}\n\n\n.hn-reward__eyebrow {\n  display: flex;\n\n  align-items: center;\n\n  gap: 11px;\n\n  width: fit-content;\n\n  margin-bottom: 22px;\n\n  color: var(--hnr-copper-light);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size: 9px;\n  font-weight: 750;\n\n  line-height: 1.3;\n\n  letter-spacing: .23em;\n\n  text-transform: uppercase;\n}\n\n\n.hn-reward__eyebrow-rule {\n  display: block;\n\n  width: 28px;\n  height: 1px;\n\n  background: currentColor;\n\n  opacity: .7;\n}\n\n\n.hn-reward__headline-wrap {\n  display: flex;\n\n  align-items: center;\n\n  gap:\n    clamp(\n      22px,\n      3vw,\n      44px\n    );\n}\n\n\n\n/* =========================================================\nOFFER SEAL\n========================================================= */\n\n.hn-reward__seal {\n  position: relative;\n\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: center;\n  justify-content: center;\n\n  width:\n    clamp(\n      130px,\n      10vw,\n      166px\n    );\n\n  height:\n    clamp(\n      130px,\n      10vw,\n      166px\n    );\n\n  flex:\n    0 0 auto;\n\n  border:\n    1px solid\n    rgba(240,201,148,.48);\n\n  border-radius: 50%;\n\n  background:\n    radial-gradient(\n      circle,\n      rgba(255,247,236,.10) 0%,\n      rgba(213,155,99,.08) 58%,\n      rgba(255,255,255,.015) 100%\n    );\n\n  box-shadow:\n    0 22px 48px\n    rgba(0,0,0,.22),\n    inset 0 0 0 7px\n    rgba(255,255,255,.025);\n\n  text-align: center;\n}\n\n\n.hn-reward__seal::before {\n  content: \"\";\n\n  position: absolute;\n\n  inset: 10px;\n\n  border:\n    1px dashed\n    rgba(240,201,148,.48);\n\n  border-radius: 50%;\n}\n\n\n.hn-reward__seal-small,\n.hn-reward__seal-off {\n  position: relative;\n\n  z-index: 2;\n\n  color: var(--hnr-copper-light);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 8px;\n  font-weight: 800;\n\n  letter-spacing: .23em;\n}\n\n\n.hn-reward__seal strong {\n  position: relative;\n\n  z-index: 2;\n\n  display: block;\n\n  margin: 4px 0;\n\n  color: var(--hnr-ivory);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      39px,\n      3.8vw,\n      61px\n    );\n\n  font-weight: 600;\n\n  line-height: .9;\n}\n\n\n\n/* =========================================================\nHEADLINE\n========================================================= */\n\n.hn-reward__headline {\n  max-width: 610px;\n}\n\n\n.hn-reward__kicker {\n  margin:\n    0\n    0\n    8px;\n\n  color:\n    rgba(255,247,236,.66);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n    clamp(\n      14px,\n      1.05vw,\n      17px\n    );\n\n  line-height: 1.4;\n}\n\n\n.hn-reward__headline h2 {\n  margin: 0;\n\n  color: var(--hnr-ivory);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n    clamp(\n      39px,\n      3.7vw,\n      64px\n    );\n\n  font-weight: 500;\n\n  line-height: .98;\n\n  letter-spacing: -.045em;\n}\n\n\n.hn-reward__headline em {\n  display: block;\n\n  margin-top: 6px;\n\n  color: var(--hnr-copper-light);\n\n  font-size: .88em;\n\n  font-weight: 400;\n  font-style: italic;\n}\n\n\n\n/* =========================================================\nDESCRIPTION\n========================================================= */\n\n.hn-reward__description {\n  max-width: 720px;\n\n  margin:\n    27px\n    0\n    0;\n\n  color: var(--hnr-text-soft);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n    clamp(\n      13.5px,\n      .95vw,\n      16px\n    );\n\n  line-height: 1.72;\n}\n\n\n.hn-reward__description strong {\n  color: var(--hnr-ivory);\n\n  font-weight: 700;\n}\n\n\n\n/* =========================================================\nBENEFITS\n========================================================= */\n\n.hn-reward__benefits {\n  display: flex;\n\n  flex-wrap: wrap;\n\n  gap: 10px;\n\n  margin-top: 28px;\n}\n\n\n.hn-reward__benefit {\n  display: flex;\n\n  align-items: center;\n\n  gap: 10px;\n\n  min-width: 155px;\n\n  padding:\n    11px\n    14px;\n\n  border:\n    1px solid\n    rgba(240,201,148,.15);\n\n  border-radius: 12px;\n\n  background:\n    rgba(255,247,236,.045);\n\n  box-shadow:\n    inset 0 1px 0\n    rgba(255,255,255,.035);\n\n  backdrop-filter: blur(7px);\n  -webkit-backdrop-filter: blur(7px);\n}\n\n\n.hn-reward__benefit-icon {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 38px;\n  height: 38px;\n\n  flex:\n    0 0 38px;\n\n  border:\n    1px solid\n    rgba(240,201,148,.34);\n\n  border-radius: 50%;\n\n  color: var(--hnr-copper-light);\n\n  background:\n    rgba(255,247,236,.035);\n}\n\n\n.hn-reward__benefit-icon svg {\n  width: 18px;\n  height: 18px;\n}\n\n\n.hn-reward__benefit small {\n  display: block;\n\n  margin-bottom: 3px;\n\n  color:\n    rgba(240,201,148,.78);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 6.8px;\n  font-weight: 800;\n\n  line-height: 1.2;\n\n  letter-spacing: .14em;\n}\n\n\n.hn-reward__benefit strong {\n  display: block;\n\n  color: var(--hnr-ivory);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 10.5px;\n\n  line-height: 1.25;\n}\n\n\n\n/* =========================================================\nACTIONS\n========================================================= */\n\n.hn-reward__actions {\n  display: flex;\n\n  flex-direction: column;\n\n  align-items: flex-start;\n\n  margin-top: 27px;\n}\n\n\n.hn-reward__cta {\n  position: relative;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 15px;\n\n  min-width: 245px;\n  min-height: 54px;\n\n  padding:\n    13px\n    24px;\n\n  overflow: hidden;\n\n  border:\n    1px solid\n    rgba(240,201,148,.22);\n\n  border-radius: 8px;\n\n  background:\n    linear-gradient(\n      135deg,\n      #9b3d55,\n      #672436\n    );\n\n  box-shadow:\n    0 14px 28px\n    rgba(0,0,0,.24);\n\n  color: #ffffff !important;\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 12.5px;\n  font-weight: 700;\n\n  text-decoration: none !important;\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n\n.hn-reward__cta::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: -70%;\n\n  width: 42%;\n  height: 100%;\n\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(255,255,255,.18),\n      transparent\n    );\n\n  transform: skewX(-22deg);\n\n  transition:\n    left .65s ease;\n}\n\n\n.hn-reward__cta:hover {\n  transform:\n    translateY(-3px);\n\n  box-shadow:\n    0 19px 35px\n    rgba(0,0,0,.30);\n}\n\n\n.hn-reward__cta:hover::before {\n  left: 130%;\n}\n\n\n.hn-reward__cta span,\n.hn-reward__cta svg {\n  position: relative;\n\n  z-index: 2;\n}\n\n\n.hn-reward__cta svg {\n  width: 18px;\n  height: 18px;\n\n  transition:\n    transform .25s ease;\n}\n\n\n.hn-reward__cta:hover svg {\n  transform:\n    translateX(5px);\n}\n\n\n.hn-reward__terms {\n  max-width: 520px;\n\n  margin:\n    12px\n    0\n    0;\n\n  color:\n    rgba(255,247,236,.48);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 8.5px;\n\n  line-height: 1.5;\n}\n\n\n\n/* =========================================================\nRIGHT VISUAL\n========================================================= */\n\n.hn-reward__visual {\n  position: relative;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n  min-height: 545px;\n}\n\n\n.hn-reward__visual-frame {\n  position: relative;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width:\n    min(\n      100%,\n      560px\n    );\n\n  min-height: 520px;\n\n  margin-left: auto;\n\n  isolation: isolate;\n}\n\n\n.hn-reward__visual-frame::before {\n  content: \"\";\n\n  position: absolute;\n\n  z-index: -2;\n\n  width: 82%;\n  height: 82%;\n\n  top: 9%;\n  left: 9%;\n\n  border:\n    1px solid\n    rgba(240,201,148,.15);\n\n  border-radius:\n    44% 56% 52% 48% /\n    47% 43% 57% 53%;\n\n  background:\n    radial-gradient(\n      circle at 50% 42%,\n      rgba(240,201,148,.12),\n      rgba(124,46,66,.08) 50%,\n      transparent 72%\n    );\n\n  transform: rotate(-5deg);\n}\n\n\n.hn-reward__visual-frame::after {\n  content: \"\";\n\n  position: absolute;\n\n  z-index: -3;\n\n  left: 50%;\n  bottom: 4%;\n\n  width: 68%;\n  height: 54px;\n\n  border-radius: 50%;\n\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(0,0,0,.32),\n      transparent 72%\n    );\n\n  filter: blur(9px);\n\n  transform:\n    translateX(-50%);\n}\n\n\n.hn-reward__visual-ring {\n  position: absolute;\n\n  z-index: -1;\n\n  border:\n    1px solid\n    rgba(240,201,148,.12);\n\n  border-radius: 50%;\n\n  pointer-events: none;\n}\n\n\n.hn-reward__visual-ring--one {\n  width: 420px;\n  height: 420px;\n\n  top: 50%;\n  left: 50%;\n\n  transform:\n    translate(-50%,-50%);\n}\n\n\n.hn-reward__visual-ring--two {\n  width: 500px;\n  height: 500px;\n\n  top: 50%;\n  left: 50%;\n\n  border-color:\n    rgba(240,201,148,.065);\n\n  transform:\n    translate(-50%,-50%);\n}\n\n\n.hn-reward__image {\n  position: relative;\n\n  z-index: 5;\n\n  display: block;\n\n  width:\n    min(\n      92%,\n      500px\n    );\n\n  height: auto;\n\n  max-height: 560px;\n\n  object-fit: contain;\n\n  object-position: center;\n\n  filter:\n    drop-shadow(\n      0 28px 30px\n      rgba(0,0,0,.28)\n    );\n\n  transform:\n    translateY(3px);\n\n  transition:\n    transform .55s\n    cubic-bezier(.22,.61,.36,1),\n    filter .55s ease;\n}\n\n\n.hn-reward__visual-frame:hover\n.hn-reward__image {\n  transform:\n    translateY(-7px)\n    scale(1.015);\n\n  filter:\n    drop-shadow(\n      0 38px 34px\n      rgba(0,0,0,.34)\n    );\n}\n\n\n\n/* =========================================================\nFLOATING OFFER BADGES\n========================================================= */\n\n.hn-reward__visual-badge {\n  position: absolute;\n\n  z-index: 12;\n\n  display: flex;\n\n  align-items: center;\n\n  gap: 10px;\n\n  min-width: 145px;\n\n  padding:\n    10px\n    13px;\n\n  border:\n    1px solid\n    rgba(240,201,148,.26);\n\n  border-radius: 14px;\n\n  background:\n    rgba(39,20,30,.86);\n\n  box-shadow:\n    0 16px 32px\n    rgba(0,0,0,.22),\n    inset 0 1px 0\n    rgba(255,255,255,.04);\n\n  backdrop-filter:\n    blur(9px);\n\n  -webkit-backdrop-filter:\n    blur(9px);\n}\n\n\n.hn-reward__visual-badge--top {\n  top: 12%;\n  right: 2%;\n}\n\n\n.hn-reward__visual-badge--bottom {\n  left: 1%;\n  bottom: 13%;\n}\n\n\n.hn-reward__visual-badge-icon {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 34px;\n  height: 34px;\n\n  flex:\n    0 0 34px;\n\n  border:\n    1px solid\n    rgba(240,201,148,.36);\n\n  border-radius: 50%;\n\n  color:\n    var(--hnr-copper-light);\n\n  font-family:\n    Georgia,\n    serif;\n\n  font-size: 15px;\n\n  font-weight: 700;\n}\n\n\n.hn-reward__visual-badge small {\n  display: block;\n\n  margin-bottom: 3px;\n\n  color:\n    rgba(240,201,148,.70);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 6.5px;\n\n  font-weight: 800;\n\n  letter-spacing: .13em;\n}\n\n\n.hn-reward__visual-badge strong {\n  display: block;\n\n  color:\n    var(--hnr-ivory);\n\n  font-family:\n    Arial,\n    sans-serif;\n\n  font-size: 10px;\n\n  line-height: 1.2;\n}\n\n\n\n/* =========================================================\nTABLET\n========================================================= */\n\n@media screen and (max-width: 1100px) {\n\n  .hn-reward__inner {\n    grid-template-columns:\n      minmax(0,1fr)\n      minmax(340px,.85fr);\n\n    gap: 30px;\n  }\n\n\n  .hn-reward__seal {\n    width: 124px;\n    height: 124px;\n  }\n\n\n  .hn-reward__headline h2 {\n    font-size:\n      clamp(\n        36px,\n        4.5vw,\n        49px\n      );\n  }\n\n\n  .hn-reward__visual {\n    min-height: 470px;\n  }\n\n\n  .hn-reward__visual-frame {\n    min-height: 450px;\n  }\n\n\n  .hn-reward__image {\n    max-height: 475px;\n  }\n\n\n  .hn-reward__visual-badge--top {\n    right: 0;\n  }\n\n\n  .hn-reward__visual-badge--bottom {\n    left: 0;\n  }\n\n}\n\n\n\n/* =========================================================\nMOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .hn-reward {\n    padding:\n      42px\n      18px;\n  }\n\n\n  .hn-reward__inner {\n    display: flex;\n\n    flex-direction: column;\n\n    gap: 18px;\n  }\n\n\n  .hn-reward__copy {\n    text-align: center;\n  }\n\n\n  .hn-reward__eyebrow {\n    justify-content: center;\n\n    width: 100%;\n\n    margin-bottom: 19px;\n\n    font-size: 8px;\n  }\n\n\n  .hn-reward__eyebrow-rule {\n    width: 20px;\n  }\n\n\n  .hn-reward__headline-wrap {\n    flex-direction: column;\n\n    gap: 20px;\n  }\n\n\n  .hn-reward__seal {\n    width: 118px;\n    height: 118px;\n  }\n\n\n  .hn-reward__headline h2 {\n    font-size:\n      clamp(\n        35px,\n        10.7vw,\n        46px\n      );\n  }\n\n\n  .hn-reward__kicker {\n    font-size: 13px;\n  }\n\n\n  .hn-reward__description {\n    max-width: 470px;\n\n    margin:\n      20px\n      auto\n      0;\n\n    font-size: 12.5px;\n  }\n\n\n  .hn-reward__benefits {\n    justify-content: center;\n\n    margin-top: 22px;\n  }\n\n\n  .hn-reward__benefit {\n    flex:\n      1\n      1\n      145px;\n\n    max-width: 205px;\n\n    text-align: left;\n  }\n\n\n  .hn-reward__actions {\n    align-items: center;\n  }\n\n\n  .hn-reward__terms {\n    text-align: center;\n  }\n\n\n  .hn-reward__visual {\n    min-height: 440px;\n  }\n\n\n  .hn-reward__visual-frame {\n    width:\n      min(\n        100%,\n        500px\n      );\n\n    min-height: 430px;\n\n    margin:\n      0 auto;\n  }\n\n\n  .hn-reward__image {\n    width:\n      min(\n        88%,\n        390px\n      );\n\n    max-height: 430px;\n  }\n\n\n  .hn-reward__visual-ring--one {\n    width: 330px;\n    height: 330px;\n  }\n\n\n  .hn-reward__visual-ring--two {\n    width: 390px;\n    height: 390px;\n  }\n\n\n  .hn-reward__visual-badge--top {\n    top: 9%;\n    right: 2%;\n  }\n\n\n  .hn-reward__visual-badge--bottom {\n    left: 2%;\n    bottom: 8%;\n  }\n\n}\n\n\n\n/* =========================================================\nSMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 430px) {\n\n  .hn-reward {\n    padding:\n      36px\n      14px;\n  }\n\n\n  .hn-reward__headline h2 {\n    font-size: 35px;\n  }\n\n\n  .hn-reward__benefits {\n    display: grid;\n\n    grid-template-columns: 1fr;\n\n    width: 100%;\n  }\n\n\n  .hn-reward__benefit {\n    width: 100%;\n\n    max-width: none;\n  }\n\n\n  .hn-reward__cta {\n    width: 100%;\n\n    max-width: 340px;\n  }\n\n\n  .hn-reward__visual {\n    min-height: 390px;\n  }\n\n\n  .hn-reward__visual-frame {\n    min-height: 380px;\n  }\n\n\n  .hn-reward__image {\n    width: 92%;\n\n    max-height: 370px;\n  }\n\n\n  .hn-reward__visual-badge {\n    min-width: 125px;\n\n    padding:\n      8px\n      10px;\n  }\n\n\n  .hn-reward__visual-badge-icon {\n    width: 30px;\n    height: 30px;\n\n    flex-basis: 30px;\n\n    font-size: 13px;\n  }\n\n\n  .hn-reward__visual-badge small {\n    font-size: 5.8px;\n  }\n\n\n  .hn-reward__visual-badge strong {\n    font-size: 8.5px;\n  }\n\n\n  .hn-reward__visual-badge--top {\n    top: 7%;\n    right: -2px;\n  }\n\n\n  .hn-reward__visual-badge--bottom {\n    left: -2px;\n    bottom: 6%;\n  }\n\n}\n\n\n\n/* =========================================================\nREDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hn-reward__image,\n  .hn-reward__cta,\n  .hn-reward__cta svg {\n    transition:\n      none !important;\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  var root =\n    document.getElementById(\n      \"hnRewardSection\"\n    );\n\n\n  if (!root) {\n    return;\n  }\n\n\n\n  /* =====================================================\n  REMOVE CUSTOM HTML WHITE GAP\n  ---------------------------------------------------------\n  Keeps the strong wrapper fix from the previous version,\n  but removes ALL cart-tracker JavaScript.\n  ===================================================== */\n\n  function removeRewardSectionGap() {\n\n    var customSection =\n      root;\n\n\n    var parent =\n      customSection.parentElement;\n\n\n    while (\n      parent &&\n      parent !== document.body\n    ) {\n\n      [\n        \"margin-top\",\n        \"margin-bottom\",\n        \"padding-top\",\n        \"padding-bottom\",\n        \"margin-block-start\",\n        \"margin-block-end\",\n        \"padding-block-start\",\n        \"padding-block-end\",\n        \"min-height\",\n        \"row-gap\",\n        \"column-gap\",\n        \"gap\"\n      ].forEach(\n        function (property) {\n\n          parent.style.setProperty(\n            property,\n            \"0\",\n            \"important\"\n          );\n\n        }\n      );\n\n\n      [\n        \"--section-padding-top\",\n        \"--section-padding-bottom\",\n        \"--section-spacing-top\",\n        \"--section-spacing-bottom\",\n        \"--spacing-top\",\n        \"--spacing-bottom\"\n      ].forEach(\n        function (property) {\n\n          parent.style.setProperty(\n            property,\n            \"0px\",\n            \"important\"\n          );\n\n        }\n      );\n\n\n      if (\n        parent.classList &&\n        parent.classList.contains(\n          \"shopify-section\"\n        )\n      ) {\n        break;\n      }\n\n\n      parent =\n        parent.parentElement;\n\n    }\n\n\n\n    var shopifySection =\n      customSection.closest(\n        \".shopify-section\"\n      );\n\n\n    if (!shopifySection) {\n      return;\n    }\n\n\n\n    /* THEME HEADING / TITLE */\n\n    var headingSelectors = [\n      \".section-heading\",\n      \".section__heading\",\n      \".section-title\",\n      \".section__title\",\n      \".section-header\",\n      \".section__header\",\n      \".section-head\",\n      \".heading-wrapper\",\n      \".title-wrapper\",\n      \".section-title-wrapper\",\n      '[class*=\"section-heading\"]',\n      '[class*=\"section__heading\"]',\n      '[class*=\"section-title\"]',\n      '[class*=\"section__title\"]'\n    ];\n\n\n    shopifySection\n      .querySelectorAll(\n        headingSelectors.join(\",\")\n      )\n      .forEach(\n        function (heading) {\n\n          if (\n            customSection.contains(\n              heading\n            )\n          ) {\n            return;\n          }\n\n\n          heading.style.setProperty(\n            \"display\",\n            \"none\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"height\",\n            \"0\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"min-height\",\n            \"0\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"max-height\",\n            \"0\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"margin\",\n            \"0\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"padding\",\n            \"0\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"border\",\n            \"0\",\n            \"important\"\n          );\n\n\n          heading.style.setProperty(\n            \"overflow\",\n            \"hidden\",\n            \"important\"\n          );\n\n        }\n      );\n\n\n\n    /*\n    COLLAPSE ANONYMOUS EMPTY SPACERS\n    */\n\n    var childInPath =\n      customSection;\n\n\n    var ancestor =\n      customSection.parentElement;\n\n\n    while (\n      ancestor &&\n      ancestor !== document.body\n    ) {\n\n      Array.prototype.slice\n        .call(\n          ancestor.children\n        )\n        .forEach(\n          function (sibling) {\n\n            if (\n              sibling === childInPath ||\n              sibling.contains(customSection) ||\n              customSection.contains(sibling)\n            ) {\n              return;\n            }\n\n\n            var siblingText =\n              (\n                sibling.textContent ||\n                \"\"\n              )\n                .replace(\n                  /\\s+/g,\n                  \"\"\n                );\n\n\n            var meaningful =\n              sibling.querySelector(\n                [\n                  \"img\",\n                  \"picture\",\n                  \"video\",\n                  \"iframe\",\n                  \"canvas\",\n                  \"form\",\n                  \"input\",\n                  \"select\",\n                  \"textarea\",\n                  \"button\",\n                  \"a[href]\",\n                  \"svg\",\n                  \"[role='button']\"\n                ].join(\",\")\n              );\n\n\n            if (\n              siblingText === \"\" &&\n              !meaningful\n            ) {\n\n              sibling.style.setProperty(\n                \"display\",\n                \"none\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"height\",\n                \"0\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"min-height\",\n                \"0\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"max-height\",\n                \"0\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"margin\",\n                \"0\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"padding\",\n                \"0\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"border\",\n                \"0\",\n                \"important\"\n              );\n\n\n              sibling.style.setProperty(\n                \"overflow\",\n                \"hidden\",\n                \"important\"\n              );\n\n            }\n\n          }\n        );\n\n\n      if (\n        ancestor.classList &&\n        ancestor.classList.contains(\n          \"shopify-section\"\n        )\n      ) {\n        break;\n      }\n\n\n      childInPath =\n        ancestor;\n\n\n      ancestor =\n        ancestor.parentElement;\n\n    }\n\n\n    customSection.style.setProperty(\n      \"margin-top\",\n      \"0\",\n      \"important\"\n    );\n\n\n    customSection.style.setProperty(\n      \"margin-bottom\",\n      \"0\",\n      \"important\"\n    );\n\n  }\n\n\n\n  /* =====================================================\n  INITIALIZE GAP FIX\n  ===================================================== */\n\n  removeRewardSectionGap();\n\n\n  requestAnimationFrame(\n    function () {\n      removeRewardSectionGap();\n    }\n  );\n\n\n  setTimeout(\n    removeRewardSectionGap,\n    50\n  );\n\n\n  setTimeout(\n    removeRewardSectionGap,\n    250\n  );\n\n\n  setTimeout(\n    removeRewardSectionGap,\n    700\n  );\n\n\n  setTimeout(\n    removeRewardSectionGap,\n    1500\n  );\n\n\n\n  /* =====================================================\n  SHOPIFY THEME EDITOR\n  ===================================================== */\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    function () {\n\n      removeRewardSectionGap();\n\n\n      setTimeout(\n        removeRewardSectionGap,\n        120\n      );\n\n\n      setTimeout(\n        removeRewardSectionGap,\n        450\n      );\n\n    }\n  );\n\n\n})();\n\n</script>"
      }
