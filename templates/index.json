        "custom_html": "<!-- =========================================================\n     HERTHA NEST - RESPONSIVE PROMOTIONAL CAROUSEL\n\n     CHANGES:\n     1. New mobile image for Slide 1\n     2. New mobile image for Slide 2\n     3. Removed white shadow from mobile descriptions\n     4. Desktop images unchanged\n     5. Category dropdown remains above banner\n     6. Custom HTML top spacing removed\n     7. Autoplay every 5 seconds\n========================================================= -->\n\n<div class=\"hn-promo-slider\" data-hn-slider=\"\">\n\n  <div class=\"hn-promo-track\">\n\n    <!-- =====================================================\n         SLIDE 1 - A PERFECT PAIR\n    ====================================================== -->\n\n    <div class=\"hn-promo-slide is-active\" data-hn-slide=\"\" aria-hidden=\"false\">\n\n      <div class=\"hn-promo-image-wrap\">\n\n        <picture>\n\n          <!-- NEW MOBILE IMAGE -->\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/e.webp?v=1787727110\">\n\n          <!-- DESKTOP IMAGE - UNCHANGED -->\n          <img class=\"hn-promo-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/Untitled_design_4200a21b-db06-44fc-8dca-8782c498f103.png?v=1787555748\" alt=\"Hertha Nest handcrafted product combo\" width=\"1600\" height=\"750\" loading=\"eager\" fetchpriority=\"high\">\n\n        </source></picture>\n\n      </div>\n\n      <div class=\"hn-promo-overlay\"></div>\n\n      <div class=\"hn-promo-content\">\n\n        <div class=\"hn-promo-text\">\n\n          <h2 class=\"hn-promo-heading\">\n            A Perfect Pair\n          </h2>\n\n          <span class=\"hn-promo-divider\"></span>\n\n          <p class=\"hn-promo-subtitle\">\n            Two handcrafted favourites, beautifully paired together.\n          </p>\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n    <!-- =====================================================\n         SLIDE 2 - FESTIVE OFFER\n    ====================================================== -->\n\n    <div class=\"hn-promo-slide\" data-hn-slide=\"\" aria-hidden=\"true\">\n\n      <div class=\"hn-promo-image-wrap\">\n\n        <picture>\n\n          <!-- NEW MOBILE IMAGE -->\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/h.webp?v=1787727110\">\n\n          <!-- DESKTOP IMAGE - UNCHANGED -->\n          <img class=\"hn-promo-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/banner.png?v=1787555748\" alt=\"Hertha Nest festive collection offer\" width=\"1600\" height=\"750\" loading=\"lazy\">\n\n        </source></picture>\n\n      </div>\n\n      <div class=\"hn-promo-overlay\"></div>\n\n      <div class=\"hn-promo-content\">\n\n        <div class=\"hn-promo-text\">\n\n          <h2 class=\"hn-promo-heading\">\n            Festive Shopping,<br>\n            More Rewarding\n          </h2>\n\n          <span class=\"hn-promo-divider\"></span>\n\n          <p class=\"hn-promo-subtitle\">\n            Enjoy 20% off the Festive Collection on cart value ₹1,000 &amp; above.\n          </p>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n  <!-- =====================================================\n       DOT NAVIGATION\n  ====================================================== -->\n\n  <div class=\"hn-promo-dots\" aria-label=\"Promotional banner navigation\">\n\n    <button type=\"button\" class=\"hn-promo-dot is-active\" data-hn-dot=\"0\" aria-label=\"Show A Perfect Pair\" aria-current=\"true\"></button>\n\n    <button type=\"button\" class=\"hn-promo-dot\" data-hn-dot=\"1\" aria-label=\"Show Festive Offer\" aria-current=\"false\"></button>\n\n  </div>\n\n</div>\n\n\n<style>\n\n/* =========================================================\n   HEADER / CATEGORY DROPDOWN ABOVE BANNER\n========================================================= */\n\n#shopify-section-header,\n.shopify-section-header,\n.shopify-section-header-sticky,\n.shopify-section-group-header-group {\n  position: relative;\n  z-index: 9999 !important;\n}\n\n\n/* Allow dropdown menus to escape header */\n\n#shopify-section-header,\n#shopify-section-header header,\n#shopify-section-header .header-wrapper,\n#shopify-section-header .header,\n\n.shopify-section-header,\n.shopify-section-header header,\n.shopify-section-header .header-wrapper,\n.shopify-section-header .header,\n\n.header__inline-menu,\n.header__menu,\n.header__navigation,\n.header__menu-container,\n.header__menu-wrapper {\n  overflow: visible !important;\n}\n\n\n/* Dropdown itself */\n\n.header__submenu,\n.header__submenu.list-menu,\n.list-menu--disclosure,\n.mega-menu,\n.mega-menu__content,\n.dropdown,\n.dropdown-menu,\n.submenu,\n.sub-menu {\n  z-index: 99999 !important;\n}\n\n\n/* =========================================================\n   REMOVE CUSTOM HTML SECTION TOP SPACE\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-block-start: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --padding-top: 0px !important;\n  --section-spacing-top: 0px !important;\n  --spacing-top: 0px !important;\n}\n\n\n/* Direct section wrappers */\n\n.shopify-section:has(.hn-promo-slider) > div {\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n  padding-block-start: 0 !important;\n}\n\n\n.shopify-section:has(.hn-promo-slider) > div > div {\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n  padding-block-start: 0 !important;\n}\n\n\n/* =========================================================\n   COMMON THEME WRAPPERS\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) .section,\n.shopify-section:has(.hn-promo-slider) .section-inner,\n.shopify-section:has(.hn-promo-slider) .section__inner,\n.shopify-section:has(.hn-promo-slider) .section-content,\n.shopify-section:has(.hn-promo-slider) .section__content,\n\n.shopify-section:has(.hn-promo-slider) .custom-html,\n.shopify-section:has(.hn-promo-slider) .custom-html-section,\n.shopify-section:has(.hn-promo-slider) .custom-html-wrapper,\n.shopify-section:has(.hn-promo-slider) .custom-html__wrapper,\n.shopify-section:has(.hn-promo-slider) .custom-html__content,\n\n.shopify-section:has(.hn-promo-slider) .custom-liquid,\n.shopify-section:has(.hn-promo-slider) .custom-liquid-section,\n.shopify-section:has(.hn-promo-slider) .custom-liquid-wrapper,\n\n.shopify-section:has(.hn-promo-slider) .page-width,\n.shopify-section:has(.hn-promo-slider) .container,\n.shopify-section:has(.hn-promo-slider) .container-fluid {\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n  padding-block-start: 0 !important;\n}\n\n\n/* =========================================================\n   REMOVE EMPTY HEADING AREA\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) .section-heading:empty,\n.shopify-section:has(.hn-promo-slider) .section__heading:empty,\n.shopify-section:has(.hn-promo-slider) .section-title:empty,\n.shopify-section:has(.hn-promo-slider) .section__title:empty,\n.shopify-section:has(.hn-promo-slider) .section-header:empty,\n.shopify-section:has(.hn-promo-slider) .section__header:empty,\n.shopify-section:has(.hn-promo-slider) .heading-wrapper:empty,\n.shopify-section:has(.hn-promo-slider) .title-wrapper:empty {\n  display: none !important;\n\n  height: 0 !important;\n  min-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n\n.shopify-section:has(.hn-promo-slider) .section-heading,\n.shopify-section:has(.hn-promo-slider) .section__heading,\n.shopify-section:has(.hn-promo-slider) .section-title-wrapper,\n.shopify-section:has(.hn-promo-slider) .section__title-wrapper {\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n}\n\n\n/* =========================================================\n   FORCE BANNER FULL WIDTH\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) .page-width,\n.shopify-section:has(.hn-promo-slider) .container,\n.shopify-section:has(.hn-promo-slider) .container-fluid {\n  width: 100% !important;\n  max-width: none !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n/* =========================================================\n   MAIN SLIDER\n========================================================= */\n\n.hn-promo-slider {\n  --hn-accent: #DE7F65;\n  --hn-heading: #3d2924;\n  --hn-text: #674b43;\n\n  position: relative;\n  z-index: 1;\n\n  display: block;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  margin-left: calc(50% - 50vw);\n  margin-right: calc(50% - 50vw);\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  border: 0;\n\n  overflow: hidden;\n\n  background: #f8eee7;\n\n  box-sizing: border-box;\n\n  isolation: isolate;\n}\n\n\n.hn-promo-slider *,\n.hn-promo-slider *::before,\n.hn-promo-slider *::after {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hn-promo-track {\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  aspect-ratio: 1600 / 750;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0;\n\n  overflow: hidden;\n}\n\n\n/* =========================================================\n   SLIDES\n========================================================= */\n\n.hn-promo-slide {\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  opacity: 0;\n  visibility: hidden;\n\n  pointer-events: none;\n\n  transition:\n    opacity 0.8s ease,\n    visibility 0.8s ease;\n}\n\n\n.hn-promo-slide.is-active {\n  opacity: 1;\n  visibility: visible;\n\n  pointer-events: auto;\n\n  z-index: 2;\n}\n\n\n/* =========================================================\n   IMAGE\n========================================================= */\n\n.hn-promo-image-wrap {\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  overflow: hidden;\n}\n\n\n.hn-promo-image-wrap picture {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n  padding: 0;\n}\n\n\n.hn-promo-image {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n  padding: 0;\n\n  border: 0;\n\n  object-fit: cover;\n  object-position: center center;\n\n  transform: scale(1);\n\n  transition: transform 6s ease;\n}\n\n\n.hn-promo-slide.is-active .hn-promo-image {\n  transform: scale(1.025);\n}\n\n\n/* =========================================================\n   DESKTOP OVERLAY\n========================================================= */\n\n.hn-promo-overlay {\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 1;\n\n  pointer-events: none;\n\n  background:\n    linear-gradient(\n      90deg,\n      rgba(255, 249, 243, 0.75) 0%,\n      rgba(255, 249, 243, 0.60) 23%,\n      rgba(255, 249, 243, 0.25) 42%,\n      rgba(255, 249, 243, 0) 62%\n    );\n}\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hn-promo-content {\n  position: relative;\n\n  z-index: 3;\n\n  display: flex;\n  align-items: center;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n\n  padding:\n    50px\n    clamp(40px, 7vw, 135px);\n}\n\n\n/* =========================================================\n   TEXT\n========================================================= */\n\n.hn-promo-text {\n  width: 100%;\n  max-width: 600px;\n\n  margin: 0;\n\n  opacity: 0;\n\n  transform: translateY(20px);\n\n  transition:\n    opacity 0.7s ease 0.15s,\n    transform 0.7s ease 0.15s;\n}\n\n\n.hn-promo-slide.is-active .hn-promo-text {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n\n/* =========================================================\n   HEADING\n========================================================= */\n\n.hn-promo-heading {\n  margin: 0;\n  padding: 0;\n\n  color: var(--hn-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size: clamp(38px, 4.2vw, 74px);\n\n  font-weight: 700;\n\n  line-height: 1.03;\n\n  letter-spacing: -0.035em;\n}\n\n\n/* =========================================================\n   DIVIDER\n========================================================= */\n\n.hn-promo-divider {\n  display: block;\n\n  width: 55px;\n  height: 3px;\n\n  margin:\n    20px\n    0\n    18px;\n\n  border-radius: 20px;\n\n  background: var(--hn-accent);\n}\n\n\n/* =========================================================\n   DESCRIPTION / SUBTITLE\n========================================================= */\n\n.hn-promo-subtitle {\n  width: 100%;\n  max-width: 520px;\n\n  margin: 0;\n\n  color: var(--hn-text);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size: clamp(15px, 1.25vw, 20px);\n\n  font-weight: 500;\n\n  line-height: 1.55;\n\n  /* NO WHITE SHADOW */\n  text-shadow: none;\n}\n\n\n/* =========================================================\n   DOT NAVIGATION\n========================================================= */\n\n.hn-promo-dots {\n  position: absolute;\n\n  z-index: 20;\n\n  left: 50%;\n  bottom: 20px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 8px;\n\n  transform: translateX(-50%);\n}\n\n\n.hn-promo-dot {\n  display: block;\n\n  width: 9px;\n  height: 9px;\n\n  min-width: 9px;\n\n  margin: 0;\n  padding: 0;\n\n  border: 0;\n\n  border-radius: 50%;\n\n  background: rgba(60, 40, 34, 0.35);\n\n  cursor: pointer;\n\n  appearance: none;\n  -webkit-appearance: none;\n\n  box-shadow: none;\n\n  transition:\n    width 0.3s ease,\n    background 0.3s ease,\n    transform 0.3s ease;\n}\n\n\n.hn-promo-dot:hover {\n  transform: scale(1.1);\n}\n\n\n.hn-promo-dot.is-active {\n  width: 28px;\n\n  border-radius: 20px;\n\n  background: var(--hn-accent);\n}\n\n\n.hn-promo-dot:focus-visible {\n  outline: 2px solid var(--hn-heading);\n  outline-offset: 3px;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and (max-width: 990px) and (min-width: 750px) {\n\n  .hn-promo-content {\n    padding-left: 40px;\n    padding-right: 40px;\n  }\n\n\n  .hn-promo-text {\n    max-width: 48%;\n  }\n\n\n  .hn-promo-heading {\n    font-size: clamp(34px, 5vw, 54px);\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  /* -------------------------------------------------------\n     MOBILE BANNER SIZE\n  ------------------------------------------------------- */\n\n  .hn-promo-track {\n    aspect-ratio: 4 / 5;\n\n    height: auto;\n    min-height: 0;\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE IMAGE\n  ------------------------------------------------------- */\n\n  .hn-promo-image-wrap {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n  }\n\n\n  .hn-promo-image {\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center center;\n\n    transform: none;\n  }\n\n\n  .hn-promo-slide.is-active .hn-promo-image {\n    transform: none;\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE OVERLAY\n  ------------------------------------------------------- */\n\n  .hn-promo-overlay {\n    display: block;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(255, 249, 243, 0.48) 0%,\n        rgba(255, 249, 243, 0.33) 17%,\n        rgba(255, 249, 243, 0.12) 29%,\n        rgba(255, 249, 243, 0) 42%\n      );\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE CONTENT\n  ------------------------------------------------------- */\n\n  .hn-promo-content {\n    position: absolute;\n\n    inset: 0;\n\n    z-index: 3;\n\n    display: flex;\n\n    align-items: flex-start;\n    justify-content: center;\n\n    width: 100%;\n    height: 100%;\n\n    padding:\n      clamp(34px, 10vw, 54px)\n      20px\n      50px;\n\n    pointer-events: none;\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE TEXT\n  ------------------------------------------------------- */\n\n  .hn-promo-text {\n    width: 100%;\n    max-width: 390px;\n\n    margin: 0 auto;\n\n    text-align: center;\n\n    opacity: 0;\n\n    transform: translateY(10px);\n  }\n\n\n  .hn-promo-slide.is-active .hn-promo-text {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE HEADING\n  ------------------------------------------------------- */\n\n  .hn-promo-heading {\n    width: 100%;\n\n    margin: 0 auto;\n    padding: 0;\n\n    color: #38251f;\n\n    text-align: center;\n\n    font-size: clamp(29px, 8.5vw, 40px);\n\n    font-weight: 700;\n\n    line-height: 1.03;\n\n    letter-spacing: -0.025em;\n\n    text-shadow:\n      0 1px 1px rgba(255, 255, 255, 0.80),\n      0 2px 6px rgba(255, 255, 255, 0.30);\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE DIVIDER\n  ------------------------------------------------------- */\n\n  .hn-promo-divider {\n    width: 42px;\n    height: 2px;\n\n    margin:\n      12px\n      auto\n      11px;\n\n    background: var(--hn-accent);\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE DESCRIPTION\n     \n     IMPORTANT:\n     White text-shadow has been completely removed.\n  ------------------------------------------------------- */\n\n  .hn-promo-subtitle {\n    width: 100%;\n    max-width: 355px;\n\n    margin: 0 auto;\n\n    color: #5f433c;\n\n    text-align: center;\n\n    font-size: 13.5px;\n\n    font-weight: 500;\n\n    line-height: 1.45;\n\n    text-shadow: none !important;\n  }\n\n\n  /* -------------------------------------------------------\n     MOBILE DOTS\n  ------------------------------------------------------- */\n\n  .hn-promo-dots {\n    left: 50%;\n\n    bottom: 16px;\n\n    gap: 7px;\n\n    transform: translateX(-50%);\n  }\n\n\n  .hn-promo-dot {\n    width: 7px;\n    height: 7px;\n\n    min-width: 7px;\n\n    background: rgba(65, 42, 35, 0.30);\n  }\n\n\n  .hn-promo-dot.is-active {\n    width: 23px;\n\n    background: var(--hn-accent);\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 420px) {\n\n  .hn-promo-content {\n    padding-top: 36px;\n\n    padding-left: 16px;\n    padding-right: 16px;\n  }\n\n\n  .hn-promo-heading {\n    font-size: 31px;\n  }\n\n\n  .hn-promo-subtitle {\n    max-width: 320px;\n\n    font-size: 12.8px;\n\n    text-shadow: none !important;\n  }\n\n}\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 350px) {\n\n  .hn-promo-content {\n    padding-top: 28px;\n  }\n\n\n  .hn-promo-heading {\n    font-size: 27px;\n  }\n\n\n  .hn-promo-divider {\n    margin-top: 9px;\n    margin-bottom: 9px;\n  }\n\n\n  .hn-promo-subtitle {\n    max-width: 290px;\n\n    font-size: 12px;\n\n    text-shadow: none !important;\n  }\n\n}\n\n\n/* =========================================================\n   REDUCED MOTION ACCESSIBILITY\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hn-promo-slide,\n  .hn-promo-image,\n  .hn-promo-text,\n  .hn-promo-dot {\n    transition: none !important;\n  }\n\n}\n\n</style>\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n     REMOVE CUSTOM HTML INTERNAL TOP GAP\n  ===================================================== */\n\n  function removeSectionGap() {\n\n    var sliders = document.querySelectorAll(\n      \"[data-hn-slider]\"\n    );\n\n\n    sliders.forEach(function (slider) {\n\n      var section = slider.closest(\n        \".shopify-section\"\n      );\n\n\n      if (!section) {\n        return;\n      }\n\n\n      /*\n       * Walk upwards from slider to Shopify section.\n       * Only removes TOP spacing.\n       */\n\n      var element = slider.parentElement;\n\n\n      while (\n        element &&\n        element !== section\n      ) {\n\n        element.style.setProperty(\n          \"margin-top\",\n          \"0\",\n          \"important\"\n        );\n\n\n        element.style.setProperty(\n          \"padding-top\",\n          \"0\",\n          \"important\"\n        );\n\n\n        element.style.setProperty(\n          \"padding-block-start\",\n          \"0\",\n          \"important\"\n        );\n\n\n        element = element.parentElement;\n      }\n\n\n      section.style.setProperty(\n        \"margin-top\",\n        \"0\",\n        \"important\"\n      );\n\n\n      section.style.setProperty(\n        \"padding-top\",\n        \"0\",\n        \"important\"\n      );\n\n\n      section.style.setProperty(\n        \"padding-block-start\",\n        \"0\",\n        \"important\"\n      );\n\n    });\n\n  }\n\n\n  removeSectionGap();\n\n\n  /*\n   * Shopify theme editor may render section\n   * again after initial page load.\n   */\n\n  setTimeout(\n    removeSectionGap,\n    150\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    700\n  );\n\n\n  /* =====================================================\n     SLIDER INITIALIZATION\n  ===================================================== */\n\n  var sliders = document.querySelectorAll(\n    \"[data-hn-slider]\"\n  );\n\n\n  sliders.forEach(function (slider) {\n\n    /* Prevent duplicate initialization */\n\n    if (\n      slider.getAttribute(\"data-hn-ready\") === \"true\"\n    ) {\n      return;\n    }\n\n\n    slider.setAttribute(\n      \"data-hn-ready\",\n      \"true\"\n    );\n\n\n    var slides = slider.querySelectorAll(\n      \"[data-hn-slide]\"\n    );\n\n\n    var dots = slider.querySelectorAll(\n      \"[data-hn-dot]\"\n    );\n\n\n    if (slides.length < 2) {\n      return;\n    }\n\n\n    var currentSlide = 0;\n\n    var autoplayTimer = null;\n\n    var autoplayDelay = 5000;\n\n\n    /* ===================================================\n       SHOW SPECIFIC SLIDE\n    =================================================== */\n\n    function showSlide(index) {\n\n      if (index >= slides.length) {\n        index = 0;\n      }\n\n\n      if (index < 0) {\n        index = slides.length - 1;\n      }\n\n\n      slides.forEach(function (slide, slideIndex) {\n\n        var active = slideIndex === index;\n\n\n        if (active) {\n\n          slide.classList.add(\n            \"is-active\"\n          );\n\n\n          slide.setAttribute(\n            \"aria-hidden\",\n            \"false\"\n          );\n\n        } else {\n\n          slide.classList.remove(\n            \"is-active\"\n          );\n\n\n          slide.setAttribute(\n            \"aria-hidden\",\n            \"true\"\n          );\n\n        }\n\n      });\n\n\n      dots.forEach(function (dot, dotIndex) {\n\n        var active = dotIndex === index;\n\n\n        if (active) {\n\n          dot.classList.add(\n            \"is-active\"\n          );\n\n\n          dot.setAttribute(\n            \"aria-current\",\n            \"true\"\n          );\n\n        } else {\n\n          dot.classList.remove(\n            \"is-active\"\n          );\n\n\n          dot.setAttribute(\n            \"aria-current\",\n            \"false\"\n          );\n\n        }\n\n      });\n\n\n      currentSlide = index;\n    }\n\n\n    /* ===================================================\n       NEXT SLIDE\n    =================================================== */\n\n    function nextSlide() {\n\n      showSlide(\n        currentSlide + 1\n      );\n\n    }\n\n\n    /* ===================================================\n       STOP AUTOPLAY\n    =================================================== */\n\n    function stopAutoplay() {\n\n      if (autoplayTimer !== null) {\n\n        clearInterval(\n          autoplayTimer\n        );\n\n\n        autoplayTimer = null;\n      }\n\n    }\n\n\n    /* ===================================================\n       START AUTOPLAY\n    =================================================== */\n\n    function startAutoplay() {\n\n      stopAutoplay();\n\n\n      autoplayTimer = setInterval(\n        nextSlide,\n        autoplayDelay\n      );\n\n    }\n\n\n    /* ===================================================\n       DOT CLICK\n    =================================================== */\n\n    dots.forEach(function (dot) {\n\n      dot.addEventListener(\n        \"click\",\n        function () {\n\n          var target = parseInt(\n            dot.getAttribute(\"data-hn-dot\"),\n            10\n          );\n\n\n          if (isNaN(target)) {\n            return;\n          }\n\n\n          showSlide(target);\n\n          startAutoplay();\n\n        }\n      );\n\n    });\n\n\n    /* ===================================================\n       PAGE VISIBILITY\n    =================================================== */\n\n    document.addEventListener(\n      \"visibilitychange\",\n      function () {\n\n        if (document.hidden) {\n\n          stopAutoplay();\n\n        } else {\n\n          startAutoplay();\n\n        }\n\n      }\n    );\n\n\n    /* ===================================================\n       INITIAL SLIDE\n    =================================================== */\n\n    showSlide(0);\n\n\n    var reducedMotion = window.matchMedia(\n      \"(prefers-reduced-motion: reduce)\"\n    );\n\n\n    if (!reducedMotion.matches) {\n      startAutoplay();\n    }\n\n  });\n\n})();\n\n</script>"
      }
    },
