        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 0,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<!--\n  Hertha Nest: Latest 30 Products — Two Connected Carousels\n\n  Top carousel: Products 1–15\n  Bottom carousel: Products 16–30\n\n  The section loads the newest published Online Store products automatically.\n  New products move to the first position and the previous 30th product leaves.\n-->\n\n<section class=\"hn-new30\" data-top-count=\"15\" data-bottom-count=\"15\" aria-labelledby=\"hn-new30-heading\">\n  <div class=\"hn-new30__inner\">\n\n    <header class=\"hn-new30__header\">\n      <span class=\"hn-new30__eyebrow\">New at Hertha Nest</span>\n\n      <h2 class=\"hn-new30__title\" id=\"hn-new30-heading\">\n        The New Décor Edit\n      </h2>\n\n      <p class=\"hn-new30__description\">\n        Explore our latest handcrafted additions, thoughtfully selected to\n        bring fresh character, colour and timeless charm into your home.\n      </p>\n    </header>\n\n    <div class=\"hn-new30__main-loading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-new30__loader\" aria-hidden=\"true\"></span>\n      <span>Discovering our latest arrivals...</span>\n    </div>\n\n    <!-- PRODUCTS 1–15 -->\n    <div class=\"hn-new30__carousel hn-new30__carousel--top\" data-carousel-position=\"top\" hidden=\"\">\n      <div class=\"hn-new30__controls\">\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n      </div>\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Latest fifteen products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n    </div>\n\n    <div class=\"hn-new30__divider\" hidden=\"\" aria-hidden=\"true\">\n      <span></span>\n    </div>\n\n    <!-- PRODUCTS 16–30 -->\n    <div class=\"hn-new30__carousel hn-new30__carousel--bottom\" data-carousel-position=\"bottom\" hidden=\"\">\n      <div class=\"hn-new30__controls\">\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n      </div>\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Next fifteen newly added products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n    </div>\n\n    <div class=\"hn-new30__empty\" hidden=\"\">\n      New products will appear here as soon as they are published.\n    </div>\n  </div>\n\n  <div class=\"hn-new30__toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">\n    <span class=\"hn-new30__toast-icon\" aria-hidden=\"true\">✓</span>\n    <span class=\"hn-new30__toast-message\">Product added to your cart.</span>\n    <a href=\"/cart\">View cart</a>\n  </div>\n</section>\n\n<style>\n  .shopify-section:has(.hn-new30){\n    width:100% !important;\n    max-width:none !important;\n    margin-top:0 !important;\n    margin-bottom:0 !important;\n    padding-top:0 !important;\n    padding-bottom:0 !important;\n    overflow:visible !important;\n  }\n\n  .hn-new30{\n    --hn30-green:#315548;\n    --hn30-green-dark:#203f35;\n    --hn30-gold:#bd9152;\n    --hn30-white:#ffffff;\n    --hn30-heading:#29211c;\n    --hn30-text:rgba(41,33,28,.70);\n    --hn30-muted:rgba(41,33,28,.52);\n    --hn30-border:rgba(49,85,72,.14);\n    --hn30-gap:20px;\n\n    position:relative;\n    left:50%;\n    width:100vw;\n    max-width:100vw;\n    margin:0 0 30px -50vw;\n    padding:38px 0 44px;\n    overflow:hidden;\n    color:var(--hn30-heading);\n\n    background:\n      radial-gradient(circle at 5% 0%,rgba(189,145,82,.14),transparent 27%),\n      radial-gradient(circle at 95% 100%,rgba(49,85,72,.10),transparent 28%),\n      linear-gradient(135deg,#f8f6ef 0%,#fffdf8 48%,#f4f3ec 100%);\n  }\n\n  .hn-new30 *,\n  .hn-new30 *::before,\n  .hn-new30 *::after{\n    box-sizing:border-box;\n  }\n\n  .hn-new30__inner{\n    width:100%;\n    max-width:1520px;\n    margin:0 auto;\n    padding:0 32px;\n  }\n\n  .hn-new30__header{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    max-width:850px;\n    margin:0 auto 22px;\n    text-align:center;\n  }\n\n  .hn-new30__eyebrow{\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    gap:9px;\n    margin:0 0 9px;\n    color:var(--hn30-green);\n    font-size:11px;\n    font-weight:750;\n    line-height:1.3;\n    letter-spacing:1.8px;\n    text-transform:uppercase;\n  }\n\n  .hn-new30__eyebrow::before,\n  .hn-new30__eyebrow::after{\n    content:\"\";\n    width:28px;\n    height:1px;\n    background:var(--hn30-gold);\n  }\n\n  .hn-new30__title{\n    margin:0;\n    color:var(--hn30-heading);\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-size:clamp(29px,3.5vw,44px);\n    font-weight:500;\n    line-height:1.12;\n    letter-spacing:-.5px;\n  }\n\n  .hn-new30__description{\n    max-width:720px;\n    margin:10px auto 0;\n    color:var(--hn30-text);\n    font-size:14px;\n    line-height:1.65;\n  }\n\n  .hn-new30__carousel{\n    width:100%;\n  }\n\n  .hn-new30__carousel[hidden],\n  .hn-new30__divider[hidden],\n  .hn-new30__empty[hidden],\n  .hn-new30__main-loading[hidden]{\n    display:none !important;\n  }\n\n  .hn-new30__controls{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:9px;\n    min-height:41px;\n    margin:0 0 17px;\n  }\n\n  .hn-new30__controls[hidden]{\n    display:none !important;\n  }\n\n  .hn-new30__arrow{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:41px;\n    height:41px;\n    padding:0;\n    border:1px solid var(--hn30-border);\n    border-radius:50%;\n    background:rgba(255,255,255,.86);\n    color:var(--hn30-green-dark);\n    box-shadow:0 7px 18px rgba(32,63,53,.08),inset 0 1px 0 rgba(255,255,255,.9);\n    cursor:pointer;\n    transition:transform .25s ease,border-color .25s ease,background .25s ease,color .25s ease,box-shadow .25s ease;\n  }\n\n  .hn-new30__arrow:hover{\n    transform:translateY(-2px);\n    border-color:var(--hn30-green);\n    background:var(--hn30-green);\n    color:#ffffff;\n    box-shadow:0 10px 22px rgba(32,63,53,.18);\n  }\n\n  .hn-new30__arrow:focus-visible{\n    outline:2px solid var(--hn30-gold);\n    outline-offset:3px;\n  }\n\n  .hn-new30__arrow svg{\n    width:17px;\n    height:17px;\n    fill:none;\n    stroke:currentColor;\n    stroke-width:1.8;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n  }\n\n  .hn-new30__viewport{\n    width:100%;\n    overflow:hidden;\n    touch-action:pan-y;\n  }\n\n  .hn-new30__track{\n    display:flex;\n    align-items:stretch;\n    gap:var(--hn30-gap);\n    width:max-content;\n    will-change:transform;\n    transition:transform .55s cubic-bezier(.22,.61,.36,1);\n  }\n\n  .hn-new30__divider{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:100%;\n    margin:26px 0 18px;\n  }\n\n  .hn-new30__divider span{\n    position:relative;\n    display:block;\n    width:min(620px,75%);\n    height:1px;\n    background:linear-gradient(90deg,transparent,rgba(49,85,72,.16),rgba(189,145,82,.36),rgba(49,85,72,.16),transparent);\n  }\n\n  .hn-new30__divider span::before{\n    content:\"\";\n    position:absolute;\n    top:50%;\n    left:50%;\n    width:7px;\n    height:7px;\n    border:1px solid rgba(189,145,82,.55);\n    background:#f8f6ef;\n    transform:translate(-50%,-50%) rotate(45deg);\n  }\n\n  .hn-new30__card{\n    position:relative;\n    flex:0 0 auto;\n    min-width:0;\n    overflow:hidden;\n    border:1px solid var(--hn30-border);\n    border-radius:18px;\n    background:var(--hn30-white);\n    box-shadow:0 10px 25px rgba(41,33,28,.06),0 2px 5px rgba(41,33,28,.025);\n    transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease;\n  }\n\n  .hn-new30__card:hover{\n    transform:translateY(-5px);\n    border-color:rgba(189,145,82,.38);\n    box-shadow:0 18px 38px rgba(41,33,28,.11),0 4px 10px rgba(41,33,28,.04);\n  }\n\n  .hn-new30__image-link{\n    position:relative;\n    display:block;\n    width:100%;\n    aspect-ratio:1 / 1;\n    overflow:hidden;\n    background:#f0eee7;\n  }\n\n  .hn-new30__image{\n    display:block;\n    width:100%;\n    height:100%;\n    object-fit:cover;\n    transition:transform .65s cubic-bezier(.22,.61,.36,1);\n  }\n\n  .hn-new30__card:hover .hn-new30__image{\n    transform:scale(1.05);\n  }\n\n  .hn-new30__image-placeholder{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:100%;\n    height:100%;\n    padding:30px;\n    background:linear-gradient(135deg,rgba(49,85,72,.12),rgba(255,255,255,.90));\n    color:var(--hn30-green);\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-size:17px;\n    line-height:1.4;\n    text-align:center;\n  }\n\n  .hn-new30__badge{\n    position:absolute;\n    top:12px;\n    left:12px;\n    z-index:2;\n    display:inline-flex;\n    align-items:center;\n    gap:7px;\n    min-height:28px;\n    padding:7px 11px;\n    border:1px solid rgba(255,255,255,.32);\n    border-radius:999px;\n    background:rgba(35,72,59,.93);\n    color:#ffffff;\n    box-shadow:0 7px 18px rgba(21,46,37,.20);\n    backdrop-filter:blur(9px);\n    -webkit-backdrop-filter:blur(9px);\n    font-size:9px;\n    font-weight:750;\n    line-height:1;\n    letter-spacing:1.05px;\n    text-transform:uppercase;\n  }\n\n  .hn-new30__badge::before{\n    content:\"\";\n    width:6px;\n    height:6px;\n    flex:0 0 6px;\n    border-radius:50%;\n    background:#e8bd78;\n    box-shadow:0 0 0 4px rgba(232,189,120,.16);\n  }\n\n  .hn-new30__content{\n    display:block;\n    padding:14px 15px 15px;\n  }\n\n  .hn-new30__vendor{\n    margin:0 0 5px;\n    overflow:hidden;\n    color:var(--hn30-green);\n    font-size:9px;\n    font-weight:750;\n    line-height:1.3;\n    letter-spacing:1.2px;\n    text-overflow:ellipsis;\n    text-transform:uppercase;\n    white-space:nowrap;\n  }\n\n  .hn-new30__product-title{\n    min-height:44px;\n    margin:0;\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-size:17px;\n    font-weight:500;\n    line-height:1.32;\n  }\n\n  .hn-new30__product-title a{\n    display:-webkit-box;\n    overflow:hidden;\n    color:var(--hn30-heading);\n    text-decoration:none;\n    -webkit-box-orient:vertical;\n    -webkit-line-clamp:2;\n    transition:color .22s ease;\n  }\n\n  .hn-new30__product-title a:hover{\n    color:var(--hn30-green);\n  }\n\n  .hn-new30__bottom{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:10px;\n    margin-top:12px;\n    padding-top:12px;\n    border-top:1px solid rgba(49,85,72,.09);\n  }\n\n  .hn-new30__prices{\n    display:flex;\n    flex-direction:column;\n    align-items:flex-start;\n    gap:1px;\n    min-width:0;\n  }\n\n  .hn-new30__price{\n    color:var(--hn30-heading);\n    font-size:17px;\n    font-weight:750;\n    line-height:1.25;\n  }\n\n  .hn-new30__compare-price{\n    color:var(--hn30-muted);\n    font-size:11px;\n    line-height:1.25;\n    text-decoration:line-through;\n  }\n\n  .hn-new30__add{\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    gap:8px;\n    min-width:118px;\n    min-height:42px;\n    padding:9px 15px;\n    border:1px solid var(--hn30-green);\n    border-radius:999px;\n    background:linear-gradient(135deg,var(--hn30-green) 0%,var(--hn30-green-dark) 100%);\n    color:#ffffff;\n    box-shadow:0 7px 16px rgba(32,63,53,.18),inset 0 1px 0 rgba(255,255,255,.13);\n    font-family:inherit;\n    font-size:11px;\n    font-weight:750;\n    line-height:1;\n    white-space:nowrap;\n    cursor:pointer;\n    transition:transform .25s ease,border-color .25s ease,background .25s ease,box-shadow .25s ease,opacity .25s ease;\n  }\n\n  .hn-new30__add:hover{\n    transform:translateY(-2px);\n    border-color:var(--hn30-gold);\n    background:linear-gradient(135deg,#c69a58 0%,#a87738 100%);\n    box-shadow:0 9px 20px rgba(145,101,48,.23);\n  }\n\n  .hn-new30__add:focus-visible{\n    outline:2px solid var(--hn30-gold);\n    outline-offset:3px;\n  }\n\n  .hn-new30__cart-symbol{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:20px;\n    height:20px;\n    flex:0 0 20px;\n    border-radius:50%;\n    background:rgba(255,255,255,.14);\n  }\n\n  .hn-new30__cart-symbol svg{\n    width:12px;\n    height:12px;\n    fill:none;\n    stroke:currentColor;\n    stroke-width:1.8;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n  }\n\n  .hn-new30__add.is-loading{\n    pointer-events:none;\n    opacity:.62;\n  }\n\n  .hn-new30__add.is-added{\n    border-color:#4f8062;\n    background:#4f8062;\n  }\n\n  .hn-new30__add:disabled{\n    min-width:105px;\n    transform:none;\n    border-color:#d2cec4;\n    background:#d2cec4;\n    color:#716e67;\n    box-shadow:none;\n    cursor:not-allowed;\n    opacity:.9;\n  }\n\n  .hn-new30__main-loading{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:11px;\n    min-height:210px;\n    color:var(--hn30-text);\n    font-size:13px;\n  }\n\n  .hn-new30__loader{\n    width:23px;\n    height:23px;\n    border:3px solid rgba(49,85,72,.16);\n    border-top-color:var(--hn30-green);\n    border-radius:50%;\n    animation:hnNew30Spin .8s linear infinite;\n  }\n\n  @keyframes hnNew30Spin{\n    to{transform:rotate(360deg);}\n  }\n\n  .hn-new30__empty{\n    padding:35px 20px;\n    border:1px solid var(--hn30-border);\n    border-radius:16px;\n    background:#ffffff;\n    color:var(--hn30-text);\n    font-size:13px;\n    line-height:1.6;\n    text-align:center;\n  }\n\n  .hn-new30__toast{\n    position:fixed;\n    right:20px;\n    bottom:20px;\n    z-index:999999;\n    display:flex;\n    align-items:center;\n    gap:10px;\n    max-width:min(420px,calc(100vw - 30px));\n    padding:13px 15px;\n    border:1px solid rgba(255,255,255,.14);\n    border-radius:13px;\n    background:rgba(32,63,53,.97);\n    color:#ffffff;\n    box-shadow:0 17px 42px rgba(0,0,0,.22);\n    opacity:0;\n    visibility:hidden;\n    transform:translateY(14px);\n    transition:opacity .3s ease,visibility .3s ease,transform .3s ease;\n  }\n\n  .hn-new30__toast.is-visible{\n    opacity:1;\n    visibility:visible;\n    transform:translateY(0);\n  }\n\n  .hn-new30__toast-icon{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    width:25px;\n    height:25px;\n    flex:0 0 25px;\n    border-radius:50%;\n    background:rgba(255,255,255,.14);\n    color:#f0cb8a;\n    font-size:13px;\n    font-weight:800;\n  }\n\n  .hn-new30__toast-message{\n    font-size:12px;\n    font-weight:650;\n    line-height:1.4;\n  }\n\n  .hn-new30__toast a{\n    margin-left:auto;\n    color:#f3ce8c;\n    font-size:11px;\n    font-weight:750;\n    white-space:nowrap;\n    text-decoration:underline;\n    text-underline-offset:3px;\n  }\n\n  @media (max-width:900px){\n    .hn-new30{padding:32px 0 38px;}\n    .hn-new30__inner{padding:0 22px;}\n    .hn-new30__header{margin-bottom:20px;}\n    .hn-new30__divider{margin-top:23px;}\n  }\n\n  @media (max-width:580px){\n    .hn-new30{\n      --hn30-gap:14px;\n      margin-bottom:20px;\n      padding:28px 0 32px;\n    }\n\n    .hn-new30__inner{padding:0 14px;}\n    .hn-new30__header{margin-bottom:17px;}\n\n    .hn-new30__eyebrow{\n      margin-bottom:7px;\n      font-size:9px;\n      letter-spacing:1.35px;\n    }\n\n    .hn-new30__eyebrow::before,\n    .hn-new30__eyebrow::after{width:20px;}\n\n    .hn-new30__title{font-size:29px;}\n\n    .hn-new30__description{\n      margin-top:8px;\n      font-size:12.5px;\n      line-height:1.55;\n    }\n\n    .hn-new30__controls{margin-bottom:14px;}\n    .hn-new30__arrow{width:37px;height:37px;}\n    .hn-new30__divider{margin:21px 0 15px;}\n    .hn-new30__divider span{width:82%;}\n    .hn-new30__card{border-radius:16px;}\n    .hn-new30__content{padding:13px 13px 14px;}\n\n    .hn-new30__product-title{\n      min-height:42px;\n      font-size:16px;\n    }\n\n    .hn-new30__bottom{\n      margin-top:10px;\n      padding-top:10px;\n    }\n\n    .hn-new30__price{font-size:16px;}\n\n    .hn-new30__add{\n      min-width:112px;\n      min-height:40px;\n      padding:8px 12px;\n      font-size:10.5px;\n    }\n\n    .hn-new30__toast{\n      right:14px;\n      bottom:14px;\n    }\n  }\n\n  @media (max-width:370px){\n    .hn-new30__add{\n      min-width:94px;\n      padding:8px 10px;\n    }\n\n    .hn-new30__cart-symbol{display:none;}\n  }\n\n  @media (prefers-reduced-motion:reduce){\n    .hn-new30__track,\n    .hn-new30__card,\n    .hn-new30__image,\n    .hn-new30__arrow,\n    .hn-new30__add{\n      transition-duration:.01ms !important;\n    }\n\n    .hn-new30__loader{animation:none;}\n  }\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  function initialiseNewThirtySection(root) {\n    if (!root || root.dataset.initialised === \"true\") {\n      return;\n    }\n\n    root.dataset.initialised = \"true\";\n\n    const mainLoading = root.querySelector(\".hn-new30__main-loading\");\n    const emptyMessage = root.querySelector(\".hn-new30__empty\");\n    const divider = root.querySelector(\".hn-new30__divider\");\n    const carousels = Array.from(root.querySelectorAll(\".hn-new30__carousel\"));\n    const toast = root.querySelector(\".hn-new30__toast\");\n    const toastMessage = root.querySelector(\".hn-new30__toast-message\");\n    const toastCartLink = root.querySelector(\".hn-new30__toast a\");\n\n    const topCount = Math.min(Math.max(Number(root.dataset.topCount || 15), 1), 30);\n    const bottomCount = Math.min(Math.max(Number(root.dataset.bottomCount || 15), 1), 30);\n    const totalProductCount = Math.min(topCount + bottomCount, 30);\n\n    const shopRoot =\n      window.Shopify &&\n      window.Shopify.routes &&\n      window.Shopify.routes.root\n        ? window.Shopify.routes.root\n        : \"/\";\n\n    const activeCurrency =\n      window.Shopify &&\n      window.Shopify.currency &&\n      window.Shopify.currency.active\n        ? window.Shopify.currency.active\n        : \"INR\";\n\n    const storeLanguage = document.documentElement.lang || \"en-IN\";\n    const reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n    let toastTimer = null;\n\n    function createStoreUrl(path) {\n      return shopRoot + String(path || \"\").replace(/^\\/+/, \"\");\n    }\n\n    function escapeHtml(value) {\n      return String(value == null ? \"\" : value)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#039;\");\n    }\n\n    function formatMoney(value) {\n      const amount = Number(value || 0);\n\n      try {\n        return new Intl.NumberFormat(storeLanguage, {\n          style: \"currency\",\n          currency: activeCurrency,\n          maximumFractionDigits: amount % 1 === 0 ? 0 : 2\n        }).format(amount);\n      } catch (error) {\n        return activeCurrency + \" \" + amount.toFixed(2);\n      }\n    }\n\n    function getProductTimestamp(product) {\n      if (!product) {\n        return 0;\n      }\n\n      /*\n       * created_at is used first because this section is intended\n       * to show products newly added to Shopify.\n       */\n      const possibleDates = [\n        product.created_at,\n        product.published_at,\n        product.updated_at\n      ];\n\n      for (const dateValue of possibleDates) {\n        if (!dateValue) {\n          continue;\n        }\n\n        const timestamp = new Date(dateValue).getTime();\n\n        if (!Number.isNaN(timestamp)) {\n          return timestamp;\n        }\n      }\n\n      return Number(product.id || 0);\n    }\n\n    function sortNewestProducts(productList) {\n      return productList.slice().sort(function (firstProduct, secondProduct) {\n        const timestampDifference =\n          getProductTimestamp(secondProduct) -\n          getProductTimestamp(firstProduct);\n\n        if (timestampDifference !== 0) {\n          return timestampDifference;\n        }\n\n        return Number(secondProduct.id || 0) - Number(firstProduct.id || 0);\n      });\n    }\n\n    function removeDuplicateProducts(productList) {\n      const uniqueProducts = new Map();\n\n      productList.forEach(function (product) {\n        if (!product) {\n          return;\n        }\n\n        const uniqueKey = product.id || product.handle;\n\n        if (!uniqueKey) {\n          return;\n        }\n\n        uniqueProducts.set(String(uniqueKey), product);\n      });\n\n      return Array.from(uniqueProducts.values());\n    }\n\n    function looksNewestFirst(productList) {\n      let previousTimestamp = Number.POSITIVE_INFINITY;\n      let checkedProducts = 0;\n\n      for (const product of productList) {\n        const currentTimestamp = getProductTimestamp(product);\n\n        if (!currentTimestamp) {\n          continue;\n        }\n\n        if (currentTimestamp > previousTimestamp) {\n          return false;\n        }\n\n        previousTimestamp = currentTimestamp;\n        checkedProducts += 1;\n\n        if (checkedProducts >= 40) {\n          break;\n        }\n      }\n\n      return checkedProducts >= 2;\n    }\n\n    async function requestProductPage(basePath, pageNumber, includeSort) {\n      const separator = basePath.indexOf(\"?\") === -1 ? \"?\" : \"&\";\n      const query = [\n        \"limit=250\",\n        \"page=\" + pageNumber,\n        includeSort ? \"sort_by=created-descending\" : \"\",\n        \"_=\" + Date.now() + \"-\" + pageNumber\n      ].filter(Boolean).join(\"&\");\n\n      const response = await fetch(\n        createStoreUrl(basePath + separator + query),\n        {\n          method: \"GET\",\n          cache: \"no-store\",\n          credentials: \"same-origin\",\n          headers: {\n            \"Accept\": \"application/json\",\n            \"X-Requested-With\": \"XMLHttpRequest\"\n          }\n        }\n      );\n\n      if (!response.ok) {\n        throw new Error(\"Product request failed with status \" + response.status + \".\");\n      }\n\n      const data = await response.json();\n\n      if (!data || !Array.isArray(data.products)) {\n        throw new Error(\"Shopify returned an invalid product response.\");\n      }\n\n      return data.products;\n    }\n\n    async function fetchProductsFromSource(basePath, includeSort) {\n      const pageSize = 250;\n      const maximumPages = 4;\n      const collectedProducts = [];\n\n      for (let pageNumber = 1; pageNumber <= maximumPages; pageNumber += 1) {\n        const pageProducts = await requestProductPage(\n          basePath,\n          pageNumber,\n          includeSort\n        );\n\n        if (!pageProducts.length) {\n          break;\n        }\n\n        collectedProducts.push.apply(collectedProducts, pageProducts);\n\n        /*\n         * When Shopify confirms newest-first ordering, the first 250\n         * already contain the newest 30. No extra catalog requests are needed.\n         */\n        if (\n          pageNumber === 1 &&\n          pageProducts.length === pageSize &&\n          looksNewestFirst(pageProducts)\n        ) {\n          break;\n        }\n\n        if (pageProducts.length < pageSize) {\n          break;\n        }\n      }\n\n      return removeDuplicateProducts(collectedProducts);\n    }\n\n    async function fetchNewestProducts() {\n      const sources = [\n        {\n          path: \"collections/all/products.json\",\n          includeSort: true\n        },\n        {\n          path: \"products.json\",\n          includeSort: false\n        }\n      ];\n\n      let finalError = null;\n\n      for (const source of sources) {\n        try {\n          const products = await fetchProductsFromSource(\n            source.path,\n            source.includeSort\n          );\n\n          if (products.length) {\n            console.info(\n              \"Hertha Nest latest-products section loaded \" +\n              products.length +\n              \" unique published products.\"\n            );\n\n            return products;\n          }\n        } catch (error) {\n          finalError = error;\n\n          console.warn(\n            \"Hertha Nest product source failed:\",\n            source.path,\n            error\n          );\n        }\n      }\n\n      throw finalError || new Error(\"Products could not be loaded.\");\n    }\n\n    function getAvailableVariant(product) {\n      if (!product || !Array.isArray(product.variants) || !product.variants.length) {\n        return null;\n      }\n\n      return product.variants.find(function (variant) {\n        return variant.available === true;\n      }) || product.variants[0];\n    }\n\n    function getImageSource(product, variant) {\n      if (variant && variant.featured_image && variant.featured_image.src) {\n        return variant.featured_image.src;\n      }\n\n      if (product.featured_image && typeof product.featured_image === \"string\") {\n        return product.featured_image;\n      }\n\n      if (product.featured_image && product.featured_image.src) {\n        return product.featured_image.src;\n      }\n\n      if (Array.isArray(product.images) && product.images.length) {\n        return typeof product.images[0] === \"string\"\n          ? product.images[0]\n          : product.images[0].src;\n      }\n\n      return \"\";\n    }\n\n    function optimiseImageUrl(imageUrl) {\n      if (!imageUrl) {\n        return \"\";\n      }\n\n      if (/[?&]width=/.test(imageUrl)) {\n        return imageUrl;\n      }\n\n      return imageUrl + (imageUrl.indexOf(\"?\") === -1 ? \"?\" : \"&\") + \"width=800\";\n    }\n\n    function createProductCard(product, isDuplicate) {\n      const variant = getAvailableVariant(product);\n      const productUrl = createStoreUrl(\n        \"products/\" + encodeURIComponent(product.handle || \"\")\n      );\n\n      const productTitle = escapeHtml(product.title || \"Product\");\n      const vendor = escapeHtml(product.vendor || \"\");\n      const imageSource = optimiseImageUrl(getImageSource(product, variant));\n      const available = Boolean(variant && variant.available !== false);\n      const price = variant ? formatMoney(variant.price) : \"\";\n\n      const comparePrice =\n        variant &&\n        Number(variant.compare_at_price) > Number(variant.price)\n          ? formatMoney(variant.compare_at_price)\n          : \"\";\n\n      const duplicateAttributes = isDuplicate ? ' aria-hidden=\"true\"' : \"\";\n      const duplicateTabIndex = isDuplicate ? ' tabindex=\"-1\"' : \"\";\n\n      const imageMarkup = imageSource\n        ? (\n            '<img class=\"hn-new30__image\"' +\n            ' src=\"' + escapeHtml(imageSource) + '\"' +\n            ' alt=\"' + productTitle + '\"' +\n            ' loading=\"lazy\"' +\n            ' decoding=\"async\"' +\n            ' width=\"800\"' +\n            ' height=\"800\">'\n          )\n        : (\n            '<div class=\"hn-new30__image-placeholder\">' +\n            productTitle +\n            '</div>'\n          );\n\n      const comparePriceMarkup = comparePrice\n        ? '<span class=\"hn-new30__compare-price\">' + comparePrice + '</span>'\n        : \"\";\n\n      const addButtonMarkup = variant && available\n        ? (\n            '<button type=\"button\"' +\n            ' class=\"hn-new30__add\"' +\n            ' data-variant-id=\"' + escapeHtml(variant.id) + '\"' +\n            ' data-product-title=\"' + productTitle + '\"' +\n            duplicateTabIndex +\n            '>' +\n              '<span class=\"hn-new30__cart-symbol\">' +\n                '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n                  '<path d=\"M6 7h12l-1 13H7L6 7Z\"></path>' +\n                  '<path d=\"M9 9V6a3 3 0 0 1 6 0v3\"></path>' +\n                '</svg>' +\n              '</span>' +\n              '<span class=\"hn-new30__button-text\">Add to cart</span>' +\n            '</button>'\n          )\n        : (\n            '<button type=\"button\" class=\"hn-new30__add\" disabled' +\n            duplicateTabIndex +\n            '>' +\n              '<span class=\"hn-new30__button-text\">Sold out</span>' +\n            '</button>'\n          );\n\n      return (\n        '<article class=\"hn-new30__card\"' + duplicateAttributes + '>' +\n          '<a href=\"' + productUrl + '\" class=\"hn-new30__image-link\"' + duplicateTabIndex + '>' +\n            '<span class=\"hn-new30__badge\">Just Unveiled</span>' +\n            imageMarkup +\n          '</a>' +\n\n          '<div class=\"hn-new30__content\">' +\n            (vendor ? '<div class=\"hn-new30__vendor\">' + vendor + '</div>' : '') +\n\n            '<h3 class=\"hn-new30__product-title\">' +\n              '<a href=\"' + productUrl + '\"' + duplicateTabIndex + '>' +\n                productTitle +\n              '</a>' +\n            '</h3>' +\n\n            '<div class=\"hn-new30__bottom\">' +\n              '<div class=\"hn-new30__prices\">' +\n                '<span class=\"hn-new30__price\">' + price + '</span>' +\n                comparePriceMarkup +\n              '</div>' +\n              addButtonMarkup +\n            '</div>' +\n          '</div>' +\n        '</article>'\n      );\n    }\n\n    function createCarousel(carousel, productList, autoplayDelay) {\n      if (!carousel || !productList.length) {\n        return null;\n      }\n\n      const viewport = carousel.querySelector(\".hn-new30__viewport\");\n      const track = carousel.querySelector(\".hn-new30__track\");\n      const previousButton = carousel.querySelector(\".hn-new30__previous\");\n      const nextButton = carousel.querySelector(\".hn-new30__next\");\n      const controls = carousel.querySelector(\".hn-new30__controls\");\n      const productCount = productList.length;\n\n      const originalCards = productList.map(function (product) {\n        return createProductCard(product, false);\n      }).join(\"\");\n\n      const duplicateCards = productCount > 1\n        ? productList.map(function (product) {\n            return createProductCard(product, true);\n          }).join(\"\")\n        : \"\";\n\n      track.innerHTML = originalCards + duplicateCards;\n      carousel.hidden = false;\n\n      if (productCount <= 1) {\n        controls.hidden = true;\n      }\n\n      const state = {\n        index: 0,\n        cardWidth: 0,\n        gap: 20,\n        autoplayTimer: null,\n        resetTimer: null,\n        resizeTimer: null,\n        touchStartX: 0,\n        touchEndX: 0,\n        isVisible: true\n      };\n\n      const transitionDuration = 550;\n\n      function getProductsPerView() {\n        const viewportWidth = viewport.clientWidth;\n\n        if (viewportWidth <= 580) {\n          return 1;\n        }\n\n        if (viewportWidth <= 820) {\n          return 2;\n        }\n\n        if (viewportWidth <= 1120) {\n          return 3;\n        }\n\n        return 4;\n      }\n\n      function setPosition(animate) {\n        track.style.transition = animate && !reducedMotion\n          ? \"transform .55s cubic-bezier(.22,.61,.36,1)\"\n          : \"none\";\n\n        track.style.transform =\n          \"translate3d(-\" +\n          state.index * (state.cardWidth + state.gap) +\n          \"px,0,0)\";\n      }\n\n      function updateCardSizes() {\n        const computedStyles = window.getComputedStyle(track);\n\n        state.gap = parseFloat(\n          computedStyles.columnGap ||\n          computedStyles.gap ||\n          \"20\"\n        ) || 20;\n\n        const productsPerView = Math.max(\n          1,\n          Math.min(productCount, getProductsPerView())\n        );\n\n        state.cardWidth =\n          (viewport.clientWidth - state.gap * (productsPerView - 1)) /\n          productsPerView;\n\n        track.querySelectorAll(\".hn-new30__card\").forEach(function (card) {\n          card.style.width = state.cardWidth + \"px\";\n        });\n\n        setPosition(false);\n      }\n\n      function moveNext() {\n        if (productCount <= 1) {\n          return;\n        }\n\n        window.clearTimeout(state.resetTimer);\n        state.index += 1;\n        setPosition(true);\n\n        if (state.index >= productCount) {\n          state.resetTimer = window.setTimeout(function () {\n            state.index = 0;\n            setPosition(false);\n          }, reducedMotion ? 20 : transitionDuration + 40);\n        }\n      }\n\n      function movePrevious() {\n        if (productCount <= 1) {\n          return;\n        }\n\n        window.clearTimeout(state.resetTimer);\n\n        if (state.index <= 0) {\n          state.index = productCount;\n          setPosition(false);\n\n          window.requestAnimationFrame(function () {\n            window.requestAnimationFrame(function () {\n              state.index = productCount - 1;\n              setPosition(true);\n            });\n          });\n        } else {\n          state.index -= 1;\n          setPosition(true);\n        }\n      }\n\n      function stopAutoplay() {\n        window.clearInterval(state.autoplayTimer);\n        state.autoplayTimer = null;\n      }\n\n      function startAutoplay() {\n        stopAutoplay();\n\n        if (\n          reducedMotion ||\n          productCount <= 1 ||\n          !state.isVisible ||\n          document.hidden\n        ) {\n          return;\n        }\n\n        state.autoplayTimer = window.setInterval(moveNext, autoplayDelay);\n      }\n\n      previousButton.addEventListener(\"click\", function () {\n        movePrevious();\n        startAutoplay();\n      });\n\n      nextButton.addEventListener(\"click\", function () {\n        moveNext();\n        startAutoplay();\n      });\n\n      viewport.addEventListener(\"mouseenter\", stopAutoplay);\n      viewport.addEventListener(\"mouseleave\", startAutoplay);\n      viewport.addEventListener(\"focusin\", stopAutoplay);\n      viewport.addEventListener(\"focusout\", startAutoplay);\n\n      viewport.addEventListener(\"touchstart\", function (event) {\n        state.touchStartX = event.changedTouches[0].screenX;\n        stopAutoplay();\n      }, { passive: true });\n\n      viewport.addEventListener(\"touchend\", function (event) {\n        state.touchEndX = event.changedTouches[0].screenX;\n\n        const swipeDistance = state.touchStartX - state.touchEndX;\n\n        if (Math.abs(swipeDistance) > 45) {\n          if (swipeDistance > 0) {\n            moveNext();\n          } else {\n            movePrevious();\n          }\n        }\n\n        startAutoplay();\n      }, { passive: true });\n\n      window.addEventListener(\"resize\", function () {\n        window.clearTimeout(state.resizeTimer);\n        state.resizeTimer = window.setTimeout(updateCardSizes, 120);\n      }, { passive: true });\n\n      document.addEventListener(\"visibilitychange\", function () {\n        if (document.hidden) {\n          stopAutoplay();\n        } else {\n          startAutoplay();\n        }\n      });\n\n      if (\"IntersectionObserver\" in window) {\n        const observer = new IntersectionObserver(function (entries) {\n          entries.forEach(function (entry) {\n            state.isVisible = entry.isIntersecting;\n\n            if (state.isVisible) {\n              startAutoplay();\n            } else {\n              stopAutoplay();\n            }\n          });\n        }, { threshold: 0.12 });\n\n        observer.observe(carousel);\n      }\n\n      window.requestAnimationFrame(function () {\n        updateCardSizes();\n        setPosition(false);\n        startAutoplay();\n      });\n\n      return state;\n    }\n\n    function showToast(message, isError) {\n      if (!toast || !toastMessage) {\n        return;\n      }\n\n      toastMessage.textContent = message;\n      toast.style.background = isError\n        ? \"rgba(132,48,48,.97)\"\n        : \"rgba(32,63,53,.97)\";\n\n      toast.classList.add(\"is-visible\");\n      window.clearTimeout(toastTimer);\n\n      toastTimer = window.setTimeout(function () {\n        toast.classList.remove(\"is-visible\");\n      }, 3200);\n    }\n\n    function updateThemeCartCount(itemCount) {\n      const selectors = [\n        \"[data-cart-count]\",\n        \".cart-count-bubble span[aria-hidden='true']\",\n        \".cart-count-number\",\n        \".cart-count\",\n        \"#CartCount\"\n      ];\n\n      document.querySelectorAll(selectors.join(\",\")).forEach(function (element) {\n        element.textContent = itemCount;\n        element.hidden = false;\n        element.removeAttribute(\"hidden\");\n      });\n\n      document.querySelectorAll(\".cart-count-bubble\").forEach(function (bubble) {\n        bubble.hidden = false;\n        bubble.classList.remove(\"hidden\");\n        bubble.removeAttribute(\"hidden\");\n      });\n    }\n\n    async function fetchCurrentCart() {\n      try {\n        const response = await fetch(createStoreUrl(\"cart.js\"), {\n          method: \"GET\",\n          cache: \"no-store\",\n          credentials: \"same-origin\",\n          headers: {\n            \"Accept\": \"application/json\",\n            \"X-Requested-With\": \"XMLHttpRequest\"\n          }\n        });\n\n        if (!response.ok) {\n          return null;\n        }\n\n        return await response.json();\n      } catch (error) {\n        return null;\n      }\n    }\n\n    function notifyThemeAboutCart(cart) {\n      [\"cart:updated\", \"cart:refresh\", \"cart:change\"].forEach(function (eventName) {\n        document.dispatchEvent(new CustomEvent(eventName, {\n          bubbles: true,\n          detail: { cart: cart }\n        }));\n      });\n    }\n\n    async function addProductToCart(button) {\n      const variantId = Number(button.dataset.variantId);\n      const productTitle = button.dataset.productTitle || \"Product\";\n\n      if (!variantId || button.classList.contains(\"is-loading\")) {\n        return;\n      }\n\n      const buttonText = button.querySelector(\".hn-new30__button-text\");\n      const originalText = buttonText ? buttonText.textContent : \"Add to cart\";\n\n      button.classList.add(\"is-loading\");\n\n      if (buttonText) {\n        buttonText.textContent = \"Adding...\";\n      }\n\n      try {\n        const response = await fetch(createStoreUrl(\"cart/add.js\"), {\n          method: \"POST\",\n          credentials: \"same-origin\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            \"Accept\": \"application/json\",\n            \"X-Requested-With\": \"XMLHttpRequest\"\n          },\n          body: JSON.stringify({\n            items: [\n              {\n                id: variantId,\n                quantity: 1\n              }\n            ]\n          })\n        });\n\n        const data = await response.json();\n\n        if (!response.ok) {\n          throw new Error(\n            data.description ||\n            data.message ||\n            \"This product could not be added.\"\n          );\n        }\n\n        button.classList.remove(\"is-loading\");\n        button.classList.add(\"is-added\");\n\n        if (buttonText) {\n          buttonText.textContent = \"Added\";\n        }\n\n        showToast(productTitle + \" added to your cart.\", false);\n\n        window.setTimeout(async function () {\n          const cart = await fetchCurrentCart();\n\n          if (cart) {\n            updateThemeCartCount(cart.item_count);\n            notifyThemeAboutCart(cart);\n          }\n        }, 300);\n\n        window.setTimeout(function () {\n          button.classList.remove(\"is-added\");\n\n          if (buttonText) {\n            buttonText.textContent = originalText;\n          }\n        }, 1900);\n      } catch (error) {\n        button.classList.remove(\"is-loading\");\n\n        if (buttonText) {\n          buttonText.textContent = originalText;\n        }\n\n        showToast(\n          error.message || \"This product could not be added.\",\n          true\n        );\n      }\n    }\n\n    root.addEventListener(\"click\", function (event) {\n      const addButton = event.target.closest(\".hn-new30__add\");\n\n      if (!addButton || addButton.disabled) {\n        return;\n      }\n\n      addProductToCart(addButton);\n    });\n\n    if (toastCartLink) {\n      toastCartLink.href = createStoreUrl(\"cart\");\n    }\n\n    fetchNewestProducts()\n      .then(function (fetchedProducts) {\n        const newestThirty = sortNewestProducts(fetchedProducts).slice(\n          0,\n          totalProductCount\n        );\n\n        const topProducts = newestThirty.slice(0, topCount);\n        const bottomProducts = newestThirty.slice(\n          topCount,\n          topCount + bottomCount\n        );\n\n        if (mainLoading) {\n          mainLoading.hidden = true;\n        }\n\n        if (!topProducts.length) {\n          if (emptyMessage) {\n            emptyMessage.hidden = false;\n          }\n          return;\n        }\n\n        createCarousel(carousels[0], topProducts, 3400);\n\n        if (bottomProducts.length && carousels[1]) {\n          if (divider) {\n            divider.hidden = false;\n          }\n\n          createCarousel(carousels[1], bottomProducts, 3900);\n        }\n      })\n      .catch(function (error) {\n        console.error(\"Hertha Nest latest 30 products error:\", error);\n\n        if (mainLoading) {\n          mainLoading.hidden = true;\n        }\n\n        if (emptyMessage) {\n          emptyMessage.hidden = false;\n          emptyMessage.textContent =\n            \"The newest products could not be loaded. Please refresh the page.\";\n        }\n      });\n  }\n\n  function initialiseAllNewThirtySections(scope) {\n    const searchArea = scope || document;\n\n    searchArea.querySelectorAll(\".hn-new30\").forEach(function (section) {\n      initialiseNewThirtySection(section);\n    });\n  }\n\n  initialiseAllNewThirtySections(document);\n\n  document.addEventListener(\"shopify:section:load\", function (event) {\n    initialiseAllNewThirtySections(event.target);\n  });\n})();\n</script>"
      }
    },
