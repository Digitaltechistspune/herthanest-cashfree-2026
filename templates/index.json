        "section_padding_top_xs": 0,
        "section_padding_bottom_xs": 0,
        "container": "fluid",
        "section_title": "",
        "custom_html": "<!--\n  Hertha Nest: Latest 30 Products — Two Connected Carousels\n\n  Top carousel:\n  Products 1–15\n\n  Bottom carousel:\n  Products 16–30\n\n  New products automatically move into the first position.\n  The previous 30th product automatically leaves the section.\n-->\n\n<section class=\"hn-new30\" data-top-count=\"15\" data-bottom-count=\"15\" aria-labelledby=\"hn-new30-heading\">\n  <div class=\"hn-new30__inner\">\n\n    <!-- Main heading shown only once -->\n    <header class=\"hn-new30__header\">\n\n      <span class=\"hn-new30__eyebrow\">\n        New at Hertha Nest\n      </span>\n\n      <h2 class=\"hn-new30__title\" id=\"hn-new30-heading\">\n        The New Décor Edit\n      </h2>\n\n      <p class=\"hn-new30__description\">\n        Explore our latest handcrafted additions, thoughtfully selected to\n        bring fresh character, colour and timeless charm into your home.\n      </p>\n\n    </header>\n\n    <!-- Loading state -->\n    <div class=\"hn-new30__main-loading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"hn-new30__loader\"></span>\n\n      <span>\n        Discovering our latest arrivals...\n      </span>\n    </div>\n\n    <!-- TOP CAROUSEL: PRODUCTS 1–15 -->\n    <div class=\"hn-new30__carousel hn-new30__carousel--top\" data-carousel-position=\"top\" hidden=\"\">\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next newest product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Latest fifteen products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n    </div>\n\n    <!-- Connected divider between the two carousels -->\n    <div class=\"hn-new30__divider\" hidden=\"\" aria-hidden=\"true\">\n      <span></span>\n    </div>\n\n    <!-- BOTTOM CAROUSEL: PRODUCTS 16–30 -->\n    <div class=\"hn-new30__carousel hn-new30__carousel--bottom\" data-carousel-position=\"bottom\" hidden=\"\">\n      <div class=\"hn-new30__controls\">\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__previous\" aria-label=\"View previous additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M15 18 9 12l6-6\"></path>\n          </svg>\n        </button>\n\n        <button type=\"button\" class=\"hn-new30__arrow hn-new30__next\" aria-label=\"View next additional product\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"m9 18 6-6-6-6\"></path>\n          </svg>\n        </button>\n\n      </div>\n\n      <div class=\"hn-new30__viewport\" aria-label=\"Next fifteen newly added products\">\n        <div class=\"hn-new30__track\"></div>\n      </div>\n    </div>\n\n    <!-- No products message -->\n    <div class=\"hn-new30__empty\" hidden=\"\">\n      New products will appear here as soon as they are published.\n    </div>\n\n  </div>\n\n  <!-- Add-to-cart notification -->\n  <div class=\"hn-new30__toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">\n    <span class=\"hn-new30__toast-icon\" aria-hidden=\"true\">\n      ✓\n    </span>\n\n    <span class=\"hn-new30__toast-message\">\n      Product added to your cart.\n    </span>\n\n    <a href=\"/cart\">\n      View cart\n    </a>\n  </div>\n</section>\n\n<style>\n  /*\n   * Remove spacing from Shopify's surrounding section wrapper.\n   */\n  .shopify-section:has(.hn-new30){\n    width:100% !important;\n    max-width:none !important;\n    margin-top:0 !important;\n    margin-bottom:0 !important;\n    padding-top:0 !important;\n    padding-bottom:0 !important;\n    overflow:visible !important;\n  }\n\n  .hn-new30{\n    --hn30-green:#315548;\n    --hn30-green-dark:#203f35;\n    --hn30-gold:#bd9152;\n    --hn30-gold-dark:#9f7237;\n    --hn30-white:#ffffff;\n    --hn30-heading:#29211c;\n    --hn30-text:rgba(41,33,28,.70);\n    --hn30-muted:rgba(41,33,28,.52);\n    --hn30-border:rgba(49,85,72,.14);\n    --hn30-gap:20px;\n\n    position:relative;\n    left:50%;\n\n    width:100vw;\n    max-width:100vw;\n\n    margin:0 0 30px -50vw;\n    padding:38px 0 44px;\n\n    overflow:hidden;\n\n    background:\n      radial-gradient(\n        circle at 5% 0%,\n        rgba(189,145,82,.14),\n        transparent 27%\n      ),\n      radial-gradient(\n        circle at 95% 100%,\n        rgba(49,85,72,.10),\n        transparent 28%\n      ),\n      linear-gradient(\n        135deg,\n        #f8f6ef 0%,\n        #fffdf8 48%,\n        #f4f3ec 100%\n      );\n\n    color:var(--hn30-heading);\n  }\n\n  .hn-new30 *,\n  .hn-new30 *::before,\n  .hn-new30 *::after{\n    box-sizing:border-box;\n  }\n\n  .hn-new30__inner{\n    width:100%;\n    max-width:1520px;\n    margin:0 auto;\n    padding:0 32px;\n  }\n\n  /*\n   * Main heading\n   */\n\n  .hn-new30__header{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n\n    max-width:850px;\n    margin:0 auto 22px;\n\n    text-align:center;\n  }\n\n  .hn-new30__eyebrow{\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    gap:9px;\n\n    margin:0 0 9px;\n\n    color:var(--hn30-green);\n\n    font-size:11px;\n    font-weight:750;\n    line-height:1.3;\n    letter-spacing:1.8px;\n    text-transform:uppercase;\n  }\n\n  .hn-new30__eyebrow::before,\n  .hn-new30__eyebrow::after{\n    content:\"\";\n\n    width:28px;\n    height:1px;\n\n    background:var(--hn30-gold);\n  }\n\n  .hn-new30__title{\n    margin:0;\n\n    color:var(--hn30-heading);\n\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-size:clamp(29px,3.5vw,44px);\n    font-weight:500;\n    line-height:1.12;\n    letter-spacing:-.5px;\n  }\n\n  .hn-new30__description{\n    max-width:720px;\n    margin:10px auto 0;\n\n    color:var(--hn30-text);\n\n    font-size:14px;\n    line-height:1.65;\n  }\n\n  /*\n   * Each carousel\n   */\n\n  .hn-new30__carousel{\n    width:100%;\n  }\n\n  .hn-new30__carousel[hidden]{\n    display:none !important;\n  }\n\n  .hn-new30__controls{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:9px;\n\n    min-height:41px;\n    margin:0 0 17px;\n  }\n\n  .hn-new30__arrow{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n\n    width:41px;\n    height:41px;\n    padding:0;\n\n    border:1px solid var(--hn30-border);\n    border-radius:50%;\n\n    background:rgba(255,255,255,.86);\n    color:var(--hn30-green-dark);\n\n    box-shadow:\n      0 7px 18px rgba(32,63,53,.08),\n      inset 0 1px 0 rgba(255,255,255,.9);\n\n    cursor:pointer;\n\n    transition:\n      transform .25s ease,\n      border-color .25s ease,\n      background .25s ease,\n      color .25s ease,\n      box-shadow .25s ease;\n  }\n\n  .hn-new30__arrow:hover{\n    transform:translateY(-2px);\n\n    border-color:var(--hn30-green);\n    background:var(--hn30-green);\n    color:#ffffff;\n\n    box-shadow:\n      0 10px 22px rgba(32,63,53,.18);\n  }\n\n  .hn-new30__arrow:focus-visible{\n    outline:2px solid var(--hn30-gold);\n    outline-offset:3px;\n  }\n\n  .hn-new30__arrow svg{\n    width:17px;\n    height:17px;\n\n    fill:none;\n    stroke:currentColor;\n    stroke-width:1.8;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n  }\n\n  .hn-new30__viewport{\n    width:100%;\n    overflow:hidden;\n    touch-action:pan-y;\n  }\n\n  .hn-new30__track{\n    display:flex;\n    align-items:stretch;\n    gap:var(--hn30-gap);\n\n    width:max-content;\n\n    will-change:transform;\n\n    transition:\n      transform .55s cubic-bezier(.22,.61,.36,1);\n  }\n\n  /*\n   * Divider joining the upper and lower carousels.\n   */\n\n  .hn-new30__divider{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n\n    width:100%;\n    margin:26px 0 18px;\n  }\n\n  .hn-new30__divider[hidden]{\n    display:none !important;\n  }\n\n  .hn-new30__divider span{\n    position:relative;\n\n    display:block;\n\n    width:min(620px,75%);\n    height:1px;\n\n    background:\n      linear-gradient(\n        90deg,\n        transparent,\n        rgba(49,85,72,.16),\n        rgba(189,145,82,.36),\n        rgba(49,85,72,.16),\n        transparent\n      );\n  }\n\n  .hn-new30__divider span::before{\n    content:\"\";\n\n    position:absolute;\n    top:50%;\n    left:50%;\n\n    width:7px;\n    height:7px;\n\n    border:1px solid rgba(189,145,82,.55);\n    background:#f8f6ef;\n\n    transform:\n      translate(-50%,-50%)\n      rotate(45deg);\n  }\n\n  /*\n   * Product card\n   */\n\n  .hn-new30__card{\n    position:relative;\n\n    flex:0 0 auto;\n    min-width:0;\n\n    overflow:hidden;\n\n    border:1px solid var(--hn30-border);\n    border-radius:18px;\n\n    background:var(--hn30-white);\n\n    box-shadow:\n      0 10px 25px rgba(41,33,28,.06),\n      0 2px 5px rgba(41,33,28,.025);\n\n    transition:\n      transform .3s ease,\n      border-color .3s ease,\n      box-shadow .3s ease;\n  }\n\n  .hn-new30__card:hover{\n    transform:translateY(-5px);\n\n    border-color:rgba(189,145,82,.38);\n\n    box-shadow:\n      0 18px 38px rgba(41,33,28,.11),\n      0 4px 10px rgba(41,33,28,.04);\n  }\n\n  /*\n   * Product image\n   */\n\n  .hn-new30__image-link{\n    position:relative;\n\n    display:block;\n\n    width:100%;\n    aspect-ratio:1 / 1;\n\n    overflow:hidden;\n\n    background:#f0eee7;\n  }\n\n  .hn-new30__image{\n    display:block;\n\n    width:100%;\n    height:100%;\n\n    object-fit:cover;\n\n    transition:\n      transform .65s cubic-bezier(.22,.61,.36,1);\n  }\n\n  .hn-new30__card:hover\n  .hn-new30__image{\n    transform:scale(1.05);\n  }\n\n  .hn-new30__image-placeholder{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n\n    width:100%;\n    height:100%;\n    padding:30px;\n\n    background:\n      linear-gradient(\n        135deg,\n        rgba(49,85,72,.12),\n        rgba(255,255,255,.90)\n      );\n\n    color:var(--hn30-green);\n\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-size:17px;\n    line-height:1.4;\n    text-align:center;\n  }\n\n  /*\n   * Latest product badge\n   */\n\n  .hn-new30__badge{\n    position:absolute;\n    top:12px;\n    left:12px;\n    z-index:2;\n\n    display:inline-flex;\n    align-items:center;\n    gap:7px;\n\n    min-height:28px;\n    padding:7px 11px;\n\n    border:1px solid rgba(255,255,255,.32);\n    border-radius:999px;\n\n    background:rgba(35,72,59,.93);\n    color:#ffffff;\n\n    box-shadow:\n      0 7px 18px rgba(21,46,37,.20);\n\n    backdrop-filter:blur(9px);\n    -webkit-backdrop-filter:blur(9px);\n\n    font-size:9px;\n    font-weight:750;\n    line-height:1;\n    letter-spacing:1.05px;\n    text-transform:uppercase;\n  }\n\n  .hn-new30__badge::before{\n    content:\"\";\n\n    width:6px;\n    height:6px;\n    flex:0 0 6px;\n\n    border-radius:50%;\n\n    background:#e8bd78;\n\n    box-shadow:\n      0 0 0 4px rgba(232,189,120,.16);\n  }\n\n  /*\n   * Product information\n   */\n\n  .hn-new30__content{\n    display:block;\n\n    padding:14px 15px 15px;\n  }\n\n  .hn-new30__vendor{\n    margin:0 0 5px;\n\n    overflow:hidden;\n\n    color:var(--hn30-green);\n\n    font-size:9px;\n    font-weight:750;\n    line-height:1.3;\n    letter-spacing:1.2px;\n    text-overflow:ellipsis;\n    text-transform:uppercase;\n    white-space:nowrap;\n  }\n\n  .hn-new30__product-title{\n    min-height:44px;\n    margin:0;\n\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-size:17px;\n    font-weight:500;\n    line-height:1.32;\n  }\n\n  .hn-new30__product-title a{\n    display:-webkit-box;\n\n    overflow:hidden;\n\n    color:var(--hn30-heading);\n    text-decoration:none;\n\n    -webkit-box-orient:vertical;\n    -webkit-line-clamp:2;\n\n    transition:color .22s ease;\n  }\n\n  .hn-new30__product-title a:hover{\n    color:var(--hn30-green);\n  }\n\n  /*\n   * Price and add-to-cart button\n   */\n\n  .hn-new30__bottom{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:10px;\n\n    margin-top:12px;\n    padding-top:12px;\n\n    border-top:1px solid rgba(49,85,72,.09);\n  }\n\n  .hn-new30__prices{\n    display:flex;\n    flex-direction:column;\n    align-items:flex-start;\n    gap:1px;\n\n    min-width:0;\n  }\n\n  .hn-new30__price{\n    color:var(--hn30-heading);\n\n    font-size:17px;\n    font-weight:750;\n    line-height:1.25;\n  }\n\n  .hn-new30__compare-price{\n    color:var(--hn30-muted);\n\n    font-size:11px;\n    line-height:1.25;\n    text-decoration:line-through;\n  }\n\n  .hn-new30__add{\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    gap:8px;\n\n    min-width:118px;\n    min-height:42px;\n    padding:9px 15px;\n\n    border:1px solid var(--hn30-green);\n    border-radius:999px;\n\n    background:\n      linear-gradient(\n        135deg,\n        var(--hn30-green) 0%,\n        var(--hn30-green-dark) 100%\n      );\n\n    color:#ffffff;\n\n    box-shadow:\n      0 7px 16px rgba(32,63,53,.18),\n      inset 0 1px 0 rgba(255,255,255,.13);\n\n    font-family:inherit;\n    font-size:11px;\n    font-weight:750;\n    line-height:1;\n    white-space:nowrap;\n\n    cursor:pointer;\n\n    transition:\n      transform .25s ease,\n      border-color .25s ease,\n      background .25s ease,\n      box-shadow .25s ease,\n      opacity .25s ease;\n  }\n\n  .hn-new30__add:hover{\n    transform:translateY(-2px);\n\n    border-color:var(--hn30-gold);\n\n    background:\n      linear-gradient(\n        135deg,\n        #c69a58 0%,\n        #a87738 100%\n      );\n\n    box-shadow:\n      0 9px 20px rgba(145,101,48,.23);\n  }\n\n  .hn-new30__add:focus-visible{\n    outline:2px solid var(--hn30-gold);\n    outline-offset:3px;\n  }\n\n  .hn-new30__cart-symbol{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n\n    width:20px;\n    height:20px;\n    flex:0 0 20px;\n\n    border-radius:50%;\n\n    background:rgba(255,255,255,.14);\n  }\n\n  .hn-new30__cart-symbol svg{\n    width:12px;\n    height:12px;\n\n    fill:none;\n    stroke:currentColor;\n    stroke-width:1.8;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n  }\n\n  .hn-new30__add.is-loading{\n    pointer-events:none;\n    opacity:.62;\n  }\n\n  .hn-new30__add.is-added{\n    border-color:#4f8062;\n    background:#4f8062;\n  }\n\n  .hn-new30__add:disabled{\n    min-width:105px;\n\n    transform:none;\n\n    border-color:#d2cec4;\n    background:#d2cec4;\n    color:#716e67;\n\n    box-shadow:none;\n    cursor:not-allowed;\n    opacity:.9;\n  }\n\n  /*\n   * Main loading state\n   */\n\n  .hn-new30__main-loading{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:11px;\n\n    min-height:210px;\n\n    color:var(--hn30-text);\n\n    font-size:13px;\n  }\n\n  .hn-new30__loader{\n    width:23px;\n    height:23px;\n\n    border:3px solid rgba(49,85,72,.16);\n    border-top-color:var(--hn30-green);\n    border-radius:50%;\n\n    animation:hnNew30Spin .8s linear infinite;\n  }\n\n  @keyframes hnNew30Spin{\n    to{\n      transform:rotate(360deg);\n    }\n  }\n\n  .hn-new30__empty{\n    padding:35px 20px;\n\n    border:1px solid var(--hn30-border);\n    border-radius:16px;\n\n    background:#ffffff;\n    color:var(--hn30-text);\n\n    font-size:13px;\n    line-height:1.6;\n    text-align:center;\n  }\n\n  /*\n   * Add-to-cart confirmation\n   */\n\n  .hn-new30__toast{\n    position:fixed;\n    right:20px;\n    bottom:20px;\n    z-index:999999;\n\n    display:flex;\n    align-items:center;\n    gap:10px;\n\n    max-width:min(420px,calc(100vw - 30px));\n    padding:13px 15px;\n\n    border:1px solid rgba(255,255,255,.14);\n    border-radius:13px;\n\n    background:rgba(32,63,53,.97);\n    color:#ffffff;\n\n    box-shadow:\n      0 17px 42px rgba(0,0,0,.22);\n\n    opacity:0;\n    visibility:hidden;\n\n    transform:translateY(14px);\n\n    transition:\n      opacity .3s ease,\n      visibility .3s ease,\n      transform .3s ease;\n  }\n\n  .hn-new30__toast.is-visible{\n    opacity:1;\n    visibility:visible;\n\n    transform:translateY(0);\n  }\n\n  .hn-new30__toast-icon{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n\n    width:25px;\n    height:25px;\n    flex:0 0 25px;\n\n    border-radius:50%;\n\n    background:rgba(255,255,255,.14);\n    color:#f0cb8a;\n\n    font-size:13px;\n    font-weight:800;\n  }\n\n  .hn-new30__toast-message{\n    font-size:12px;\n    font-weight:650;\n    line-height:1.4;\n  }\n\n  .hn-new30__toast a{\n    margin-left:auto;\n\n    color:#f3ce8c;\n\n    font-size:11px;\n    font-weight:750;\n    white-space:nowrap;\n\n    text-decoration:underline;\n    text-underline-offset:3px;\n  }\n\n  /*\n   * Tablet\n   */\n\n  @media (max-width:900px){\n    .hn-new30{\n      padding:32px 0 38px;\n    }\n\n    .hn-new30__inner{\n      padding:0 22px;\n    }\n\n    .hn-new30__header{\n      margin-bottom:20px;\n    }\n\n    .hn-new30__divider{\n      margin-top:23px;\n    }\n  }\n\n  /*\n   * Mobile\n   */\n\n  @media (max-width:580px){\n    .hn-new30{\n      --hn30-gap:14px;\n\n      margin-bottom:20px;\n      padding:28px 0 32px;\n    }\n\n    .hn-new30__inner{\n      padding:0 14px;\n    }\n\n    .hn-new30__header{\n      margin-bottom:17px;\n    }\n\n    .hn-new30__eyebrow{\n      margin-bottom:7px;\n\n      font-size:9px;\n      letter-spacing:1.35px;\n    }\n\n    .hn-new30__eyebrow::before,\n    .hn-new30__eyebrow::after{\n      width:20px;\n    }\n\n    .hn-new30__title{\n      font-size:29px;\n    }\n\n    .hn-new30__description{\n      margin-top:8px;\n\n      font-size:12.5px;\n      line-height:1.55;\n    }\n\n    .hn-new30__controls{\n      margin-bottom:14px;\n    }\n\n    .hn-new30__arrow{\n      width:37px;\n      height:37px;\n    }\n\n    .hn-new30__divider{\n      margin:21px 0 15px;\n    }\n\n    .hn-new30__divider span{\n      width:82%;\n    }\n\n    .hn-new30__card{\n      border-radius:16px;\n    }\n\n    .hn-new30__content{\n      padding:13px 13px 14px;\n    }\n\n    .hn-new30__product-title{\n      min-height:42px;\n\n      font-size:16px;\n    }\n\n    .hn-new30__bottom{\n      margin-top:10px;\n      padding-top:10px;\n    }\n\n    .hn-new30__price{\n      font-size:16px;\n    }\n\n    .hn-new30__add{\n      min-width:112px;\n      min-height:40px;\n      padding:8px 12px;\n\n      font-size:10.5px;\n    }\n\n    .hn-new30__toast{\n      right:14px;\n      bottom:14px;\n    }\n  }\n\n  @media (max-width:370px){\n    .hn-new30__add{\n      min-width:94px;\n      padding:8px 10px;\n    }\n\n    .hn-new30__cart-symbol{\n      display:none;\n    }\n  }\n\n  @media (prefers-reduced-motion:reduce){\n    .hn-new30__track,\n    .hn-new30__card,\n    .hn-new30__image,\n    .hn-new30__arrow,\n    .hn-new30__add{\n      transition-duration:.01ms !important;\n    }\n\n    .hn-new30__loader{\n      animation:none;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  function initialiseNewThirtySection(root) {\n    if (\n      !root ||\n      root.dataset.initialised === \"true\"\n    ) {\n      return;\n    }\n\n    root.dataset.initialised = \"true\";\n\n    const mainLoading = root.querySelector(\n      \".hn-new30__main-loading\"\n    );\n\n    const emptyMessage = root.querySelector(\n      \".hn-new30__empty\"\n    );\n\n    const divider = root.querySelector(\n      \".hn-new30__divider\"\n    );\n\n    const carouselElements = Array.from(\n      root.querySelectorAll(\n        \".hn-new30__carousel\"\n      )\n    );\n\n    const toast = root.querySelector(\n      \".hn-new30__toast\"\n    );\n\n    const toastMessage = root.querySelector(\n      \".hn-new30__toast-message\"\n    );\n\n    const toastCartLink = root.querySelector(\n      \".hn-new30__toast a\"\n    );\n\n    const topCount = Math.min(\n      Math.max(\n        Number(root.dataset.topCount || 15),\n        1\n      ),\n      30\n    );\n\n    const bottomCount = Math.min(\n      Math.max(\n        Number(root.dataset.bottomCount || 15),\n        1\n      ),\n      30\n    );\n\n    const totalProductCount =\n      topCount + bottomCount;\n\n    const shopRoot =\n      window.Shopify &&\n      window.Shopify.routes &&\n      window.Shopify.routes.root\n        ? window.Shopify.routes.root\n        : \"/\";\n\n    const activeCurrency =\n      window.Shopify &&\n      window.Shopify.currency &&\n      window.Shopify.currency.active\n        ? window.Shopify.currency.active\n        : \"INR\";\n\n    const storeLanguage =\n      document.documentElement.lang ||\n      \"en-IN\";\n\n    let toastTimer = null;\n\n    function createStoreUrl(path) {\n      const cleanPath = String(path).replace(\n        /^\\/+/,\n        \"\"\n      );\n\n      return shopRoot + cleanPath;\n    }\n\n    function escapeHtml(value) {\n      return String(value || \"\")\n        .replace(/&/g,\"&amp;\")\n        .replace(/</g,\"&lt;\")\n        .replace(/>/g,\"&gt;\")\n        .replace(/\"/g,\"&quot;\")\n        .replace(/'/g,\"&#039;\");\n    }\n\n    function formatMoney(value) {\n      const amount = Number(value || 0);\n\n      try {\n        return new Intl.NumberFormat(\n          storeLanguage,\n          {\n            style:\"currency\",\n            currency:activeCurrency,\n            maximumFractionDigits:\n              amount % 1 === 0 ? 0 : 2\n          }\n        ).format(amount);\n      } catch (error) {\n        return (\n          activeCurrency +\n          \" \" +\n          amount.toFixed(2)\n        );\n      }\n    }\n\n    function getAvailableVariant(product) {\n      if (\n        !product.variants ||\n        !product.variants.length\n      ) {\n        return null;\n      }\n\n      return (\n        product.variants.find(function (variant) {\n          return variant.available === true;\n        }) ||\n        product.variants[0]\n      );\n    }\n\n    function getImageSource(product, variant) {\n      if (\n        variant &&\n        variant.featured_image &&\n        variant.featured_image.src\n      ) {\n        return variant.featured_image.src;\n      }\n\n      if (\n        product.featured_image &&\n        typeof product.featured_image === \"string\"\n      ) {\n        return product.featured_image;\n      }\n\n      if (\n        product.featured_image &&\n        product.featured_image.src\n      ) {\n        return product.featured_image.src;\n      }\n\n      if (\n        product.images &&\n        product.images.length\n      ) {\n        return typeof product.images[0] === \"string\"\n          ? product.images[0]\n          : product.images[0].src;\n      }\n\n      return \"\";\n    }\n\n    function optimiseImageUrl(imageUrl) {\n      if (!imageUrl) {\n        return \"\";\n      }\n\n      if (imageUrl.indexOf(\"width=\") !== -1) {\n        return imageUrl;\n      }\n\n      return (\n        imageUrl +\n        (\n          imageUrl.indexOf(\"?\") === -1\n            ? \"?\"\n            : \"&\"\n        ) +\n        \"width=800\"\n      );\n    }\n\n    function createProductCard(\n      product,\n      isDuplicate\n    ) {\n      const variant =\n        getAvailableVariant(product);\n\n      const productUrl = createStoreUrl(\n        \"products/\" +\n        encodeURIComponent(product.handle)\n      );\n\n      const productTitle =\n        escapeHtml(product.title);\n\n      const vendor =\n        escapeHtml(product.vendor || \"\");\n\n      const imageSource = optimiseImageUrl(\n        getImageSource(product, variant)\n      );\n\n      const available =\n        variant &&\n        variant.available !== false;\n\n      const price = variant\n        ? formatMoney(variant.price)\n        : \"\";\n\n      const comparePrice =\n        variant &&\n        Number(variant.compare_at_price) >\n        Number(variant.price)\n          ? formatMoney(\n              variant.compare_at_price\n            )\n          : \"\";\n\n      const duplicateAttributes =\n        isDuplicate\n          ? 'aria-hidden=\"true\"'\n          : \"\";\n\n      const duplicateTabIndex =\n        isDuplicate\n          ? 'tabindex=\"-1\"'\n          : \"\";\n\n      let imageMarkup = \"\";\n\n      if (imageSource) {\n        imageMarkup =\n          '<img ' +\n            'class=\"hn-new30__image\" ' +\n            'src=\"' +\n              escapeHtml(imageSource) +\n            '\" ' +\n            'alt=\"' +\n              productTitle +\n            '\" ' +\n            'loading=\"lazy\" ' +\n            'decoding=\"async\" ' +\n            'width=\"800\" ' +\n            'height=\"800\"' +\n          \">\";\n      } else {\n        imageMarkup =\n          '<div class=\"hn-new30__image-placeholder\">' +\n            productTitle +\n          \"</div>\";\n      }\n\n      let comparePriceMarkup = \"\";\n\n      if (comparePrice) {\n        comparePriceMarkup =\n          '<span class=\"hn-new30__compare-price\">' +\n            comparePrice +\n          \"</span>\";\n      }\n\n      let addButtonMarkup = \"\";\n\n      if (variant && available) {\n        addButtonMarkup =\n          '<button ' +\n            'type=\"button\" ' +\n            'class=\"hn-new30__add\" ' +\n            'data-variant-id=\"' +\n              escapeHtml(variant.id) +\n            '\" ' +\n            'data-product-title=\"' +\n              productTitle +\n            '\" ' +\n            duplicateTabIndex +\n          \">\" +\n\n            '<span class=\"hn-new30__cart-symbol\">' +\n\n              '<svg ' +\n                'viewBox=\"0 0 24 24\" ' +\n                'aria-hidden=\"true\"' +\n              '>' +\n\n                '<path d=\"M6 7h12l-1 13H7L6 7Z\"></path>' +\n                '<path d=\"M9 9V6a3 3 0 0 1 6 0v3\"></path>' +\n\n              \"</svg>\" +\n\n            \"</span>\" +\n\n            '<span class=\"hn-new30__button-text\">' +\n              \"Add to cart\" +\n            \"</span>\" +\n\n          \"</button>\";\n      } else {\n        addButtonMarkup =\n          '<button ' +\n            'type=\"button\" ' +\n            'class=\"hn-new30__add\" ' +\n            \"disabled \" +\n            duplicateTabIndex +\n          \">\" +\n\n            '<span class=\"hn-new30__button-text\">' +\n              \"Sold out\" +\n            \"</span>\" +\n\n          \"</button>\";\n      }\n\n      return (\n        '<article ' +\n          'class=\"hn-new30__card\" ' +\n          duplicateAttributes +\n        \">\" +\n\n          '<a ' +\n            'href=\"' +\n              productUrl +\n            '\" ' +\n            'class=\"hn-new30__image-link\" ' +\n            duplicateTabIndex +\n          \">\" +\n\n            '<span class=\"hn-new30__badge\">' +\n              \"Just Unveiled\" +\n            \"</span>\" +\n\n            imageMarkup +\n\n          \"</a>\" +\n\n          '<div class=\"hn-new30__content\">' +\n\n            (\n              vendor\n                ? '<div class=\"hn-new30__vendor\">' +\n                    vendor +\n                  \"</div>\"\n                : \"\"\n            ) +\n\n            '<h3 class=\"hn-new30__product-title\">' +\n\n              '<a ' +\n                'href=\"' +\n                  productUrl +\n                '\" ' +\n                duplicateTabIndex +\n              \">\" +\n                productTitle +\n              \"</a>\" +\n\n            \"</h3>\" +\n\n            '<div class=\"hn-new30__bottom\">' +\n\n              '<div class=\"hn-new30__prices\">' +\n\n                '<span class=\"hn-new30__price\">' +\n                  price +\n                \"</span>\" +\n\n                comparePriceMarkup +\n\n              \"</div>\" +\n\n              addButtonMarkup +\n\n            \"</div>\" +\n\n          \"</div>\" +\n\n        \"</article>\"\n      );\n    }\n\n    /*\n     * Fetch the newest products.\n     *\n     * The collection request asks Shopify for newest-first products.\n     * JavaScript sorts them again as an additional safeguard.\n     */\n    async function fetchNewestProducts() {\n      const fetchLimit = Math.min(\n        Math.max(totalProductCount + 20,50),\n        250\n      );\n\n      const productUrls = [\n        createStoreUrl(\n          \"collections/all/products.json\" +\n          \"?limit=\" +\n          fetchLimit +\n          \"&sort_by=created-descending\"\n        ),\n\n        createStoreUrl(\n          \"products.json?limit=\" +\n          fetchLimit\n        )\n      ];\n\n      let finalError = null;\n\n      for (const productUrl of productUrls) {\n        try {\n          const response = await fetch(\n            productUrl,\n            {\n              method:\"GET\",\n              cache:\"no-store\",\n              headers:{\n                \"Accept\":\"application/json\",\n                \"X-Requested-With\":\n                  \"XMLHttpRequest\"\n              }\n            }\n          );\n\n          if (!response.ok) {\n            throw new Error(\n              \"Product request failed: \" +\n              response.status\n            );\n          }\n\n          const data =\n            await response.json();\n\n          if (\n            data &&\n            Array.isArray(data.products)\n          ) {\n            return data.products;\n          }\n\n        } catch (error) {\n          finalError = error;\n        }\n      }\n\n      throw (\n        finalError ||\n        new Error(\n          \"Products could not be loaded.\"\n        )\n      );\n    }\n\n    function sortNewestProducts(productList) {\n      return productList\n        .slice()\n        .sort(function (\n          firstProduct,\n          secondProduct\n        ) {\n          const firstDate = new Date(\n            firstProduct.published_at ||\n            firstProduct.created_at ||\n            0\n          ).getTime();\n\n          const secondDate = new Date(\n            secondProduct.published_at ||\n            secondProduct.created_at ||\n            0\n          ).getTime();\n\n          return secondDate - firstDate;\n        });\n    }\n\n    /*\n     * Create one independent infinite carousel.\n     */\n    function createCarousel(\n      carousel,\n      productList,\n      autoplayDelay\n    ) {\n      if (\n        !carousel ||\n        !productList.length\n      ) {\n        return null;\n      }\n\n      const viewport = carousel.querySelector(\n        \".hn-new30__viewport\"\n      );\n\n      const track = carousel.querySelector(\n        \".hn-new30__track\"\n      );\n\n      const previousButton = carousel.querySelector(\n        \".hn-new30__previous\"\n      );\n\n      const nextButton = carousel.querySelector(\n        \".hn-new30__next\"\n      );\n\n      const controls = carousel.querySelector(\n        \".hn-new30__controls\"\n      );\n\n      const productCount =\n        productList.length;\n\n      const originalCards = productList\n        .map(function (product) {\n          return createProductCard(\n            product,\n            false\n          );\n        })\n        .join(\"\");\n\n      const duplicateCards =\n        productCount > 1\n          ? productList\n              .map(function (product) {\n                return createProductCard(\n                  product,\n                  true\n                );\n              })\n              .join(\"\")\n          : \"\";\n\n      track.innerHTML =\n        originalCards + duplicateCards;\n\n      carousel.hidden = false;\n\n      if (productCount <= 1) {\n        controls.hidden = true;\n      }\n\n      const state = {\n        index:0,\n        cardWidth:0,\n        gap:20,\n        autoplayTimer:null,\n        resetTimer:null,\n        resizeTimer:null,\n        touchStartX:0,\n        touchEndX:0,\n        isVisible:true\n      };\n\n      const transitionDuration = 550;\n\n      function getProductsPerView() {\n        const viewportWidth =\n          viewport.clientWidth;\n\n        if (viewportWidth <= 580) {\n          return 1;\n        }\n\n        if (viewportWidth <= 820) {\n          return 2;\n        }\n\n        if (viewportWidth <= 1120) {\n          return 3;\n        }\n\n        return 4;\n      }\n\n      function setPosition(animate) {\n        track.style.transition = animate\n          ? (\n              \"transform .55s \" +\n              \"cubic-bezier(.22,.61,.36,1)\"\n            )\n          : \"none\";\n\n        track.style.transform =\n          \"translate3d(-\" +\n          state.index *\n            (state.cardWidth + state.gap) +\n          \"px,0,0)\";\n      }\n\n      function updateCardSizes() {\n        const computedStyles =\n          window.getComputedStyle(track);\n\n        state.gap =\n          parseFloat(\n            computedStyles.columnGap ||\n            computedStyles.gap ||\n            \"20\"\n          ) || 20;\n\n        const productsPerView =\n          getProductsPerView();\n\n        state.cardWidth =\n          (\n            viewport.clientWidth -\n            state.gap *\n              (productsPerView - 1)\n          ) /\n          productsPerView;\n\n        track\n          .querySelectorAll(\n            \".hn-new30__card\"\n          )\n          .forEach(function (card) {\n            card.style.width =\n              state.cardWidth + \"px\";\n          });\n\n        setPosition(false);\n      }\n\n      function moveNext() {\n        if (productCount <= 1) {\n          return;\n        }\n\n        window.clearTimeout(\n          state.resetTimer\n        );\n\n        state.index += 1;\n\n        setPosition(true);\n\n        if (\n          state.index >= productCount\n        ) {\n          state.resetTimer =\n            window.setTimeout(\n              function () {\n                state.index = 0;\n\n                setPosition(false);\n\n                window.requestAnimationFrame(\n                  function () {\n                    window.requestAnimationFrame(\n                      function () {\n                        track.style.transition =\n                          \"transform .55s \" +\n                          \"cubic-bezier\" +\n                          \"(.22,.61,.36,1)\";\n                      }\n                    );\n                  }\n                );\n              },\n              transitionDuration + 40\n            );\n        }\n      }\n\n      function movePrevious() {\n        if (productCount <= 1) {\n          return;\n        }\n\n        window.clearTimeout(\n          state.resetTimer\n        );\n\n        if (state.index <= 0) {\n          state.index =\n            productCount;\n\n          setPosition(false);\n\n          window.requestAnimationFrame(\n            function () {\n              window.requestAnimationFrame(\n                function () {\n                  state.index =\n                    productCount - 1;\n\n                  setPosition(true);\n                }\n              );\n            }\n          );\n        } else {\n          state.index -= 1;\n\n          setPosition(true);\n        }\n      }\n\n      function stopAutoplay() {\n        window.clearInterval(\n          state.autoplayTimer\n        );\n\n        state.autoplayTimer = null;\n      }\n\n      function startAutoplay() {\n        stopAutoplay();\n\n        if (\n          productCount <= 1 ||\n          !state.isVisible ||\n          document.hidden\n        ) {\n          return;\n        }\n\n        state.autoplayTimer =\n          window.setInterval(\n            moveNext,\n            autoplayDelay\n          );\n      }\n\n      previousButton.addEventListener(\n        \"click\",\n        function () {\n          movePrevious();\n          startAutoplay();\n        }\n      );\n\n      nextButton.addEventListener(\n        \"click\",\n        function () {\n          moveNext();\n          startAutoplay();\n        }\n      );\n\n      viewport.addEventListener(\n        \"mouseenter\",\n        stopAutoplay\n      );\n\n      viewport.addEventListener(\n        \"mouseleave\",\n        startAutoplay\n      );\n\n      viewport.addEventListener(\n        \"focusin\",\n        stopAutoplay\n      );\n\n      viewport.addEventListener(\n        \"focusout\",\n        startAutoplay\n      );\n\n      viewport.addEventListener(\n        \"touchstart\",\n        function (event) {\n          state.touchStartX =\n            event.changedTouches[0].screenX;\n\n          stopAutoplay();\n        },\n        {\n          passive:true\n        }\n      );\n\n      viewport.addEventListener(\n        \"touchend\",\n        function (event) {\n          state.touchEndX =\n            event.changedTouches[0].screenX;\n\n          const swipeDistance =\n            state.touchStartX -\n            state.touchEndX;\n\n          if (\n            Math.abs(swipeDistance) > 45\n          ) {\n            if (swipeDistance > 0) {\n              moveNext();\n            } else {\n              movePrevious();\n            }\n          }\n\n          startAutoplay();\n        },\n        {\n          passive:true\n        }\n      );\n\n      window.addEventListener(\n        \"resize\",\n        function () {\n          window.clearTimeout(\n            state.resizeTimer\n          );\n\n          state.resizeTimer =\n            window.setTimeout(\n              updateCardSizes,\n              120\n            );\n        },\n        {\n          passive:true\n        }\n      );\n\n      document.addEventListener(\n        \"visibilitychange\",\n        function () {\n          if (document.hidden) {\n            stopAutoplay();\n          } else {\n            startAutoplay();\n          }\n        }\n      );\n\n      if (\n        \"IntersectionObserver\" in window\n      ) {\n        const observer =\n          new IntersectionObserver(\n            function (entries) {\n              entries.forEach(\n                function (entry) {\n                  state.isVisible =\n                    entry.isIntersecting;\n\n                  if (state.isVisible) {\n                    startAutoplay();\n                  } else {\n                    stopAutoplay();\n                  }\n                }\n              );\n            },\n            {\n              threshold:.12\n            }\n          );\n\n        observer.observe(carousel);\n      }\n\n      window.requestAnimationFrame(\n        function () {\n          updateCardSizes();\n          setPosition(false);\n          startAutoplay();\n        }\n      );\n\n      return state;\n    }\n\n    function showToast(message, isError) {\n      if (!toast) {\n        return;\n      }\n\n      toastMessage.textContent =\n        message;\n\n      toast.style.background = isError\n        ? \"rgba(132,48,48,.97)\"\n        : \"rgba(32,63,53,.97)\";\n\n      toast.classList.add(\n        \"is-visible\"\n      );\n\n      window.clearTimeout(\n        toastTimer\n      );\n\n      toastTimer =\n        window.setTimeout(\n          function () {\n            toast.classList.remove(\n              \"is-visible\"\n            );\n          },\n          3200\n        );\n    }\n\n    function updateThemeCartCount(itemCount) {\n      const selectors = [\n        \"[data-cart-count]\",\n        \".cart-count-bubble \" +\n          \"span[aria-hidden='true']\",\n        \".cart-count-number\",\n        \".cart-count\",\n        \"#CartCount\"\n      ];\n\n      document\n        .querySelectorAll(\n          selectors.join(\",\")\n        )\n        .forEach(function (element) {\n          element.textContent =\n            itemCount;\n\n          element.hidden = false;\n\n          element.removeAttribute(\n            \"hidden\"\n          );\n        });\n\n      document\n        .querySelectorAll(\n          \".cart-count-bubble\"\n        )\n        .forEach(function (bubble) {\n          bubble.hidden = false;\n\n          bubble.classList.remove(\n            \"hidden\"\n          );\n\n          bubble.removeAttribute(\n            \"hidden\"\n          );\n        });\n    }\n\n    async function fetchCurrentCart() {\n      try {\n        const response = await fetch(\n          createStoreUrl(\"cart.js\"),\n          {\n            method:\"GET\",\n            headers:{\n              \"Accept\":\"application/json\",\n              \"X-Requested-With\":\n                \"XMLHttpRequest\"\n            }\n          }\n        );\n\n        if (!response.ok) {\n          return null;\n        }\n\n        return await response.json();\n\n      } catch (error) {\n        return null;\n      }\n    }\n\n    function notifyThemeAboutCart(cart) {\n      [\n        \"cart:updated\",\n        \"cart:refresh\",\n        \"cart:change\"\n      ].forEach(function (eventName) {\n        document.dispatchEvent(\n          new CustomEvent(\n            eventName,\n            {\n              bubbles:true,\n              detail:{\n                cart:cart\n              }\n            }\n          )\n        );\n      });\n    }\n\n    async function addProductToCart(button) {\n      const variantId =\n        Number(button.dataset.variantId);\n\n      const productTitle =\n        button.dataset.productTitle ||\n        \"Product\";\n\n      if (\n        !variantId ||\n        button.classList.contains(\n          \"is-loading\"\n        )\n      ) {\n        return;\n      }\n\n      const buttonText =\n        button.querySelector(\n          \".hn-new30__button-text\"\n        );\n\n      const originalText = buttonText\n        ? buttonText.textContent\n        : \"Add to cart\";\n\n      button.classList.add(\n        \"is-loading\"\n      );\n\n      if (buttonText) {\n        buttonText.textContent =\n          \"Adding...\";\n      }\n\n      try {\n        const response = await fetch(\n          createStoreUrl(\"cart/add.js\"),\n          {\n            method:\"POST\",\n            headers:{\n              \"Content-Type\":\n                \"application/json\",\n              \"Accept\":\n                \"application/json\",\n              \"X-Requested-With\":\n                \"XMLHttpRequest\"\n            },\n            body:JSON.stringify({\n              items:[\n                {\n                  id:variantId,\n                  quantity:1\n                }\n              ]\n            })\n          }\n        );\n\n        const data =\n          await response.json();\n\n        if (!response.ok) {\n          throw new Error(\n            data.description ||\n            data.message ||\n            \"This product could not be added.\"\n          );\n        }\n\n        button.classList.remove(\n          \"is-loading\"\n        );\n\n        button.classList.add(\n          \"is-added\"\n        );\n\n        if (buttonText) {\n          buttonText.textContent =\n            \"Added\";\n        }\n\n        showToast(\n          productTitle +\n          \" added to your cart.\",\n          false\n        );\n\n        window.setTimeout(\n          async function () {\n            const cart =\n              await fetchCurrentCart();\n\n            if (cart) {\n              updateThemeCartCount(\n                cart.item_count\n              );\n\n              notifyThemeAboutCart(\n                cart\n              );\n            }\n          },\n          300\n        );\n\n        window.setTimeout(\n          function () {\n            button.classList.remove(\n              \"is-added\"\n            );\n\n            if (buttonText) {\n              buttonText.textContent =\n                originalText;\n            }\n          },\n          1900\n        );\n\n      } catch (error) {\n        button.classList.remove(\n          \"is-loading\"\n        );\n\n        if (buttonText) {\n          buttonText.textContent =\n            originalText;\n        }\n\n        showToast(\n          error.message ||\n          \"This product could not be added.\",\n          true\n        );\n      }\n    }\n\n    /*\n     * One delegated add-to-cart listener handles both carousels.\n     */\n    root.addEventListener(\n      \"click\",\n      function (event) {\n        const addButton =\n          event.target.closest(\n            \".hn-new30__add\"\n          );\n\n        if (\n          !addButton ||\n          addButton.disabled\n        ) {\n          return;\n        }\n\n        addProductToCart(\n          addButton\n        );\n      }\n    );\n\n    if (toastCartLink) {\n      toastCartLink.href =\n        createStoreUrl(\"cart\");\n    }\n\n    /*\n     * Fetch once, sort once, then split:\n     *\n     * 1–15  = top carousel\n     * 16–30 = bottom carousel\n     */\n    fetchNewestProducts()\n      .then(function (fetchedProducts) {\n        const newestThirty =\n          sortNewestProducts(\n            fetchedProducts\n          ).slice(\n            0,\n            totalProductCount\n          );\n\n        const topProducts =\n          newestThirty.slice(\n            0,\n            topCount\n          );\n\n        const bottomProducts =\n          newestThirty.slice(\n            topCount,\n            topCount + bottomCount\n          );\n\n        mainLoading.hidden = true;\n\n        if (!topProducts.length) {\n          emptyMessage.hidden = false;\n          return;\n        }\n\n        createCarousel(\n          carouselElements[0],\n          topProducts,\n          3400\n        );\n\n        if (\n          bottomProducts.length &&\n          carouselElements[1]\n        ) {\n          divider.hidden = false;\n\n          createCarousel(\n            carouselElements[1],\n            bottomProducts,\n            3900\n          );\n        }\n      })\n      .catch(function (error) {\n        console.error(\n          \"Hertha Nest latest 30 products error:\",\n          error\n        );\n\n        mainLoading.hidden = true;\n        emptyMessage.hidden = false;\n\n        emptyMessage.textContent =\n          \"The newest products could not be loaded.\";\n      });\n  }\n\n  function initialiseAllNewThirtySections(\n    scope\n  ) {\n    const searchArea =\n      scope || document;\n\n    searchArea\n      .querySelectorAll(\n        \".hn-new30\"\n      )\n      .forEach(function (section) {\n        initialiseNewThirtySection(\n          section\n        );\n      });\n  }\n\n  initialiseAllNewThirtySections(\n    document\n  );\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    function (event) {\n      initialiseAllNewThirtySections(\n        event.target\n      );\n    }\n  );\n})();\n</script>"
      }
    },
