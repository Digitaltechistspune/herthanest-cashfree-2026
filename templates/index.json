    width\n                )\n              ) +\n              \" \" +\n              width +\n              \"w\"\n            );\n\n          }\n        )\n        .join(\", \");\n\n    }\n\n\n\n    function firstVariant(product) {\n\n      if (\n        !product ||\n        !Array.isArray(product.variants) ||\n        !product.variants.length\n      ) {\n        return null;\n      }\n\n\n      return (\n        product.variants.find(\n          function (variant) {\n            return (\n              variant.available === true\n            );\n          }\n        ) ||\n        product.variants[0]\n      );\n\n    }\n\n\n\n    function renderCard(\n      product,\n      duplicate\n    ) {\n\n      var variant =\n        firstVariant(product);\n\n\n      var title =\n        escapeHtml(\n          product.title ||\n          \"Wooden Toy\"\n        );\n\n\n      var vendor =\n        escapeHtml(\n          product.vendor ||\n          \"Hertha Nest\"\n        );\n\n\n      var productUrl =\n        storeUrl(\n          \"products/\" +\n          encodeURIComponent(\n            product.handle ||\n            \"\"\n          )\n        );\n\n\n      var image =\n        productImage(product);\n\n\n      var available =\n        Boolean(\n          variant &&\n          variant.available !== false\n        );\n\n\n      var price =\n        variant\n          ? formatMoney(\n              variant.price\n            )\n          : \"\";\n\n\n      var compare =\n\n        variant &&\n        Number(\n          variant.compare_at_price\n        ) >\n        Number(\n          variant.price\n        )\n\n          ? formatMoney(\n              variant.compare_at_price\n            )\n\n          : \"\";\n\n\n      var duplicateAria =\n        duplicate\n          ? ' aria-hidden=\"true\"'\n          : \"\";\n\n\n      var duplicateTabindex =\n        duplicate\n          ? ' tabindex=\"-1\"'\n          : \"\";\n\n\n      var imageMarkup =\n        image\n\n          ? (\n            '<img' +\n            ' class=\"hn-toys__image\"' +\n            ' src=\"' +\n            escapeHtml(\n              imageAtWidth(\n                image,\n                480\n              )\n            ) +\n            '\"' +\n            ' srcset=\"' +\n            srcSet(image) +\n            '\"' +\n            ' sizes=\"' +\n            '(max-width: 580px) calc(100vw - 28px), ' +\n            '(max-width: 820px) calc((100vw - 46px) / 2), ' +\n            '(max-width: 1050px) calc((100vw - 80px) / 3), ' +\n            '360px' +\n            '\"' +\n            ' alt=\"' +\n            title +\n            '\"' +\n            ' loading=\"lazy\"' +\n            ' decoding=\"async\"' +\n            ' width=\"600\"' +\n            ' height=\"600\"' +\n            '>'\n          )\n\n          : (\n            '<div class=\"hn-toys__image-placeholder\">' +\n            title +\n            '</div>'\n          );\n\n\n      var compareMarkup =\n        compare\n\n          ? (\n            '<span class=\"hn-toys__compare\">' +\n            compare +\n            '</span>'\n          )\n\n          : \"\";\n\n\n      var soldOutMarkup =\n        available\n\n          ? \"\"\n\n          : (\n            '<span class=\"hn-toys__sold-out\">' +\n            'Sold Out' +\n            '</span>'\n          );\n\n\n      return (\n        '<article class=\"hn-toys__card\"' +\n        duplicateAria +\n        '>' +\n\n          '<a' +\n          ' class=\"hn-toys__image-link\"' +\n          ' href=\"' +\n          productUrl +\n          '\"' +\n          duplicateTabindex +\n          ' aria-label=\"View ' +\n          title +\n          '\"' +\n          '>' +\n\n            '<span class=\"hn-toys__badge\">' +\n            'Wooden Play' +\n            '</span>' +\n\n            soldOutMarkup +\n\n            imageMarkup +\n\n          '</a>' +\n\n\n          '<div class=\"hn-toys__card-content\">' +\n\n            '<div class=\"hn-toys__vendor\">' +\n            vendor +\n            '</div>' +\n\n            '<h3 class=\"hn-toys__product-title\">' +\n\n              '<a href=\"' +\n              productUrl +\n              '\"' +\n              duplicateTabindex +\n              '>' +\n              title +\n              '</a>' +\n\n            '</h3>' +\n\n\n            '<div class=\"hn-toys__card-bottom\">' +\n\n              '<div class=\"hn-toys__prices\">' +\n\n                '<span class=\"hn-toys__price\">' +\n                price +\n                '</span>' +\n\n                compareMarkup +\n\n              '</div>' +\n\n\n              '<a' +\n              ' class=\"hn-toys__product-link\"' +\n              ' href=\"' +\n              productUrl +\n              '\"' +\n              duplicateTabindex +\n              '>' +\n              'View Product' +\n              '</a>' +\n\n            '</div>' +\n\n          '</div>' +\n\n        '</article>'\n      );\n\n    }\n\n\n\n    async function loadCollection() {\n\n      try {\n\n        var response =\n          await fetch(\n            storeUrl(\n              \"collections/\" +\n              encodeURIComponent(handle) +\n              \"/products.json?limit=50\"\n            ),\n            {\n              method:\n                \"GET\",\n\n              credentials:\n                \"same-origin\",\n\n              headers:\n                {\n                  \"Accept\":\n                    \"application/json\",\n\n                  \"X-Requested-With\":\n                    \"XMLHttpRequest\"\n                }\n            }\n          );\n\n\n        if (!response.ok) {\n\n          throw new Error(\n            \"Collection request failed.\"\n          );\n\n        }\n\n\n        var data =\n          await response.json();\n\n\n        if (\n          !data ||\n          !Array.isArray(data.products)\n        ) {\n\n          throw new Error(\n            \"Invalid collection response.\"\n          );\n\n        }\n\n\n        var products =\n          data.products;\n\n\n        loading.hidden =\n          true;\n\n\n        count.textContent =\n\n          products.length +\n\n          (\n            products.length === 1\n              ? \" curated piece\"\n              : \" curated pieces\"\n          );\n\n\n        if (!products.length) {\n\n          empty.hidden =\n            false;\n\n          controls.hidden =\n            true;\n\n          return;\n\n        }\n\n\n        buildInfiniteCarousel(\n          products\n        );\n\n\n      } catch (error) {\n\n\n        loading.hidden =\n          true;\n\n\n        empty.hidden =\n          false;\n\n\n        controls.hidden =\n          true;\n\n\n        count.textContent =\n          \"Wooden Kids Toys\";\n\n\n        console.warn(\n          \"Hertha Nest wooden toys collection section:\",\n          error\n        );\n\n      }\n\n    }\n\n\n\n    function buildInfiniteCarousel(products) {\n\n      var productCount =\n        products.length;\n\n\n      var cloneCount =\n        Math.min(\n          4,\n          productCount\n        );\n\n\n      var leadingProducts =\n        productCount > 1\n          ? products.slice(\n              productCount -\n              cloneCount\n            )\n          : [];\n\n\n      var trailingProducts =\n        productCount > 1\n          ? products.slice(\n              0,\n              cloneCount\n            )\n          : [];\n\n\n      var leadingMarkup =\n        leadingProducts\n          .map(\n            function (product) {\n              return renderCard(\n                product,\n                true\n              );\n            }\n          )\n          .join(\"\");\n\n\n      var originalMarkup =\n        products\n          .map(\n            function (product) {\n              return renderCard(\n                product,\n                false\n              );\n            }\n          )\n          .join(\"\");\n\n\n      var trailingMarkup =\n        t