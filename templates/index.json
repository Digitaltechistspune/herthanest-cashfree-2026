        "custom_html": "<!-- =========================================================\nHERTHA NEST — PREMIUM HERO PRODUCT SHOWCASE\nCUSTOM HTML — NO LIQUID REQUIRED\n\n==============================================================\nEASY FUTURE EDITING\n==============================================================\n\n1. PRODUCT URL:\n   Search:\n   EDIT PRODUCT URL HERE\n\n2. PRODUCT IMAGE:\n   Search:\n   EDIT PRODUCT IMAGE HERE\n\nYou only need to update those two places if you change\nthe featured product later.\n\n============================================================== -->\n\n\n<section class=\"hnhero-product\" id=\"hnheroProduct\" edit=\"\" product=\"\" url=\"\" here=\"\" change=\"\" only=\"\" this=\"\" when=\"\" using=\"\" another=\"\" product.=\"=====================================================\">\n  data-product-url=\"https://herthanest.in/collections/festival-specials/products/xs\"\n\n  aria-labelledby=\"hnheroTitle\"\n&gt;\n\n\n  <!-- =====================================================\n       BACKGROUND DECORATION\n  ====================================================== -->\n\n  <div class=\"hnhero-bg\" aria-hidden=\"true\">\n\n    <span class=\"hnhero-glow hnhero-glow-1\"></span>\n\n    <span class=\"hnhero-glow hnhero-glow-2\"></span>\n\n    <span class=\"hnhero-arch hnhero-arch-1\"></span>\n\n    <span class=\"hnhero-arch hnhero-arch-2\"></span>\n\n    <span class=\"hnhero-pattern hnhero-pattern-1\"></span>\n\n    <span class=\"hnhero-pattern hnhero-pattern-2\"></span>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       MAIN HERO\n  ====================================================== -->\n\n  <div class=\"hnhero-inner\">\n\n\n    <!-- =====================================================\n         LEFT CONTENT\n    ====================================================== -->\n\n    <div class=\"hnhero-content\">\n\n\n      <!-- EYEBROW -->\n\n      <div class=\"hnhero-eyebrow\">\n\n        <span class=\"hnhero-eyebrow-line\"></span>\n\n        <span>\n          HERTHA NEST SIGNATURE\n        </span>\n\n      </div>\n\n\n\n      <!-- INTRO -->\n\n      <p class=\"hnhero-kicker\">\n        Where craftsmanship becomes character.\n      </p>\n\n\n\n      <!-- PRODUCT TITLE -->\n\n      <h2 class=\"hnhero-title\" id=\"hnheroTitle\">\n\n        <span class=\"hnhero-title-main\" id=\"hnheroTitleMain\">\n          Handcrafted\n        </span>\n\n        <em id=\"hnheroTitleAccent\">\n          Elephant Chowki\n        </em>\n\n      </h2>\n\n\n\n      <!-- ORNAMENT -->\n\n      <div class=\"hnhero-ornament\" aria-hidden=\"true\">\n\n        <span></span>\n\n        <i></i>\n\n        <span></span>\n\n      </div>\n\n\n\n      <!-- PRICE + AVAILABILITY -->\n\n      <div class=\"hnhero-price-row\">\n\n\n        <span class=\"hnhero-price\" id=\"hnheroPrice\">\n          Loading...\n        </span>\n\n\n        <span class=\"hnhero-compare-price\" id=\"hnheroComparePrice\" hidden=\"\"></span>\n\n\n        <span class=\"hnhero-stock\" id=\"hnheroStock\">\n          Checking availability\n        </span>\n\n\n      </div>\n\n\n\n      <!-- DESCRIPTION -->\n\n      <p class=\"hnhero-description\">\n\n        A vibrant statement piece inspired by Indian artistry,\n        bringing together expressive hand-painted details, functional\n        design and heritage character for a home that feels truly unique.\n\n      </p>\n\n\n\n      <!-- =====================================================\n           PREMIUM PRODUCT DETAIL CARDS\n      ====================================================== -->\n\n      <div class=\"hnhero-specs\">\n\n\n        <!-- SPEC 1 -->\n\n        <div class=\"hnhero-spec-card\">\n\n          <span class=\"hnhero-spec-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n              <path d=\"M4 5h16v14H4V5Zm4 0v4M4 9h4M16 5v4m0 0h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n            </svg>\n\n          </span>\n\n\n          <span class=\"hnhero-spec-copy\">\n\n            <small>\n              FORM\n            </small>\n\n            <strong>\n              Functional Décor\n            </strong>\n\n            <em>\n              Beautiful &amp; useful\n            </em>\n\n          </span>\n\n        </div>\n\n\n\n        <!-- SPEC 2 -->\n\n        <div class=\"hnhero-spec-card\">\n\n          <span class=\"hnhero-spec-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n              <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n            </svg>\n\n          </span>\n\n\n          <span class=\"hnhero-spec-copy\">\n\n            <small>\n              STYLE\n            </small>\n\n            <strong>\n              Heritage Inspired\n            </strong>\n\n            <em>\n              Rooted in Indian art\n            </em>\n\n          </span>\n\n        </div>\n\n\n\n        <!-- SPEC 3 -->\n\n        <div class=\"hnhero-spec-card\">\n\n          <span class=\"hnhero-spec-icon\">\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n              <path d=\"M5 6h14v12H5V6Zm3 3h8M8 13h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n            </svg>\n\n          </span>\n\n\n          <span class=\"hnhero-spec-copy\">\n\n            <small>\n              CRAFT\n            </small>\n\n            <strong>\n              Hand-Painted Finish\n            </strong>\n\n            <em>\n              Rich artisan detailing\n            </em>\n\n          </span>\n\n        </div>\n\n\n      </div>\n\n\n\n      <!-- =====================================================\n           CTA\n      ====================================================== -->\n\n      <div class=\"hnhero-actions\">\n\n\n        <a class=\"hnhero-primary-button\" id=\"hnheroProductButton\" href=\"https://herthanest.in/collections/festival-specials/products/xs\">\n\n          <span>\n            View Product Details\n          </span>\n\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </a>\n\n\n\n        <a class=\"hnhero-secondary-link\" href=\"https://herthanest.in/collections/festival-specials\">\n\n          Explore Festival Specials\n\n          <span aria-hidden=\"true\">\n            ↗\n          </span>\n\n        </a>\n\n\n      </div>\n\n\n\n      <!-- TRUST MESSAGE -->\n\n      <div class=\"hnhero-trust\">\n\n        <span class=\"hnhero-trust-star\">\n          ✦\n        </span>\n\n        <p>\n          Statement décor for spaces that deserve\n          <strong>something extraordinary.</strong>\n        </p>\n\n      </div>\n\n\n    </div>\n\n\n\n    <!-- =====================================================\n         RIGHT — PRODUCT STAGE\n    ====================================================== -->\n\n    <div class=\"hnhero-visual\">\n\n\n      <!-- HANDCRAFTED BADGE -->\n\n      <div class=\"hnhero-badge\">\n\n        <span class=\"hnhero-badge-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          HANDCRAFTED\n\n          <strong>\n            INDIAN ARTISTRY\n          </strong>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- VERTICAL PRICE -->\n\n      <div class=\"hnhero-side-price\" id=\"hnheroSidePrice\" aria-hidden=\"true\"></div>\n\n\n\n      <!-- =====================================================\n           PRODUCT IMAGE\n\n           EDIT PRODUCT IMAGE HERE\n\n           Change only src=\"\" when changing product.\n      ====================================================== -->\n\n      <a class=\"hnhero-image-link\" id=\"hnheroImageLink\" href=\"https://herthanest.in/collections/festival-specials/products/xs\" aria-label=\"View featured Hertha Nest product\">\n\n        <img class=\"hnhero-image\" id=\"hnheroImage\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/0_72539fff-d896-423b-b112-d19fab87a411.png?v=1788944054\" width=\"1100\" height=\"1100\" alt=\"Handcrafted Hertha Nest Elephant Chowki\">\n\n      </a>\n\n\n\n      <!-- PRODUCT SHADOW -->\n\n      <span class=\"hnhero-floor-shadow\" aria-hidden=\"true\"></span>\n\n\n\n      <!-- =====================================================\n           PREMIUM PODIUM\n      ====================================================== -->\n\n      <div class=\"hnhero-podium\" aria-hidden=\"true\">\n\n        <div class=\"hnhero-podium-top\"></div>\n\n        <div class=\"hnhero-podium-edge\"></div>\n\n        <div class=\"hnhero-podium-body\"></div>\n\n        <div class=\"hnhero-podium-highlight\"></div>\n\n      </div>\n\n\n\n      <!-- FLOATING STORY CARD -->\n\n      <div class=\"hnhero-floating-card\">\n\n        <span class=\"hnhero-floating-icon\">\n          ✦\n        </span>\n\n\n        <span>\n\n          Made to become\n\n          <strong>\n            the conversation piece.\n          </strong>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- DECORATIVE HALO -->\n\n      <span class=\"hnhero-halo hnhero-halo-1\" aria-hidden=\"true\"></span>\n\n      <span class=\"hnhero-halo hnhero-halo-2\" aria-hidden=\"true\"></span>\n\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       PREMIUM BOTTOM FEATURE BAR\n  ====================================================== -->\n\n  <div class=\"hnhero-benefit-wrap\">\n\n    <div class=\"hnhero-benefits\">\n\n\n      <!-- BENEFIT 1 -->\n\n      <div class=\"hnhero-benefit\">\n\n        <span class=\"hnhero-benefit-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          <small>\n            DESIGN\n          </small>\n\n          <strong>\n            Heritage Inspired\n          </strong>\n\n          <em>\n            Crafted with character\n          </em>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- BENEFIT 2 -->\n\n      <div class=\"hnhero-benefit\">\n\n        <span class=\"hnhero-benefit-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M5 6h14v12H5V6Zm3 3h8M8 13h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          <small>\n            CRAFT\n          </small>\n\n          <strong>\n            Artisan Finish\n          </strong>\n\n          <em>\n            Rich hand-painted detail\n          </em>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- BENEFIT 3 -->\n\n      <div class=\"hnhero-benefit\">\n\n        <span class=\"hnhero-benefit-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M4 5h16v14H4V5m4 0v4M4 9h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          <small>\n            FUNCTION\n          </small>\n\n          <strong>\n            Décor With Purpose\n          </strong>\n\n          <em>\n            Beautiful and functional\n          </em>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- BENEFIT 4 -->\n\n      <div class=\"hnhero-benefit\">\n\n        <span class=\"hnhero-benefit-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M4 10h16v10H4V10Zm-1-4h18v4H3V6Zm9 14V6m0 0c-1-4-6-4-6-1 0 2 3 2 6 1Zm0 0c1-4 6-4 6-1 0 2-3 2-6 1Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          <small>\n            GIFTING\n          </small>\n\n          <strong>\n            Thoughtfully Distinctive\n          </strong>\n\n          <em>\n            Memorable festive gifting\n          </em>\n\n        </span>\n\n      </div>\n\n\n\n      <!-- BENEFIT 5 -->\n\n      <div class=\"hnhero-benefit\">\n\n        <span class=\"hnhero-benefit-icon\">\n\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n\n            <path d=\"M12 3 4 7v5c0 5 3.2 8 8 9 4.8-1 8-4 8-9V7l-8-4Zm-3 9 2 2 4-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\n          </svg>\n\n        </span>\n\n\n        <span>\n\n          <small>\n            DISCOVER\n          </small>\n\n          <strong>\n            Hertha Nest\n          </strong>\n\n          <em>\n            A brighter home\n          </em>\n\n        </span>\n\n      </div>\n\n\n    </div>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\n   HERTHA NEST\n   PREMIUM PRODUCT HERO\n========================================================= */\n\n\n/* =========================================================\n   FORCE TRUE FULL WIDTH\n========================================================= */\n\n.hnhero-product {\n\n  position:\n    relative;\n\n  width:\n    100vw;\n\n  max-width:\n    100vw;\n\n  margin-left:\n    calc(50% - 50vw);\n\n  margin-right:\n    calc(50% - 50vw);\n\n}\n\n\n/* Try to remove theme container restriction when supported */\n\n.shopify-section:has(.hnhero-product) {\n\n  margin-left:\n    0 !important;\n\n  margin-right:\n    0 !important;\n\n  padding-left:\n    0 !important;\n\n  padding-right:\n    0 !important;\n\n}\n\n\n.shopify-section:has(.hnhero-product) .page-width,\n.shopify-section:has(.hnhero-product) .container,\n.shopify-section:has(.hnhero-product) .container-fluid,\n.shopify-section:has(.hnhero-product) .custom-html,\n.shopify-section:has(.hnhero-product) .custom-html-wrapper {\n\n  width:\n    100% !important;\n\n  max-width:\n    none !important;\n\n  padding-left:\n    0 !important;\n\n  padding-right:\n    0 !important;\n\n}\n\n\n\n/* =========================================================\n   SECTION\n========================================================= */\n\n.hnhero-product {\n\n  --hn-navy:\n    #102b4d;\n\n  --hn-navy-deep:\n    #081d36;\n\n  --hn-navy-soft:\n    #1a416b;\n\n  --hn-ivory:\n    #f7f1e8;\n\n  --hn-cream:\n    #efe3d3;\n\n  --hn-brown:\n    #38261d;\n\n  --hn-muted:\n    #716158;\n\n  --hn-rust:\n    #a54619;\n\n  --hn-gold:\n    #c69245;\n\n  --hn-gold-soft:\n    #e5c38a;\n\n\n  position:\n    relative;\n\n\n  z-index:\n    1;\n\n\n  padding:\n\n    clamp(\n      70px,\n      6vw,\n      115px\n    )\n\n    clamp(\n      24px,\n      6.5vw,\n      125px\n    )\n\n    0;\n\n\n  overflow:\n    hidden;\n\n\n  background:\n\n    radial-gradient(\n\n      circle at 82% 34%,\n\n      rgba(\n        214,\n        181,\n        132,\n        .23\n      ),\n\n      transparent\n      27%\n\n    ),\n\n    linear-gradient(\n\n      135deg,\n\n      #fffdf9 0%,\n\n      #f8f2e9 48%,\n\n      #eee1d2 100%\n\n    );\n\n\n  color:\n    var(--hn-brown);\n\n\n  isolation:\n    isolate;\n\n}\n\n\n\n.hnhero-product *,\n.hnhero-product *::before,\n.hnhero-product *::after {\n\n  box-sizing:\n    border-box;\n\n}\n\n\n\n/* =========================================================\n   BACKGROUND\n========================================================= */\n\n.hnhero-bg {\n\n  position:\n    absolute;\n\n  inset:\n    0;\n\n  z-index:\n    -1;\n\n  overflow:\n    hidden;\n\n  pointer-events:\n    none;\n\n}\n\n\n\n.hnhero-glow {\n\n  position:\n    absolute;\n\n  display:\n    block;\n\n  border-radius:\n    50%;\n\n}\n\n\n\n.hnhero-glow-1 {\n\n  width:\n    600px;\n\n  height:\n    600px;\n\n  top:\n    -290px;\n\n  right:\n    -100px;\n\n\n  background:\n\n    radial-gradient(\n\n      circle,\n\n      rgba(\n        198,\n        146,\n        69,\n        .18\n      ),\n\n      rgba(\n        198,\n        146,\n        69,\n        0\n      )\n      70%\n\n    );\n\n}\n\n\n\n.hnhero-glow-2 {\n\n  width:\n    480px;\n\n  height:\n    480px;\n\n  left:\n    -190px;\n\n  bottom:\n    -220px;\n\n\n  background:\n\n    radial-gradient(\n\n      circle,\n\n      rgba(\n        16,\n        43,\n        77,\n        .09\n      ),\n\n      rgba(\n        16,\n        43,\n        77,\n        0\n      )\n      72%\n\n    );\n\n}\n\n\n\n/* =========================================================\n   BACKGROUND ARCHES\n========================================================= */\n\n.hnhero-arch {\n\n  position:\n    absolute;\n\n  display:\n    block;\n\n  border:\n\n    1px solid\n    rgba(\n      118,\n      80,\n      46,\n      .09\n    );\n\n  border-bottom:\n    0;\n\n  border-radius:\n\n    320px\n    320px\n    0\n    0;\n\n}\n\n\n\n.hnhero-arch-1 {\n\n  width:\n\n    min(\n      39vw,\n      620px\n    );\n\n  height:\n    74%;\n\n  top:\n    63px;\n\n  right:\n    7%;\n\n}\n\n\n\n.hnhero-arch-2 {\n\n  width:\n\n    min(\n      31vw,\n      500px\n    );\n\n  height:\n    64%;\n\n  top:\n    125px;\n\n  right:\n    10.5%;\n\n}\n\n\n\n/* =========================================================\n   DECORATIVE PATTERN LINES\n========================================================= */\n\n.hnhero-pattern {\n\n  position:\n    absolute;\n\n  display:\n    block;\n\n  width:\n    420px;\n\n  height:\n    1px;\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      transparent,\n\n      rgba(\n        16,\n        43,\n        77,\n        .11\n      ),\n\n      transparent\n\n    );\n\n}\n\n\n\n.hnhero-pattern-1 {\n\n  top:\n    150px;\n\n  left:\n    -100px;\n\n  transform:\n    rotate(-19deg);\n\n}\n\n\n\n.hnhero-pattern-2 {\n\n  right:\n    -90px;\n\n  bottom:\n    240px;\n\n  transform:\n    rotate(21deg);\n\n}\n\n\n\n/* =========================================================\n   MAIN GRID\n========================================================= */\n\n.hnhero-inner {\n\n  position:\n    relative;\n\n  z-index:\n    5;\n\n\n  display:\n    grid;\n\n\n  grid-template-columns:\n\n    minmax(\n      0,\n      .92fr\n    )\n\n    minmax(\n      500px,\n      1.08fr\n    );\n\n\n  align-items:\n    center;\n\n\n  gap:\n\n    clamp(\n      40px,\n      5vw,\n      95px\n    );\n\n\n  width:\n    100%;\n\n\n  max-width:\n    1580px;\n\n\n  min-height:\n    690px;\n\n\n  margin:\n    0 auto;\n\n}\n\n\n\n/* =========================================================\n   LEFT CONTENT\n========================================================= */\n\n.hnhero-content {\n\n  position:\n    relative;\n\n  z-index:\n    20;\n\n\n  width:\n    100%;\n\n\n  max-width:\n    675px;\n\n}\n\n\n\n/* =========================================================\n   EYEBROW\n========================================================= */\n\n.hnhero-eyebrow {\n\n  display:\n    flex;\n\n  align-items:\n    center;\n\n  gap:\n    12px;\n\n\n  margin-bottom:\n    20px;\n\n\n  color:\n    #88562e;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      9px,\n      .7vw,\n      11px\n    );\n\n\n  font-weight:\n    700;\n\n\n  line-height:\n    1.25;\n\n\n  letter-spacing:\n    .24em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n\n.hnhero-eyebrow-line {\n\n  display:\n    block;\n\n\n  width:\n    30px;\n\n  height:\n    1px;\n\n\n  background:\n    currentColor;\n\n\n  opacity:\n    .7;\n\n}\n\n\n\n/* =========================================================\n   KICKER\n========================================================= */\n\n.hnhero-kicker {\n\n  margin:\n\n    0\n    0\n    9px;\n\n\n  color:\n    #4f4037;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      17px,\n      1.3vw,\n      22px\n    );\n\n\n  font-weight:\n    400;\n\n\n  line-height:\n    1.4;\n\n}\n\n\n\n/* =========================================================\n   TITLE\n========================================================= */\n\n.hnhero-title {\n\n  margin:\n    0;\n\n\n  color:\n    var(--hn-brown);\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n\n    clamp(\n      53px,\n      4.8vw,\n      85px\n    );\n\n\n  font-weight:\n    500;\n\n\n  line-height:\n    .95;\n\n\n  letter-spacing:\n    -.05em;\n\n}\n\n\n\n.hnhero-title-main {\n\n  display:\n    block;\n\n}\n\n\n\n.hnhero-title em {\n\n  display:\n    block;\n\n\n  margin-top:\n    8px;\n\n\n  color:\n    var(--hn-rust);\n\n\n  font-size:\n    .77em;\n\n\n  font-weight:\n    400;\n\n\n  font-style:\n    italic;\n\n\n  line-height:\n    1;\n\n\n  letter-spacing:\n    -.03em;\n\n}\n\n\n\n/* =========================================================\n   ORNAMENT\n========================================================= */\n\n.hnhero-ornament {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    8px;\n\n\n  width:\n    80px;\n\n\n  margin-top:\n    22px;\n\n}\n\n\n\n.hnhero-ornament span {\n\n  display:\n    block;\n\n\n  width:\n    28px;\n\n\n  height:\n    1px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(\n        148,\n        99,\n        48,\n        .20\n      ),\n\n      rgba(\n        148,\n        99,\n        48,\n        .80\n      )\n\n    );\n\n}\n\n\n\n.hnhero-ornament span:last-child {\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(\n        148,\n        99,\n        48,\n        .80\n      ),\n\n      rgba(\n        148,\n        99,\n        48,\n        .20\n      )\n\n    );\n\n}\n\n\n\n.hnhero-ornament i {\n\n  display:\n    block;\n\n\n  width:\n    6px;\n\n\n  height:\n    6px;\n\n\n  border:\n\n    1px solid\n    rgba(\n      148,\n      99,\n      48,\n      .80\n    );\n\n\n  background:\n    #f7eee2;\n\n\n  transform:\n    rotate(45deg);\n\n}\n\n\n\n/* =========================================================\n   PRICE\n========================================================= */\n\n.hnhero-price-row {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  flex-wrap:\n    wrap;\n\n\n  gap:\n    12px;\n\n\n  margin-top:\n    21px;\n\n}\n\n\n\n.hnhero-price {\n\n  color:\n    var(--hn-navy);\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n    28px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    -.01em;\n\n}\n\n\n\n.hnhero-compare-price {\n\n  color:\n    #a1948a;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    14px;\n\n\n  text-decoration:\n    line-through;\n\n}\n\n\n\n/* =========================================================\n   STOCK\n========================================================= */\n\n.hnhero-stock {\n\n  display:\n    inline-flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  min-height:\n    28px;\n\n\n  padding:\n\n    5px\n    12px;\n\n\n  border:\n\n    1px solid\n    rgba(\n      16,\n      43,\n      77,\n      .10\n    );\n\n\n  border-radius:\n    100px;\n\n\n  background:\n\n    rgba(\n      255,\n      255,\n      255,\n      .46\n    );\n\n\n  color:\n    #5e5148;\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  font-size:\n    9px;\n\n\n  font-weight:\n    700;\n\n\n  letter-spacing:\n    .10em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n\n.hnhero-stock.is-available {\n\n  border-color:\n    rgba(\n      67,\n      98,\n      55,\n      .12\n    );\n\n\n  background:\n    #e6efe1;\n\n\n  color:\n    #416138;\n\n}\n\n\n\n.hnhero-stock.is-sold {\n\n  border-color:\n    rgba(\n      137,\n      57,\n      34,\n      .12\n    );\n\n\n  background:\n    #f1dfda;\n\n\n  color:\n    #873b27;\n\n}\n\n\n\n/* =========================================================\n   DESCRIPTION\n========================================================= */\n\n.hnhero-description {\n\n  width:\n    100%;\n\n\n  max-width:\n    580px;\n\n\n  margin:\n\n    21px\n    0\n    0;\n\n\n  color:\n    var(--hn-muted);\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      14px,\n      .98vw,\n      16.5px\n    );\n\n\n  font-weight:\n    400;\n\n\n  line-height:\n    1.72;\n\n}\n\n\n\n/* =========================================================\n   PREMIUM SPEC CARDS\n========================================================= */\n\n.hnhero-specs {\n\n  display:\n    grid;\n\n\n  grid-template-columns:\n\n    repeat(\n      3,\n      minmax(\n        0,\n        1fr\n      )\n    );\n\n\n  gap:\n    11px;\n\n\n  width:\n    100%;\n\n\n  max-width:\n    630px;\n\n\n  margin-top:\n    29px;\n\n}\n\n\n\n.hnhero-spec-card {\n\n  position:\n    relative;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    11px;\n\n\n  min-height:\n    78px;\n\n\n  padding:\n\n    13px\n    13px;\n\n\n  overflow:\n    hidden;\n\n\n  border:\n\n    1px solid\n    rgba(\n      16,\n      43,\n      77,\n      .10\n    );\n\n\n  border-radius:\n    14px;\n\n\n  background:\n\n    linear-gradient(\n\n      135deg,\n\n      rgba(\n        255,\n        255,\n        255,\n        .62\n      ),\n\n      rgba(\n        255,\n        255,\n        255,\n        .25\n      )\n\n    );\n\n\n  box-shadow:\n\n    0\n    12px\n    32px\n    rgba(\n      57,\n      40,\n      29,\n      .055\n    ),\n\n    inset\n    0\n    1px\n    0\n    rgba(\n      255,\n      255,\n      255,\n      .70\n    );\n\n\n  backdrop-filter:\n    blur(6px);\n\n\n  -webkit-backdrop-filter:\n    blur(6px);\n\n\n  transition:\n\n    transform\n    .25s\n    ease,\n\n    box-shadow\n    .25s\n    ease,\n\n    border-color\n    .25s\n    ease;\n\n}\n\n\n\n.hnhero-spec-card::after {\n\n  content:\n    \"\";\n\n\n  position:\n    absolute;\n\n\n  left:\n    0;\n\n\n  bottom:\n    0;\n\n\n  width:\n    100%;\n\n\n  height:\n    2px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      transparent,\n\n      var(--hn-gold),\n\n      transparent\n\n    );\n\n\n  opacity:\n    .48;\n\n}\n\n\n\n.hnhero-spec-card:hover {\n\n  transform:\n    translateY(-3px);\n\n\n  border-color:\n\n    rgba(\n      198,\n      146,\n      69,\n      .30\n    );\n\n\n  box-shadow:\n\n    0\n    18px\n    35px\n    rgba(\n      56,\n      39,\n      27,\n      .085\n    );\n\n}\n\n\n\n.hnhero-spec-icon {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  width:\n    42px;\n\n\n  height:\n    42px;\n\n\n  flex:\n\n    0\n    0\n    42px;\n\n\n  border:\n\n    1px solid\n    rgba(\n      198,\n      146,\n      69,\n      .37\n    );\n\n\n  border-radius:\n    50%;\n\n\n  background:\n\n    linear-gradient(\n\n      135deg,\n\n      #fffdf8,\n\n      #eadbc7\n\n    );\n\n\n  box-shadow:\n\n    0\n    5px\n    15px\n    rgba(\n      86,\n      55,\n      31,\n      .08\n    );\n\n\n  color:\n    var(--hn-navy);\n\n}\n\n\n\n.hnhero-spec-icon svg {\n\n  width:\n    20px;\n\n\n  height:\n    20px;\n\n}\n\n\n\n.hnhero-spec-copy {\n\n  display:\n    block;\n\n\n  min-width:\n    0;\n\n\n  color:\n    var(--hn-brown);\n\n\n  font-family:\n    Arial, sans-serif;\n\n\n  line-height:\n    1.25;\n\n}\n\n\n