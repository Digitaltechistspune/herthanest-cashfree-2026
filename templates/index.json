        "custom_html": "<!-- =========================================================\n     HERTHA NEST - RESPONSIVE PROMOTIONAL CAROUSEL\n\n     FIXES:\n     1. Removes Custom HTML internal white space above banner\n     2. Category dropdown stays ABOVE banner\n     3. Header height/design remains untouched\n     4. Desktop + mobile banners preserved\n     5. Autoplay every 5 seconds\n========================================================= -->\n\n\n<div class=\"hn-promo-slider\" data-hn-slider>\n\n  <div class=\"hn-promo-track\">\n\n\n    <!-- =====================================================\n         SLIDE 1 - A PERFECT PAIR\n    ====================================================== -->\n\n    <div class=\"hn-promo-slide is-active\" data-hn-slide aria-hidden=\"false\">\n\n      <div class=\"hn-promo-image-wrap\">\n\n        <picture>\n\n          <!-- MOBILE -->\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/Untitled_design_2_cb75c4c8-3439-4d2b-9fe8-2f392b86ee5d.png?v=1787561425\">\n\n          <!-- DESKTOP -->\n          <img class=\"hn-promo-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/Untitled_design_4200a21b-db06-44fc-8dca-8782c498f103.png?v=1787555748\" alt=\"Hertha Nest handcrafted product combo\" width=\"1600\" height=\"750\" loading=\"eager\" fetchpriority=\"high\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-promo-overlay\"></div>\n\n\n      <div class=\"hn-promo-content\">\n\n        <div class=\"hn-promo-text\">\n\n          <h2 class=\"hn-promo-heading\">\n            A Perfect Pair\n          </h2>\n\n          <span class=\"hn-promo-divider\"></span>\n\n          <p class=\"hn-promo-subtitle\">\n            Two handcrafted favourites, beautifully paired together.\n          </p>\n\n        </div>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =====================================================\n         SLIDE 2 - FESTIVE OFFER\n    ====================================================== -->\n\n    <div class=\"hn-promo-slide\" data-hn-slide aria-hidden=\"true\">\n\n      <div class=\"hn-promo-image-wrap\">\n\n        <picture>\n\n          <!-- MOBILE -->\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/Untitled_design_1.png?v=1787561424\">\n\n          <!-- DESKTOP -->\n          <img class=\"hn-promo-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/banner.png?v=1787555748\" alt=\"Hertha Nest festive collection offer\" width=\"1600\" height=\"750\" loading=\"lazy\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-promo-overlay\"></div>\n\n\n      <div class=\"hn-promo-content\">\n\n        <div class=\"hn-promo-text\">\n\n          <h2 class=\"hn-promo-heading\">\n            Festive Shopping,<br>\n            More Rewarding\n          </h2>\n\n          <span class=\"hn-promo-divider\"></span>\n\n          <p class=\"hn-promo-subtitle\">\n            Enjoy 20% off the Festive Collection on cart value ₹1,000 &amp; above.\n          </p>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n\n\n  <!-- =====================================================\n       DOT NAVIGATION\n  ====================================================== -->\n\n  <div class=\"hn-promo-dots\" aria-label=\"Promotional banner navigation\">\n\n    <button type=\"button\" class=\"hn-promo-dot is-active\" data-hn-dot=\"0\" aria-label=\"Show A Perfect Pair\" aria-current=\"true\"></button>\n\n    <button type=\"button\" class=\"hn-promo-dot\" data-hn-dot=\"1\" aria-label=\"Show Festive Offer\" aria-current=\"false\"></button>\n\n  </div>\n\n</div>\n\n\n\n<style>\n\n/* =========================================================\n   FIX 1\n   CATEGORY DROPDOWN ABOVE BANNER\n========================================================= */\n\n#shopify-section-header,\n.shopify-section-header,\n.shopify-section-header-sticky,\n.shopify-section-group-header-group {\n\n  position: relative;\n\n  z-index: 9999 !important;\n\n}\n\n\n/* Allow dropdown to extend outside header */\n\n#shopify-section-header,\n#shopify-section-header header,\n#shopify-section-header .header-wrapper,\n#shopify-section-header .header,\n\n.shopify-section-header,\n.shopify-section-header header,\n.shopify-section-header .header-wrapper,\n.shopify-section-header .header,\n\n.header__inline-menu,\n.header__menu,\n.header__navigation,\n.header__menu-container,\n.header__menu-wrapper {\n\n  overflow: visible !important;\n\n}\n\n\n/* Dropdown itself */\n\n.header__submenu,\n.header__submenu.list-menu,\n.list-menu--disclosure,\n.mega-menu,\n.mega-menu__content,\n.dropdown,\n.dropdown-menu,\n.submenu,\n.sub-menu {\n\n  z-index: 99999 !important;\n\n}\n\n\n\n/* =========================================================\n   FIX 2\n   REMOVE TOP SPACE CREATED BY CUSTOM HTML SECTION\n========================================================= */\n\n/*\n   IMPORTANT:\n\n   The blue Shopify editor border proves that the white\n   space belongs to the Custom HTML section.\n\n   We therefore reset only the Shopify section that\n   contains .hn-promo-slider.\n*/\n\n\n.shopify-section:has(.hn-promo-slider) {\n\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n\n  padding-block-start: 0 !important;\n\n}\n\n\n/* =========================================================\n   REMOVE SECTION TOP PADDING VARIABLES\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) {\n\n  --section-padding-top: 0px !important;\n  --padding-top: 0px !important;\n  --section-spacing-top: 0px !important;\n  --spacing-top: 0px !important;\n\n}\n\n\n\n/* =========================================================\n   REMOVE INTERNAL CUSTOM HTML WRAPPER TOP SPACING\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) > div {\n\n  margin-top: 0 !important;\n\n  padding-top: 0 !important;\n\n  padding-block-start: 0 !important;\n\n}\n\n\n.shopify-section:has(.hn-promo-slider) > div > div {\n\n  margin-top: 0 !important;\n\n  padding-top: 0 !important;\n\n  padding-block-start: 0 !important;\n\n}\n\n\n\n/* =========================================================\n   COMMON THEME SECTION WRAPPERS\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) .section,\n.shopify-section:has(.hn-promo-slider) .section-inner,\n.shopify-section:has(.hn-promo-slider) .section__inner,\n.shopify-section:has(.hn-promo-slider) .section-content,\n.shopify-section:has(.hn-promo-slider) .section__content,\n\n.shopify-section:has(.hn-promo-slider) .custom-html,\n.shopify-section:has(.hn-promo-slider) .custom-html-section,\n.shopify-section:has(.hn-promo-slider) .custom-html-wrapper,\n.shopify-section:has(.hn-promo-slider) .custom-html__wrapper,\n.shopify-section:has(.hn-promo-slider) .custom-html__content,\n\n.shopify-section:has(.hn-promo-slider) .custom-liquid,\n.shopify-section:has(.hn-promo-slider) .custom-liquid-section,\n.shopify-section:has(.hn-promo-slider) .custom-liquid-wrapper,\n\n.shopify-section:has(.hn-promo-slider) .page-width,\n.shopify-section:has(.hn-promo-slider) .container,\n.shopify-section:has(.hn-promo-slider) .container-fluid {\n\n  margin-top: 0 !important;\n\n  padding-top: 0 !important;\n\n  padding-block-start: 0 !important;\n\n}\n\n\n\n/* =========================================================\n   REMOVE EMPTY SECTION HEADING AREA\n========================================================= */\n\n/*\n   Your theme has a \"Section Heading\" configuration.\n\n   Some themes create the heading wrapper even when there\n   is no heading. That can leave empty vertical space.\n*/\n\n\n.shopify-section:has(.hn-promo-slider) .section-heading:empty,\n.shopify-section:has(.hn-promo-slider) .section__heading:empty,\n.shopify-section:has(.hn-promo-slider) .section-title:empty,\n.shopify-section:has(.hn-promo-slider) .section__title:empty,\n.shopify-section:has(.hn-promo-slider) .section-header:empty,\n.shopify-section:has(.hn-promo-slider) .section__header:empty,\n.shopify-section:has(.hn-promo-slider) .heading-wrapper:empty,\n.shopify-section:has(.hn-promo-slider) .title-wrapper:empty {\n\n  display: none !important;\n\n  height: 0 !important;\n\n  min-height: 0 !important;\n\n  margin: 0 !important;\n\n  padding: 0 !important;\n\n}\n\n\n\n/* =========================================================\n   HEADING WRAPPERS WITH NO REAL CONTENT\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) .section-heading,\n.shopify-section:has(.hn-promo-slider) .section__heading,\n.shopify-section:has(.hn-promo-slider) .section-title-wrapper,\n.shopify-section:has(.hn-promo-slider) .section__title-wrapper {\n\n  margin-top: 0 !important;\n\n  padding-top: 0 !important;\n\n}\n\n\n\n/* =========================================================\n   FULL WIDTH SECTION\n========================================================= */\n\n.shopify-section:has(.hn-promo-slider) .page-width,\n.shopify-section:has(.hn-promo-slider) .container,\n.shopify-section:has(.hn-promo-slider) .container-fluid {\n\n  width: 100% !important;\n\n  max-width: none !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n\n}\n\n\n\n/* =========================================================\n   ENSURE BANNER ITSELF HAS ZERO EXTERNAL TOP GAP\n========================================================= */\n\n.hn-promo-slider {\n\n  --hn-accent: #DE7F65;\n  --hn-heading: #3d2924;\n  --hn-text: #674b43;\n\n  position: relative;\n\n  z-index: 1;\n\n  display: block;\n\n  width: 100vw;\n  max-width: 100vw;\n\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  margin-left: calc(50% - 50vw);\n  margin-right: calc(50% - 50vw);\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  border: 0;\n\n  overflow: hidden;\n\n  background: #f8eee7;\n\n  box-sizing: border-box;\n\n  isolation: isolate;\n\n}\n\n\n.hn-promo-slider *,\n.hn-promo-slider *::before,\n.hn-promo-slider *::after {\n\n  box-sizing: border-box;\n\n}\n\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hn-promo-track {\n\n  position: relative;\n\n  display: block;\n\n  width: 100%;\n\n  aspect-ratio: 1600 / 750;\n\n  margin: 0 !important;\n\n  padding: 0 !important;\n\n  border: 0;\n\n  overflow: hidden;\n\n}\n\n\n\n/* =========================================================\n   SLIDES\n========================================================= */\n\n.hn-promo-slide {\n\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n\n  padding: 0;\n\n  opacity: 0;\n\n  visibility: hidden;\n\n  pointer-events: none;\n\n  transition:\n    opacity 0.8s ease,\n    visibility 0.8s ease;\n\n}\n\n\n.hn-promo-slide.is-active {\n\n  opacity: 1;\n\n  visibility: visible;\n\n  pointer-events: auto;\n\n  z-index: 2;\n\n}\n\n\n\n/* =========================================================\n   IMAGE\n========================================================= */\n\n.hn-promo-image-wrap {\n\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n\n  padding: 0;\n\n  overflow: hidden;\n\n}\n\n\n.hn-promo-image-wrap picture {\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n\n  padding: 0;\n\n}\n\n\n.hn-promo-image {\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n\n  padding: 0;\n\n  border: 0;\n\n  object-fit: cover;\n\n  object-position: center center;\n\n  transform: scale(1);\n\n  transition: transform 6s ease;\n\n}\n\n\n.hn-promo-slide.is-active .hn-promo-image {\n\n  transform: scale(1.025);\n\n}\n\n\n\n/* =========================================================\n   DESKTOP OVERLAY\n========================================================= */\n\n.hn-promo-overlay {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 1;\n\n  pointer-events: none;\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(255, 249, 243, 0.75) 0%,\n\n      rgba(255, 249, 243, 0.60) 23%,\n\n      rgba(255, 249, 243, 0.25) 42%,\n\n      rgba(255, 249, 243, 0) 62%\n\n    );\n\n}\n\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hn-promo-content {\n\n  position: relative;\n\n  z-index: 3;\n\n  display: flex;\n\n  align-items: center;\n\n  width: 100%;\n  height: 100%;\n\n  margin: 0;\n\n  padding:\n\n    50px\n\n    clamp(40px, 7vw, 135px);\n\n}\n\n\n\n/* =========================================================\n   TEXT\n========================================================= */\n\n.hn-promo-text {\n\n  width: 100%;\n\n  max-width: 600px;\n\n  margin: 0;\n\n  opacity: 0;\n\n  transform: translateY(20px);\n\n  transition:\n\n    opacity 0.7s ease 0.15s,\n\n    transform 0.7s ease 0.15s;\n\n}\n\n\n.hn-promo-slide.is-active .hn-promo-text {\n\n  opacity: 1;\n\n  transform: translateY(0);\n\n}\n\n\n\n/* =========================================================\n   HEADING\n========================================================= */\n\n.hn-promo-heading {\n\n  margin: 0;\n\n  padding: 0;\n\n  color: var(--hn-heading);\n\n  font-family:\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n\n    clamp(\n      38px,\n      4.2vw,\n      74px\n    );\n\n  font-weight: 700;\n\n  line-height: 1.03;\n\n  letter-spacing: -0.035em;\n\n}\n\n\n\n/* =========================================================\n   DIVIDER\n========================================================= */\n\n.hn-promo-divider {\n\n  display: block;\n\n  width: 55px;\n\n  height: 3px;\n\n  margin:\n\n    20px\n    0\n    18px;\n\n  border-radius: 20px;\n\n  background: var(--hn-accent);\n\n}\n\n\n\n/* =========================================================\n   SUBTITLE\n========================================================= */\n\n.hn-promo-subtitle {\n\n  width: 100%;\n\n  max-width: 520px;\n\n  margin: 0;\n\n  color: var(--hn-text);\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n\n    clamp(\n      15px,\n      1.25vw,\n      20px\n    );\n\n  font-weight: 500;\n\n  line-height: 1.55;\n\n}\n\n\n\n/* =========================================================\n   DOTS\n========================================================= */\n\n.hn-promo-dots {\n\n  position: absolute;\n\n  z-index: 20;\n\n  left: 50%;\n\n  bottom: 20px;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 8px;\n\n  transform: translateX(-50%);\n\n}\n\n\n.hn-promo-dot {\n\n  display: block;\n\n  width: 9px;\n  height: 9px;\n\n  min-width: 9px;\n\n  margin: 0;\n\n  padding: 0;\n\n  border: 0;\n\n  border-radius: 50%;\n\n  background:\n\n    rgba(\n      60,\n      40,\n      34,\n      0.35\n    );\n\n  cursor: pointer;\n\n  appearance: none;\n\n  -webkit-appearance: none;\n\n  box-shadow: none;\n\n  transition:\n\n    width 0.3s ease,\n\n    background 0.3s ease,\n\n    transform 0.3s ease;\n\n}\n\n\n.hn-promo-dot:hover {\n\n  transform: scale(1.1);\n\n}\n\n\n.hn-promo-dot.is-active {\n\n  width: 28px;\n\n  border-radius: 20px;\n\n  background: var(--hn-accent);\n\n}\n\n\n.hn-promo-dot:focus-visible {\n\n  outline:\n    2px solid\n    var(--hn-heading);\n\n  outline-offset: 3px;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and (max-width: 990px) and (min-width: 750px) {\n\n\n  .hn-promo-content {\n\n    padding-left: 40px;\n\n    padding-right: 40px;\n\n  }\n\n\n  .hn-promo-text {\n\n    max-width: 48%;\n\n  }\n\n\n  .hn-promo-heading {\n\n    font-size:\n\n      clamp(\n        34px,\n        5vw,\n        54px\n      );\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n\n  .hn-promo-track {\n\n    aspect-ratio: 4 / 5;\n\n    height: auto;\n\n    min-height: 0;\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE IMAGE\n  ===================================================== */\n\n  .hn-promo-image-wrap {\n\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n  }\n\n\n  .hn-promo-image {\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n\n    object-position: center center;\n\n    transform: none;\n\n  }\n\n\n  .hn-promo-slide.is-active .hn-promo-image {\n\n    transform: none;\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE OVERLAY\n  ===================================================== */\n\n  .hn-promo-overlay {\n\n    display: block;\n\n    background:\n\n      linear-gradient(\n\n        180deg,\n\n        rgba(255, 249, 243, 0.48) 0%,\n\n        rgba(255, 249, 243, 0.33) 17%,\n\n        rgba(255, 249, 243, 0.12) 29%,\n\n        rgba(255, 249, 243, 0) 42%\n\n      );\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE CONTENT\n  ===================================================== */\n\n  .hn-promo-content {\n\n    position: absolute;\n\n    inset: 0;\n\n    z-index: 3;\n\n    display: flex;\n\n    align-items: flex-start;\n\n    justify-content: center;\n\n    width: 100%;\n    height: 100%;\n\n    padding:\n\n      clamp(34px, 10vw, 54px)\n\n      20px\n\n      50px;\n\n    pointer-events: none;\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE TEXT\n  ===================================================== */\n\n  .hn-promo-text {\n\n    width: 100%;\n\n    max-width: 390px;\n\n    margin: 0 auto;\n\n    text-align: center;\n\n    opacity: 0;\n\n    transform: translateY(10px);\n\n  }\n\n\n  .hn-promo-slide.is-active .hn-promo-text {\n\n    opacity: 1;\n\n    transform: translateY(0);\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE HEADING\n  ===================================================== */\n\n  .hn-promo-heading {\n\n    width: 100%;\n\n    margin: 0 auto;\n\n    padding: 0;\n\n    color: #38251f;\n\n    text-align: center;\n\n    font-size:\n\n      clamp(\n        29px,\n        8.5vw,\n        40px\n      );\n\n    font-weight: 700;\n\n    line-height: 1.03;\n\n    letter-spacing: -0.025em;\n\n    text-shadow:\n\n      0 1px 1px\n      rgba(255,255,255,0.80),\n\n      0 2px 6px\n      rgba(255,255,255,0.30);\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE DIVIDER\n  ===================================================== */\n\n  .hn-promo-divider {\n\n    width: 42px;\n\n    height: 2px;\n\n    margin:\n\n      12px\n\n      auto\n\n      11px;\n\n    background: var(--hn-accent);\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE SUBTITLE\n  ===================================================== */\n\n  .hn-promo-subtitle {\n\n    width: 100%;\n\n    max-width: 355px;\n\n    margin: 0 auto;\n\n    color: #5f433c;\n\n    text-align: center;\n\n    font-size: 13.5px;\n\n    font-weight: 500;\n\n    line-height: 1.45;\n\n    text-shadow:\n\n      0 1px 1px\n      rgba(255,255,255,0.90),\n\n      0 1px 4px\n      rgba(255,255,255,0.40);\n\n  }\n\n\n\n  /* =====================================================\n     MOBILE DOTS\n  ===================================================== */\n\n  .hn-promo-dots {\n\n    left: 50%;\n\n    bottom: 16px;\n\n    gap: 7px;\n\n    transform: translateX(-50%);\n\n  }\n\n\n  .hn-promo-dot {\n\n    width: 7px;\n\n    height: 7px;\n\n    min-width: 7px;\n\n    background:\n\n      rgba(\n        65,\n        42,\n        35,\n        0.30\n      );\n\n  }\n\n\n  .hn-promo-dot.is-active {\n\n    width: 23px;\n\n    background: var(--hn-accent);\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 420px) {\n\n\n  .hn-promo-content {\n\n    padding-top: 36px;\n\n    padding-left: 16px;\n\n    padding-right: 16px;\n\n  }\n\n\n  .hn-promo-heading {\n\n    font-size: 31px;\n\n  }\n\n\n  .hn-promo-subtitle {\n\n    max-width: 320px;\n\n    font-size: 12.8px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 350px) {\n\n\n  .hn-promo-content {\n\n    padding-top: 28px;\n\n  }\n\n\n  .hn-promo-heading {\n\n    font-size: 27px;\n\n  }\n\n\n  .hn-promo-divider {\n\n    margin-top: 9px;\n\n    margin-bottom: 9px;\n\n  }\n\n\n  .hn-promo-subtitle {\n\n    max-width: 290px;\n\n    font-size: 12px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n\n  .hn-promo-slide,\n  .hn-promo-image,\n  .hn-promo-text,\n  .hn-promo-dot {\n\n    transition: none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n     REMOVE CUSTOM HTML INTERNAL TOP GAP\n  ===================================================== */\n\n  function removeSectionGap() {\n\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-slider]\"\n      );\n\n\n    sliders.forEach(function (slider) {\n\n\n      var section =\n        slider.closest(\n          \".shopify-section\"\n        );\n\n\n      if (!section) {\n\n        return;\n\n      }\n\n\n      /*\n       * Walk upwards from the banner to the Shopify section.\n       *\n       * This only removes TOP spacing.\n       * It does NOT touch left/right/bottom content styling.\n       */\n\n      var element =\n        slider.parentElement;\n\n\n      while (\n        element &&\n        element !== section\n      ) {\n\n\n        element.style.setProperty(\n          \"margin-top\",\n          \"0\",\n          \"important\"\n        );\n\n\n        element.style.setProperty(\n          \"padding-top\",\n          \"0\",\n          \"important\"\n        );\n\n\n        element.style.setProperty(\n          \"padding-block-start\",\n          \"0\",\n          \"important\"\n        );\n\n\n        element =\n          element.parentElement;\n\n      }\n\n\n      section.style.setProperty(\n        \"margin-top\",\n        \"0\",\n        \"important\"\n      );\n\n\n      section.style.setProperty(\n        \"padding-top\",\n        \"0\",\n        \"important\"\n      );\n\n\n      section.style.setProperty(\n        \"padding-block-start\",\n        \"0\",\n        \"important\"\n      );\n\n\n    });\n\n  }\n\n\n  removeSectionGap();\n\n\n  /*\n   * Shopify theme editor can re-render sections dynamically.\n   * Run once again shortly after render.\n   */\n\n  setTimeout(\n    removeSectionGap,\n    150\n  );\n\n\n  setTimeout(\n    removeSectionGap,\n    700\n  );\n\n\n\n  /* =====================================================\n     SLIDER\n  ===================================================== */\n\n  var sliders =\n    document.querySelectorAll(\n      \"[data-hn-slider]\"\n    );\n\n\n  sliders.forEach(function (slider) {\n\n\n    /* Prevent duplicate initialization */\n\n    if (\n      slider.getAttribute(\n        \"data-hn-ready\"\n      ) === \"true\"\n    ) {\n\n      return;\n\n    }\n\n\n    slider.setAttribute(\n      \"data-hn-ready\",\n      \"true\"\n    );\n\n\n    var slides =\n      slider.querySelectorAll(\n        \"[data-hn-slide]\"\n      );\n\n\n    var dots =\n      slider.querySelectorAll(\n        \"[data-hn-dot]\"\n      );\n\n\n    if (slides.length < 2) {\n\n      return;\n\n    }\n\n\n    var currentSlide = 0;\n\n    var autoplayTimer = null;\n\n    var autoplayDelay = 5000;\n\n\n\n    /* ===================================================\n       SHOW SLIDE\n    =================================================== */\n\n    function showSlide(index) {\n\n\n      if (index >= slides.length) {\n\n        index = 0;\n\n      }\n\n\n      if (index < 0) {\n\n        index = slides.length - 1;\n\n      }\n\n\n      slides.forEach(\n        function (\n          slide,\n          slideIndex\n        ) {\n\n\n          var active =\n            slideIndex === index;\n\n\n          if (active) {\n\n\n            slide.classList.add(\n              \"is-active\"\n            );\n\n\n            slide.setAttribute(\n              \"aria-hidden\",\n              \"false\"\n            );\n\n\n          } else {\n\n\n            slide.classList.remove(\n              \"is-active\"\n            );\n\n\n            slide.setAttribute(\n              \"aria-hidden\",\n              \"true\"\n            );\n\n\n          }\n\n        }\n      );\n\n\n      dots.forEach(\n        function (\n          dot,\n          dotIndex\n        ) {\n\n\n          var active =\n            dotIndex === index;\n\n\n          if (active) {\n\n\n            dot.classList.add(\n              \"is-active\"\n            );\n\n\n            dot.setAttribute(\n              \"aria-current\",\n              \"true\"\n            );\n\n\n          } else {\n\n\n            dot.classList.remove(\n              \"is-active\"\n            );\n\n\n            dot.setAttribute(\n              \"aria-current\",\n              \"false\"\n            );\n\n\n          }\n\n        }\n      );\n\n\n      currentSlide = index;\n\n    }\n\n\n\n    /* ===================================================\n       NEXT\n    =================================================== */\n\n    function nextSlide() {\n\n\n      showSlide(\n        currentSlide + 1\n      );\n\n    }\n\n\n\n    /* ===================================================\n       STOP AUTOPLAY\n    =================================================== */\n\n    function stopAutoplay() {\n\n\n      if (\n        autoplayTimer !== null\n      ) {\n\n\n        clearInterval(\n          autoplayTimer\n        );\n\n\n        autoplayTimer = null;\n\n      }\n\n    }\n\n\n\n    /* ===================================================\n       START AUTOPLAY\n    =================================================== */\n\n    function startAutoplay() {\n\n\n      stopAutoplay();\n\n\n      autoplayTimer =\n        setInterval(\n          nextSlide,\n          autoplayDelay\n        );\n\n    }\n\n\n\n    /* ===================================================\n       DOT CLICK\n    =================================================== */\n\n    dots.forEach(function (dot) {\n\n\n      dot.addEventListener(\n        \"click\",\n        function () {\n\n\n          var target =\n            parseInt(\n              dot.getAttribute(\n                \"data-hn-dot\"\n              ),\n              10\n            );\n\n\n          if (\n            isNaN(target)\n          ) {\n\n            return;\n\n          }\n\n\n          showSlide(target);\n\n\n          startAutoplay();\n\n        }\n      );\n\n    });\n\n\n\n    /* ===================================================\n       TAB VISIBILITY\n    =================================================== */\n\n    document.addEventListener(\n      \"visibilitychange\",\n      function () {\n\n\n        if (\n          document.hidden\n        ) {\n\n\n          stopAutoplay();\n\n\n        } else {\n\n\n          startAutoplay();\n\n        }\n\n      }\n    );\n\n\n\n    /* ===================================================\n       INITIALIZE\n    =================================================== */\n\n    showSlide(0);\n\n\n    var reducedMotion =\n      window.matchMedia(\n        \"(prefers-reduced-motion: reduce)\"\n      );\n\n\n    if (\n      !reducedMotion.matches\n    ) {\n\n\n      startAutoplay();\n\n    }\n\n\n  });\n\n})();\n\n</script>"
      }
    },
