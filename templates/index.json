        "custom_html": "<!-- =========================================================\n  HERTHA NEST — PREMIUM FESTIVE HERO CAROUSEL\n\n  MOBILE:\n  Slide 1 = m1.webp\n  Slide 2 = m2.webp\n  Slide 3 = m3.webp\n\n  DESKTOP:\n  Slide 1 = 2.webp\n  Slide 2 = 3.webp\n\n  IMPORTANT:\n  Desktop 1.webp has been completely removed.\n========================================================= -->\n\n\n<section class=\"hn-festive-hero\" data-hn-festive-slider=\"\" aria-label=\"Hertha Nest festive collection\">\n\n  <div class=\"hn-festive-track\">\n\n\n    <!-- =====================================================\n      SLIDE 1\n      MOBILE ONLY\n      m1.webp\n\n      This slide DOES NOT exist on desktop.\n    ====================================================== -->\n\n    <article class=\"\n        hn-festive-slide\n        hn-mobile-only-slide\n        hn-mobile-slide-one\n      \" data-hn-festive-slide=\"0\" aria-hidden=\"true\">\n\n      <div class=\"hn-festive-media\">\n\n        <picture>\n\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/m1.webp?v=1788857588\">\n\n          <!--\n            Transparent fallback.\n            Prevents desktop from loading a removed desktop image.\n          -->\n          <img class=\"hn-festive-image\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==\" alt=\"Hertha Nest handcrafted festive gifting collection\" width=\"800\" height=\"1000\" loading=\"eager\" fetchpriority=\"high\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-festive-overlay\"></div>\n\n\n      <div class=\"hn-festive-content\">\n\n        <div class=\"hn-festive-copy\">\n\n          <span class=\"hn-festive-eyebrow\">\n            FESTIVE EDIT\n          </span>\n\n\n          <h2 class=\"hn-festive-heading\">\n            Gifts Made to<br>\n            <em>Feel Personal.</em>\n          </h2>\n\n\n          <span class=\"hn-festive-line\"></span>\n\n\n          <p class=\"hn-festive-description\">\n            Thoughtfully handcrafted pieces that turn festive gifting\n            into something beautiful, meaningful and memorable.\n          </p>\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- =====================================================\n      SLIDE 2\n      DESKTOP = 2.webp\n      MOBILE  = m2.webp\n\n      CONTENT LEFT\n      PRODUCTS RIGHT\n    ====================================================== -->\n\n    <article class=\"\n        hn-festive-slide\n        hn-content-left\n        hn-slide-statement\n      \" data-hn-festive-slide=\"1\" aria-hidden=\"true\">\n\n      <div class=\"hn-festive-media\">\n\n        <picture>\n\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/m2.webp?v=1788857588\">\n\n\n          <img class=\"hn-festive-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/2.webp?v=1788857587\" alt=\"Hertha Nest artistic handcrafted statement decor\" width=\"1600\" height=\"750\" loading=\"eager\" fetchpriority=\"high\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-festive-overlay\"></div>\n\n\n      <div class=\"hn-festive-content\">\n\n        <div class=\"hn-festive-copy\">\n\n          <span class=\"hn-festive-eyebrow\">\n            HANDCRAFTED STORIES\n          </span>\n\n\n          <h2 class=\"hn-festive-heading\">\n            Décor That Makes<br>\n            <em>a Statement.</em>\n          </h2>\n\n\n          <span class=\"hn-festive-line\"></span>\n\n\n          <p class=\"hn-festive-description\">\n            Artful accents inspired by Indian craftsmanship,\n            created to bring character, colour and conversation\n            into your home.\n          </p>\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- =====================================================\n      SLIDE 3\n      DESKTOP = 3.webp\n      MOBILE  = m3.webp\n\n      PRODUCTS LEFT\n      CONTENT RIGHT\n\n      DESKTOP CONTENT MOVED FURTHER RIGHT\n    ====================================================== -->\n\n    <article class=\"\n        hn-festive-slide\n        hn-content-right\n        hn-slide-tradition\n      \" data-hn-festive-slide=\"2\" aria-hidden=\"true\">\n\n      <div class=\"hn-festive-media\">\n\n        <picture>\n\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/m3.webp?v=1788857588\">\n\n\n          <img class=\"hn-festive-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/3.webp?v=1788857587\" alt=\"Hertha Nest hand painted festive decor\" width=\"1600\" height=\"750\" loading=\"lazy\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-festive-overlay\"></div>\n\n\n      <div class=\"hn-festive-content\">\n\n        <div class=\"hn-festive-copy\">\n\n          <span class=\"hn-festive-eyebrow\">\n            CELEBRATE BEAUTIFULLY\n          </span>\n\n\n          <h2 class=\"hn-festive-heading\">\n            Tradition,<br>\n            <em>\n              Beautifully<br>\n              Reimagined.\n            </em>\n          </h2>\n\n\n          <span class=\"hn-festive-line\"></span>\n\n\n          <p class=\"hn-festive-description\">\n            Bring home festive warmth with colourful handcrafted décor\n            designed to make every celebration feel a little more special.\n          </p>\n\n        </div>\n\n      </div>\n\n    </article>\n\n  </div>\n\n\n\n  <!-- =====================================================\n    NAVIGATION\n  ====================================================== -->\n\n  <div class=\"hn-festive-dots\" aria-label=\"Promotional banner navigation\">\n\n\n    <!-- MOBILE ONLY DOT -->\n\n    <button type=\"button\" class=\"\n        hn-festive-dot\n        hn-mobile-only-dot\n      \" data-hn-festive-dot=\"0\" aria-label=\"Show festive gifting banner\" aria-current=\"false\"></button>\n\n\n    <!-- DESKTOP + MOBILE -->\n\n    <button type=\"button\" class=\"hn-festive-dot\" data-hn-festive-dot=\"1\" aria-label=\"Show handcrafted decor banner\" aria-current=\"false\"></button>\n\n\n    <!-- DESKTOP + MOBILE -->\n\n    <button type=\"button\" class=\"hn-festive-dot\" data-hn-festive-dot=\"2\" aria-label=\"Show festive traditions banner\" aria-current=\"false\"></button>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\n   HEADER + DROPDOWN COMPATIBILITY\n========================================================= */\n\n#shopify-section-header,\n.shopify-section-header,\n.shopify-section-header-sticky,\n.shopify-section-group-header-group {\n  position: relative;\n\n  z-index: 9999 !important;\n}\n\n\n#shopify-section-header,\n#shopify-section-header header,\n#shopify-section-header .header-wrapper,\n#shopify-section-header .header,\n\n.shopify-section-header,\n.shopify-section-header header,\n.shopify-section-header .header-wrapper,\n.shopify-section-header .header,\n\n.header__inline-menu,\n.header__menu,\n.header__navigation,\n.header__menu-container,\n.header__menu-wrapper {\n  overflow: visible !important;\n}\n\n\n.header__submenu,\n.header__submenu.list-menu,\n.list-menu--disclosure,\n.mega-menu,\n.mega-menu__content,\n.dropdown,\n.dropdown-menu,\n.submenu,\n.sub-menu {\n  z-index: 99999 !important;\n}\n\n\n\n/* =========================================================\n   REMOVE SHOPIFY SECTION SPACING\n========================================================= */\n\n.shopify-section:has(.hn-festive-hero) {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --spacing-top: 0px !important;\n}\n\n\n.shopify-section:has(.hn-festive-hero) > div,\n.shopify-section:has(.hn-festive-hero) > div > div {\n  margin-top: 0 !important;\n\n  padding-top: 0 !important;\n}\n\n\n.shopify-section:has(.hn-festive-hero) .page-width,\n.shopify-section:has(.hn-festive-hero) .container,\n.shopify-section:has(.hn-festive-hero) .container-fluid,\n.shopify-section:has(.hn-festive-hero) .custom-liquid,\n.shopify-section:has(.hn-festive-hero) .custom-liquid-wrapper,\n.shopify-section:has(.hn-festive-hero) .custom-html,\n.shopify-section:has(.hn-festive-hero) .custom-html-wrapper {\n\n  width: 100% !important;\n\n  max-width: none !important;\n\n  margin-top: 0 !important;\n\n  padding-top: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n\n/* =========================================================\n   MAIN HERO\n========================================================= */\n\n.hn-festive-hero {\n\n  --hn-gold: #b98442;\n\n  --hn-gold-dark: #895923;\n\n  --hn-heading: #35251d;\n\n  --hn-heading-soft: #664a37;\n\n  --hn-text: #514037;\n\n  position: relative;\n\n  z-index: 1;\n\n  display: block;\n\n  width: 100vw;\n\n  max-width: 100vw;\n\n  margin:\n\n    0\n    calc(50% - 50vw);\n\n  padding: 0;\n\n  overflow: hidden;\n\n  background: #ead4b6;\n\n  isolation: isolate;\n}\n\n\n.hn-festive-hero *,\n.hn-festive-hero *::before,\n.hn-festive-hero *::after {\n\n  box-sizing: border-box;\n\n}\n\n\n\n/* =========================================================\n   TRACK\n========================================================= */\n\n.hn-festive-track {\n\n  position: relative;\n\n  width: 100%;\n\n  aspect-ratio: 1600 / 750;\n\n  margin: 0;\n\n  padding: 0;\n\n  overflow: hidden;\n\n}\n\n\n\n/* =========================================================\n   SLIDES\n========================================================= */\n\n.hn-festive-slide {\n\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n\n  height: 100%;\n\n  margin: 0;\n\n  padding: 0;\n\n  opacity: 0;\n\n  visibility: hidden;\n\n  pointer-events: none;\n\n  z-index: 1;\n\n  transition:\n\n    opacity\n    900ms\n    cubic-bezier(.22,.61,.36,1),\n\n    visibility\n    900ms\n    ease;\n}\n\n\n.hn-festive-slide.is-active {\n\n  opacity: 1;\n\n  visibility: visible;\n\n  pointer-events: auto;\n\n  z-index: 2;\n\n}\n\n\n\n/* =========================================================\n   DESKTOP:\n   REMOVE MOBILE-ONLY FIRST SLIDE\n========================================================= */\n\n@media screen and (min-width: 750px) {\n\n  .hn-mobile-only-slide {\n\n    display: none !important;\n\n  }\n\n\n  .hn-mobile-only-dot {\n\n    display: none !important;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   IMAGE\n========================================================= */\n\n.hn-festive-media {\n\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n\n  height: 100%;\n\n  overflow: hidden;\n\n}\n\n\n.hn-festive-media picture {\n\n  display: block;\n\n  width: 100%;\n\n  height: 100%;\n\n}\n\n\n.hn-festive-image {\n\n  display: block;\n\n  width: 100%;\n\n  height: 100%;\n\n  margin: 0;\n\n  object-fit: cover;\n\n  object-position: center center;\n\n  border: 0;\n\n  transform: scale(1.01);\n\n  transition:\n\n    transform\n    7s\n    cubic-bezier(.22,.61,.36,1);\n}\n\n\n.hn-festive-slide.is-active\n.hn-festive-image {\n\n  transform: scale(1.035);\n\n}\n\n\n\n/* =========================================================\n   OVERLAY\n========================================================= */\n\n.hn-festive-overlay {\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 1;\n\n  pointer-events: none;\n\n}\n\n\n\n/* ---------------------------------------------------------\n   CONTENT LEFT\n--------------------------------------------------------- */\n\n.hn-content-left\n.hn-festive-overlay {\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(251,244,230,0.84) 0%,\n\n      rgba(251,244,230,0.61) 23%,\n\n      rgba(251,244,230,0.24) 43%,\n\n      rgba(251,244,230,0.04) 58%,\n\n      rgba(251,244,230,0) 68%\n\n    );\n\n}\n\n\n\n/* ---------------------------------------------------------\n   CONTENT RIGHT\n--------------------------------------------------------- */\n\n.hn-content-right\n.hn-festive-overlay {\n\n  background:\n\n    linear-gradient(\n\n      270deg,\n\n      rgba(251,244,230,0.84) 0%,\n\n      rgba(251,244,230,0.61) 23%,\n\n      rgba(251,244,230,0.23) 43%,\n\n      rgba(251,244,230,0.04) 58%,\n\n      rgba(251,244,230,0) 68%\n\n    );\n\n}\n\n\n\n/* =========================================================\n   VERY SUBTLE CINEMATIC VIGNETTE\n========================================================= */\n\n.hn-festive-slide::after {\n\n  content: \"\";\n\n  position: absolute;\n\n  inset: 0;\n\n  z-index: 1;\n\n  pointer-events: none;\n\n  background:\n\n    linear-gradient(\n\n      180deg,\n\n      rgba(44,28,18,0.015) 0%,\n\n      rgba(44,28,18,0) 58%,\n\n      rgba(44,28,18,0.07) 100%\n\n    );\n\n}\n\n\n\n/* =========================================================\n   CONTENT\n========================================================= */\n\n.hn-festive-content {\n\n  position: relative;\n\n  z-index: 3;\n\n  display: flex;\n\n  align-items: center;\n\n  width: 100%;\n\n  height: 100%;\n\n  padding:\n\n    50px\n    clamp(55px, 7vw, 135px);\n\n}\n\n\n\n/* LEFT CONTENT */\n\n.hn-content-left\n.hn-festive-content {\n\n  justify-content: flex-start;\n\n}\n\n\n\n/* RIGHT CONTENT */\n\n.hn-content-right\n.hn-festive-content {\n\n  justify-content: flex-end;\n\n}\n\n\n\n/* =========================================================\n   THIRD BANNER DESKTOP POSITION FIX\n\n   Content is intentionally moved further right.\n========================================================= */\n\n@media screen and (min-width: 991px) {\n\n  .hn-slide-tradition\n  .hn-festive-content {\n\n    padding-left: 55%;\n\n    padding-right:\n      clamp(\n        26px,\n        3.2vw,\n        62px\n      );\n\n  }\n\n\n  .hn-slide-tradition\n  .hn-festive-copy {\n\n    width: 100%;\n\n    max-width: 620px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   TEXT BLOCK\n========================================================= */\n\n.hn-festive-copy {\n\n  width: 100%;\n\n  max-width: 600px;\n\n  margin: 0;\n\n  opacity: 0;\n\n  transform:\n    translateY(22px);\n\n  transition:\n\n    opacity\n    750ms\n    ease\n    180ms,\n\n    transform\n    750ms\n    cubic-bezier(.22,.61,.36,1)\n    180ms;\n\n}\n\n\n.hn-festive-slide.is-active\n.hn-festive-copy {\n\n  opacity: 1;\n\n  transform:\n    translateY(0);\n\n}\n\n\n\n/* =========================================================\n   EYEBROW\n========================================================= */\n\n.hn-festive-eyebrow {\n\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 11px;\n\n  margin: 0 0 18px;\n\n  color:\n    var(--hn-gold-dark);\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n    clamp(\n      10px,\n      0.72vw,\n      12px\n    );\n\n  font-weight: 700;\n\n  line-height: 1.2;\n\n  letter-spacing: 0.22em;\n\n  text-transform: uppercase;\n\n}\n\n\n.hn-festive-eyebrow::before {\n\n  content: \"\";\n\n  width: 27px;\n\n  height: 1px;\n\n  background:\n    currentColor;\n\n  opacity: 0.65;\n\n}\n\n\n\n/* =========================================================\n   HEADING\n========================================================= */\n\n.hn-festive-heading {\n\n  width: 100%;\n\n  max-width: 650px;\n\n  margin: 0;\n\n  padding: 0;\n\n  color:\n    var(--hn-heading);\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n  font-size:\n\n    clamp(\n      40px,\n      4.25vw,\n      74px\n    );\n\n  font-weight: 500;\n\n  line-height: 1.01;\n\n  letter-spacing: -0.04em;\n\n}\n\n\n.hn-festive-heading em {\n\n  color:\n    var(--hn-heading-soft);\n\n  font-weight: 400;\n\n  font-style: italic;\n\n}\n\n\n\n/* =========================================================\n   DECORATIVE LINE\n========================================================= */\n\n.hn-festive-line {\n\n  display: block;\n\n  width: 53px;\n\n  height: 2px;\n\n  margin:\n\n    23px\n    0\n    18px;\n\n  border-radius: 20px;\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      #8b5c29,\n\n      #daa75e\n\n    );\n\n}\n\n\n\n/* =========================================================\n   DESCRIPTION\n========================================================= */\n\n.hn-festive-description {\n\n  width: 100%;\n\n  max-width: 525px;\n\n  margin: 0;\n\n  padding: 0;\n\n  color:\n    var(--hn-text);\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n\n    clamp(\n      14px,\n      1.08vw,\n      18px\n    );\n\n  font-weight: 400;\n\n  line-height: 1.65;\n\n  letter-spacing: 0.003em;\n\n  text-shadow: none;\n\n}\n\n\n\n/* =========================================================\n   PREMIUM DOT NAVIGATION\n========================================================= */\n\n.hn-festive-dots {\n\n  position: absolute;\n\n  z-index: 30;\n\n  left: 50%;\n\n  bottom: 20px;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: center;\n\n  gap: 8px;\n\n  padding:\n\n    7px\n    12px;\n\n  border:\n\n    1px solid\n    rgba(255,255,255,0.28);\n\n  border-radius: 50px;\n\n  background:\n\n    rgba(255,247,235,0.43);\n\n  box-shadow:\n\n    0 5px 18px\n    rgba(72,46,29,0.10);\n\n  backdrop-filter:\n    blur(7px);\n\n  -webkit-backdrop-filter:\n    blur(7px);\n\n  transform:\n    translateX(-50%);\n\n}\n\n\n.hn-festive-dot {\n\n  display: block;\n\n  width: 7px;\n\n  height: 7px;\n\n  min-width: 7px;\n\n  margin: 0;\n\n  padding: 0;\n\n  border: 0;\n\n  border-radius: 50px;\n\n  background:\n\n    rgba(72,49,34,0.36);\n\n  cursor: pointer;\n\n  appearance: none;\n\n  -webkit-appearance: none;\n\n  transition:\n\n    width\n    300ms\n    ease,\n\n    background\n    300ms\n    ease,\n\n    transform\n    300ms\n    ease;\n\n}\n\n\n.hn-festive-dot:hover {\n\n  transform:\n    scale(1.12);\n\n}\n\n\n.hn-festive-dot.is-active {\n\n  width: 27px;\n\n  background:\n\n    #9b6a32;\n\n}\n\n\n.hn-festive-dot:focus-visible {\n\n  outline:\n\n    2px solid\n    #35251d;\n\n  outline-offset: 3px;\n\n}\n\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media screen and\n(max-width: 1100px) and\n(min-width: 750px) {\n\n  .hn-festive-content {\n\n    padding:\n\n      35px\n      42px;\n\n  }\n\n\n  .hn-festive-copy {\n\n    width: 45%;\n\n    max-width: 470px;\n\n  }\n\n\n  .hn-festive-heading {\n\n    font-size:\n\n      clamp(\n        34px,\n        5vw,\n        53px\n      );\n\n  }\n\n\n  .hn-festive-description {\n\n    font-size: 14px;\n\n    line-height: 1.52;\n\n  }\n\n\n  .hn-slide-tradition\n  .hn-festive-content {\n\n    padding-left: 52%;\n\n    padding-right: 28px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n\n  /* -------------------------------------------------------\n     BANNER RATIO\n  ------------------------------------------------------- */\n\n  .hn-festive-track {\n\n    aspect-ratio: 4 / 5;\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE IMAGES\n  ------------------------------------------------------- */\n\n  .hn-festive-image {\n\n    width: 100%;\n\n    height: 100%;\n\n    object-fit: cover;\n\n    object-position:\n      center center;\n\n    transform:\n      none !important;\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE OVERLAY\n\n     Stronger at top so text remains clearly readable.\n  ------------------------------------------------------- */\n\n  .hn-content-left\n  .hn-festive-overlay,\n\n  .hn-content-right\n  .hn-festive-overlay,\n\n  .hn-mobile-only-slide\n  .hn-festive-overlay {\n\n    background:\n\n      linear-gradient(\n\n        180deg,\n\n        rgba(252,244,229,0.89) 0%,\n\n        rgba(252,244,229,0.74) 15%,\n\n        rgba(252,244,229,0.48) 27%,\n\n        rgba(252,244,229,0.16) 39%,\n\n        rgba(252,244,229,0) 50%\n\n      );\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE CONTENT\n  ------------------------------------------------------- */\n\n  .hn-festive-content,\n\n  .hn-content-left\n  .hn-festive-content,\n\n  .hn-content-right\n  .hn-festive-content,\n\n  .hn-slide-tradition\n  .hn-festive-content {\n\n    position: absolute;\n\n    inset: 0;\n\n    display: flex;\n\n    align-items:\n      flex-start;\n\n    justify-content:\n      center;\n\n    width: 100%;\n\n    height: 100%;\n\n    padding:\n\n      clamp(\n        30px,\n        8.5vw,\n        45px\n      )\n\n      18px\n\n      55px;\n\n    pointer-events: none;\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE COPY\n  ------------------------------------------------------- */\n\n  .hn-festive-copy,\n\n  .hn-content-left\n  .hn-festive-copy,\n\n  .hn-content-right\n  .hn-festive-copy,\n\n  .hn-slide-tradition\n  .hn-festive-copy {\n\n    width: 100%;\n\n    max-width: 395px;\n\n    margin:\n\n      0\n      auto;\n\n    text-align:\n      center;\n\n    transform:\n      translateY(10px);\n\n  }\n\n\n  .hn-festive-slide.is-active\n  .hn-festive-copy {\n\n    transform:\n      translateY(0);\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE EYEBROW\n  ------------------------------------------------------- */\n\n  .hn-festive-eyebrow {\n\n    justify-content:\n      center;\n\n    margin-bottom: 9px;\n\n    color: #79502a;\n\n    font-size: 9px;\n\n    font-weight: 700;\n\n    letter-spacing: 0.19em;\n\n  }\n\n\n  .hn-festive-eyebrow::before {\n\n    display: none;\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE HEADING\n  ------------------------------------------------------- */\n\n  .hn-festive-heading {\n\n    width: 100%;\n\n    max-width: 380px;\n\n    margin:\n\n      0\n      auto;\n\n    color: #34251e;\n\n    text-align: center;\n\n    font-size:\n\n      clamp(\n        29px,\n        8.3vw,\n        39px\n      );\n\n    font-weight: 500;\n\n    line-height: 1.01;\n\n    letter-spacing:\n      -0.035em;\n\n  }\n\n\n  .hn-festive-heading em {\n\n    color: #654834;\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE LINE\n  ------------------------------------------------------- */\n\n  .hn-festive-line {\n\n    width: 38px;\n\n    height: 1.5px;\n\n    margin:\n\n      11px\n      auto\n      10px;\n\n  }\n\n\n\n  /* =======================================================\n     MOBILE DESCRIPTION VISIBILITY FIX\n\n     CHANGED:\n     - darker text\n     - larger text\n     - stronger font weight\n     - subtle premium translucent background\n     - light backdrop blur\n  ======================================================= */\n\n  .hn-festive-description {\n\n    width: auto;\n\n    max-width: 360px;\n\n    margin:\n\n      0\n      auto;\n\n    padding:\n\n      7px\n      11px\n      8px;\n\n    color: #3e2d25;\n\n    text-align: center;\n\n    font-size: 13.2px;\n\n    font-weight: 600;\n\n    line-height: 1.48;\n\n    letter-spacing: 0;\n\n    border:\n\n      1px solid\n      rgba(255,255,255,0.28);\n\n    border-radius: 8px;\n\n    background:\n\n      rgba(255,248,237,0.46);\n\n    box-shadow:\n\n      0 4px 15px\n      rgba(78,49,28,0.055);\n\n    backdrop-filter:\n      blur(3px);\n\n    -webkit-backdrop-filter:\n      blur(3px);\n\n    text-shadow:\n\n      0 1px 0\n      rgba(255,255,255,0.28);\n\n  }\n\n\n\n  /* -------------------------------------------------------\n     MOBILE DOTS\n  ------------------------------------------------------- */\n\n  .hn-festive-dots {\n\n    bottom: 14px;\n\n    gap: 7px;\n\n    padding:\n\n      7px\n      10px;\n\n  }\n\n\n  .hn-festive-dot {\n\n    width: 6px;\n\n    height: 6px;\n\n    min-width: 6px;\n\n  }\n\n\n  .hn-festive-dot.is-active {\n\n    width: 22px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 420px) {\n\n  .hn-festive-content,\n\n  .hn-content-left\n  .hn-festive-content,\n\n  .hn-content-right\n  .hn-festive-content,\n\n  .hn-slide-tradition\n  .hn-festive-content {\n\n    padding:\n\n      28px\n      15px\n      52px;\n\n  }\n\n\n  .hn-festive-heading {\n\n    font-size: 30px;\n\n  }\n\n\n  .hn-festive-description {\n\n    max-width: 345px;\n\n    font-size: 12.8px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   VERY SMALL MOBILE\n========================================================= */\n\n@media screen and (max-width: 350px) {\n\n  .hn-festive-content,\n\n  .hn-content-left\n  .hn-festive-content,\n\n  .hn-content-right\n  .hn-festive-content,\n\n  .hn-slide-tradition\n  .hn-festive-content {\n\n    padding-top: 23px;\n\n  }\n\n\n  .hn-festive-eyebrow {\n\n    margin-bottom: 7px;\n\n    font-size: 8px;\n\n  }\n\n\n  .hn-festive-heading {\n\n    font-size: 27px;\n\n  }\n\n\n  .hn-festive-line {\n\n    margin-top: 8px;\n\n    margin-bottom: 8px;\n\n  }\n\n\n  .hn-festive-description {\n\n    max-width: 300px;\n\n    padding:\n\n      6px\n      9px;\n\n    font-size: 11.5px;\n\n  }\n\n}\n\n\n\n/* =========================================================\n   REDUCED MOTION ACCESSIBILITY\n========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .hn-festive-slide,\n\n  .hn-festive-image,\n\n  .hn-festive-copy,\n\n  .hn-festive-dot {\n\n    transition:\n      none !important;\n\n  }\n\n}\n\n</style>\n\n\n\n<script>\n\n(function () {\n\n  \"use strict\";\n\n\n  /* =====================================================\n     CONFIG\n  ===================================================== */\n\n  var MOBILE_QUERY =\n    window.matchMedia(\n      \"(max-width: 749px)\"\n    );\n\n\n  var AUTOPLAY_DELAY =\n    5500;\n\n\n\n  /* =====================================================\n     REMOVE SECTION TOP SPACING\n  ===================================================== */\n\n  function removeFestiveSectionGap() {\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-festive-slider]\"\n      );\n\n\n    sliders.forEach(\n      function (slider) {\n\n        var section =\n          slider.closest(\n            \".shopify-section\"\n          );\n\n\n        if (!section) {\n          return;\n        }\n\n\n        var element =\n          slider.parentElement;\n\n\n        while (\n          element &&\n          element !== section\n        ) {\n\n          element.style.setProperty(\n            \"margin-top\",\n            \"0\",\n            \"important\"\n          );\n\n\n          element.style.setProperty(\n            \"padding-top\",\n            \"0\",\n            \"important\"\n          );\n\n\n          element =\n            element.parentElement;\n\n        }\n\n\n        section.style.setProperty(\n          \"margin-top\",\n          \"0\",\n          \"important\"\n        );\n\n\n        section.style.setProperty(\n          \"padding-top\",\n          \"0\",\n          \"important\"\n        );\n\n      }\n    );\n\n  }\n\n\n\n  /* =====================================================\n     INITIALIZE SINGLE SLIDER\n  ===================================================== */\n\n  function initializeSlider(slider) {\n\n\n    if (\n      slider.getAttribute(\n        \"data-hn-ready\"\n      ) === \"true\"\n    ) {\n\n      return;\n\n    }\n\n\n    slider.setAttribute(\n      \"data-hn-ready\",\n      \"true\"\n    );\n\n\n    var slides =\n      Array.prototype.slice.call(\n\n        slider.querySelectorAll(\n          \"[data-hn-festive-slide]\"\n        )\n\n      );\n\n\n    var dots =\n      Array.prototype.slice.call(\n\n        slider.querySelectorAll(\n          \"[data-hn-festive-dot]\"\n        )\n\n      );\n\n\n    if (!slides.length) {\n      return;\n    }\n\n\n\n    var currentSlideIndex = null;\n\n    var autoplayTimer = null;\n\n    var touchStartX = 0;\n\n    var touchEndX = 0;\n\n\n\n    /* ===================================================\n       AVAILABLE SLIDES\n\n       Mobile:\n       0, 1, 2\n\n       Desktop:\n       1, 2\n    =================================================== */\n\n    function getAvailableIndexes() {\n\n\n      if (MOBILE_QUERY.matches) {\n\n        return [0, 1, 2];\n\n      }\n\n\n      return [1, 2];\n\n    }\n\n\n\n    /* ===================================================\n       CHECK AVAILABLE\n    =================================================== */\n\n    function isAvailable(index) {\n\n      return (\n        getAvailableIndexes()\n        .indexOf(index) !== -1\n      );\n\n    }\n\n\n\n    /* ===================================================\n       SHOW SLIDE\n    =================================================== */\n\n    function showSlide(index) {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      if (!isAvailable(index)) {\n\n        index =\n          available[0];\n\n      }\n\n\n      slides.forEach(\n        function (slide) {\n\n\n          var slideIndex =\n            parseInt(\n\n              slide.getAttribute(\n                \"data-hn-festive-slide\"\n              ),\n\n              10\n\n            );\n\n\n          var active =\n            slideIndex === index &&\n            isAvailable(slideIndex);\n\n\n          slide.classList.toggle(\n            \"is-active\",\n            active\n          );\n\n\n          slide.setAttribute(\n\n            \"aria-hidden\",\n\n            active\n              ? \"false\"\n              : \"true\"\n\n          );\n\n        }\n      );\n\n\n\n      dots.forEach(\n        function (dot) {\n\n\n          var dotIndex =\n            parseInt(\n\n              dot.getAttribute(\n                \"data-hn-festive-dot\"\n              ),\n\n              10\n\n            );\n\n\n          var active =\n            dotIndex === index &&\n            isAvailable(dotIndex);\n\n\n          dot.classList.toggle(\n            \"is-active\",\n            active\n          );\n\n\n          dot.setAttribute(\n\n            \"aria-current\",\n\n            active\n              ? \"true\"\n              : \"false\"\n\n          );\n\n\n          dot.setAttribute(\n\n            \"aria-hidden\",\n\n            isAvailable(dotIndex)\n              ? \"false\"\n              : \"true\"\n\n          );\n\n        }\n      );\n\n\n      currentSlideIndex =\n        index;\n\n    }\n\n\n\n    /* ===================================================\n       NEXT\n    =================================================== */\n\n    function nextSlide() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      var currentPosition =\n        available.indexOf(\n          currentSlideIndex\n        );\n\n\n      if (currentPosition === -1) {\n\n        showSlide(\n          available[0]\n        );\n\n        return;\n\n      }\n\n\n      var nextPosition =\n        currentPosition + 1;\n\n\n      if (\n        nextPosition >=\n        available.length\n      ) {\n\n        nextPosition = 0;\n\n      }\n\n\n      showSlide(\n        available[nextPosition]\n      );\n\n    }\n\n\n\n    /* ===================================================\n       PREVIOUS\n    =================================================== */\n\n    function previousSlide() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      var currentPosition =\n        available.indexOf(\n          currentSlideIndex\n        );\n\n\n      if (currentPosition === -1) {\n\n        showSlide(\n          available[0]\n        );\n\n        return;\n\n      }\n\n\n      var previousPosition =\n        currentPosition - 1;\n\n\n      if (\n        previousPosition < 0\n      ) {\n\n        previousPosition =\n          available.length - 1;\n\n      }\n\n\n      showSlide(\n        available[previousPosition]\n      );\n\n    }\n\n\n\n    /* ===================================================\n       AUTOPLAY\n    =================================================== */\n\n    function stopAutoplay() {\n\n\n      if (\n        autoplayTimer !== null\n      ) {\n\n        clearInterval(\n          autoplayTimer\n        );\n\n\n        autoplayTimer =\n          null;\n\n      }\n\n    }\n\n\n\n    function startAutoplay() {\n\n\n      stopAutoplay();\n\n\n      if (\n\n        window.matchMedia(\n          \"(prefers-reduced-motion: reduce)\"\n        ).matches\n\n      ) {\n\n        return;\n\n      }\n\n\n      autoplayTimer =\n        setInterval(\n\n          nextSlide,\n\n          AUTOPLAY_DELAY\n\n        );\n\n    }\n\n\n\n    /* ===================================================\n       DOT CLICK\n    =================================================== */\n\n    dots.forEach(\n      function (dot) {\n\n\n        dot.addEventListener(\n          \"click\",\n          function () {\n\n\n            var index =\n              parseInt(\n\n                dot.getAttribute(\n                  \"data-hn-festive-dot\"\n                ),\n\n                10\n\n              );\n\n\n            if (\n              isNaN(index) ||\n              !isAvailable(index)\n            ) {\n\n              return;\n\n            }\n\n\n            showSlide(index);\n\n\n            startAutoplay();\n\n          }\n        );\n\n      }\n    );\n\n\n\n    /* ===================================================\n       PAUSE DESKTOP AUTOPLAY ON HOVER\n    =================================================== */\n\n    slider.addEventListener(\n      \"mouseenter\",\n      function () {\n\n        if (\n          !MOBILE_QUERY.matches\n        ) {\n\n          stopAutoplay();\n\n        }\n\n      }\n    );\n\n\n    slider.addEventListener(\n      \"mouseleave\",\n      function () {\n\n        if (\n          !MOBILE_QUERY.matches\n        ) {\n\n          startAutoplay();\n\n        }\n\n      }\n    );\n\n\n\n    /* ===================================================\n       MOBILE SWIPE\n    =================================================== */\n\n    slider.addEventListener(\n\n      \"touchstart\",\n\n      function (event) {\n\n\n        if (\n          !event.touches.length\n        ) {\n\n          return;\n\n        }\n\n\n        touchStartX =\n          event.touches[0].clientX;\n\n      },\n\n      {\n        passive: true\n      }\n\n    );\n\n\n\n    slider.addEventListener(\n\n      \"touchend\",\n\n      function (event) {\n\n\n        if (\n          !event.changedTouches.length\n        ) {\n\n          return;\n\n        }\n\n\n        touchEndX =\n          event.changedTouches[0].clientX;\n\n\n        var difference =\n          touchStartX -\n          touchEndX;\n\n\n        if (\n          Math.abs(difference) <\n          45\n        ) {\n\n          return;\n\n        }\n\n\n        if (\n          difference > 0\n        ) {\n\n          nextSlide();\n\n        } else {\n\n          previousSlide();\n\n        }\n\n\n        startAutoplay();\n\n      },\n\n      {\n        passive: true\n      }\n\n    );\n\n\n\n    /* ===================================================\n       TAB VISIBILITY\n    =================================================== */\n\n    document.addEventListener(\n\n      \"visibilitychange\",\n\n      function () {\n\n\n        if (\n          document.hidden\n        ) {\n\n          stopAutoplay();\n\n        } else {\n\n          startAutoplay();\n\n        }\n\n      }\n\n    );\n\n\n\n    /* ===================================================\n       RESPONSIVE BREAKPOINT CHANGE\n\n       Mobile starts at m1.\n       Desktop starts at desktop 2.webp.\n    =================================================== */\n\n    function handleBreakpointChange() {\n\n\n      var available =\n        getAvailableIndexes();\n\n\n      if (\n        available.indexOf(\n          currentSlideIndex\n        ) === -1\n      ) {\n\n        showSlide(\n          available[0]\n        );\n\n      }\n\n\n      startAutoplay();\n\n    }\n\n\n\n    if (\n      MOBILE_QUERY.addEventListener\n    ) {\n\n      MOBILE_QUERY.addEventListener(\n        \"change\",\n        handleBreakpointChange\n      );\n\n    } else {\n\n      MOBILE_QUERY.addListener(\n        handleBreakpointChange\n      );\n\n    }\n\n\n\n    /* ===================================================\n       INITIAL SLIDE\n    =================================================== */\n\n    var initialIndexes =\n      getAvailableIndexes();\n\n\n    showSlide(\n      initialIndexes[0]\n    );\n\n\n    startAutoplay();\n\n  }\n\n\n\n  /* =====================================================\n     INITIALIZE ALL\n  ===================================================== */\n\n  function initializeAllFestiveSliders() {\n\n\n    removeFestiveSectionGap();\n\n\n    var sliders =\n      document.querySelectorAll(\n        \"[data-hn-festive-slider]\"\n      );\n\n\n    sliders.forEach(\n      initializeSlider\n    );\n\n  }\n\n\n\n  initializeAllFestiveSliders();\n\n\n\n  setTimeout(\n    removeFestiveSectionGap,\n    200\n  );\n\n\n  setTimeout(\n    removeFestiveSectionGap,\n    700\n  );\n\n\n\n  /* =====================================================\n     SHOPIFY THEME EDITOR SUPPORT\n  ===================================================== */\n\n  document.addEventListener(\n\n    \"shopify:section:load\",\n\n    function () {\n\n\n      initializeAllFestiveSliders();\n\n\n      setTimeout(\n        removeFestiveSectionGap,\n        100\n      );\n\n    }\n\n  );\n\n\n})();\n\n</script>"
      }
    },
