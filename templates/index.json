        "custom_html": "<!-- =========================================================\nHERTHA NEST — PREMIUM HANDCRAFTED HERO CAROUSEL\n\nMOBILE\nSlide 1 = m1.webp\nSlide 2 = m2.webp\nSlide 3 = m3.webp\n\nDESKTOP\nSlide 1 = new1.webp\nProduct RIGHT → Content LEFT\n\nSlide 2 = new2.webp\nProduct LEFT → Content RIGHT\n\nCTA:\nhttps://herthanest.in/collections/festival-specials\n\nLATEST CHANGES\n---------------------------------------------------------\n1. Slide 2 content moved further RIGHT on desktop.\n2. Slide 2 heading now uses SAME font size as Slide 1.\n3. \"Tradition, Beautifully\" stays on one line on desktop.\n4. Aggressive removal of Custom HTML top spacing.\n========================================================= -->\n\n\n<section class=\"hn-premium-hero\" data-hn-premium-slider=\"\" aria-label=\"Hertha Nest handcrafted home decor\">\n\n  <div class=\"hn-premium-track\">\n\n\n    <!-- =====================================================\n    MOBILE SLIDE 1\n    ====================================================== -->\n\n    <article class=\"hn-premium-slide hn-mobile-only-slide\" data-hn-premium-slide=\"0\" aria-hidden=\"true\">\n\n      <div class=\"hn-premium-media\">\n\n        <picture>\n\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/m1.webp?v=1788857588\">\n\n          <img class=\"hn-premium-image\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==\" alt=\"Hertha Nest handcrafted festive gifting collection\" width=\"800\" height=\"1000\" loading=\"eager\" fetchpriority=\"high\">\n\n        </source></picture>\n\n      </div>\n\n      <div class=\"hn-premium-overlay\"></div>\n\n\n      <div class=\"hn-premium-content\">\n\n        <div class=\"hn-premium-copy\">\n\n          <span class=\"hn-premium-eyebrow\">\n            FESTIVE EDIT\n          </span>\n\n\n          <h2 class=\"hn-premium-heading\">\n            Gifts Made to\n            <em>Feel Personal.</em>\n          </h2>\n\n\n          <span class=\"hn-premium-line\"></span>\n\n\n          <p class=\"hn-premium-description\">\n            Thoughtfully handcrafted pieces that turn festive gifting\n            into something beautiful, meaningful and memorable.\n          </p>\n\n\n          <a class=\"hn-premium-button\" href=\"https://herthanest.in/collections/festival-specials\" aria-label=\"Shop Hertha Nest festival specials\">\n\n            <span>\n              Shop the Collection\n            </span>\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n              <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n\n          </a>\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- =====================================================\n    DESKTOP SLIDE 1\n\n    IMAGE:\n    new1.webp\n\n    PRODUCT RIGHT\n    CONTENT LEFT\n\n    MOBILE:\n    m2.webp\n    ====================================================== -->\n\n    <article class=\"\n        hn-premium-slide\n        hn-content-left\n        hn-slide-handcrafted\n      \" data-hn-premium-slide=\"1\" aria-hidden=\"true\">\n\n      <div class=\"hn-premium-media\">\n\n        <picture>\n\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/m2.webp?v=1788857588\">\n\n          <img class=\"hn-premium-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/new1.webp?v=1788941273\" alt=\"Hertha Nest handcrafted Indian home decor collection\" width=\"1600\" height=\"750\" loading=\"eager\" fetchpriority=\"high\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-premium-overlay\"></div>\n\n\n      <div class=\"hn-premium-content\">\n\n        <div class=\"hn-premium-copy\">\n\n          <span class=\"hn-premium-eyebrow\">\n            ART   |   HERITAGE   |   A BRIGHTER HOME\n          </span>\n\n\n          <h2 class=\"hn-premium-heading\">\n\n            Handcrafted\n\n            <span>\n              Stories\n            </span>\n\n            <em>\n              for Modern Homes\n            </em>\n\n          </h2>\n\n\n\n          <!-- PREMIUM ORNAMENT -->\n\n          <div class=\"hn-premium-ornament\" aria-hidden=\"true\">\n\n            <span></span>\n            <i></i>\n            <span></span>\n\n          </div>\n\n\n\n          <p class=\"hn-premium-description\">\n\n            Bring home the charm of Indian craftsmanship with timeless\n            décor pieces that blend tradition with today’s living.\n\n          </p>\n\n\n\n          <a class=\"hn-premium-button\" href=\"https://herthanest.in/collections/festival-specials\" aria-label=\"Shop Hertha Nest Festival Specials\">\n\n            <span>\n              Shop the Collection\n            </span>\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n              <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n\n          </a>\n\n\n\n          <!-- PREMIUM FEATURE ROW -->\n\n          <div class=\"hn-premium-features\" aria-label=\"Hertha Nest collection highlights\">\n\n\n            <div class=\"hn-premium-feature\">\n\n              <span class=\"hn-feature-icon\">\n\n                <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                </svg>\n\n              </span>\n\n              <span>\n                Authentic<br>\n                Craftsmanship\n              </span>\n\n            </div>\n\n\n\n            <span class=\"hn-feature-separator\"></span>\n\n\n\n            <div class=\"hn-premium-feature\">\n\n              <span class=\"hn-feature-icon\">\n\n                <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M3 10.5 12 3l9 7.5V21H3V10.5Zm5 10.5v-7h8v7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                </svg>\n\n              </span>\n\n              <span>\n                Beautiful<br>\n                Home Décor\n              </span>\n\n            </div>\n\n\n\n            <span class=\"hn-feature-separator\"></span>\n\n\n\n            <div class=\"hn-premium-feature\">\n\n              <span class=\"hn-feature-icon\">\n\n                <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M4 10h16v11H4V10Zm-1-4h18v4H3V6Zm9 15V6m0 0c-1-4-6-4-6-1 0 2 3 2 6 1Zm0 0c1-4 6-4 6-1 0 2-3 2-6 1Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                </svg>\n\n              </span>\n\n              <span>\n                Perfect<br>\n                for Gifting\n              </span>\n\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- =====================================================\n    DESKTOP SLIDE 2\n\n    IMAGE:\n    new2.webp\n\n    PRODUCT LEFT\n    CONTENT RIGHT\n\n    MOBILE:\n    m3.webp\n\n    IMPORTANT:\n    Text is intentionally shifted further right on desktop.\n    Heading uses SAME size as Slide 1.\n    ====================================================== -->\n\n    <article class=\"\n        hn-premium-slide\n        hn-content-right\n        hn-slide-tradition\n      \" data-hn-premium-slide=\"2\" aria-hidden=\"true\">\n\n      <div class=\"hn-premium-media\">\n\n        <picture>\n\n          <source media=\"(max-width: 749px)\" srcset=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/m3.webp?v=1788857588\">\n\n          <img class=\"hn-premium-image\" src=\"https://cdn.shopify.com/s/files/1/0677/4649/6670/files/new2.webp?v=1788941273\" alt=\"Hertha Nest Indian artisan decor collection\" width=\"1600\" height=\"750\" loading=\"lazy\">\n\n        </source></picture>\n\n      </div>\n\n\n      <div class=\"hn-premium-overlay\"></div>\n\n\n      <div class=\"hn-premium-content\">\n\n        <div class=\"hn-premium-copy\">\n\n\n          <span class=\"hn-premium-eyebrow\">\n\n            ROOTED IN INDIA\n              |  \n            MADE WITH CHARACTER\n\n          </span>\n\n\n\n          <h2 class=\"\n              hn-premium-heading\n              hn-tradition-heading\n            \">\n\n            <span class=\"hn-tradition-first-line\">\n              Tradition, Beautifully\n            </span>\n\n            <em>\n              Reimagined.\n            </em>\n\n          </h2>\n\n\n\n          <!-- PREMIUM ORNAMENT -->\n\n          <div class=\"hn-premium-ornament\" aria-hidden=\"true\">\n\n            <span></span>\n            <i></i>\n            <span></span>\n\n          </div>\n\n\n\n          <p class=\"hn-premium-description\">\n\n            Discover expressive handcrafted accents inspired by Indian\n            artistry, thoughtfully created for beautiful modern homes.\n\n          </p>\n\n\n\n          <a class=\"hn-premium-button\" href=\"https://herthanest.in/collections/festival-specials\" aria-label=\"Shop Hertha Nest Festival Specials\">\n\n            <span>\n              Shop the Collection\n            </span>\n\n            <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n              <path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg>\n\n          </a>\n\n\n\n          <!-- PREMIUM FEATURE ROW -->\n\n          <div class=\"hn-premium-features\" aria-label=\"Hertha Nest collection highlights\">\n\n\n            <div class=\"hn-premium-feature\">\n\n              <span class=\"hn-feature-icon\">\n\n                <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M12 21V10M12 15C7 15 4 12 4 7c5 0 8 3 8 8ZM12 13c0-5 3-8 8-8 0 5-3 8-8 8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                </svg>\n\n              </span>\n\n              <span>\n                Indian<br>\n                Craftsmanship\n              </span>\n\n            </div>\n\n\n\n            <span class=\"hn-feature-separator\"></span>\n\n\n\n            <div class=\"hn-premium-feature\">\n\n              <span class=\"hn-feature-icon\">\n\n                <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M3 10.5 12 3l9 7.5V21H3V10.5Zm5 10.5v-7h8v7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                </svg>\n\n              </span>\n\n              <span>\n                Modern<br>\n                Home Styling\n              </span>\n\n            </div>\n\n\n\n            <span class=\"hn-feature-separator\"></span>\n\n\n\n            <div class=\"hn-premium-feature\">\n\n              <span class=\"hn-feature-icon\">\n\n                <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\">\n                  <path d=\"M4 10h16v11H4V10Zm-1-4h18v4H3V6Zm9 15V6m0 0c-1-4-6-4-6-1 0 2 3 2 6 1Zm0 0c1-4 6-4 6-1 0 2-3 2-6 1Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                </svg>\n\n              </span>\n\n              <span>\n                Thoughtful<br>\n                Gifting\n              </span>\n\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </article>\n\n  </div>\n\n\n\n  <!-- =====================================================\n  DOT NAVIGATION\n  ====================================================== -->\n\n  <div class=\"hn-premium-dots\" aria-label=\"Promotional banner navigation\">\n\n    <button type=\"button\" class=\"hn-premium-dot hn-mobile-only-dot\" data-hn-premium-dot=\"0\" aria-label=\"Show festive gifting banner\" aria-current=\"false\"></button>\n\n\n    <button type=\"button\" class=\"hn-premium-dot\" data-hn-premium-dot=\"1\" aria-label=\"Show handcrafted home decor banner\" aria-current=\"false\"></button>\n\n\n    <button type=\"button\" class=\"hn-premium-dot\" data-hn-premium-dot=\"2\" aria-label=\"Show artisan decor banner\" aria-current=\"false\"></button>\n\n  </div>\n\n</section>\n\n\n\n<style>\n\n/* =========================================================\nHERTHA NEST PREMIUM HERO\n========================================================= */\n\n\n/* =========================================================\nCUSTOM HTML THEME-SHELL HARD RESET\n========================================================= */\n\n/*\n  WHY THIS EXISTS\n\n  The theme's Custom HTML section renders its own outer wrapper\n  and \"Section Heading\" area BEFORE the code pasted into the\n  Custom HTML field.\n\n  Setting the editor's Top/Bottom padding to 0 only resets part\n  of that wrapper. The heading shell can still keep height even\n  when the Section title field is empty.\n\n  This reset:\n  1. Removes OUTER top + bottom spacing.\n  2. Hides the theme-generated heading/title shell completely.\n  3. Removes wrapper width/padding restrictions.\n  4. Does NOT remove spacing inside the actual hero design.\n*/\n\n.shopify-section:has(.hn-premium-hero) {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin: 0 !important;\n  margin-block: 0 !important;\n\n  padding: 0 !important;\n  padding-block: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Reset common Custom HTML wrappers around the hero */\n\n.shopify-section:has(.hn-premium-hero) > div,\n.shopify-section:has(.hn-premium-hero) > div > div,\n.shopify-section:has(.hn-premium-hero) .section,\n.shopify-section:has(.hn-premium-hero) .section-padding,\n.shopify-section:has(.hn-premium-hero) .section__wrapper,\n.shopify-section:has(.hn-premium-hero) .section-wrapper,\n.shopify-section:has(.hn-premium-hero) .custom-html,\n.shopify-section:has(.hn-premium-hero) .custom-html__inner,\n.shopify-section:has(.hn-premium-hero) .custom-html-wrapper,\n.shopify-section:has(.hn-premium-hero) .custom-html-section,\n.shopify-section:has(.hn-premium-hero) .page-width,\n.shopify-section:has(.hn-premium-hero) .container,\n.shopify-section:has(.hn-premium-hero) .container-fluid {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  margin-block: 0 !important;\n\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n  padding-block: 0 !important;\n\n  min-height: 0 !important;\n\n  --section-padding-top: 0px !important;\n  --section-padding-bottom: 0px !important;\n  --section-spacing-top: 0px !important;\n  --section-spacing-bottom: 0px !important;\n  --spacing-top: 0px !important;\n  --spacing-bottom: 0px !important;\n}\n\n\n/* Remove theme width restrictions */\n\n.shopify-section:has(.hn-premium-hero) .page-width,\n.shopify-section:has(.hn-premium-hero) .container,\n.shopify-section:has(.hn-premium-hero) .container-fluid,\n.shopify-section:has(.hn-premium-hero) .custom-html,\n.shopify-section:has(.hn-premium-hero) .custom-html__inner,\n.shopify-section:has(.hn-premium-hero) .custom-html-wrapper,\n.shopify-section:has(.hn-premium-hero) .custom-html-section {\n  width: 100% !important;\n  max-width: none !important;\n\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n\n/*\n  IMPORTANT:\n  The theme heading shell is hidden whether the Section title\n  field is empty OR contains test text such as \"hello\".\n\n  Our hero uses hn-* classes, so these selectors do not touch\n  the hero's own eyebrow/headings.\n*/\n\n.shopify-section:has(.hn-premium-hero) .section-heading,\n.shopify-section:has(.hn-premium-hero) .section__heading,\n.shopify-section:has(.hn-premium-hero) .section-title,\n.shopify-section:has(.hn-premium-hero) .section__title,\n.shopify-section:has(.hn-premium-hero) .section-header,\n.shopify-section:has(.hn-premium-hero) .section__header,\n.shopify-section:has(.hn-premium-hero) .section-head,\n.shopify-section:has(.hn-premium-hero) .heading-wrapper,\n.shopify-section:has(.hn-premium-hero) .title-wrapper,\n.shopify-section:has(.hn-premium-hero) [class*=\"section-heading\"],\n.shopify-section:has(.hn-premium-hero) [class*=\"section__heading\"],\n.shopify-section:has(.hn-premium-hero) [class*=\"section-title\"],\n.shopify-section:has(.hn-premium-hero) [class*=\"section__title\"] {\n  display: none !important;\n\n  width: 0 !important;\n  height: 0 !important;\n  min-height: 0 !important;\n  max-height: 0 !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  border: 0 !important;\n\n  overflow: hidden !important;\n}\n\n\n/* Hero itself must touch the section boundaries */\n\n.hn-premium-hero {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n/* =========================================================\nHEADER / DROPDOWN SAFETY\n========================================================= */\n\n#shopify-section-header,\n.shopify-section-header,\n.shopify-section-header-sticky,\n.shopify-section-group-header-group {\n\n  position: relative;\n\n  z-index: 9999 !important;\n\n}\n\n\n#shopify-section-header,\n#shopify-section-header header,\n#shopify-section-header .header-wrapper,\n#shopify-section-header .header,\n\n.shopify-section-header,\n.shopify-section-header header,\n.shopify-section-header .header-wrapper,\n.shopify-section-header .header,\n\n.header__inline-menu,\n.header__menu,\n.header__navigation,\n.header__menu-container,\n.header__menu-wrapper {\n\n  overflow: visible !important;\n\n}\n\n\n.header__submenu,\n.header__submenu.list-menu,\n.list-menu--disclosure,\n.mega-menu,\n.mega-menu__content,\n.dropdown,\n.dropdown-menu,\n.submenu,\n.sub-menu {\n\n  z-index: 99999 !important;\n\n}\n\n\n\n/* =========================================================\nHERO\n========================================================= */\n\n.hn-premium-hero {\n\n  --hn-brown: #3b271d;\n\n  --hn-brown-soft: #694735;\n\n  --hn-rust: #aa4c1d;\n\n  --hn-rust-dark: #893410;\n\n  --hn-gold: #b67c38;\n\n  --hn-copy: #59463b;\n\n  --hn-cream: #faf1e2;\n\n\n  position: relative;\n\n  z-index: 1;\n\n\n  display: block;\n\n\n  width: 100vw;\n\n  max-width: 100vw;\n\n\n  margin:\n\n    0\n    calc(50% - 50vw);\n\n\n  padding: 0 !important;\n\n\n  overflow: hidden;\n\n\n  background:\n    #ead4b6;\n\n\n  isolation:\n    isolate;\n\n}\n\n\n\n.hn-premium-hero *,\n.hn-premium-hero *::before,\n.hn-premium-hero *::after {\n\n  box-sizing:\n    border-box;\n\n}\n\n\n\n/* =========================================================\nTRACK\n========================================================= */\n\n.hn-premium-track {\n\n  position: relative;\n\n\n  width: 100%;\n\n\n  aspect-ratio:\n    1600 / 750;\n\n\n  margin: 0;\n\n\n  padding: 0;\n\n\n  overflow:\n    hidden;\n\n}\n\n\n\n/* =========================================================\nSLIDES\n========================================================= */\n\n.hn-premium-slide {\n\n  position: absolute;\n\n  inset: 0;\n\n\n  width: 100%;\n\n  height: 100%;\n\n\n  margin: 0;\n\n  padding: 0;\n\n\n  opacity: 0;\n\n  visibility: hidden;\n\n  pointer-events: none;\n\n\n  z-index: 1;\n\n\n  transition:\n\n    opacity\n    850ms\n    cubic-bezier(.22,.61,.36,1),\n\n    visibility\n    850ms\n    ease;\n\n}\n\n\n\n.hn-premium-slide.is-active {\n\n  opacity: 1;\n\n  visibility: visible;\n\n  pointer-events: auto;\n\n\n  z-index: 2;\n\n}\n\n\n\n/* =========================================================\nDESKTOP\n========================================================= */\n\n@media screen and (min-width: 750px) {\n\n  .hn-mobile-only-slide,\n  .hn-mobile-only-dot {\n\n    display: none !important;\n\n  }\n\n}\n\n\n\n/* =========================================================\nIMAGE\n========================================================= */\n\n.hn-premium-media,\n.hn-premium-media picture {\n\n  position: absolute;\n\n  inset: 0;\n\n\n  display: block;\n\n\n  width: 100%;\n\n  height: 100%;\n\n\n  margin: 0;\n\n  padding: 0;\n\n\n  overflow:\n    hidden;\n\n}\n\n\n\n.hn-premium-image {\n\n  display: block;\n\n\n  width: 100%;\n\n  height: 100%;\n\n\n  margin: 0;\n\n\n  border: 0;\n\n\n  object-fit:\n    cover;\n\n\n  object-position:\n    center center;\n\n\n  transform:\n    scale(1.005);\n\n\n  transition:\n\n    transform\n    7s\n    cubic-bezier(.22,.61,.36,1);\n\n}\n\n\n\n.hn-premium-slide.is-active\n.hn-premium-image {\n\n  transform:\n    scale(1.022);\n\n}\n\n\n\n/* =========================================================\nOVERLAY\n========================================================= */\n\n.hn-premium-overlay {\n\n  position: absolute;\n\n  inset: 0;\n\n\n  z-index: 1;\n\n\n  pointer-events: none;\n\n}\n\n\n\n/* =========================================================\nSLIDE 1 — TEXT LEFT\n========================================================= */\n\n.hn-content-left\n.hn-premium-overlay {\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(250,242,229,.91) 0%,\n\n      rgba(250,242,229,.80) 20%,\n\n      rgba(250,242,229,.52) 34%,\n\n      rgba(250,242,229,.18) 47%,\n\n      rgba(250,242,229,.025) 59%,\n\n      rgba(250,242,229,0) 68%\n\n    );\n\n}\n\n\n\n/* =========================================================\nSLIDE 2 — TEXT RIGHT\n========================================================= */\n\n.hn-content-right\n.hn-premium-overlay {\n\n  background:\n\n    linear-gradient(\n\n      270deg,\n\n      rgba(250,242,229,.91) 0%,\n\n      rgba(250,242,229,.80) 21%,\n\n      rgba(250,242,229,.52) 35%,\n\n      rgba(250,242,229,.17) 48%,\n\n      rgba(250,242,229,.025) 60%,\n\n      rgba(250,242,229,0) 69%\n\n    );\n\n}\n\n\n\n/* =========================================================\nCINEMATIC DEPTH\n========================================================= */\n\n.hn-premium-slide::after {\n\n  content: \"\";\n\n\n  position: absolute;\n\n  inset: 0;\n\n\n  z-index: 1;\n\n\n  pointer-events: none;\n\n\n  background:\n\n    linear-gradient(\n\n      180deg,\n\n      rgba(31,20,13,.008) 0%,\n\n      rgba(31,20,13,0) 65%,\n\n      rgba(31,20,13,.07) 100%\n\n    );\n\n}\n\n\n\n/* =========================================================\nCONTENT\n========================================================= */\n\n.hn-premium-content {\n\n  position: relative;\n\n\n  z-index: 4;\n\n\n  display: flex;\n\n\n  align-items: center;\n\n\n  width: 100%;\n\n  height: 100%;\n\n\n  margin: 0;\n\n\n  padding:\n\n    45px\n    clamp(\n      70px,\n      6.4vw,\n      124px\n    );\n\n}\n\n\n\n.hn-content-left\n.hn-premium-content {\n\n  justify-content:\n    flex-start;\n\n}\n\n\n\n.hn-content-right\n.hn-premium-content {\n\n  justify-content:\n    flex-end;\n\n}\n\n\n\n/* =========================================================\nCOPY\n========================================================= */\n\n.hn-premium-copy {\n\n  position: relative;\n\n\n  width: 100%;\n\n\n  max-width:\n    620px;\n\n\n  margin: 0;\n\n\n  opacity: 0;\n\n\n  transform:\n    translateY(20px);\n\n\n  transition:\n\n    opacity\n    700ms\n    ease\n    170ms,\n\n    transform\n    700ms\n    cubic-bezier(.22,.61,.36,1)\n    170ms;\n\n}\n\n\n\n.hn-premium-slide.is-active\n.hn-premium-copy {\n\n  opacity: 1;\n\n\n  transform:\n    translateY(0);\n\n}\n\n\n\n/* =========================================================\nSECOND SLIDE DESKTOP POSITION\n\nThis is the important change.\n\nContent stays structurally in the right side but the copy itself\nis shifted further RIGHT without sacrificing its available width.\n========================================================= */\n\n@media screen and (min-width: 1101px) {\n\n\n  .hn-content-right\n  .hn-premium-content {\n\n    padding-left:\n      53%;\n\n\n    padding-right:\n\n      clamp(\n        65px,\n        6vw,\n        115px\n      );\n\n  }\n\n\n\n  .hn-content-right\n  .hn-premium-copy {\n\n    max-width:\n      760px;\n\n\n    /*\n    MOVE SECOND SLIDE TEXT FURTHER RIGHT\n    */\n\n    left:\n\n      clamp(\n        32px,\n        2.8vw,\n        54px\n      );\n\n  }\n\n}\n\n\n\n/* =========================================================\nSUBTLE PREMIUM LIGHT BEHIND RIGHT COPY\n========================================================= */\n\n@media screen and (min-width: 1101px) {\n\n  .hn-content-right\n  .hn-premium-copy::before {\n\n    content: \"\";\n\n\n    position: absolute;\n\n\n    z-index:\n      -1;\n\n\n    top:\n      -35px;\n\n\n    right:\n      -40px;\n\n\n    bottom:\n      -30px;\n\n\n    left:\n      -45px;\n\n\n    border-radius:\n      40px;\n\n\n    background:\n\n      radial-gradient(\n\n        ellipse at center,\n\n        rgba(255,248,236,.17) 0%,\n\n        rgba(255,248,236,.07) 48%,\n\n        rgba(255,248,236,0) 76%\n\n      );\n\n\n    pointer-events:\n      none;\n\n  }\n\n}\n\n\n\n/* =========================================================\nEYEBROW\n========================================================= */\n\n.hn-premium-eyebrow {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    13px;\n\n\n  width:\n    fit-content;\n\n\n  margin:\n\n    0\n    0\n    17px;\n\n\n  color:\n    #8d5d2f;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      9px,\n      .67vw,\n      11px\n    );\n\n\n  font-weight:\n    700;\n\n\n  line-height:\n    1.35;\n\n\n  letter-spacing:\n    .22em;\n\n\n  text-transform:\n    uppercase;\n\n}\n\n\n\n.hn-premium-eyebrow::before {\n\n  content: \"\";\n\n\n  display:\n    block;\n\n\n  width:\n    25px;\n\n\n  height:\n    1px;\n\n\n  flex:\n\n    0\n    0\n    25px;\n\n\n  background:\n    currentColor;\n\n\n  opacity:\n    .65;\n\n}\n\n\n\n/* =========================================================\nMAIN HEADING\n\nIMPORTANT:\nThis SINGLE font-size rule now controls BOTH desktop slides.\nTherefore Slide 2 has exactly the same heading scale as Slide 1.\n========================================================= */\n\n.hn-premium-heading {\n\n  display:\n    flex;\n\n\n  flex-direction:\n    column;\n\n\n  width:\n    100%;\n\n\n  margin:\n    0;\n\n\n  color:\n    var(--hn-brown);\n\n\n  font-family:\n\n    Georgia,\n    \"Times New Roman\",\n    serif;\n\n\n  font-size:\n\n    clamp(\n      44px,\n      4vw,\n      73px\n    );\n\n\n  font-weight:\n    500;\n\n\n  line-height:\n    .97;\n\n\n  letter-spacing:\n    -.045em;\n\n}\n\n\n\n.hn-premium-heading > span {\n\n  display:\n    block;\n\n}\n\n\n\n.hn-premium-heading em {\n\n  display:\n    block;\n\n\n  margin-top:\n    6px;\n\n\n  color:\n    var(--hn-rust);\n\n\n  font-weight:\n    400;\n\n\n  font-style:\n    italic;\n\n\n  font-size:\n    .82em;\n\n\n  line-height:\n    1.08;\n\n\n  letter-spacing:\n    -.035em;\n\n}\n\n\n\n/* =========================================================\nSECOND SLIDE HEADING\n\nNO DIFFERENT FONT SIZE HERE.\n\nIt deliberately inherits the exact same:\nfont-size\nline-height\nitalic scale\n\nas Slide 1.\n========================================================= */\n\n.hn-tradition-heading {\n\n  max-width:\n    760px;\n\n}\n\n\n\n/* Desktop keeps this line together */\n\n@media screen and (min-width: 1101px) {\n\n  .hn-tradition-first-line {\n\n    display:\n      block;\n\n\n    white-space:\n      nowrap;\n\n  }\n\n}\n\n\n\n/* =========================================================\nPREMIUM ORNAMENT\n========================================================= */\n\n.hn-premium-ornament {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    8px;\n\n\n  width:\n    78px;\n\n\n  height:\n    12px;\n\n\n  margin-top:\n    22px;\n\n}\n\n\n\n.hn-premium-ornament span {\n\n  display:\n    block;\n\n\n  width:\n    28px;\n\n\n  height:\n    1px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(139,89,43,.18),\n\n      rgba(139,89,43,.72)\n\n    );\n\n}\n\n\n\n.hn-premium-ornament span:last-child {\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      rgba(139,89,43,.72),\n\n      rgba(139,89,43,.18)\n\n    );\n\n}\n\n\n\n.hn-premium-ornament i {\n\n  display:\n    block;\n\n\n  width:\n    6px;\n\n\n  height:\n    6px;\n\n\n  border:\n\n    1px solid\n    rgba(139,89,43,.78);\n\n\n  background:\n\n    rgba(255,244,226,.55);\n\n\n  transform:\n    rotate(45deg);\n\n}\n\n\n\n/* =========================================================\nMOBILE-FIRST SLIDE\n========================================================= */\n\n.hn-mobile-only-slide\n.hn-premium-heading {\n\n  display:\n    block;\n\n}\n\n\n.hn-mobile-only-slide\n.hn-premium-heading em {\n\n  display:\n    block;\n\n}\n\n\n\n/* =========================================================\nDECORATIVE LINE\n========================================================= */\n\n.hn-premium-line {\n\n  display:\n    block;\n\n\n  width:\n    52px;\n\n\n  height:\n    2px;\n\n\n  margin:\n\n    22px\n    0\n    17px;\n\n\n  border-radius:\n    50px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      #8c5725,\n\n      #d5a05a\n\n    );\n\n}\n\n\n\n/* =========================================================\nDESCRIPTION\n========================================================= */\n\n.hn-premium-description {\n\n  width:\n    100%;\n\n\n  max-width:\n    540px;\n\n\n  margin:\n\n    17px\n    0\n    0;\n\n\n  color:\n    var(--hn-copy);\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n\n    clamp(\n      14px,\n      1vw,\n      17px\n    );\n\n\n  font-weight:\n    400;\n\n\n  line-height:\n    1.62;\n\n\n  letter-spacing:\n    .002em;\n\n}\n\n\n\n.hn-mobile-only-slide\n.hn-premium-description {\n\n  margin-top:\n    0;\n\n}\n\n\n\n/* =========================================================\nCTA BUTTON\n========================================================= */\n\n.hn-premium-button {\n\n  position:\n    relative;\n\n\n  display:\n    inline-flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  gap:\n    18px;\n\n\n  min-width:\n    242px;\n\n\n  margin-top:\n    27px;\n\n\n  padding:\n\n    16px\n    24px;\n\n\n  overflow:\n    hidden;\n\n\n  border:\n\n    1px solid\n    rgba(113,45,14,.18);\n\n\n  border-radius:\n    6px;\n\n\n  background:\n\n    linear-gradient(\n\n      135deg,\n\n      #ad4818 0%,\n\n      #8c3210 100%\n\n    );\n\n\n  box-shadow:\n\n    0\n    12px\n    28px\n    rgba(109,51,22,.20),\n\n    inset\n    0\n    1px\n    0\n    rgba(255,255,255,.14);\n\n\n  color:\n    #ffffff !important;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n    15px;\n\n\n  font-weight:\n    600;\n\n\n  line-height:\n    1;\n\n\n  text-decoration:\n    none !important;\n\n\n  cursor:\n    pointer;\n\n\n  pointer-events:\n    auto;\n\n\n  transform:\n    translateZ(0);\n\n\n  transition:\n\n    transform\n    250ms\n    ease,\n\n    box-shadow\n    250ms\n    ease,\n\n    filter\n    250ms\n    ease;\n\n}\n\n\n\n.hn-premium-button::before {\n\n  content: \"\";\n\n\n  position:\n    absolute;\n\n\n  top:\n    0;\n\n\n  left:\n    -75%;\n\n\n  width:\n    46%;\n\n\n  height:\n    100%;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      transparent,\n\n      rgba(255,255,255,.18),\n\n      transparent\n\n    );\n\n\n  transform:\n    skewX(-22deg);\n\n\n  transition:\n\n    left\n    620ms\n    ease;\n\n}\n\n\n\n.hn-premium-button:hover {\n\n  transform:\n\n    translateY(-3px)\n    scale(1.01);\n\n\n  box-shadow:\n\n    0\n    17px\n    35px\n    rgba(101,44,17,.27),\n\n    inset\n    0\n    1px\n    0\n    rgba(255,255,255,.17);\n\n\n  filter:\n    saturate(1.04);\n\n}\n\n\n\n.hn-premium-button:hover::before {\n\n  left:\n    130%;\n\n}\n\n\n\n.hn-premium-button span {\n\n  position:\n    relative;\n\n\n  z-index:\n    2;\n\n}\n\n\n\n.hn-premium-button svg {\n\n  position:\n    relative;\n\n\n  z-index:\n    2;\n\n\n  display:\n    block;\n\n\n  width:\n    20px;\n\n\n  height:\n    20px;\n\n\n  flex:\n\n    0\n    0\n    20px;\n\n\n  transition:\n\n    transform\n    250ms\n    ease;\n\n}\n\n\n\n.hn-premium-button:hover svg {\n\n  transform:\n    translateX(5px);\n\n}\n\n\n\n.hn-premium-button:focus-visible {\n\n  outline:\n\n    3px solid\n    rgba(93,48,25,.40);\n\n\n  outline-offset:\n    4px;\n\n}\n\n\n\n/* =========================================================\nFEATURES\n========================================================= */\n\n.hn-premium-features {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    20px;\n\n\n  width:\n    fit-content;\n\n\n  margin-top:\n    29px;\n\n\n  padding:\n\n    3px\n    0;\n\n}\n\n\n\n.hn-premium-feature {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  gap:\n    9px;\n\n\n  color:\n    #4b3629;\n\n\n  font-family:\n\n    Arial,\n    Helvetica,\n    sans-serif;\n\n\n  font-size:\n    12px;\n\n\n  font-weight:\n    500;\n\n\n  line-height:\n    1.28;\n\n}\n\n\n\n.hn-feature-icon {\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  width:\n    39px;\n\n\n  height:\n    39px;\n\n\n  flex:\n\n    0\n    0\n    39px;\n\n\n  border:\n\n    1px solid\n    rgba(130,79,39,.45);\n\n\n  border-radius:\n    50%;\n\n\n  background:\n\n    rgba(255,248,237,.22);\n\n\n  box-shadow:\n\n    inset\n    0\n    1px\n    0\n    rgba(255,255,255,.35);\n\n\n  color:\n    #855126;\n\n\n  transition:\n\n    transform\n    250ms\n    ease,\n\n    background\n    250ms\n    ease;\n\n}\n\n\n\n.hn-premium-feature:hover\n.hn-feature-icon {\n\n  transform:\n    translateY(-2px);\n\n\n  background:\n\n    rgba(255,248,237,.45);\n\n}\n\n\n\n.hn-feature-icon svg {\n\n  width:\n    22px;\n\n\n  height:\n    22px;\n\n}\n\n\n\n.hn-feature-separator {\n\n  display:\n    block;\n\n\n  width:\n    1px;\n\n\n  height:\n    48px;\n\n\n  background:\n\n    linear-gradient(\n\n      180deg,\n\n      rgba(102,72,49,0),\n\n      rgba(102,72,49,.24),\n\n      rgba(102,72,49,0)\n\n    );\n\n}\n\n\n\n/* =========================================================\nDOT NAVIGATION\n========================================================= */\n\n.hn-premium-dots {\n\n  position:\n    absolute;\n\n\n  z-index:\n    30;\n\n\n  left:\n    50%;\n\n\n  bottom:\n    20px;\n\n\n  display:\n    flex;\n\n\n  align-items:\n    center;\n\n\n  justify-content:\n    center;\n\n\n  gap:\n    8px;\n\n\n  padding:\n\n    7px\n    12px;\n\n\n  border:\n\n    1px solid\n    rgba(255,255,255,.34);\n\n\n  border-radius:\n    50px;\n\n\n  background:\n\n    rgba(255,247,235,.52);\n\n\n  box-shadow:\n\n    0\n    5px\n    18px\n    rgba(72,46,29,.10),\n\n    inset\n    0\n    1px\n    0\n    rgba(255,255,255,.35);\n\n\n  backdrop-filter:\n    blur(8px);\n\n\n  -webkit-backdrop-filter:\n    blur(8px);\n\n\n  transform:\n    translateX(-50%);\n\n}\n\n\n\n.hn-premium-dot {\n\n  display:\n    block;\n\n\n  width:\n    7px;\n\n\n  height:\n    7px;\n\n\n  min-width:\n    7px;\n\n\n  margin:\n    0;\n\n\n  padding:\n    0;\n\n\n  border:\n    0;\n\n\n  border-radius:\n    100px;\n\n\n  background:\n\n    rgba(72,49,34,.36);\n\n\n  cursor:\n    pointer;\n\n\n  appearance:\n    none;\n\n\n  -webkit-appearance:\n    none;\n\n\n  transition:\n\n    width\n    280ms\n    ease,\n\n    background\n    280ms\n    ease,\n\n    transform\n    280ms\n    ease;\n\n}\n\n\n\n.hn-premium-dot:hover {\n\n  transform:\n    scale(1.15);\n\n}\n\n\n\n.hn-premium-dot.is-active {\n\n  width:\n    27px;\n\n\n  background:\n\n    linear-gradient(\n\n      90deg,\n\n      #875526,\n\n      #b87936\n\n    );\n\n}\n\n\n\n.hn-premium-dot:focus-visible {\n\n  outline:\n\n    2px solid\n    #35251d;\n\n\n  outline-offset:\n    3px;\n\n}\n\n\n\n/* =========================================================\nTABLET\n========================================================= */\n\n@media screen and\n(max-width: 1100px) and\n(min-width: 750px) {\n\n\n  .hn-premium-content {\n\n    padding:\n\n      30px\n      38px;\n\n  }\n\n\n\n  .hn-premium-copy {\n\n    width:\n      48%;\n\n\n    max-width:\n      500px;\n\n  }\n\n\n\n  /*\n  BOTH SLIDES USE THIS SAME FONT SIZE ON TABLET\n  */\n\n  .hn-premium-heading {\n\n    font-size:\n\n      clamp(\n        33px,\n        4.7vw,\n        50px\n      );\n\n  }\n\n\n\n  .hn-content-right\n  .hn-premium-content {\n\n    padding-left:\n      52%;\n\n\n    padding-right:\n      22px;\n\n  }\n\n\n\n  .hn-content-right\n  .hn-premium-copy {\n\n    width:\n      100%;\n\n\n    max-width:\n      520px;\n\n\n    /*\n    Smaller right movement on tablet\n    */\n\n    left:\n      10px;\n\n  }\n\n\n\n  /*\n  Allow phrase to wrap on tablet if required.\n  This prevents horizontal overflow.\n  */\n\n  .hn-tradition-first-line {\n\n    white-space:\n      normal;\n\n  }\n\n\n\n  .hn-premium-ornament {\n\n    margin-top:\n      15px;\n\n  }\n\n\n\n  .hn-premium-description {\n\n    margin-top:\n      11px;\n\n\n    font-size:\n      12.5px;\n\n\n    line-height:\n      1.48;\n\n  }\n\n\n\n  .hn-premium-button {\n\n    min-width:\n      195px;\n\n\n    margin-top:\n      17px;\n\n\n    padding:\n\n      12px\n      18px;\n\n\n    font-size:\n      12px;\n\n  }\n\n\n\n  .hn-premium-features {\n\n    gap:\n      10px;\n\n\n    margin-top:\n      18px;\n\n  }\n\n\n\n  .hn-premium-feature {\n\n    gap:\n      6px;\n\n\n    font-size:\n      8.5px;\n\n  }\n\n\n\n  .hn-feature-icon {\n\n    width:\n      29px;\n\n\n    height:\n      29px;\n\n\n    flex-basis:\n      29px;\n\n  }\n\n\n\n  .hn-feature-icon svg {\n\n    width:\n      16px;\n\n\n    height:\n      16px;\n\n  }\n\n\n\n  .hn-feature-separator {\n\n    height:\n      34px;\n\n  }\n\n}\n\n\n\n/* =========================================================\nMOBILE\n========================================================= */\n\n@media screen and (max-width: 749px) {\n\n\n  .hn-premium-track {\n\n    aspect-ratio:\n      4 / 5;\n\n  }\n\n\n\n  .hn-premium-image {\n\n    width:\n      100%;\n\n\n    height:\n      100%;\n\n\n    object-fit:\n      cover;\n\n\n    object-position:\n      center center;\n\n\n    transform:\n      none !important;\n\n  }\n\n\n\n  /* MOBILE OVERLAY */\n\n  .hn-content-left\n  .hn-premium-overlay,\n\n  .hn-content-right\n  .hn-premium-overlay,\n\n  .hn-mobile-only-slide\n  .hn-premium-overlay {\n\n    background:\n\n      linear-gradient(\n\n        180deg,\n\n        rgba(252,244,229,.91) 0%,\n\n        rgba(252,244,229,.78) 15%,\n\n        rgba(252,244,229,.49) 27%,\n\n        rgba(252,244,229,.17) 40%,\n\n        rgba(252,244,229,0) 53%\n\n      );\n\n  }\n\n\n\n  /* CONTENT */\n\n  .hn-premium-content,\n  .hn-content-left\n  .hn-premium-content,\n  .hn-content-right\n  .hn-premium-content {\n\n    position:\n      absolute;\n\n\n    inset:\n      0;\n\n\n    display:\n      flex;\n\n\n    align-items:\n      flex-start;\n\n\n    justify-content:\n      center;\n\n\n    width:\n      100%;\n\n\n    height:\n      100%;\n\n\n    padding:\n\n      clamp(\n        27px,\n        7.5vw,\n        40px\n      )\n\n      18px\n\n      65px;\n\n  }\n\n\n\n  /* COPY */\n\n  .hn-premium-copy,\n  .hn-content-left\n  .hn-premium-copy,\n  .hn-content-right\n  .hn-premium-copy {\n\n    left:\n      auto;\n\n\n    width